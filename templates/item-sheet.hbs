<form class="la-sheet la-item-sheet" autocomplete="off">
  <header class="la-item-header"><img src="{{item.img}}" data-edit="img" alt=""><div><small>{{localize itemTypeLabel}}</small><input class="la-name" name="name" value="{{item.name}}"></div></header>
  <nav class="sheet-tabs la-tabs" data-group="primary"><a class="item" data-tab="details">{{localize "LA.Details"}}</a><a class="item" data-tab="description">{{localize "LA.Description"}}</a></nav>
  <section class="sheet-body la-body">
    <div class="tab" data-group="primary" data-tab="details">
      <section class="la-panel la-item-fields">
        <label>{{localize "LA.ItemCategory"}}<input value="{{localize itemTypeLabel}}" disabled></label>
        <label>{{localize "LA.Action"}}<input name="system.action" value="{{system.action}}" placeholder="Standard / minor / all-out"></label>
        <label>{{localize "LA.Range"}}<input name="system.range" value="{{system.range}}"></label>
        <label>{{localize "LA.Cost"}}<input name="system.cost" value="{{system.cost}}"></label>
        <label>{{localize "LA.Duration"}}<input name="system.duration" value="{{system.duration}}"></label>
        <label>{{localize "LA.Requirements"}}<input name="system.requirements" value="{{system.requirements}}"></label>
        <label>{{localize "LA.Uses"}}<input name="system.uses.value" type="number" value="{{system.uses.value}}"></label>
        <label>{{localize "LA.Uses"}} max<input name="system.uses.max" type="number" value="{{system.uses.max}}"></label>
        <label>{{localize "LA.Bulk"}}<input name="system.bulk" type="number" step="0.1" value="{{system.bulk}}"></label>
        <label>{{localize "LA.Quantity"}}<input name="system.quantity" type="number" min="0" value="{{system.quantity}}"></label>
        <label>{{localize "LA.Damage"}} formula<input name="system.damage.formula" value="{{system.damage.formula}}" placeholder="e.g. 1d6 + 2"></label>
        <label>{{localize "LA.Attack"}} bonus<input name="system.attack.bonus" type="number" value="{{system.attack.bonus}}"></label>
      </section>
      {{#if isRace}}
      <section class="la-panel"><h2>{{localize "LA.RacialOverview"}}</h2><p class="la-race-description">{{system.description}}</p><div class="la-race-traits"><h3>{{localize "LA.RacialTraits"}}</h3><ul>{{#each raceTraits as |trait|}}<li>{{#if trait.name}}<strong>{{trait.name}}.</strong> {{/if}}{{trait.description}}</li>{{/each}}</ul></div></section>
      <section class="la-panel"><h2>{{localize "LA.RacialData"}}</h2><div class="la-item-fields">
        <label>{{localize "LA.Speed"}}<input name="system.speed" type="number" value="{{system.speed}}"></label>
        <label>{{localize "LA.Size"}}<input name="system.size" value="{{system.size}}"></label>
        <label>{{localize "LA.Languages"}}<input name="system.languages" value="{{system.languages}}"></label>
        <label>{{localize "LA.SpecialSenses"}}<input name="system.specialSenses" value="{{system.specialSenses}}"></label>
        <label>+/- {{localize "LA.Strength"}}<input name="system.attributeAdjustments.str" type="number" value="{{system.attributeAdjustments.str}}"></label>
        <label>+/- {{localize "LA.Agility"}}<input name="system.attributeAdjustments.agi" type="number" value="{{system.attributeAdjustments.agi}}"></label>
        <label>+/- {{localize "LA.Vitality"}}<input name="system.attributeAdjustments.vit" type="number" value="{{system.attributeAdjustments.vit}}"></label>
        <label>+/- {{localize "LA.Intelligence"}}<input name="system.attributeAdjustments.int" type="number" value="{{system.attributeAdjustments.int}}"></label>
        <label>+/- {{localize "LA.Mind"}}<input name="system.attributeAdjustments.mnd" type="number" value="{{system.attributeAdjustments.mnd}}"></label>
        <label>+/- {{localize "LA.Charisma"}}<input name="system.attributeAdjustments.cha" type="number" value="{{system.attributeAdjustments.cha}}"></label>
      </div><label>{{localize "LA.RacialTraits"}}<textarea name="system.traitsText">{{system.traitsText}}</textarea></label><label>{{localize "LA.ChoiceGroupsJSON"}}<textarea name="system.choiceGroupsText">{{system.choiceGroupsText}}</textarea></label></section>
      {{/if}}
      {{#if isClass}}
      <section class="la-panel"><h2>{{localize "LA.ClassProgression"}}</h2><div class="la-item-fields">
        <label>{{localize "LA.ClassKind"}}<select name="system.classKind"><option value="base" {{#if (eq system.classKind "base")}}selected{{/if}}>{{localize "LA.BaseClass"}}</option><option value="advanced" {{#if (eq system.classKind "advanced")}}selected{{/if}}>{{localize "LA.AdvancedClass"}}</option></select></label>
        <label>{{localize "LA.ClassLevel"}}<input name="system.classLevel" type="number" min="0" value="{{system.classLevel}}"></label>
        <label>{{localize "LA.InitiativeDie"}}<input name="system.initiativeDie" value="{{system.initiativeDie}}" placeholder="1d20"></label>
        <label>{{localize "LA.Fortitude"}} {{localize "LA.ClassBonus"}}<input name="system.defenceBonuses.fort" type="number" value="{{system.defenceBonuses.fort}}"></label>
        <label>{{localize "LA.Reflex"}} {{localize "LA.ClassBonus"}}<input name="system.defenceBonuses.ref" type="number" value="{{system.defenceBonuses.ref}}"></label>
        <label>{{localize "LA.Will"}} {{localize "LA.ClassBonus"}}<input name="system.defenceBonuses.will" type="number" value="{{system.defenceBonuses.will}}"></label>
        <label>{{localize "LA.HPAtFirstLevel"}}<input name="system.hpAtFirstLevel" type="number" value="{{system.hpAtFirstLevel}}"></label>
        <label>{{localize "LA.HPPerLevel"}}<input name="system.hpPerLevel" type="number" value="{{system.hpPerLevel}}"></label>
        <label>{{localize "LA.MPAtFirstLevel"}}<input name="system.mpAtFirstLevel" type="number" value="{{system.mpAtFirstLevel}}"></label>
        <label>{{localize "LA.MPPerLevel"}}<input name="system.mpPerLevel" type="number" value="{{system.mpPerLevel}}"></label>
        <label>{{localize "LA.TrainedSkillCount"}}<input name="system.trainedSkillCount" type="number" value="{{system.trainedSkillCount}}"></label>
      </div><h3 class="la-subheading">{{localize "LA.SkillBonuses"}}</h3><div class="la-item-fields">
        <label>{{localize "LA.Acrobatics"}}<input name="system.skillBonuses.acrobatics" type="number" value="{{system.skillBonuses.acrobatics}}"></label><label>{{localize "LA.Alchemy"}}<input name="system.skillBonuses.alchemy" type="number" value="{{system.skillBonuses.alchemy}}"></label>
        <label>{{localize "LA.Athletics"}}<input name="system.skillBonuses.athletics" type="number" value="{{system.skillBonuses.athletics}}"></label><label>{{localize "LA.Deception"}}<input name="system.skillBonuses.deception" type="number" value="{{system.skillBonuses.deception}}"></label>
        <label>{{localize "LA.Disable"}}<input name="system.skillBonuses.disable" type="number" value="{{system.skillBonuses.disable}}"></label><label>{{localize "LA.LoreTerrestrial"}}<input name="system.skillBonuses.lore-terrestrial" type="number" value="{{system.skillBonuses.lore-terrestrial}}"></label>
        <label>{{localize "LA.LoreMystic"}}<input name="system.skillBonuses.lore-mystic" type="number" value="{{system.skillBonuses.lore-mystic}}"></label><label>{{localize "LA.LoreOccult"}}<input name="system.skillBonuses.lore-occult" type="number" value="{{system.skillBonuses.lore-occult}}"></label>
        <label>{{localize "LA.Medicine"}}<input name="system.skillBonuses.medicine" type="number" value="{{system.skillBonuses.medicine}}"></label><label>{{localize "LA.Perception"}}<input name="system.skillBonuses.perception" type="number" value="{{system.skillBonuses.perception}}"></label>
        <label>{{localize "LA.Perform"}}<input name="system.skillBonuses.perform" type="number" value="{{system.skillBonuses.perform}}"></label><label>{{localize "LA.Persuasion"}}<input name="system.skillBonuses.persuasion" type="number" value="{{system.skillBonuses.persuasion}}"></label>
        <label>{{localize "LA.Pilot"}}<input name="system.skillBonuses.pilot" type="number" value="{{system.skillBonuses.pilot}}"></label><label>{{localize "LA.Ride"}}<input name="system.skillBonuses.ride" type="number" value="{{system.skillBonuses.ride}}"></label>
        <label>{{localize "LA.Smithing"}}<input name="system.skillBonuses.smithing" type="number" value="{{system.skillBonuses.smithing}}"></label><label>{{localize "LA.Spellcraft"}}<input name="system.skillBonuses.spellcraft" type="number" value="{{system.skillBonuses.spellcraft}}"></label>
        <label>{{localize "LA.Stealth"}}<input name="system.skillBonuses.stealth" type="number" value="{{system.skillBonuses.stealth}}"></label><label>{{localize "LA.Survival"}}<input name="system.skillBonuses.survival" type="number" value="{{system.skillBonuses.survival}}"></label>
      </div><p class="la-hint">{{localize "LA.ClassProgressionHint"}}</p></section>
      <section class="la-panel"><h2>{{localize "LA.ClassChoices"}}</h2><label>{{localize "LA.ClassSkillList"}}<textarea name="system.classSkillsText">{{system.classSkillsText}}</textarea></label><label>{{localize "LA.SpecializationOptionsJSON"}}<textarea name="system.choiceGroupsText" placeholder='[{"key":"specialization","label":"Choose a path","options":[{"name":"Option A"}]}]'>{{system.choiceGroupsText}}</textarea></label></section>
      {{/if}}
    </div>
    <div class="tab" data-group="primary" data-tab="description"><section class="la-panel"><h2>{{localize "LA.Description"}}</h2><textarea class="la-item-description" name="system.description">{{system.description}}</textarea></section></div>
    {{#unless isNonRollable}}<footer class="la-item-footer"><button type="button" class="item-roll la-primary-button">{{localize "LA.Roll"}}</button></footer>{{/unless}}
  </section>
</form>
