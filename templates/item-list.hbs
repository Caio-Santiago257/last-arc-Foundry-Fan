<div class="la-item-list">
  {{#if items.length}}
    {{#each items as |item|}}
      <div class="item la-item-row {{#if (eq item.type 'race')}}la-race-row{{/if}} {{#if (eq item.type 'technick')}}la-technick-row{{/if}} {{#if (eq item.type 'spell')}}la-spell-row{{/if}} {{#if (eq item.type 'performance')}}la-performance-row{{/if}} {{#if (or (eq item.type 'feature') (eq item.type 'talent'))}}la-feature-row{{/if}} {{#if (eq item.type 'talent')}}la-talent-row{{/if}} {{#if (or (eq item.type 'class') (eq item.type 'advanced-class'))}}la-class-row{{/if}} {{#if (or (eq item.type 'armor') item.system.equippable)}}la-equipped-row{{/if}}" data-item-id="{{item.id}}">
        {{#if (eq item.type "technick")}}
          <button type="button" class="item-roll la-item-image-button" title="{{localize 'LA.Roll'}}" aria-label="{{localize 'LA.Roll'}}"><img src="{{item.displayImg}}" alt=""></button>
          <button type="button" class="item-edit la-link">{{item.name}}</button>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          <small class="la-item-tech-description">{{item.system.description}}{{#if item.system.selectedSkillLabel}} · {{item.system.selectedSkillLabel}}{{/if}}{{#if item.system.selectedWeaponGroupLabel}} · {{localize "LA.WeaponGroupChoice"}}: {{item.system.selectedWeaponGroupLabel}}{{/if}}</small>
        {{else if (eq item.type "spell")}}
          <button type="button" class="item-roll la-item-image-button" title="{{localize 'LA.CastSpell'}}" aria-label="{{localize 'LA.CastSpell'}}"><img src="{{item.displayImg}}" alt=""></button>
          <button type="button" class="item-edit la-link">{{item.name}}</button>
          <span class="la-item-detail">{{item.system.school}} · {{item.system.action}}</span>
          <span class="la-item-detail">{{item.system.mpCost}} MP</span>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          <small class="la-spell-description">{{item.system.description}}</small>
        {{else if (eq item.type "performance")}}
          <button type="button" class="item-roll la-item-image-button" title="{{localize 'LA.UsePerformance'}}" aria-label="{{localize 'LA.UsePerformance'}}"><img src="{{item.displayImg}}" alt=""></button>
          <button type="button" class="item-edit la-link">{{item.name}}</button>
          <span class="la-item-detail">{{#if (eq item.system.targetSide "ally")}}{{localize "LA.Allies"}}{{else}}{{localize "LA.Enemies"}}{{/if}}</span>
          <span class="la-item-detail">{{localize "LA.Perform"}}</span>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          <small class="la-performance-description">{{item.system.description}}</small>
        {{else if (eq item.system.automation.kind "aeonRoster")}}
          <button type="button" class="item-edit la-link">{{item.name}}</button>
          <button type="button" class="la-aeon-open la-icon-button" data-actor-uuid="{{item.system.automation.actorUuid}}" title="{{localize 'LA.OpenAeonSheet'}}" aria-label="{{localize 'LA.OpenAeonSheet'}}"><i class="fas fa-external-link-alt" aria-hidden="true"></i></button>
          <button type="button" class="la-aeon-summon la-icon-button" title="{{localize 'LA.SummonAeon'}}"><i class="fas fa-magic" aria-hidden="true"></i></button>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          <small class="la-feature-description">{{item.system.description}}</small>
        {{else if (or (eq item.type "feature") (eq item.type "talent"))}}
          {{#if (or (eq item.type "talent") (eq item.system.automation.kind "aeonUltimate") (eq item.system.automation.kind "aeonAction") (eq item.system.automation.kind "adversaryAbility"))}}<button type="button" class="item-roll la-item-image-button" title="{{localize 'LA.Roll'}}" aria-label="{{localize 'LA.Roll'}}"><img src="{{item.displayImg}}" alt=""></button>{{else}}<img class="la-item-image" src="{{item.displayImg}}" alt="">{{/if}}
          <button type="button" class="item-edit la-link">{{item.name}}</button>
          {{#if (eq item.system.automation.kind "summonAeon")}}<button type="button" class="la-aeon-add la-small-button" title="{{localize 'LA.AddAeonIdol'}}"><i class="fas fa-plus" aria-hidden="true"></i> {{localize "LA.AddAeonIdol"}}</button>{{/if}}
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          <small class="la-feature-description">{{item.system.description}}</small>
        {{else if (eq item.type "race")}}
          <button type="button" class="item-edit la-link"><img class="la-item-inline-image" src="{{item.displayImg}}" alt=""> {{item.name}}</button>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
        {{else}}
          {{#if (or (eq item.type "armor") item.system.equippable)}}<label class="la-item-equipped" title="{{localize 'LA.Equipped'}}" aria-label="{{localize 'LA.Equipped'}}"><input type="checkbox" data-item-equipped data-item-id="{{item.id}}" {{checked item.system.equipped}}></label>{{/if}}
          {{#if (or (eq item.type "class") (eq item.type "advanced-class"))}}
            <button type="button" class="item-edit la-link"><img class="la-item-inline-image" src="{{item.displayImg}}" alt=""> {{item.name}} · {{item.system.classLevel}} {{localize "LA.ClassLevels"}}</button>
            <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
            {{#if item.system.selectedTalentTrees}}<small class="la-class-trees">{{localize "LA.SelectedTalentTrees"}}: {{#each item.system.selectedTalentTrees as |tree|}}{{tree}}{{#unless @last}}, {{/unless}}{{/each}}</small>{{/if}}
          {{else}}
          {{#unless (or (eq item.type "race") (eq item.type "class") (eq item.type "advanced-class"))}}<button type="button" class="item-roll la-item-image-button" title="{{localize 'LA.Roll'}}" aria-label="{{localize 'LA.Roll'}}"><img src="{{item.displayImg}}" alt=""></button>{{/unless}}
          <button type="button" class="item-edit la-link"><img class="la-item-inline-image" src="{{item.displayImg}}" alt=""> {{item.name}}</button>
          <span class="la-item-detail">{{item.system.action}} {{item.system.range}}</span>
          <span class="la-item-detail">{{item.system.cost}}</span>
          <button type="button" class="item-delete la-icon-button" title="{{localize 'LA.Delete'}}"><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
          {{/if}}
        {{/if}}
      </div>
    {{/each}}
  {{else}}<p class="la-empty">{{localize "LA.NoItems"}}</p>{{/if}}
</div>
