{"_id":"bf30a8df6d0089c5","name":"Stone Hatchet","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Axes","description":"A primitive stone hatchet, commonly used by less civilized and sophisticated groups. When you roll a natural 1 on an attack roll, this weapon moves -1 step on the Break Gauge.","cost":50,"availability":"Common","bulk":0.1,"weaponGroup":"axes","weaponSize":"Small","weaponSkill":"light-weapon","attack":{"bonus":0},"damage":{"formula":"2d6-1","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"A primitive stone hatchet, commonly used by less civilized and sophisticated groups. When you roll a natural 1 on an attack roll, this weapon moves -1 step on the Break Gauge."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
