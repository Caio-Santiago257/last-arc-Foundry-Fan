{"_id":"6e98535001d17379","name":"Headsman’s Axe","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Axes","description":"An axe forged for the sole purpose of execution. Should your attack roll beat both a target’s Ref and Fort Defence, there is a 10% chance (10 or less on d%) that the target is immediately reduced to 0 HP. This does not kill the target unless the damage beat the target’s Threshold. This is a death effect.","cost":13600,"availability":"Exotic","bulk":2,"weaponGroup":"axes","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":3},"damage":{"formula":"2d10+2","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"An axe forged for the sole purpose of execution. Should your attack roll beat both a target’s Ref and Fort Defence, there is a 10% chance (10 or less on d%) that the target is immediately reduced to 0 HP. This does not kill the target unless the damage beat the target’s Threshold. This is a death effect."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"1b98561106b1060d","name":"Ogre Killer","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Axes","description":"This large axe was forged by the fae to topple the giants threatening their realm. Giants are treated as weak against this weapon’s damage. Requires 15 Str to wield.","cost":16600,"availability":"Exotic","bulk":2,"weaponGroup":"axes","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":3},"damage":{"formula":"2d12+3","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"This large axe was forged by the fae to topple the giants threatening their realm. Giants are treated as weak against this weapon’s damage. Requires 15 Str to wield.","prerequisites":{"str":15}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
