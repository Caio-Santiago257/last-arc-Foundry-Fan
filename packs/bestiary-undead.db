{"_id":"d69eb5c5eb99252b","name":"Ghoul","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"These corpses, driven by unimaginable vanity, mindlessly gorge on the flesh of the living in a futile bid to reclaim the warmth of life."},"attributes":{"str":{"score":13},"vit":{"score":16},"agi":{"score":15},"int":{"score":13},"mnd":{"score":13},"cha":{"score":14}},"skills":{"acrobatics":{"trained":true,"total":10},"athletics":{"trained":true,"total":9},"deception":{"trained":true,"total":10},"perception":{"trained":true,"total":10},"stealth":{"trained":true,"total":15},"survival":{"trained":true,"total":9},"unarmed":{"trained":true,"total":14}},"defences":{"ref":{"total":18},"fort":{"total":19},"will":{"total":17}},"resources":{"hp":{"value":48,"max":48,"baseMax":48},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":19,"immunities":["Dark","Disease","Fear Effects","Petrify","Zombify"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":6,"level":6,"xp":1200,"size":"medium","species":"Undead","profileLine":"Corrupt Evil Medium Undead 6; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"These corpses, driven by unimaginable vanity, mindlessly gorge on the flesh of the living in a futile bid to reclaim the warmth of life.","languages":"Infernal These corpses, driven by unimaginable vanity, mindlessly gorge on the flesh of the living in a futile bid to reclaim the warmth of life.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 20","passivePerception":20,"attributes":{"str":13,"agi":15,"vit":16,"int":13,"mnd":13,"cha":14},"defences":{"ref":18,"flatFootedRef":16,"fort":19,"will":17},"damageReduction":5,"breakThreshold":19,"immunities