cted","checkSkill":"spellcraft","description":"A dark rift damages nearby foes and weakens their Break Threshold.","specialRules":"A successful defence check still takes half damage. Targets occupying multiple squares take +1 damage die. Break Threshold penalty: -10 on a successful defence check, -5 otherwise, until your next turn.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"dark","defence":"fort","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0276d09238d09b21","name":"Darkness","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":6,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Magickal shadow blinds a creature.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"blinded","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7f14ca7a024fb6ee","name":"Expiry","type":"spell","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"school":"Black Magick","mpCost":24,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A curse makes the target unable to benefit from allied aid.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"zombified","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f1791d81b50504c5","name":"Infest","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Infects a foe with spreading dark energy.","specialRules":"Successful defence checks take half damage. Target takes half the initial damage at the start of its next turn and one quarter at the start of the following turn; adjacent creatures whose Fort Defence is beaten take half damage and then one quarter on their next turn. Later ticks bypass damage reduction.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"62240b5462d0b1c2","name":"Maim","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A severe burst of dark energy inflicts damage.","specialRules":"Each explosive damage die creates two extra dice. If this spell moves the target down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"afb33629247b46c6","name":"Dark Dalmatica","type":"armor","img":"icons/equipment/chest/breastplate-banded-steel-grey.webp","system":{"category":"Mystic Armour","description":"Mystic armour; damage reduction and armour check penalty are recorded.","cost":7900,"availability":"Exotic","bulk":1,"armorType":"mystic","damageReduction":8,"armorCheckPenalty":-2,"specialRules":"Robes adorned with occult iconography. You gain resistance to holy damage. Additionally, you gain a +5","itemEffects":{"resistances":["holy"]},"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8cadb96f9c7d99f1","name":"Heretic’s Rod","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"category":"Staves","description":"This rod channels dark magick.","cost":16600,"availability":"Rare","bulk":1,"weaponGroup":"staves","weaponSize":"Medium","weaponSkill":"spellcraft","attack":{"bonus":3},"damage":{"formula":"3d6+3","type":"Dark"},"range":"Ranged","capacity":0,"specialRules":"A dark sceptre favoured by apostates and cultists. When you cast a black magick spell that deals dark damage, you may reroll your damage dice, keeping the second result, even if worse.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"804830ff5dbddbd8","name":"Wraith","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"A spectre of death, said to appear at one’s final hour."},"attributes":{"str":{"score":1},"vit":{"score":18},"agi":{"score":19},"int":{"score":11},"mnd":{"score":16},"cha":{"score":21}},"skills":{"acrobatics":{"trained":true,"total":14},"deception":{"trained":true,"total":15},"lore-occult":{"trained":true,"total":10},"perception":{"trained":true,"total":13},"persuasion":{"trained":true,"total":15},"stealth":{"trained":true,"total":19},"unarmed":{"trained":true,"total":19}},"defences":{"ref":{"total":26},"fort":{"total":26},"will":{"total":25}},"resources":{"hp":{"value":115,"max":115,"baseMax":115},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":10,"baseSpeed":10,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":26,"immunities":["Curse","Dark","Disease","Fear Effects","Petrify","Poison","Sleep"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":11,"level":11,"xp":2200,"size":"medium","species":"Undead","profileLine":"Corrupt Evil Medium Incorporeal Undead 11; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"A spectre of death, said to appear at one’s final hour.","languages":"","speedText":"10 (hover)","initiativeDie":"1d6","senses":"Lifesense; Passive Perception 23","passivePerception":23,"attributes":{"str":1,"agi":19,"vit":18,"int":11,"mnd":16,"cha":21},"defences":{"ref":26,"flatFootedRef":22,"fort":26,"will":25},"damageReduction":10,"breakThreshold":26,"immunities":["Curse","Dark","Disease","Fear Effects","Petrify","Poison","Sleep"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":14,"key":"acrobatics"},{"name":"Deception","bonus":15,"key":"deception"},{"name":"Lore (occult)","bonus":10