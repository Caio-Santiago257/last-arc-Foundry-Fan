{"_id":"204292ddd9b95190","name":"Dragon, Bone","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Sustained by dark magic beyond natural life, these dragons’ decayed bodies and twisted minds spread ruin—one breath turns flesh to rot."},"attributes":{"str":{"score":29},"vit":{"score":22},"agi":{"score":10},"int":{"score":3},"mnd":{"score":15},"cha":{"score":7}},"skills":{"athletics":{"trained":true,"total":19},"perception":{"trained":true,"total":12},"unarmed":{"trained":true,"total":24}},"defences":{"ref":{"total":20},"fort":{"total":27},"will":{"total":23}},"resources":{"hp":{"value":110,"max":110,"baseMax":110},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":37,"immunities":["Blind","Curse","Dark","Death Effects","Disease","Fear Effects","Mind Effects","Paralysis","Petrify","Stuns","Zombify"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":10,"level":10,"xp":2000,"size":"large","species":"Undead","profileLine":"Corrupt Evil Large Undead 10; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Sustained by dark magic beyond natural life, these dragons’ decayed bodies and twisted minds spread ruin—one breath turns flesh to rot.","languages":"","speedText":"8","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 22","passivePerception":22,"attributes":{"str":29,"agi":10,"vit":22,"int":3,"mnd":15,"cha":7},"defences":{"ref":20,"flatFootedRef":20,"fort":27,"will":23},"damageReduction":10,"breakThreshold":37,"immunities":["Blind","Curse","Dark","Death Effects","Disease","Fear Effects","Mind Effects","Paralysis","Petrify","Stuns","Zombify"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Athletics","bonus":19,"key":"athletics"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Unarmed","bonus":24,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":24,"damage":"1d8+14","mode":"melee","type":"piercing"}],"abilities":[{"name":"Accursed Fang","description":"Whenever the bone dragon’s bite attack beats both a target’s Ref and Will Defence, the target becomes cursed with withering. Higher-level targets gain a +5 to their defence against this ability."},{"name":"Ancient Breath","description":"As a primary action, the bone dragon can make an attack (d20+21) against the Ref Defence of all living creatures within a 6 square cone, dealing 6d6+11 dark damage. Otherwise, creatures take half damage. Additionally, should the attack beat both a target’s Ref and Fort Defence, the target becomes zombified. The bone dragon may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Tail Slam","description":"Whenever the bone dragon uses a primary action to attack while flanked, it may make a free slam attack (d20+24) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d6+14 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Holy Water (5%), Bone Club (20%), Dragon Bone (95%)","steal":"Holy Water (20%), Bone Club (50%)","sourcePage":356}},"prototypeToken":{"name":"Dragon, Bone","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"b459d82acb2b7ce3","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+14","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":