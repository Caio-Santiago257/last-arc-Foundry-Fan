{"_id":"ba544e2a02287586","name":"Gigas, Death","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":12,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Headless horrors, risen through daemonic blood."},"attributes":{"str":{"score":41},"vit":{"score":21},"agi":{"score":12},"int":{"score":1},"mnd":{"score":10},"cha":{"score":10}},"skills":{"perception":{"trained":true,"total":11},"unarmed":{"trained":true,"total":31}},"defences":{"ref":{"total":22},"fort":{"total":28},"will":{"total":23}},"resources":{"hp":{"value":120,"max":120,"baseMax":120},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":43,"immunities":["Curse","Dark","Fear Effects","Poison","Toad"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":12,"level":12,"xp":2400,"size":"huge","species":"Undead","profileLine":"Corrupt Evil Huge Undead 12; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Headless horrors, risen through daemonic blood.","languages":"","speedText":"8","initiativeDie":"1d6","senses":"Blindsense; Passive Perception 21","passivePerception":21,"attributes":{"str":41,"agi":12,"vit":21,"int":1,"mnd":10,"cha":10},"defences":{"ref":22,"flatFootedRef":21,"fort":28,"will":23},"damageReduction":15,"breakThreshold":43,"immunities":["Curse","Dark","Fear Effects","Poison","Toad"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Perception","bonus":11,"key":"perception"},{"name":"Unarmed","bonus":31,"key":"unarmed"}],"attacks":[{"name":"Slams","attack":27,"damage":"1d8+25","mode":"melee","type":"blunt"}],"abilities":[{"name":"Shamble","description":"The death gigas requires an all-out action to move. Additionally, the death gigas may not charge."},{"name":"Tremor","description":"As a primary action, the gigas can make an attack roll (d20+21) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 8d6+11 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The death gigas may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun."},{"name":"Necrotic Strike","description":"Whenever a death gigas’ slam beats both a target's Ref and Will Defence, the target becomes cursed with exhaustion. Higher-level targets gain a +5 to their defence against this ability."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Putrid Flesh (20%), Antidote (50%)","steal":"Stardust (5%), Ammonia Salt (20%), Putrid Flesh (95%)","sourcePage":358}},"prototypeToken":{"name":"Gigas, Death","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"a362f915f9a47148","name":"Slams","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+25","type":"blunt"},"attack":{"bonus":-4},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"808e0f3c7857dc8d","name":"Shamble","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The death gigas requires an all-out action to move. Additionally, the death gigas may not charge.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"94af37735567c5a0","name":"Tremor","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, the gigas can make an attack roll (d20+21) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 8d6+11 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The death gigas may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cb3a2a1da677f474","name":"Necrotic Strike","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a death gigas’ slam beats both a target's Ref and Will Defence, the target becomes cursed with exhaustion. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a6f41da44ae28e56","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6e33985de71f25d9","name":"Improved Initiative","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"13b99e3cb7280d88","name":"Mighty Strikes","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e436e678ca8d730b","name":"Shake It Off","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7313ddfd39450ebe","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"11127e7ad5f852d5","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"dd32e3dc62608485","name":"Dullahan","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":14,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Pure","biography":"Oathbound knights slain before their duty was done, they haunt the living—regret twisted into bitter rage. Forsaking chivalry, they strike without mercy."},"attributes":{"str":{"score":25},"vit":{"score":19},"agi":{"score":16},"int":{"score":11},"mnd":{"score":19},"cha":{"score":22}},"skills":{"deception":{"trained":true,"total":18},"perception":{"trained":true,"total":16},"persuasion":{"trained":true,"total":18},"ride":{"trained":true,"total":15},"stealth":{"trained":true,"total":15},"unarmed":{"trained":true,"total":19}},"defences":{"ref":{"total":31},"fort":{"total":29},"will":{"total":29}},"resources":{"hp":{"value":145,"max":145,"baseMax":145},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":34,"immunities":["Curse","Dark","Death Effects","Disease","Fear Effects","Paralysis","Petrify","Poison","Stuns","Toad"],"resistances":["Blunt","Fire","Piercing","Slashing"],"vulnerabilities":["Holy Block Bone Shield (+26)"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":14,"level":14,"xp":2800,"size":"medium","species":"Undead","profileLine":"Pure Evil Medium Undead 14; Aggressive","classLevels":"","alignment":"Pure","temperament":"Aggressive","description":"Oathbound knights slain before their duty was done, they haunt the living—regret twisted into bitter rage. Forsaking chivalry, they strike without mercy.","languages":"","speedText":"4 (encumbered)","initiativeDie":"1d8","senses":"Lifesense; Passive Perception 26","passivePerception":26,"attributes":{"str":25,"agi":16,"vit":19,"int":11,"mnd":19,"cha":22},"defences":{"ref":31,"flatFootedRef":28,"fort":29,"will":29},"damageReduction":15,"breakThreshold":34,"immunities":["Curse","Dark","Death Effects","Disease","Fear Effects","Paralysis","Petrify","Poison","Stuns","Toad"],"resistances":["Blunt","Fire","Piercing","Slashing"],"weaknesses":["Holy Block Bone Shield (+26)"],"skills":[{"name":"Handed","bonus":24,"key":""},{"name":"Deception","bonus":18,"key":"deception"},{"name":"Perception","bonus":16,"key":"perception"},{"name":"Persuasion","bonus":18,"key":"persuasion"},{"name":"Ride","bonus":15,"key":"ride"},{"name":"Stealth","bonus":15,"key":"stealth"},{"name":"Unarmed","bonus":19,"key":"unarmed"}],"attacks":[{"name":"Doom Flail","attack":25,"damage":"3d8+19","mode":"melee","type":"blunt"}],"abilities":[{"name":"Accursed","description":"Dullahans ignore the cursed effects of cursed items they wield."},{"name":"Frightful Presence","description":"Any enemy that begins its turn within the dullahan’s reach is subject to an attack roll (d20+18) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. Otherwise, the creature suffers no effect and is immune to this ability for the duration of the encounter. This is a fear effect."},{"name":"Necrotic Strike","description":"Whenever a dullahan’s melee attack beats both a target’s Ref and Will Defence, the target becomes cursed with exhaustion. Higher-level targets gain a +5 to their defence against this ability."}],"spells":[],"performances":[],"equipped":"Bone Shield, Doom Flail, Zombie Mail","loot":"Zombie Mail (20%), Doom Flail (50%), Bone Shield (95%)","steal":"Moondust (5%), Ectoplasm (20%), 540gp (50%) * Includes 2 points of mighty strikes.","sourcePage":359}},"prototypeToken":{"name":"Dullahan","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"3d4e4632bb8ff80a","name":"Doom Flail","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"3d8+19","type":"blunt"},"attack":{"bonus":25},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a4e8617fb1d25bb6","name":"Accursed","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Dullahans ignore the cursed effects of cursed items they wield.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8b94224c958a754d","name":"Frightful Presence","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Any enemy that begins its turn within the dullahan’s reach is subject to an attack roll (d20+18) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. Otherwise, the creature suffers no effect and is immune to this ability for the duration of the encounter. This is a fear effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2b44499ab6af68ee","name":"Necrotic Strike","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a dullahan’s melee attack beats both a target’s Ref and Will Defence, the target becomes cursed with exhaustion. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"11dd30a29c316723","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0d45c9d09e9052ee","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"979dea5bdf5a831b","name":"Mighty Strikes","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8298b5562ce1c1e8","name":"Skill Focus (1-handed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c6412b698d1bb666","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"61468ed6d984036c","name":"Throw","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"When using Trip, you may move the target 1 square beyond your reach and deal blunt damage equal to your unarmed or natural attack damage.","prerequisites":{"technicks":["Trip"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5409e2601c88dcc8","name":"Trip","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"After a successful grapple, the target falls prone in its space and is no longer grappled.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"de01fe3efbced1c8","name":"Bone Shield","type":"armor","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"category":"Shields","description":"Shield; item attack bonus applies to shield block checks.","cost":9100,"availability":"Epic","weaponSize":"Medium","weaponSkill":"one-handed","attack":{"bonus":2},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":1,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"462a619ed5676826","name":"Doom Flail","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"category":"Bludgeons","description":"A cursed flail that hits with great power. You may use the appropriate weapon skill in place of the Unarmed skill when using the Trip technick. Additionally, use this weapon’s damage in place of your unarmed damage when used with the Throw technick.","cost":13600,"availability":"Epic","bulk":1,"weaponGroup":"bludgeons","weaponSize":"Medium","weaponSkill":"one-handed","attack":{"bonus":3},"damage":{"formula":"3d8+3","type":"Blunt"},"range":"Melee","capacity":0,"specialRules":"A cursed flail that hits with great power. You may use the appropriate weapon skill in place of the Unarmed skill when using the Trip technick. Additionally, use this weapon’s damage in place of your unarmed damage when used with the Throw technick.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2351db94499cbe12","name":"Zombie Mail","type":"armor","img":"icons/equipment/chest/breastplate-banded-steel-grey.webp","system":{"category":"Heavy Armour","description":"This cursed set of armour is adorned with the necrotic flesh of the dead. You gain resistance to all physical damage.","cost":11700,"availability":"Epic","bulk":3,"armorType":"heavy","reflexBonus":3,"damageReduction":9,"maxAgilityBonus":3,"armorCheckPenalty":-10,"specialRules":"This cursed set of armour is adorned with the necrotic flesh of the dead. You gain resistance to all physical damage.","itemEffects":{"resistances":["all"]},"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"19753b86e75d6880","name":"Dragon, Zombie","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":15,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Prideful beyond death, these ancient dragons will their broken bodies to fight on, driven by undying hatred and eternal strife."},"attributes":{"str":{"score":39},"vit":{"score":25},"agi":{"score":8},"int":{"score":5},"mnd":{"score":21},"cha":{"score":10}},"skills":{"athletics":{"trained":true,"total":26},"perception":{"trained":true,"total":17},"survival":{"trained":true,"total":17},"unarmed":{"trained":true,"total":31}},"defences":{"ref":{"total":23},"fort":{"total":33},"will":{"total":31}},"resources":{"hp":{"value":200,"max":200,"baseMax":200},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":48,"immunities":["Blind","Curse","Dark","Disease","Fear Effects","Paralysis","Petrify","Poison","Silence","Sleep","Stuns","Toad"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":15,"level":15,"xp":3000,"size":"huge","species":"Undead","profileLine":"Corrupt Evil Huge Undead 15; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Prideful beyond death, these ancient dragons will their broken bodies to fight on, driven by undying hatred and eternal strife.","languages":"","speedText":"6, Fly 10 squares","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 27","passivePerception":27,"attributes":{"str":39,"agi":8,"vit":25,"int":5,"mnd":21,"cha":10},"defences":{"ref":23,"flatFootedRef":23,"fort":33,"will":31},"damageReduction":15,"breakThreshold":48,"immunities":["Blind","Curse","Dark","Disease","Fear Effects","Paralysis","Petrify","Poison","Silence","Sleep","Stuns","Toad"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Athletics","bonus":26,"key":"athletics"},{"name":"Perception","bonus":17,"key":"perception"},{"name":"Survival","bonus":17,"key":"survival"},{"name":"Unarmed","bonus":31,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":31,"damage":"2d6 +21","mode":"melee","type":"piercing"}],"abilities":[{"name":"Ancient Breath","description":"As a primary action, the zombie dragon can make an attack (d20+24) against the Ref Defence of all living creatures within a 12 square cone, dealing 8d6+14 dark damage. Otherwise, creatures take half damage. Additionally, should the attack beat both a target's Ref and Fort Defence, the target becomes zombified. The zombie dragon may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Cursed Body","description":"Whenever the zombie dragon is hit by a melee attack, the attacker suffers an attack (d20+22) against their Will Defence. If successful, the target becomes cursed with withering. Higher-level targets gain a +5 to their defence against this ability."},{"name":"Tail Slam","description":"Whenever the zombie dragon uses a primary action to attack while flanked, it may make a free slam attack (d20+31) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+21 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Zombie Mail (5%), Mega-Potion (20%), Dragon Bone (50%)","steal":"Dragon Bone (5%), Mega-Potion (50%), Putrid Flesh (95%)","sourcePage":360}},"prototypeToken":{"name":"Dragon, Zombie","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"227b7b756b824e62","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6 +21","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6d2cae24539f5e67","name":"Ancient Breath","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, the zombie dragon can make an attack (d20+24) against the Ref Defence of all living creatures within a 12 square cone, dealing 8d6+14 dark damage. Otherwise, creatures take half damage. Additionally, should the attack beat both a target's Ref and Fort Defence, the target becomes zombified. The zombie dragon may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2ffa7c838f967fc0","name":"Cursed Body","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the zombie dragon is hit by a melee attack, the attacker suffers an attack (d20+22) against their Will Defence. If successful, the target becomes cursed with withering. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a40416f42407b80d","name":"Tail Slam","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the zombie dragon uses a primary action to attack while flanked, it may make a free slam attack (d20+31) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+21 damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4de8c6f494b01ff5","name":"Crush","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"When you pin a target, automatically deal unarmed, claw, or slam damage to it.","prerequisites":{"technicks":["Pin"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"142f668a1a90322a","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"41eadff23f1c903c","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ddc9ce181f30dd9e","name":"Lunge","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Once per turn, extend the reach of your next melee attack by 1 square and take -2 Reflex Defence until your next turn. Cannot be used while charging, prone, or making a counterattack.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ab055e9ed76713f2","name":"Pin","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"250c3689ed551939","name":"Shake it Off","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"02a9711c0f97b55a","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"98d0ae34ef296179","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c44b41aea73a4c18","name":"Reaper","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":16,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Shrouded in shadow and silence, these spectral enforcers appear only when infernal pacts are broken. Relentless and unyielding, they hunt down oathbreakers to drag them into eternal torment, serving as the archfiends’ inescapable agents of doom."},"attributes":{"str":{"score":1},"vit":{"score":18},"agi":{"score":28},"int":{"score":14},"mnd":{"score":25},"cha":{"score":20}},"skills":{"acrobatics":{"trained":true,"total":22},"deception":{"trained":true,"total":18},"lore-occult":{"trained":true,"total":15},"perception":{"trained":true,"total":20},"persuasion":{"trained":true,"total":18},"stealth":{"trained":true,"total":22},"unarmed":{"trained":true,"total":27}},"defences":{"ref":{"total":35},"fort":{"total":31},"will":{"total":34}},"resources":{"hp":{"value":165,"max":165,"baseMax":165},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":10,"baseSpeed":10,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":41,"immunities":["Blind","Confusion","Curse","Dark","Death Effects","Disease","Fear Effects","Paralysis","Petrify","Sleep","Stuns","Toad"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":16,"level":16,"xp":3200,"size":"large","species":"Undead","profileLine":"Corrupt Evil Large Incorporeal Undead 16; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Shrouded in shadow and silence, these spectral enforcers appear only when infernal pacts are broken. Relentless and unyielding, they hunt down oathbreakers to drag them into eternal torment, serving as the archfiends’ inescapable agents of doom.","languages":"","speedText":"10 (hover)","initiativeDie":"1d6","senses":"Lifesense; Passive Perception 30","passivePerception":30,"attributes":{"str":1,"agi":28,"vit":18,"int":14,"mnd":25,"cha":20},"defences":{"ref":35,"flatFootedRef":26,"fort":31,"will":34},"damageReduction":15,"breakThreshold":41,"immunities":["Blind","Confusion","Curse","Dark","Death Effects","Disease","Fear Effects","Paralysis","Petrify","Sleep","Stuns","Toad"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":22,"key":"acrobatics"},{"name":"Deception","bonus":18,"key":"deception"},{"name":"Lore (arcane)","bonus":15,"key":""},{"name":"Lore (occult)","bonus":15,"key":"lore-occult"},{"name":"Lore (social)","bonus":15,"key":""},{"name":"Perception","bonus":20,"key":"perception"},{"name":"Persuasion","bonus":18,"key":"persuasion"},{"name":"Stealth","bonus":22,"key":"stealth"},{"name":"Unarmed","bonus":27,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":27,"damage":"1d6+17","mode":"melee","type":"slashing"}],"abilities":[{"name":"Annul","description":"As primary action, a reaper can make an attack roll (d20+25) against the Will Defence of a single creature within 6 squares and line of sight. If successful, the target’s MP is reduced to 0. The reaper may not use this ability again for 1d4+1 turns. Higher-level targets gain a +5 to their defence against this ability."},{"name":"Death Strike","description":"Whenever a reaper’s claw attack beats both a target’s Ref and Will Defence, the target becomes cursed with doom. This is a death effect. Higher-level targets gain a +5 to their defence against this ability."},{"name":"Incorporeal Touch","description":"The reaper's claw attacks deal unaspected damage to living creatures. Additionally, when the reaper successfully hits a living creature with its claws, the target moves -1 step on the Break Gauge. This secondary effect is a death effect."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Ambrosia (20%), Ectoplasm (50%)","steal":"Bloodstring Lyre (5%), Cursed Bone (20%), Ambrosia (50%), Ectoplasm (95%)","sourcePage":361}},"prototypeToken":{"name":"Reaper","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"52f62ac8491f80dc","name":"Claws","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+17","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e192efe468b9dbc3","name":"Annul","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As primary action, a reaper can make an attack roll (d20+25) against the Will Defence of a single creature within 6 squares and line of sight. If successful, the target’s MP is reduced to 0. The reaper may not use this ability again for 1d4+1 turns. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5ddcd8ee8f7b6733","name":"Death Strike","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a reaper’s claw attack beats both a target’s Ref and Will Defence, the target becomes cursed with doom. This is a death effect. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a1d9f5b26bad82d9","name":"Incorporeal Touch","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The reaper's claw attacks deal unaspected damage to living creatures. Additionally, when the reaper successfully hits a living creature with its claws, the target moves -1 step on the Break Gauge. This secondary effect is a death effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e2365ee773bd6eea","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7afcc0e30c838cf4","name":"Disruptive","type":"technick","img":"icons/skills/trades/music-notes-sound-blue.webp","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7d49824c3e6cceaf","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9491e96445814204","name":"Improved Initiative","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5ba777034ceb63f4","name":"Rapid Counter","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"Make additional counterattacks per turn equal to your Agility modifier and counterattack while flat-footed; each trigger still allows only one attack.","effects":{"counterattacksPerTurnFromAgi":true},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8a93e08267bcf39f","name":"Skill Focus (stealth, unarmed)","type":"technick","img":"icons/magic/nature/stealth-hide-eyes-green.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"stealth, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3d75c997de41b16c","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"d1312d62af391433","name":"Wendigo","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":17,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Tormented souls condemned to the frozen northern wastes, twisted by the horror of cannibalism. Their warped forms roam endlessly, hunting the living—each agonized scream a fleeting balm for their own eternal torment."},"attributes":{"str":{"score":30},"vit":{"score":20},"agi":{"score":24},"int":{"score":7},"mnd":{"score":20},"cha":{"score":18}},"skills":{"athletics":{"trained":true,"total":23},"perception":{"trained":true,"total":23},"stealth":{"trained":true,"total":25},"survival":{"trained":true,"total":23},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":35},"fort":{"total":33},"will":{"total":33}},"resources":{"hp":{"value":187,"max":187,"baseMax":187},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":38,"immunities":["Cold","Confusion","Curse","Dark","Death Effects","Disease","Fear Effects","Petrify","Poison","Toad"],"resistances":[],"vulnerabilities":["Fire","Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":17,"level":17,"xp":3400,"size":"medium","species":"Undead","profileLine":"Corrupt Evil Medium Undead 17; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Tormented souls condemned to the frozen northern wastes, twisted by the horror of cannibalism. Their warped forms roam endlessly, hunting the living—each agonized scream a fleeting balm for their own eternal torment.","languages":"","speedText":"8, Climb 8","initiativeDie":"1d6","senses":"Lifesense; Passive Perception 33","passivePerception":33,"attributes":{"str":30,"agi":24,"vit":20,"int":7,"mnd":20,"cha":18},"defences":{"ref":35,"flatFootedRef":28,"fort":33,"will":33},"damageReduction":15,"breakThreshold":38,"immunities":["Cold","Confusion","Curse","Dark","Death Effects","Disease","Fear Effects","Petrify","Poison","Toad"],"resistances":[],"weaknesses":["Fire","Holy"],"skills":[{"name":"Athletics","bonus":23,"key":"athletics"},{"name":"Perception","bonus":23,"key":"perception"},{"name":"Stealth","bonus":25,"key":"stealth"},{"name":"Survival","bonus":23,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":28,"damage":"1d6+18","mode":"melee","type":"piercing"},{"name":"Claws","attack":28,"damage":"1d4+18","mode":"melee","type":"slashing"}],"abilities":[{"name":"Agonizing Bite","description":"Whenever a wendigos bite attack beat both a target’s Ref and Will Defence, the creature becomes cursed with agony. Higher-level targets gain a +5 to their defence against this ability."},{"name":"Blistering Scream","description":"As a primary action, a wendigo may make an attack roll (d20+22) against the Will Defence of all living creatures within 12 squares. If successful, the creatures become flat-footed and unable to take any actions until the start of the wendigo’s next turn. The wendigo may not use this ability again for 1d4+1 turns. This is a fear effect."},{"name":"Icy Claw","description":"A wendigo’s natural attacks deal cold damage against creatures that are weak, resistant, or immune to cold damage."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Hi-Potion (20%), Ice Crystal (50%), Putrid Flesh (95%)","steal":"Bone Club (5%), Cursed Bone (20%), Ice Crystal (95%)","sourcePage":362}},"prototypeToken":{"name":"Wendigo","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"0cd1c94ad08b0e8f","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Me