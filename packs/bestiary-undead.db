agic/symbols/rune-sigil-horned-white-purple.webp","system":{"school":"Black Magick","mpCost":4,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Magickal force suppresses the target's speech.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"silenced","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"93d672e9b9110e14","name":"Darkness","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":6,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Magickal shadow blinds a creature.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"blinded","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a6e53363c6df8114","name":"Infest","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Infects a foe with spreading dark energy.","specialRules":"Successful defence checks take half damage. Target takes half the initial damage at the start of its next turn and one quarter at the start of the following turn; adjacent creatures whose Fort Defence is beaten take half damage and then one quarter on their next turn. Later ticks bypass damage reduction.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a69cc2e36c57f2a2","name":"Maim","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A severe burst of dark energy inflicts damage.","specialRules":"Each explosive damage die creates two extra dice. If this spell moves the target down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"154ddc3b188a6343","name":"Bone Wand","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"category":"Staves","description":"This dark wand was crafted from the cursed bone of an ancient revenant. When you cast a black magick spell that deals dark damage, it deals +1 die of damage.","cost":3100,"availability":"Rare","bulk":0.1,"weaponGroup":"staves","weaponSize":"Small","weaponSkill":"spellcraft","attack":{"bonus":2},"damage":{"formula":"3d4+2","type":"Dark"},"range":"Ranged","capacity":0,"specialRules":"This dark wand was crafted from the cursed bone of an ancient revenant. When you cast a black magick spell that deals dark damage, it deals +1 die of damage.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"649926780ba568e4","name":"Banshee","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Undead","alignment":"Corrupt","biography":"Tormented spirits of maidens who lost loved ones to war, endlessly mourning with wails that shatter mortal minds."},"attributes":{"str":{"score":1},"vit":{"score":15},"agi":{"score":18},"int":{"score":5},"mnd":{"score":20},"cha":{"score":23}},"skills":{"acrobatics":{"trained":true,"total":13},"deception":{"trained":true,"total":15},"perception":{"trained":true,"total":14},"unarmed":{"trained":true,"total":18}},"defences":{"ref":{"total":23},"fort":{"total":21},"will":{"total":24}},"resources":{"hp":{"value":56,"max":56,"baseMax":56},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":2,"baseSpeed":2,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":21,"immunities":["Confusion","Curse","Dark","Disease","Fear Effects","Mind Effects","Petrify","Stuns","Zombify"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Undead","profile":"undead","cr":8,"level":8,"xp":1600,"size":"medium","species":"Undead","profileLine":"Corrupt Evil Medium Incorporeal Undead 8; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Tormented spirits of maidens who lost loved ones to war, endlessly mourning with wails that shatter mortal minds.","languages":"Common Tormented spirits of maidens who lost loved ones to war, endlessly mourning with wails that shatter mortal minds.","speedText":"2, Fly 8 (hover)","initiativeDie":"1d6","senses":"Lifesense; Passive Perception 24","passivePerception":24,"attributes":{"str":1,"agi":18,"vit":15,"int":5,"mnd":20,"cha":23},"defences":{"ref":23,"flatFootedRef":19,"fort":21,"will":24},"damageReduction":10,"breakThreshold":21,"immunities":["Confusion","Curse","Dark","Disease","Fear Effects","Mind Effects","Petrify","Stuns","Zombify"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":13,"key":"acrobatics"},{"name":"Deception","bonus":15,"key":"deception"},{"name":"Perception","bonus":14,"key":"perception"},{"name":"Unarmed","bonus":18,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":18,"damage":"1d4+8","mode":"melee","type":"blunt"}],"abilities":[{"name":"Wail","description":"As an all-out action, a banshee may make an attack (d20+20) against the Will Defence of all living creatures within 6 squares. If successful, the target takes 2d6+10 unaspected damage and becomes flat-footed and unable to take any actions until the start of the banshee’s next turn. Otherwise, the target takes half damage, does not become flat-footed, and may act normally. The banshee may not use this ability again for 1d4+1 turns. This is a fear effect."},{"name":"Incorporeal Touch","description":"The banshees slam attack deals unaspected damage to living creatures. Additionally, when the banshee successfully hits a living creature with its slam, the target moves -1 step on the Break Gauge. This secondary effect is a death effect."}],"spells":[],"performances":[],"equipped":"","loot":"Obsidian Brooch (5%), Mega-Potion (20%), Ectoplasm (50%), Obsidian (95%)","steal":"Obsidian (20%), Ectoplasm (95%)","sourcePage":354}},"prototypeToken":{"name":"Banshee","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"5a5cb150b207d255","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+8","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"829a313bc1b023e7","name":"Wail","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As an all-out action, a banshee may make an attack (d20+20) against the Will Defence of all living creatures within 6 squares. If successful, the target takes 2d6+10 unaspected damage and becomes flat-footed and unable to take any actions until the start of the banshee’s next turn. Otherwise, the target takes half damage, does not become flat-footed, and may act normally. The banshee may not use this ability again for 1d4+1 turns. This is a fear effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"858d1c8036748f40","name":"Incorporeal Touch","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The banshees slam attack deals unaspected damage to living creatures. Additionally, when the banshee successfully hits a living creature with its slam, the target moves -1 step on the Break Gauge. This secondary effect is a death effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4227981442c9e434","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"98e339bc4987a4a3","name":"Disruptive","type":"technick","img":"icons/skills/trades/music-notes-sound-blue.webp","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"26da8719fcf57193","name":"Improved Initiative","type":"technick","img":"icons/magic/symbols/rune-sig