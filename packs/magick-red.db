{"_id":"e2eff48e26e4877e","name":"Ark Blast","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Deathflare.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A high-voltage blast strikes nearby foes.","specialRules":"Beating Reflex and Fortitude also paralyses. DC 25/30/35 can jump to 4/5/6 additional targets. Same check for all; cannot repeat targets or hit caster. Chain prioritizes drenched/electric-weak targets, skips electric-immune targets, and ignores concealment.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
