{"_id":"b7153c97ad5d7f63","name":"Chain Lightning","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Thunder_II.webp","system":{"school":"Red Magick","mpCost":16,"action":"Primary Action","target":"One creature within 6 squares and line of sight, then nearby chained targets","targetMode":"selected","checkSkill":"spellcraft","description":"Electricity leaps from target to target.","specialRules":"Successful Reflex defence still takes half damage. Beating Reflex and Fortitude paralyses. Jumps to the closest eligible creature within 2 squares, up to 3/4/5/6 total at DC 20/25/30/35; cannot repeat or hit caster. One check for all. Prioritizes drenched/electric-weak and ignores concealment; excludes electric immunity.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
