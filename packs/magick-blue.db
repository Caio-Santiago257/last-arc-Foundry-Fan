{"_id":"37b271cfcdc435c0","name":"Gravity","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"school":"Blue Magick","mpCost":10,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Pulls a flying creature down and encumbers it.","specialRules":"An actively flying target lands in the nearest available spaces without provoking counterattacks. Ends Levitation. Higher-level targets gain +5 to Fort Defence; may be dispelled.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":1}]},{"dc":25,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":2}]},{"dc":30,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":3}]},{"dc":35,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":4}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
