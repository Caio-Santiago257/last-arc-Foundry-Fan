{"_id":"142e5e3d705c4e63","name":"Charm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Mage's_Ballad.webp","system":{"school":"Blue Magick","mpCost":34,"action":"All-out Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Turns a foe into a temporary ally.","specialRules":"The target treats your allies as its own and your enemies as hostile. The effect ends if it is attacked, damaged, or moved down the Break Gauge by you or an ally. Mind effect; summoned creatures are immune; may be dispelled. Higher-level targets gain +5 to Will Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":2}]},{"dc":25,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":3}]},{"dc":30,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":4}]},{"dc":35,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":5}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
