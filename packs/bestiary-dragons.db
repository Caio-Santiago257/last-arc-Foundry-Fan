ved Initiative","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dc5d60e70289ecde","name":"Rapid Counter","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Make additional counterattacks per turn equal to your Agility modifier and counterattack while flat-footed; each trigger still allows only one attack.","effects":{"counterattacksPerTurnFromAgi":true},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3eb2e4d9707e2269","name":"Skill Focus (unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c01a41c84b05a3ef","name":"Threshold Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"0dd3ea810c88cb8a","name":"Wyrm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":14,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Corrupt","biography":"Dreaded dragons of the Badlands, awakening from long slumbers to lay waste to cities in hunger."},"attributes":{"str":{"score":33},"vit":{"score":23},"agi":{"score":10},"int":{"score":6},"mnd":{"score":17},"cha":{"score":16}},"skills":{"athletics":{"trained":true,"total":23},"lore-terrestrial":{"trained":true,"total":10},"perception":{"trained":true,"total":15},"survival":{"trained":true,"total":15},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":23},"fort":{"total":31},"will":{"total":28}},"resources":{"hp":{"value":173,"max":173,"baseMax":173},"mp":{"value":84,"max":84}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":46,"immunities":["Confusion","Disease","Fire","Paralysis","Petrify"],"resistances":["Blunt"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":14,"level":14,"xp":2800,"size":"huge","species":"Dragons","profileLine":"Corrupt Neutral Huge Dragon 14; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Dreaded dragons of the Badlands, awakening from long slumbers to lay waste to cities in hunger.","languages":"Draconic Dreaded dragons of the Badlands, awakening from long slumbers to lay waste to cities in hunger.","speedText":"6, Fly 10","initiativeDie":"1d8","senses":"Dark Vision, Scent; Passive Perception 25","passivePerception":25,"attributes":{"str":33,"agi":10,"vit":23,"int":6,"mnd":17,"cha":16},"defences":{"ref":23,"flatFootedRef":23,"fort":31,"will":28},"damageReduction":15,"breakThreshold":46,"immunities":["Confusion","Disease","Fire","Paralysis","Petrify"],"resistances":["Blunt"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":23,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":10,"key":"lore-terrestrial"},{"name":"Perception","bonus":15,"key":"perception"},{"name":"Survival","bonus":15,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":28,"damage":"2d6+18","mode":"melee","type":"piercing"},{"name":"Claws","attack":28,"damage":"1d8+18","mode":"melee","type":"slashing"}],"abilities":[{"name":"Devour","description":"Whenever a wyrm reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The wyrm then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the wyrm may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Fire Breath","description":"As a primary action, a wyrm can make an attack (d20+23) against the Ref Defence of all creatures within a 12 square cone. If successful, targets take 8d6+13 fire damage. Otherwise, targets take half damage. The wyrm may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Tail Slam","description":"Whenever the wyrm uses a primary action to attack while flanked, it may make a free slam attack (d20+28) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+18 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Dragon Heart (20%), Dragon Scale (50%), Dragon Bone (95%)","steal":"Winged Boots (5%), Hi-Potion (20%), Dragon Scale (95%)","sourcePage":321}},"prototypeToken":{"name":"Wyrm","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"dee68ae60fb3e84e","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-s