{"_id":"bad5b96fa34b351d","name":"Wyvern","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Corrupt","biography":"Iconic dragons of Val’daera’s skies, often used in heraldry to symbolize majesty."},"attributes":{"str":{"score":25},"vit":{"score":20},"agi":{"score":16},"int":{"score":8},"mnd":{"score":12},"cha":{"score":9}},"skills":{"athletics":{"trained":true,"total":16},"lore-terrestrial":{"trained":true,"total":8},"perception":{"trained":true,"total":10},"stealth":{"trained":true,"total":7},"survival":{"trained":true,"total":10},"unarmed":{"trained":true,"total":21}},"defences":{"ref":{"total":21},"fort":{"total":24},"will":{"total":20}},"resources":{"hp":{"value":93,"max":93,"baseMax":93},"mp":{"value":32,"max":32}},"combat":{"initiativeDie":"1d6","speed":4,"baseSpeed":4,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":29,"immunities":["Fire","Paralysis","Sleep"],"resistances":[],"vulnerabilities":["Cold"]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":8,"level":8,"xp":1600,"size":"large","species":"Dragons","profileLine":"Corrupt Neutral Large Dragon 8; Territorial","classLevels":"","alignment":"Corrupt","temperament":"Territorial","description":"Iconic dragons of Val’daera’s skies, often used in heraldry to symbolize majesty.","languages":"Draconic Iconic dragons of Val’daera’s skies, often used in heraldry to symbolize majesty.","speedText":"4, Fly 12 (hover)","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 20","passivePerception":20,"attributes":{"str":25,"agi":16,"vit":20,"int":8,"mnd":12,"cha":9},"defences":{"ref":21,"flatFootedRef":18,"fort":24,"will":20},"damageReduction":10,"breakThreshold":29,"immunities":["Fire","Paralysis","Sleep"],"resistances":[],"weaknesses":["Cold"],"skills":[{"name":"Athletics","bonus":16,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":8,"key":"lore-terrestrial"