{"_id":"86db69e241668379","name":"Zilant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":16,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Pure","biography":"Majestic and regal, these azure dragons are prized above all by the dragoneers of Akarta."},"attributes":{"str":{"score":31},"vit":{"score":25},"agi":{"score":10},"int":{"score":8},"mnd":{"score":17},"cha":{"score":10}},"skills":{"athletics":{"trained":true,"total":23},"lore-terrestrial":{"trained":true,"total":12},"perception":{"trained":true,"total":16},"stealth":{"trained":true,"total":3},"survival":{"trained":true,"total":16},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":25},"fort":{"total":34},"will":{"total":30}},"resources":{"hp":{"value":213,"max":213,"baseMax":213},"mp":{"value":96,"max":96}},"combat":{"initiativeDie":"1d6","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":49,"immunities":["Electric","Paralysis","Toad"],"resistances":["Blunt"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":16,"level":16,"xp":3200,"size":"huge","species":"Dragons","profileLine":"Pure Neutral Huge Dragon 16; Aggressive","classLevels":"","alignment":"Pure","temperament":"Aggressive","description":"Majestic and regal, these azure dragons are prized above all by the dragoneers of Akarta.","languages":"Draconic Majestic and regal, these azure dragons are prized above all by the dragoneers of Akarta.","speedText":"6, Fly 10","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 26","passivePerception":26,"attributes":{"str":31,"agi":10,"vit":25,"int":8,"mnd":17,"cha":10},"defences":{"ref":25,"flatFootedRef":25,"fort":34,"will":30},"damageReduction":15,"breakThreshold":49,"immunities":["Electric","Paralysis","Toad"],"resistances":["Blunt"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":23,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":12,"k