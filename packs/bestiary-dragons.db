":0},"flags":{}},{"_id":"77a4e103ce7ba668","name":"Tail Slam","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the wyrm uses a primary action to attack while flanked, it may make a free slam attack (d20+28) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+18 damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3173af7bf6fd9581","name":"Crush","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When you pin a target, automatically deal unarmed, claw, or slam damage to it.","prerequisites":{"technicks":["Pin"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e65226b01810abfc","name":"Defence Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3d3980367b7696a1","name":"Disruptive","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5b86ea8db2ac63d1","name":"HP Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5d5bfdd8b39777c2","name":"Pin","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-