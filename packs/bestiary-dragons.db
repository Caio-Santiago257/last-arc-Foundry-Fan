{"_id":"dbfe9ca6a7a6f3c5","name":"Lindwyrm","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":18,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Corrupt","biography":"Ancient dragons of the Jorunheim Tundra, where their immense hunger is matched only by the land’s savage bounty."},"attributes":{"str":{"score":41},"vit":{"score":31},"agi":{"score":8},"int":{"score":8},"mnd":{"score":21},"cha":{"score":18}},"skills":{"athletics":{"trained":true,"total":29},"lore-terrestrial":{"trained":true,"total":13},"perception":{"trained":true,"total":19},"survival":{"trained":true,"total":19},"unarmed":{"trained":true,"total":34}},"defences":{"ref":{"total":23},"fort":{"total":39},"will":{"total":34}},"resources":{"hp":{"value":293,"max":293,"baseMax":293},"mp":{"value":144,"max":144}},"combat":{"initiativeDie":"1d6","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":64,"immunities":["Cold","Confusion","Curse","Death Effects","Disease","Mind Effects","Petrify","Sleep","Zombify"],"resistances":["Dark","Electric","Holy"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":18,"level":18,"xp":3600,"size":"gargantuan","species":"Dragons","profileLine":"Corrupt Evil Gargantuan Dragon 18; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Ancient dragons of the Jorunheim Tundra, where their immense hunger is matched only by the land’s savage bounty.","languages":"Draconic Ancient dragons of the Jorunheim Tundra, where their immense hunger is matched only by the land’s savage bounty.","speedText":"6, Fly 12","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 29","passivePerception":29,"attributes":{"str":41,"agi":8,"vit":31,"int":8,"mnd":21,"cha":18},"defences":{"ref":23,"flatFootedRef":23,"fort":39,"will":34},"damageReduction":15,"breakThreshold":64,"immunities":["Cold","Confusion","Curse","Death Effects","Disease","Mind Effects","Petrify","Sleep","Zombify"],"resistances":["Dark","Electric","Holy"],"weaknesses":["Fire"],"skills":[{"name":"Athletics","bonus":29,"key":"athletics"},{"name":"Lore (social)","bonus":13,"key":""},{"name":"Lore (terrestrial)","bonus":13,"key":"lore-terrestrial"},{"name":"Perception","bonus":19,"key":"perception"},{"name":"Survival","bonus":19,"key":"survival"},{"name":"Unarmed","bonus":34,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":34,"damage":"3d6+24","mode":"melee","type":"piercing"},{"name":"Claws","attack":34,"damage":"2d6+24","mode":"melee","type":"slashing"}],"abilities":[{"name":"Devour","description":"Whenever a lindwyrm reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The lindwyrm then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the lindwyrm may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Frightful Presence","description":"Any enemy that begins its turn within the lindwyrm’s reach is subject to an attack roll (d20+23) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. However, any creature that resisted this effect cannot be targeted by this ability again, for the duration of the encounter. This is a fear effect."},{"name":"Ice Breath","description":"As a primary action, lindwyrms can make an attack (d20+29) against the Ref Defence of all creatures within a 12 square cone. If successful, targets take 10d6+19 cold damage. Otherwise, targets take half damage. Additionally, if the attack roll beats both a target’s Ref and Fort Defence, their speed is reduced to 2 squares until the start of the lindwyrm's next turn. A lindwyrm may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Tail Slam","description":"Whenever the lindwyrm uses a primary action to attack while flanked, it may make a free slam attack (d20+34) against another target within reach that is providing the initial target the flanking bonus. This attack deals 2d6+24 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Dragon Heart (20%), Dragon Scale (50%), Dragon Bone (95%)","steal":"Moondust (5%), Hi-Potion (20%), Dragon Scale (95%)","sourcePage":323}},"prototypeToken":{"name":"Lindwyrm","texture":{"src":"icons/svg/mystery-man.svg"},"width":4,"height":4,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"06de1bea858bf910","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"3d6+24","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b1244cabc760d0dc","name":"Claws","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+24","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c627d66c478df919","name":"Devour","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a lindwyrm reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The lindwyrm then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the lindwyrm may perform a coup de grace on an unconscious creature, devouring the creature.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c74720b3138e4031","name":"Frightful Presence","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Any enemy that begins its turn within the lindwyrm’s reach is subject to an attack roll (d20+23) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. However, any creature that resisted this effect cannot be targeted by this ability again, for the duration of the encounter. This is a fear effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ff930d6494ca8f6f","name":"Ice Breath","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, lindwyrms can make an attack (d20+29) against the Ref Defence of all creatures within a 12 square cone. If successful, targets take 10d6+19 cold damage. Otherwise, targets take half damage. Additionally, if the attack roll beats both a target’s Ref and Fort Defence, their speed is reduced to 2 squares until the start of the lindwyrm's next turn. A lindwyrm may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"44f05686c832fa18","name":"Tail Slam","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the lindwyrm uses a primary action to attack while flanked, it may make a free slam attack (d20+34) against another target within reach that is providing the initial target the flanking bonus. This attack deals 2d6+24 damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e2e05e84bf0b65c8","name":"Crush","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When you pin a target, automatically deal unarmed, claw, or slam damage to it.","prerequisites":{"technicks":["Pin"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"83836c80655ea1a5","name":"Defence Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5b020ce934f13cbd","name":"Disruptive","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"85e364baa06051ff","name":"HP Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a8da3d228ce1b9f6","name":"Improved Initiative","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9bf037a0a3fa9141","name":"Pin","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"78d1a5448141360b","name":"Shake it Off","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bdc7d61ca5073b58","name":"Skill Focus (unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3651dae80215417e","name":"Threshold Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"de94538804137bc3","name":"Turtle, Dragon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":19,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Neutral","biography":"Vast and ancient, their shells are often mistaken for sea stacks or islands—until the “land” begins to move. Pity those who anchor too close."},"attributes":{"str":{"score":36},"vit":{"score":27},"agi":{"score":10},"int":{"score":7},"mnd":{"score":16},"cha":{"score":13}},"skills":{"athletics":{"trained":true,"total":27},"perception":{"trained":true,"total":22},"persuasion":{"trained":true,"total":15},"survival":{"trained":true,"total":17},"unarmed":{"trained":true,"total":32}},"defences":{"ref":{"total":25},"fort":{"total":38},"will":{"total":33}},"resources":{"hp":{"value":271,"max":271,"baseMax":271},"mp":{"value":114,"max":114}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":63,"immunities":["Blunt","Charm","Confusion","Curse","Fear Effects","Paralysis","Petrify","Stuns","Toad"],"resistances":["Piercing*","Slashing*"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":19,"level":19,"xp":3800,"size":"gargantuan","species":"Dragons","profileLine":"Neutral Gargantuan Dragon 19; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"Vast and ancient, their shells are often mistaken for sea stacks or islands—until the “land” begins to move. Pity those who anchor too close.","languages":"Draconic Vast and ancient, their shells are often mistaken for sea stacks or islands—until the “land” begins to move. Pity those who anchor too close.","speedText":"4, Swim 6","initiativeDie":"1d8","senses":"Dark Vision, Scent; Passive Perception 32","passivePerception":32,"attributes":{"str":36,"agi":10,"vit":27,"int":7,"mnd":16,"cha":13},"defences":{"ref":25,"flatFootedRef":25,"fort":38,"will":33},"damageReduction":15,"breakThreshold":63,"immunities":["Blunt","Charm","Confusion","Curse","Fear Effects","Paralysis","Petrify","Stuns","Toad"],"resistances":["Piercing*","Slashing*"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":27,"key":"athletics"},{"name":"Perception","bonus":22,"key":"perception"},{"name":"Persuasion","bonus":15,"key":"persuasion"},{"name":"Survival","bonus":17,"key":"survival"},{"name":"Unarmed","bonus":32,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":29,"damage":"3d6+25","mode":"melee","type":"piercing"},{"name":"Claws","attack":29,"damage":"2d6+25","mode":"melee","type":"slashing"}],"abilities":[{"name":"Devour","description":"Whenever a dragon turtle reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The dragon turtle then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the dragon turtle may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Fire Breath","description":"As a primary action, the dragon turtle can make an attack (d20+27) against the Ref Defence of all creatures within a 12 square cone. If successful, targets take 10d6+17 fire damage. Otherwise, targets take half damage. The dragon turtle may not use this ability again for 1d4 +1 turns. This is an area effect."},{"name":"Immovable","description":"The dragon turtle cannot be moved by any means of forced movement, including teleportation."},{"name":"Impassable*","description":"Creatures may not move through squares occupied by the dragon turtle, regardless of size."},{"name":"Lurk","description":"When in marine, freshwater, or beach environments, dragon turtles treat Stealth as a trained skill and ignore any size penalties to Stealth checks when in water."},{"name":"Mighty Guard","description":"As a secondary action, the dragon turtle can retreat into its shell for 1d4+1 turns. While in its shell, the dragon turtle clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the dragon turtle would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the dragon turtle may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Adamantite (20%), Dragon Heart (50%), Dragon Bone (95%)","steal":"Stardust (5%), Adamantite (20%), Dragon Scale (50%), 200gp (95%)","sourcePage":324}},"prototypeToken":{"name":"Turtle, Dragon","texture":{"src":"icons/svg/mystery-man.svg"},"width":4,"height":4,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"b30d9b7b747921eb","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"3d6+25","type":"piercing"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0aefb4db98d2ab8d","name":"Claws","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+25","type":"slashing"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9e5464b2795b9044","name":"Devour","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a dragon turtle reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The dragon turtle then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the dragon turtle may perform a coup de grace on an unconscious creature, devouring the creature.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"89f924eb3aa964ca","name":"Fire Breath","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, the dragon turtle can make an attack (d20+27) against the Ref Defence of all creatures within a 12 square cone. If successful, targets take 10d6+17 fire damage. Otherwise, targets take half damage. The dragon turtle may not use this ability again for 1d4 +1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6aaa015da77eadef","name":"Immovable","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The dragon turtle cannot be moved by any means of forced movement, including teleportation.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b00bf8cf418e5c36","name":"Impassable*","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Creatures may not move through squares occupied by the dragon turtle, regardless of size.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b46da33c0fa5b4ef","name":"Lurk","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When in marine, freshwater, or beach environments, dragon turtles treat Stealth as a trained skill and ignore any size penalties to Stealth checks when in water.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"042cf2045952ea8e","name":"Mighty Guard","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a secondary action, the dragon turtle can retreat into its shell for 1d4+1 turns. While in its shell, the dragon turtle clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the dragon turtle would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the dragon turtle may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d99d15f0ede615d5","name":"Crush","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When you pin a target, automatically deal unarmed, claw, or slam damage to it.","prerequisites":{"technicks":["Pin"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"933757725e9b05b5","name":"Defence Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ae6b31b65ef79923","name":"Disruptive","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1a2320019e202625","name":"HP Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"819026b945140dfd","name":"Pin","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0c19e2738b9801e1","name":"Mighty Strikes","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"baec04f1064c53fc","name":"Shake It Off","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2352bbe3678b6d90","name":"Skill Focus (perception, unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"96184609055458fa","name":"Threshold Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
