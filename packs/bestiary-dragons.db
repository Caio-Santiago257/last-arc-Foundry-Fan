{"_id":"39c6788280176e1f","name":"Hydra","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":7,"xp":0,"nextLevel":0,"className":"","race":"Dragons","alignment":"Neutral","biography":"A savage dragon with multiple vicious heads, each as deadly as the last."},"attributes":{"str":{"score":25},"vit":{"score":24},"agi":{"score":12},"int":{"score":2},"mnd":{"score":11},"cha":{"score":9}},"skills":{"athletics":{"trained":true,"total":15},"perception":{"trained":true,"total":8},"unarmed":{"trained":true,"total":20}},"defences":{"ref":{"total":17},"fort":{"total":25},"will":{"total":25}},"resources":{"hp":{"value":84,"max":84,"baseMax":84},"mp":{"value":21,"max":21}},"combat":{"initiativeDie":"1d6","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":35,"immunities":[],"resistances":["Cold","Electric"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Dragons","profile":"dragon","cr":7,"level":7,"xp":1400,"size":"huge","species":"Dragons","profileLine":"Neutral Evil Huge Dragon 7; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"A savage dragon with multiple vicious heads, each as deadly as the last.","languages":"","speedText":"4, Swim 4","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 18","passivePerception":18,"attributes":{"str":25,"agi":12,"vit":24,"int":2,"mnd":11,"cha":9},"defences":{"ref":17,"flatFootedRef":16,"fort":25,"will":25},"damageReduction":5,"breakThreshold":35,"immunities":[],"resistances":["Cold","Electric"],"weaknesses":["Fire"],"skills":[{"name":"Athletics","bonus":15,"key":"athletics"},{"name":"Perception","bonus":8,"key":"perception"},{"name":"Unarmed","bonus":20,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":20,"damage":"2d6+10","mode":"melee","type":"piercing"}],"abilities":[{"name":"Dual Mind","description":"Hydras add twice their level to their Will Defence."},{"name":"Regrow","description":"When a hydra loses a limb, they can grow it back in 1d10+1 days, at which point any penalties are removed."},{"name":"Triad","description":"When the hydra attacks a single creature with its bite, it combos on a natural 19-20."},{"name":"Tribite","description":"When the hydra uses a primary action to attack with its bite, it may attack up to 3 targets, making a separate attack roll for each target."}],"spells":[],"performances":[],"equipped":"","loot":"Snowdrop (5%), Dragon Scale (20%), Storm Crystal (50%)","steal":"Coral Sword (5%), Dragon Scale (20%), Storm Crystal (95%) Dragons The mighty children of Fomalhaut, they once held the world by the throat, ruling through sheer terror. While they are a far cry from what they once were, they are still fiercely powerful and formidable creatures. Dragons progress as beasts, however, they gain 2 attribute increases at every 4th level, as normal, and gain an amount of MP equal to 3+Mnd at each level.","sourcePage":319}},"prototypeToken":{"name":"Hydra","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"f7f0180c2752b5c0","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+10","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6e16ee24f95c7164","name":"Dual Mind","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Hydras add twice their level to their Will Defence.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fa8ee9aba6f567b4","name":