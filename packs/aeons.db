{"_id":"b56f69807109cb07","name":"Betelgeuse (The Great Pox)","type":"npc","img":"icons/creatures/magical/elemental-earth.webp","system":{"details":{"level":1,"className":"Aeon","race":"large","biography":"<p>Primal of pestilence and decay; father of Goblin-kind.</p>"},"attributes":{"str":{"score":10},"vit":{"score":10},"agi":{"score":10},"int":{"score":10},"mnd":{"score":10},"cha":{"score":10}},"skills":{"perception":{"trained":true},"spellcraft":{"trained":true},"unarmed":{"trained":true}},"defences":{"ref":{"total":18},"fort":{"total":31},"will":{"total":23}},"resources":{"hp":{"value":133,"max":133,"baseMax":133},"mp":{"value":63,"max":63}},"combat":{"creatureSize":"large","speed":6,"baseSpeed":6,"initiativeDie":"1d20","damageReduction":5,"baseDamageReduction":5,"immunities":[],"resistances":[],"vulnerabilities":[]},"aeon":{"isAeon":true,"aeonId":"betelgeuse","name":"Betelgeuse","epithet":"The Great Pox","affinity":"dark","size":"large","reach":2,"speed":{"land":6},"description":"Primal of pestilence and decay; father of Goblin-kind.","features":[{"name":"Corpulent","description":"Immune to blind, slow, and zombify. Resistant to dark damage and weak to holy damage."},{"name":"Gnawxious Bite","description":"After using Pin, Betelgeuse may make a free bite attack against the pinned target for 1d8 piercing damage instead of 1d6 blunt. The target may become poisoned: 50% at level 1, 75% at level 2, automatic at level 6.","automation":{"kind":"aeonAction","actionId":"gnawxiousBite"}},{"name":"Cesspool","ultimate":true,"description":"All-out area action: attack Fortitude Defence of all enemies within 6 squares. A target whose defence is beaten becomes slowed, poisoned (death fog), diseased, and blinded; silenced at level 6 and paralysed at level 10. Unsummon Betelgeuse after resolution."}],"spellProgression":[{"level":1,"spells":["Torpor","Infest"]},{"level":2,"spells":["Mire"]},{"level":4,"spells":["Sap"]},{"level":6,"spells":["Corrode"]},{"level":8,"spells":["Expiry