b88","name":"Fomalhaut: Dragonstorm","type":"feature","img":"icons/creatures/magical/elemental-earth.webp","system":{"category":"Aeon Ultimate","description":"All-out action: attack the Reflex Defence of all enemies within 6 squares. On a hit deal unaspected damage; on a miss deal half. Unsummon Fomalhaut after resolution. 6d6 + Summoner level (8d6 at Summoner 6, 10d6 at Summoner 10).","automation":{"kind":"aeonUltimate","attackDefence":"ref","damageType":"unaspected"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dfab18c622d56b2a","name":"Fireball","type":"spell","img":"icons/magic/fire/explosion-fireball-large-orange.webp","system":{"school":"Red Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"An explosive fire orb damages its target and nearby creatures.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half the primary damage if the check beats their Reflex Defence; otherwise none.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"6d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"8d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"10d6","damageType":"fire","defence":"ref","halfOnFailure":true}]}]},"aeonEntity":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"last-arc-analogue":{"aeonGranted":{"kind":"spell","name":"Fireball","level":1}}}},{"_id":"deaf6ce68691792f","name":"Lightning Bolt","type":"spell","img":"icons/magic/lightning/bolt-forked-blue.webp","system":{"school":"Red Magick","mpCost":16,"actio