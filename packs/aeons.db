{"_id":"84f392c69d941ec6","name":"Fomalhaut (The Wyrmking)","type":"npc","img":"icons/creatures/magical/elemental-earth.webp","system":{"details":{"level":1,"className":"Aeon","race":"huge","biography":"<p>Primal of arcane power and father of dragons.</p>"},"attributes":{"str":{"score":10},"vit":{"score":10},"agi":{"score":10},"int":{"score":10},"mnd":{"score":10},"cha":{"score":10}},"skills":{"perception":{"trained":true},"spellcraft":{"trained":true},"unarmed":{"trained":true}},"defences":{"ref":{"total":22},"fort":{"total":28},"will":{"total":28}},"resources":{"hp":{"value":112,"max":112,"baseMax":112},"mp":{"value":98,"max":98}},"combat":{"creatureSize":"huge","speed":6,"baseSpeed":6,"initiativeDie":"1d20","damageReduction":5,"baseDamageReduction":5,"immunities":[],"resistances":[],"vulnerabilities":[]},"aeon":{"isAeon":true,"aeonId":"fomalhaut","name":"Fomalhaut","epithet":"The Wyrmking","affinity":"unaspected","size":"huge","reach":3,"speed":{"land":6,"fly":12},"description":"Primal of arcane power and father of dragons.","features":[{"name":"Arcane Supremacy","description":"+5 to all defences against spells. Area effects deal half damage to Fomalhaut, or no damage if the effect fails to beat the relevant defence."},{"name":"Dragonphase","description":"After casting a spell that deals elemental damage, gain resistance to that element until casting another spell. Immune to slow."},{"name":"Dragonstorm","ultimate":true,"description":"All-out action: attack the Reflex Defence of all enemies within 6 squares. On a hit deal unaspected damage; on a miss deal half. Unsummon Fomalhaut after resolution. 6d6 + Summoner level (8d6 at Summoner 6, 10d6 at Summoner 10)."}],"spellProgression":[{"level":1,"spells":["Fireball","Lightning Bolt","Ice Blast"]},{"level":2,"spells":["Dispel","Gravity"]},{"level":4,"spells":["Firestorm","Thunderstorm","Blizzard"]},{"level":6,"spells":["Banish","Levitation"]},{"level":8,"spells":["Inferno","Ark Blast","Whiteout"]}],"spellOwners":{},"