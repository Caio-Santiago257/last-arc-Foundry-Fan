nt; success treats the attack as not beating its Reflex Defence.","prerequisites":{"skills":["ride"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7371fc0707a5cb3e","name":"Powerful Charge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"Gain +2 on attacks made while charging and deal additional damage equal to half your character level.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"77a7ed32e50617b4","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ac6f01c39fd17977","name":"Skill Focus (1-handed, 2-handed, ride)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed, 2-handed, ride","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e7ff08ffbf5db67f","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d5a0b4a4957e4882","name":"Trample","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"During a mounted charge, move through creatures 