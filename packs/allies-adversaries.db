":[{"type":"damage","formula":"2d6","damageType":"blunt","defence":"ref","halfOnFailure":true},{"type":"condition","status":"flatFooted","requiresDefences":["ref","fort"],"durationRounds":0},{"type":"condition","status":"prone","requiresDefences":[{"defence":"fort","margin":5}],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"blunt","defence":"ref","halfOnFailure":true},{"type":"condition","status":"flatFooted","requiresDefences":["ref","fort"],"durationRounds":0},{"type":"condition","status":"prone","requiresDefences":[{"defence":"fort","margin":5}],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"blunt","defence":"ref","halfOnFailure":true},{"type":"condition","status":"flatFooted","requiresDefences":["ref","fort"],"durationRounds":0},{"type":"condition","status":"prone","requiresDefences":[{"defence":"fort","margin":5}],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d42979578235434d","name":"Shockwave","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Akh_Morn.webp","system":{"school":"Green Magick","mpCost":10,"action":"Primary Action","target":"All creatures in a 6-square cone","targetMode":"selected","checkSkill":"spellcraft","description":"Ground tremors damage and stagger creatures in a cone.","specialRules":"Successful Reflex defence still takes half damage. Beating Reflex and Fortitude causes flat-footed; beating Fortitude by 5 also causes prone. Does not affect hover; secondary effect is a stun.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"blunt","defence":"ref","halfOnFailure":true},{"type":"condition","status":"flatFooted","requiresDefences":["ref","fort"],"durationRounds":0},{"type":"condition","status":"prone","requiresDefences":[{"defence":"fort","margin":5}],"durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"owner