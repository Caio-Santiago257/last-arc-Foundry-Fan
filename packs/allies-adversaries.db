ed","attack":{"bonus":2},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":2,"specialRules":"This large tower shield helps protect the wielder from the worst of attacks. You suffer only a -2 penalty when fighting defensively, rather than the normal -5.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7039be8b37c35192","name":"Shielded Armour","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Heavy Armour","description":"This bulky armour is heavily fortified with additional plates. When you take physical damage, explosive dice generate -1 damage die per explosive die.","cost":8900,"availability":"Uncommon","bulk":3,"armorType":"heavy","reflexBonus":4,"damageReduction":8,"maxAgilityBonus":0,"armorCheckPenalty":-10,"specialRules":"This bulky armour is heavily fortified with additional plates. When you take physical damage, explosive dice generate -1 damage die per explosive die.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dac199f3838cdb2b","name":"Steel Gorget","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/MNK/Steel_Peak.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":1400,"availability":"Common","bulk":0.1,"equipSlot":"Neck","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"de691d7259275412","name":"High Priest","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"Initiate 6/Bard 1/Bishop 8","race":"Human","alignment":"Pure","biography":"High-ranking clerics of the Hieratium Order, they serve beneath the Supreme Patriarch himself, entrusted with the governance and spiritual guidance of their diocese. Only the most devout and righteous are chosen to bear such sacred responsibility."},"attributes":{"str":{"score":10},"vit":{"score":13},"agi":{"score":10},"int":{"score":16},"mnd":{"score":18},"cha":{"score":16}},"skills":{"alchemy":{"trained":true,"total":15},"lore-mystic":{"trained":true,"total":20},"medicine":{"trained":true,"total":16},"perception":{"trained":true,"total":16},"perform":{"trained":true,"total":20},"persuasion":{"trained":true,"total":15},"survival":{"trained":true,"total":16}},"defences":{"ref":{"total":32},"fort":{"total":29},"will":{"total":34}},"resources":{"hp":{"value":118,"max":118,"baseMax":118},"mp":{"value":133,"max":133}},"combat":{"initiativeDie":"1d12","speed":6,"baseSpeed":6,"damageReduction":8,"baseDamageReduction":8,"breakThreshold":34,"immunities":["Blind","Confusion","Disease","Drench","Oil","Paralysis","Petrify","Poison","Silence","Sleep","Slow","Toad","Zombify"],"resistances":["Dark"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":15,"level":6,"xp":3000,"size":"medium","species":"Human","profileLine":"Pure Good Medium Human Initiate 6/Bard 1/Bishop 8","classLevels":"Initiate 6/Bard 1/Bishop 8","alignment":"Pure","temperament":"","description":"High-ranking clerics of the Hieratium Order, they serve beneath the Supreme Patriarch himself, entrusted with the governance and spiritual guidance of their diocese. Only the most devout and righteous are chosen to bear such sacred responsibility.","languages":"Celestial, Common, Elven, Infernal High-ranking clerics of the Hieratium Order, they serve beneath the Supreme Patriarch himself, entrusted with the governance and spiritual guidance of their diocese. Only the most devout and righteous are chosen to bear such sacred responsibility.","speedText":"6","initiativeDie":"1d12","senses":"; Passive Perception 26","passivePerception":26,"attributes":{"str":10,"agi":10,"vit":13,"int":16,"mnd":18,"cha":16},"defences":{"ref":32,"flatFootedRef":28,"fort":29,"will":34},"damageReduction":8,"breakThreshold":34,"immunities":["Blind","Confusion","Disease","Drench","Oil","Paralysis","Petrify","Poison","Silence","Sleep","Slow","Toad","Zombify"],"resistances":["Dark"],"weaknesses":[],"skills":[{"name":"Alchemy","bonus":15,"key":"alchemy"},{"name":"Lore (mystic)","bonus":20,"key":"lore-mystic"},{"name":"Medicine","bonus":16,"key":"medicine"},{"name":"Perception","bonus":16,"key":"perception"},{"name":"Perform (oratory)","bonus":20,"key":"perform"},{"name":"Persuasion","bonus":15,"key":"persuasion"},{"name":"Survival","bonus":16,"key":"survival"}],"attacks":[{"name":"Bishop’s Crosier","attack":25,"damage":"3d8+10","mode":"ranged","type":"blunt"}],"abilities":[],"spells":["Barrier","Cleanse","Cure","Curatio","Dispel","Faith","Holy","Luminescence","Regen","Revive","Smite","Shell"],"performances":["Beau Capriccio","Knight's Paeon","Scamp's Nocturne","Vigil's Overture"],"equipped":"Bishop’s Crosier, Catholicon Ring, Crucifix, Radiant Raiment","loot":"Bishop’s Crosier (5%), Radiant Raiment (20%), Crucifix (50%), Catholicon Ring (95%), and 8,700gp","steal":"Elixir (5%), Mega Ether (20%), Holy Water (50%)","sourcePage":264}},"prototypeToken":{"name":"High Priest","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"b8500c68666e6d95","name":"Bishop’s Crosier","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d8+10","type":"blunt"},"attack":{"bonus":25},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"71ca7c04971ab6ec","name":"Asylum","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Divine_Might.webp","system":{"className":"Bishop","tree":"Priest","description":"You bestow your allies with a divine blessing that cannot be overcome. Enemies suffer a -5 penalty to any skill checks made to dispel your white magick.","prerequisites":"Sanctuary","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c88c2939061ca019","name":"Benediction","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Secret_of_the_Lily.webp","system":{"className":"Bishop","tree":"Priest","description":"You bestow the merciful blessings of the Goddess unto others. Whenever you cast a white magick spell that heals a creature, you also move the creature +1 step on the Break Gauge.","prerequisites":"Healer’s Blessing I","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b312890ff80b802d","name":"Divine Preservation","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Devotee","description":"Channeling mana also advances the user's Break Gauge. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7a1b3e63742c1da9","name":"Healer’s Blessing I","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d86b41e4b156ac48","name":"Healer’s Blessing II","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fee04ad13e327f1a","name":"Monologue","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"className":"Bard","tree":"Mediator","description":"Extend an oratory performance to affect a short cone of creatures. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f6b243ef0339511c","name":"Prayer","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"className":"Bishop","tree":"Priest","description":"You recite a holy prayer, granting your allies the blessings of Elysium. When you affect an ally with an oratory bardic performance, they also gain an amount of temporary HP equal to your class level. This temporary HP is used first and lasts until the start of your next turn.","prerequisites":"Bardic Study, Trained in Perform Oratory","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4092cc562772d542","name":"Sanctuary","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Bishop","tree":"Priest","description":"The forces of evil find it difficult to overcome your divine power. Whenever you grant allies DR with white magick spells, the DR is only reduced by 3 points when exceeded by damage, rather than 5.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e6e773fe3d671207","name":"Arcane Study 3","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f33e100b09976bac","name":"Armour Proficiency (mystic)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1e96418fcb5c6098","name":"Bardic Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Learn performances from scores, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots. New slots are granted retroactively when the Intelligence modifier increases.","prerequisites":{"anySkills":["perform"]},"repeatable":true,"effects":{"performanceSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"75f8245c08d594d6","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"88ecfcfc88d8b29a","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"40cd1103c443b3f9","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7897778d117a31bf","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"be98d349780e59f5","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c9cab68ff4b4e784","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a749bb550fa36265","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ad02ae75a3b665c3","name":"Skill Focus (lore mystic, perform oration, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Army's_Paeon.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"lore mystic, perform oration, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0fecffd7233cbb31","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"81feefe1e6caa1d7","name":"Weapon Proficiency (knives, staves)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"knives, staves","category":