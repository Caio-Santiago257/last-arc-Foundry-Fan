null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"afe06e2c4df39391","name":"Manafont","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Secret_of_the_Lily.webp","system":{"className":"Mage","tree":"Arcanist","description":"Channeling restores additional mana based on character level. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2ff153b05fcf0a4e","name":"Penetrating Spell","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Mage","tree":"Arcanist","description":"Treat a damaged target's Break Threshold as lower for the spell. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2b802931b26d4029","name":"Spell Mastery","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Archmage","tree":"Thaumaturge","description":"You are able to empower your spells more often. You may now use the Focused Spell talent once per encounter.","prerequisites":"Focused Spell","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7516f3a8043484e3","name":"Swift Spell","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Mage","tree":"Arcanist","description":"Once per day, cast a normally primary-action spell as a minor action. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b00bb14119ded9d2","name":"Arcane Study 3","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"53cf90e2cb9dcc36","name":"Armour Proficiency (mystic)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a41d4803cdd62e98","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"420ea61f57ef193a","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fcbb63835e727b54","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a00bd7fe63992410","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e3a0d624721de3d1","name":"Linguist","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Learn 1 + Intelligence modifier additional languages (minimum 1). This technick may be taken more than once.","prerequisites":{"attributes":{"int":13}},"repeatable":true,"choice":{"type":"languages"},"effects":{"languages":{"base":1,"intModifier":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ea026297e2da0c21","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e930f707b495813f","name":"Skill Focus (lore arcane, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"lore arcane, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3b943a5b8a37f2d2","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"84f51f22a8b6c1ca","name":"Weapon Proficiency (knives, staves, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"knives, staves, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"90ea86bb19666cf3","name":"Arcane Acumen 4","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f6954074076c815a","name":"Surecast","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Surecast.webp","system":{"category":"Class Feature","description":"Cast a primary-action-or-faster spell defensively as an all-out action without the usual penalty."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"66eba7e4e03ed93f","name":"Ark Blast","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Deathflare.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A high-voltage blast strikes nearby foes.","specialRules":"Beating Reflex and Fortitude also paralyses. DC 25/30/35 can jump to 4/5/6 additional targets. Same check for all; cannot repeat targets or hit caster. Chain prioritizes drenched/electric-weak targets, skips electric-immune targets, and ignores concealment.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f2b5c03f6b817cd3","name":"Barrier","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Succor.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants increasing protection against elemental damage.","specialRules":"Encounter duration. Elemental damage reduces this DR by 5 when it exceeds the DR. Stacks with existing DR but not itself; does not stack with Ward. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Barrier elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":10,"label":"Barrier elemental DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":15,"label":"Barrier elemental DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"28d589b63917c81e","name":"Blizzard","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"A storm of ice damages a group and can remove a target's minor action.","specialRules":"Successful Reflex defence still takes half damage. Beating Reflex and Fortitude removes the target's minor action next turn. Area radius grows from 1 to 2/3 squares at DC 25/30.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"cold","defence":"ref","halfOnFailure":true},{"type":"condition","status":"minorActionOnly","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"cold","defence":"ref","halfOnFailure":true},{"type":"condition","status":"minorActionOnly","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"cold","defence":"ref","halfOnFailure":true},{"type":"condition","status":"minorActionOnly","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e7615ae6029b5644","name":"Cleanse","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":6,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Removes ailments, with stronger results cleansing more conditions.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"removeConditions","statuses":["poisoned"]}]},{"dc":20,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced"]}]},{"dc":25,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed"]}]},{"dc":30,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping"]}]},{"dc":35,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified"]}]},{"dc":40,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified","cursed"]}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bf109b0c952bf89f","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bf6cbeba0a78b553","name":"Firestorm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_III.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"Fire rains down across an expanding area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half the initial damage at the start of the next turn and one quarter at the following turn. Area radius 1/2/3 squares for DC 20/25/30. DR reduces only the initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6a98ec4886181975","name":"Gravity","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"school":"Blue Magick","mpCost":10,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Pulls a flying creature down and encumbers it.","specialRules":"An actively flying target lands in the nearest available spaces without provoking counterattacks. Ends Levitation. Higher-level targets gain +5 to Fort Defence; may be dispelled.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":1}]},{"dc":25,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":2}]},{"dc":30,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":3}]},{"dc":35,"effects":[{"type":"condition","status":"encumbered","defence":"fort","durationRounds":4}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ff10be98c37cf8cb","name":"Inferno","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Inferno.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A massive firestorm scorches a wide area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half damage at start of next turn and one quarter at following turn. Multi-square targets take +1 die; DR applies only to initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"adc4e1e600641721","name":"Invisibility","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Hide.webp","system":{"school":"Blue Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Conceals a creature for the encounter.","specialRules":"Actions other than movement, sneaking, or carefully interacting with unattended objects end the effect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"invisible","durationRounds":0}]},{"dc":25,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":2,"label":"Invisibility Stealth"}]},{"dc":30,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":5,"label":"Invisibility Stealth"}]},{"dc":35,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":10,"label":"Invisibility Stealth"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ec886c6cf4a91075","name":"Muddle","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Trick_Attack.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Confuses a foe and disrupts its ability to distinguish friend from enemy.","specialRules":"Higher-level targets gain +5 to Will Defence. Mind effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"confused","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a6cf09ea0dc71eef","name":"Shell","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Sacred_Soil.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants protection from physical damage.","specialRules":"Encounter duration. Physical damage reduces the effect's DR by 5 when it exceeds it. May stack with existing DR, but not with itself or Protect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":5,"label":"Shell physical DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":10,"label":"Shell physical DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":15,"label":"Shell physical DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2cb7a61bf930e1ae","name":"Teleport","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Aetherial_Manipulation.webp","system":{"school":"Blue Magick","mpCost":24,"action":"All-out Action","target":"You, or one object or creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Moves a target through space, with distance and size based on the check.","specialRules":"DC 20/25/30/35/40 allow Medium/Large/Huge/Gargantuan/Colossal targets up to 6/12/18/24/30 squares. Contents and riders travel with their carrier. Unwilling creatures require beating Fort Defence. Destination must be in line of sight; higher-level targets gain +5 to Fort Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]},{"dc":40,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ab3d4a242f0074b2","name":"Thunderstorm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Stellar_Detonation.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"Lightning damages a target and nearby creatures.","specialRules":"Successful Reflex defence still takes half damage. Beating Reflex and Fortitude paralyses. Area radius 1/2/3 squares for DC 20/25/30.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"782420d53bef2176","name":"Whiteout","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A snowstorm damages foes and can deny their next minor action.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude removes minor action next turn. Multi-square targets take +1 die.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"cold","defence":"ref","halfOnFailure":true},{"type":"condition","status":"minorActionOnly","requir