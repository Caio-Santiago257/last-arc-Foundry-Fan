{"_id":"e406a288e834634b","name":"Orc Grunt","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"Nonheroic 6","race":"Orc","alignment":"Corrupt","biography":"The fierce heart of the orcish hordes, these warriors clash with brutal fury, fueled by bloodlust and an insatiable hunger for plunder."},"attributes":{"str":{"score":17},"vit":{"score":15},"agi":{"score":13},"int":{"score":7},"mnd":{"score":8},"cha":{"score":6}},"skills":{"athletics":{"trained":true,"total":11}},"defences":{"ref":{"total":14},"fort":{"total":12},"will":{"total":9}},"resources":{"hp":{"value":30,"max":30,"baseMax":30},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d10","speed":4,"baseSpeed":4,"damageReduction":3,"baseDamageReduction":3,"breakThreshold":12,"immunities":[],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"nonheroic","cr":2,"level":6,"xp":400,"size":"medium","species":"Orc","profileLine":"Corrupt Evil Medium Orc Nonheroic 6","classLevels":"Nonheroic 6","alignment":"Corrupt","temperament":"","description":"The fierce heart of the orcish hordes, these warriors clash with brutal fury, fueled by bloodlust and an insatiable hunger for plunder.","languages":"Goblin* , Orcish The fierce heart of the orcish hordes, these warriors clash with brutal fury, fueled by bloodlust and an insatiable hunger for plunder.","speedText":"4 (encumbered)","initiativeDie":"1d10","senses":"Low-light Vision; Passive Perception 12","passivePerception":12,"attributes":{"str":17,"agi":13,"vit":15,"int":7,"mnd":8,"cha":6},"defences":{"ref":14,"flatFootedRef":13,"fort":12,"will":9},"damageReduction":3,"breakThreshold":12,"immunities":[],"resistances":[],"weaknesses":[],"skills":[{"name":"Handed","bonus":11,"key":""},{"name":"Athletics","bonus":11,"key":"athletics"}],"attacks":[{"name":"Orcish Tabar","attack":11,"damage":"2d8+9","mode":"melee","type":"slashing"},{"name":"Shield Bash: Orcish Madu"