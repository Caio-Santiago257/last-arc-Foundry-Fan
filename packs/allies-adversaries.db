reflexBonus":3,"damageReduction":6,"maxAgilityBonus":3,"armorCheckPenalty":-5,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"89e00fc4aa778e76","name":"Crossbow","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"category":"Crossbows","description":"Arbalest 6,400 +2 2d12 Twin-Shot 8,500 +3 2d6+2 Cranequin 10,900 +3 3d8+2 Comitatus 13,600 +3 2d12+2 Gastraphetes 16,600 +4 2d10+2 Wyrm Sniper 19,900 +4 2d12+3 Appleshot 23,500 +5 2d8+5 Sarnga 27,400 +5 2d10+5 Appleshot A famous crossbow used to overthrow a tyrant king, it is said to split its own bolts, able to hit the same spot repeatedly. Successful hits against a single target, that do not result in a critical hit, increase the critical range of Appleshot’s next attack against the same target by 1. This effect stacks with itself and lasts until a critical hit is achieved or a different target is attacked, whichever comes first.","cost":400,"availability":"Common","bulk":1,"weaponGroup":"crossbows","weaponSize":"Medium","weaponSkill":"ranged","attack":{"bonus":0},"damage":{"formula":"2d8","type":"Piercing"},"range":"Ranged","capacity":15,"specialRules":"Arbalest 6,400 +2 2d12 Twin-Shot 8,500 +3 2d6+2 Cranequin 10,900 +3 3d8+2 Comitatus 13,600 +3 2d12+2 Gastraphetes 16,600 +4 2d10+2 Wyrm Sniper 19,900 +4 2d12+3 Appleshot 23,500 +5 2d8+5 Sarnga 27,400 +5 2d10+5 Appleshot A famous crossbow used to overthrow a tyrant king, it is said to split its own bolts, able to hit the same spot repeatedly. Successful hits against a single target, that do not result in a critical hit, increase the critical range of Appleshot’s next attack against the same target by 1. This effect stacks with itself and lasts until a critical hit is achieved or a different target is attacked, whichever comes first.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"711664f49d939999","name":"Steel Broadswor