and 8."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"595668ae156ba326","name":"Ark Blast","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Deathflare.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A high-voltage blast strikes nearby foes.","specialRules":"Beating Reflex and Fortitude also paralyses. DC 25/30/35 can jump to 4/5/6 additional targets. Same check for all; cannot repeat targets or hit caster. Chain prioritizes drenched/electric-weak targets, skips electric-immune targets, and ignores concealment.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fd94ed72f2896a95","name":"Banish","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Holy_Spirit.webp","system":{"school":"White Magick","mpCost":24,"action":"Primary Action","target":"One summoned creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Forces a summoned creature away.","specialRules":"Higher-level targets gain +5 to Will Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"unsummoned","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fc91e489fc07d5c7","name":"Black Hole","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Salted_Earth.webp","system":{"school":"Black Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A dark rift damages nearby foes and weakens their Break Threshold.","specialRules":"A successful defence check still takes half damage. Targets occupying multiple squares take +1 damage die. Break Threshold penalty: -10 on a successful defence check, -5 otherwise, until your next turn.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"dark","defence":"fort","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fc147f710f02c888","name":"Blizzard","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"A storm of ice damages a group and can remove a target's minor action.","specialRules":"Successful Reflex defence still takes half damage. Beating Reflex and Fortitude removes the target's minor action next turn. Area radius grows from 1 to 2/3 squares at DC 25/30.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"cold","defence":"ref","halfOnFailure":true},{"type":"conditi