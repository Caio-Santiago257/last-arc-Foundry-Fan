/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Sabreur","tree":"Fencer","description":"Whenever you successfully parry a melee attack, you may make a counterattack against the opponent. This counterattack must be made with a sword or knife using the 1-handed or Light weapon skill.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bc97861a91517211","name":"Swift Stealth","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Aeolian_Edge.webp","system":{"className":"Rogue","tree":"Footpad","description":"Sneak at normal movement speed; Dark Stalker may extend this benefit. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2fee97adef3803b1","name":"Weapon Specialisation (swords)","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"42d24de48c4a3e47","name":"Armour Proficiency (light)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Searing_Light.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7ca8c47227084cb0","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8f953a87929263ba","name":"Dodge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Trick_Attack.webp","system":{"description":"Once per turn as a reaction in light or no armour, make an Acrobatics check to avoid a successful attack. If the check beats the attack roll, treat the attack as not beating your Reflex Defence.","prerequisites":{"attributes":{"agi":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b20705b3b8220d58","name":"Dual Wield I","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Reduce the penalty for attacking with two weapons from -10 to -5.","prerequisites":{"attributes":{"agi":15}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d8a3c2dac3ea7520","name":"Dual Wield II","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Reduce the two-weapon attack penalty from -5 to -2.","prerequisites":{"attributes":{"agi":17},"characterLevel":6,"technicks":["Dual Wield I"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f4ea2ddfe1461b23","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c6b59fc09665fb6f","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a99d45c5ec59bed3","name":"Rapid Counter","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Make additional counterattacks per turn equal to your Agility modifier and counterattack while flat-footed; each trigger still allows only one attack.","effects":{"counterattacksPerTurnFromAgi":true},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2495d8cd124ade63","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b4b85a2293cf15e7","name":"Skill Focus (acrobatics, light weapon)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"acrobatics, light weapon","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c39864f99d9be618","name":"Weapon Finesse","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength when calculating damage with light weapons, thrown weapons, unarmed attacks, and natural attacks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"96b74e547816035e","name":"Weapon Proficiency (bludgeons, crossbows, knives, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"bludgeons, crossbows, knives, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"20658dab1c6f1d32","name":"En Garde","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":"Class feature; see class entry."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ec0c54634f880f93","name":"Panache 1","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"813c86509251dfef","name":"Parry","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":"Class feature; see class entry."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a6db878b25e694da","name":"Swordplay 1","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/RDM/Magicked_Swordplay.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"541595a244d2d29c","name":"Bolt Pendant","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","descri