:0,"ownership":{"default":0},"flags":{}},{"_id":"8c4a8c0634832865","name":"Manafont","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Secret_of_the_Lily.webp","system":{"className":"Mage","tree":"Arcanist","description":"Channeling restores additional mana based on character level. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fc689ccde19c3be9","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7960e6cf86be3db5","name":"Armour Proficiency (mystic)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"332d3f3a01c148f8","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"843b05bccf2a7405","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"efa5bb6c11ebafbf","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6aa6ced871e25ab1","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6c7887ed7f6d8b8c","name":"Skill Focus (spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5832f1cf91daea41","name":"Weapon Proficiency (knives, staves, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"knives, staves, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2b12d411ebb6a76f","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"58dfd396880e87f0","name":"Ember","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire.webp","system":{"school":"Red Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A small fire bolt strikes one creature and may splash nearby foes.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half of the primary damage only if the check beats their Reflex Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"d