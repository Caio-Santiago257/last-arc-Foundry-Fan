}},{"_id":"be30ac697628f8a7","name":"Monologue","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"className":"Bard","tree":"Mediator","description":"Extend an oratory performance to affect a short cone of creatures. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b41ad82b48341a18","name":"Skilled Negotiator","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"className":"Bard","tree":"Mediator","description":"Reroll Persuasion checks; Socialite may improve the kept result. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0bac44b70200189d","name":"Armour Proficiency (light)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Searing_Light.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f44b46e5c68878a4","name":"Bardic Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Learn performances from scores, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots. New slots are granted retroactively when the Intelligence modifier increases.","prerequisites":{"anySkills":["perform"]},"repeatable":true,"effects":{"performanceSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0538f1b7b1ea7105","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c4e10e75c1200047","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"45952c1623f1d558","name":"Linguist","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Learn 1 + Intelligence modifier additional languages (minimum 1). This technick may be taken more than once.","prerequisites":{"attributes":{"int":13}},"repeatable":true,"choice":{"type":"languages"},"effects":{"languages":{"base":1,"intModifier":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"69d8fc630533b0b9","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d5bbf7737870d34d","name":"Skill Focus (deception, light weapon, perform oratory, persuasion, ranged)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"deception, light weapon, perform oratory, persuasion, ranged","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5616fad26f2b6229","name":"Weapon Finesse","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength when calculating damage with light weapons, thrown weapons, unarmed attacks, and natural attacks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c2cd539ce3c502f3","name":"Weapon Proficiency (bows, knives, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"bows, knives, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c141ddb59690e6d7","name":"Beau Capriccio","type":"performance","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"action":"Perform check","targetSide":"ally","description":"An elegant tune lets allies use the performer's check in place of their Will Defence.","specialRules":"","automation":{"skill":"perform","minimumDC":0,"effects":[{"type":"buff","bonuses":{"substituteDefence":{"will":true}}}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6b364ef0e7c8acdf","name":"Champion's Virelai","type":"performance","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Battle_Voice.webp","system":{"action":"Perform check","targetSide":"ally","description":"A battle song that improves allies' weapon skill checks.","specialRules":"","automation":{"skill":"perform","minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"buff","bonuses":{"weaponSkillBonus":1}}]},{"dc":20,"effects":[{"type":"buff","bonuses":{"weaponSkillBonus":2}}]},{"dc":25,"effects":[{"type":"buff","bonuses":{"weaponSkillBonus":3}}]},{"dc":30,"effects":[{"type":"buff","bonuses":{"weaponSkillBonus":4}}]},{"dc":35,"effects":[{"type":"buff","bonuses":{"weaponSkillBonus":5}}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c4f4ffafcd849fed","name":"Knight's Paeon","type":"performance","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Army's_Paeon.webp","system":{"action":"Perform check","targetSide":"ally","description":"A resolute verse improves allies' Reflex Defence against attacks.","specialRules":"","automation":{"skill":"perform","minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"buff","bonuses":{"defenceBonuses":{"ref":1}}}]},{"dc":20,"effects":[{"type":"buff","bonuses":{"defenceBonuses":{"ref":2}}}]},{"dc":25,"effects":[{"type":"buff","bonuses":{"defenceBonuses":{"ref":3}}}]},{"dc":30,"effects":[{"type":"buff","bonuses":{"defenceBonuses":{"ref":4}}}]},{"dc":35,"effects":[{"type":"buff","bonuses":{"defenceBonuses":{"ref":5}}}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4e1c591e20b838e8","name":"Aevis Striker","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"category":"Bows","description":"A bow designed to take down flying creatures. Creatures with a natural fly speed are treated as weak against damage from this weapon. This is true even if said creature