"2d4+3","type":"Piercing"},"range":"Melee","capacity":0,"specialRules":"An ornate parrying dagger, favoured by duellists. You gain a +2 bonus on attack rolls made to parry.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7e60a03ffa431238","name":"Assassin","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"Rogue 5/ Ranger 2/Assassin 3","race":"Dark Elf","alignment":"Neutral","biography":"Silent as shadows and deadly as a whisper, these blades in the dark are among the world’s most elite killers."},"attributes":{"str":{"score":14},"vit":{"score":14},"agi":{"score":19},"int":{"score":14},"mnd":{"score":10},"cha":{"score":10}},"skills":{"acrobatics":{"trained":true,"total":14},"alchemy":{"trained":true,"total":12},"deception":{"trained":true,"total":10},"disable":{"trained":true,"total":14},"light-weapon":{"trained":true,"total":19},"perception":{"trained":true,"total":10},"ranged":{"trained":true,"total":19},"stealth":{"trained":true,"total":21},"unarmed":{"trained":true,"total":12}},"defences":{"ref":{"total":29},"fort":{"total":26},"will":{"total":20}},"resources":{"hp":{"value":94,"max":94,"baseMax":94},"mp":{"value":24,"max":24}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":8,"baseDamageReduction":8,"breakThreshold":26,"immunities":["Poison"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":10,"level":5,"xp":2000,"size":"medium","species":"Dark Elf","profileLine":"Neutral Evil Medium Dark Elf Rogue 5/ Ranger 2/Assassin 3","classLevels":"Rogue 5/ Ranger 2/Assassin 3","alignment":"Neutral","temperament":"","description":"Silent as shadows and deadly as a whisper, these blades in the dark are among the world’s most elite killers.","languages":"Common, Elven, Goblin, Infernal Silent as shadows and deadly as a whisper, these blades in the dark are among the world’s most elite killers.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 20","passivePerception":20,"attributes":{"str":14,"agi":19,"vit":14,"int":14,"mnd":10,"cha":10},"defences":{"ref":29,"flatFootedRef":25,"fort":26,"will":20},"damageReduction":8,"breakThreshold":26,"immunities":["Poison"],"resistances":[],"weaknesses":[],"skills":[{"name":"Acrobatics","bonus":14,"key":"acrobatics"},{"name":"Alchemy","bonus":12,"key":"alchemy"},{"name":"Deception","bonus":10,"key":"deception"},{"name":"Disable","bonus":14,"key":"disable"},{"name":"Light Weapon","bonus":19,"key":"light-weapon"},{"name":"Lore (social)","bonus":12,"key":""},{"name":"Perception","bonus":10,"key":"perception"},{"name":"Ranged","bonus":19,"key":"ranged"},{"name":"Stealth","bonus":21,"key":"stealth"},{"name":"Unarmed","bonus":12,"key":"unarmed"}],"attacks":[{"name":"Assassin’s Kard","attack":21,"damage":"2d4+12","mode":"melee","type":"slashing"},{"name":"Twin-Shot","attack":22,"damage":"2d6+11","mode":"ranged","type":"piercing"},{"name":"Twin-Shot","attack":22,"damage":"3d6+11","mode":"ranged","type":"piercing"}],"abilities":[],"spells":[],"performances":[],"equipped":"2 Assassin’s Kard, Black Garb, Bloodstone Pendant, Twin Shot, Long Bolts","loot":"Black Garb (5%), Twin Shot (20%), Assassin’s Kard (50%), Bloodstone Pendant (95%), and 3,700gp","steal":"Black Adder Venom (20%), 10 Long Bolts (50%), Hi-Potion (95%) & Adversaries","sourcePage":266}},"prototypeToken":{"name":"Assassin","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"075e143c07450fbe","name":"Assassin’s Kard","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d4+12","type":"slashing"},"attack":{"bonus":21},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b134b29b1c1e9f96","name":"Twin-Shot","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"2d6+11","type":"piercing"},"attack":{"bonus":3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7ffabba46f58c7f9","name":"Twin-Shot","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d6+11","type":"piercing"},"attack":{"bonus":3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7912119cd728f375","name":"Ambuscade","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"className":"Assassin","tree":"Sniper","description":"You open fire on your targets from the shadows, catching them by surprise. Your ranged attacks gain the benefit of your Backstab talent while you are undetected or have high ground against the target.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ae3183ce1fe6c37f","name":"Backstab","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"className":"Rogue","tree":"Cutthroat","description":"Deal extra damage with a qualifying light-weapon attack against a vulnerable target. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"de3077f96c6259eb","name":"Debilitating Injury","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Rogue","tree":"Cutthroat","description":"A successful Backstab can move the target farther down the Break Gauge. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d8f4b5881449b638","name":"Dead Shot","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"className":"Ranger","tree":"Archer","description":"Add Agility to qualifying bow or crossbow attacks against a target's weak point. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"88d9baca17b22882","name":"Improved Stealth","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Rogue","tree":"Footpad","description":"Reroll Stealth checks made to sneak; Sneaky may improve the result. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5fc5cca9e2e7fef7","name":"Vanish","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Assassin","tree":"Blackguard","description":"As a master of stealth, you can seemingly vanish into thin air. Once per encounter, you may make a Stealth check against the Passive Perception of all creatures within line of sight. If you beat a target’s Passive Perception, you gain total concealment against the target until the end of the encounter. Actions other than moving, sneaking, interacting with unattended objects (subject to GM discretion), or your Mark of Death ability immediately end this effect.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b93edd1968fe43cb","name":"Armour Proficiency (light)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Searing_Light.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0bde8425c3a42a8d","name":"Deadly Aim","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"After aiming at a target, your next ranged attack against it deals one additional damage die; the benefit ends if your aim is disrupted and does not stack with Rapid Shot.","prerequisites":{"characterLevel":4,"technicks":["Precise Shot"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"994464585a8047f8","name":"Dodge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Trick_Attack.webp","system":{"description":"Once per turn as a reaction in light or no armour, make an Acrobatics check to avoid a successful attack. If the check beats the attack roll, treat the attack as not beating your Reflex Defence.","prerequisites":{"attributes":{"agi":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3a60cfd2fa00c5bd","name":"Dual Wield I","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Reduce the penalty for attacking with two weapons from -10 to -5.","prerequisites":{"attributes":{"agi":15}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3837611d5c3c8525","name":"Dual Wield II","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Reduce the two-weapon attack penalty from -5 to -2.","prerequisites":{"attributes":{"agi":17},"characterLevel":6,"technicks":["Dual Wield I"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"48801f841889673e","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"37025a47b8b61f3e","name":"Skill Focus (light weapon, ranged, stealth)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"light weapon, ranged, stealth","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"11838961fb7cc737","name":"Triple Crit","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"description":"Ranged weapon critical hits deal triple weapon damage.","prerequisites":{"characterLevel":8},"effects":{"rangedCriticalMultiplier":3},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8316e603ec4613b2","name":"Weapon Finesse","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength when calculating damage with light weapons, thrown weapons, unarmed attacks, and natural attacks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"df6fab6ea73ea804","name":"Weapon Proficiency (bludgeons, crossbows, knives, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"bludgeons, crossbows, knives, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cc81e307d7fde5eb","name":"Blindside","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"category":"Class Feature","description":"While flanking, treat the target as flat-footed."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e4c93f53f8c49031","name":"Cloak and Dagger 1","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ffd89dc84d34ff37","name":"Assassin’s Kard","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Knives","description":"Knive; Piercing damage.","cost":8500,"availability":"Rare","bulk":0.1,"weaponGroup":"knives","weaponSize":"Tiny","weaponSkill":"light-weapon","attack":{"bonus":2},"damage":{"formula":"2d4+3","type":"Piercing"},"range":"Melee","capacity":0,"specialRules":"These shadowy blades are said to be the favoured weapons of a secret syndicate of assassins. Once per encounter, as a free action, you may choose to treat a target as flanked against all attacks made with this weapon until the start of your next turn.","quantity":2,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"48ce48b4a127d5b1","name":"Black Garb","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Light Armour","description":"Light Armour; Reflex bonus, damage reduction and maximum Agility bonus are recorded.","cost":9700,"availability":"Rare","bulk":2,"armorType":"light","reflexBonus":1,"damageReduction":8,"maxAgilityBonus":6,"armorCheckPenalty":-5,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"699472d100da4e17","name":"Bloodstone Pendant","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":200,"availability":"Uncommon","bulk":0.1,"equipSlot":"Neck","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"1d166fa7b94d5d21","name":"Goblin Fodder","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":4,"xp":0,"nextLevel":0,"className":"Nonheroic 4","race":"Goblin","alignment":"Corrupt","biography":"The lowest ranking minions in the Badlands’ armies—if soldiers they can be called. Their orcish masters discard them like broken tools, caring more for their rusted weapons than for the lives they waste."},"attributes":{"str":{"score":11},"vit":{"score":12},"agi":{"score":15},"int":{"score":10},"mnd":{"score":9},"cha":{"score":6}},"skills":{"perception":{"trained":true,"total":6},"ranged":{"trained":true,"total":9},"stealth":{"trained":true,"total":14}},"defences":{"ref":{"total":15},"fort":{"total":11},"will":{"total":9}},"resources":{"hp":{"value":16,"max":16,"baseMax":16},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":2,"baseDamageReduction":2,"breakThreshold":11,"immunities":[],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"nonheroic","cr":1,"level":4,"xp":200,"size":"small","species":"Goblin","profileLine":"Corrupt Evil Small Goblin Nonheroic 4","classLevels":"Nonheroic 4","alignment":"Corrupt","temperament":"","description":"The lowest ranking minions in the Badlands’ armies—if soldiers they can be called. Their orcish masters discard them like broken tools, caring more for their rusted weapons than for the lives they waste.","languages":"Goblin, Orcish* The lowest ranking minions in the Badlands’ armies—if soldiers they can be called. Their orcish masters discard them like broken tools, caring more for their rusted weapons than for the lives they waste.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 16","passivePerception":16,"attributes":{"str":11,"agi":15,"vit":12,"int":10,"mnd":9,"cha":6},"defences":{"ref":15,"flatFootedRef":13,"fort":11,"will":9},"damageReduction":2,"breakThreshold":11,"immuniti