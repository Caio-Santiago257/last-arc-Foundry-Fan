ownership":{"default":0},"flags":{}},{"_id":"d7c429a4cf5f73a8","name":"Blood Magick","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"className":"Warlock","tree":"Diabolist","description":"You tap into the profane power of blood sacrifice to empower your dark magick. Whenever you cast a black magick spell, you may reroll your Spellcraft check, keeping the second result, even if worse. You then lose 2d6 HP .","prerequisites":"","automation":{"type":"rollableResourceOrAttack","automated":false,"requiresTargetOrResourcePrompt":true},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"022e04388f90a52c","name":"Blood Pact","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Warlock","tree":"Diabolist","description":"You may call upon more powerful daemons but must pay their price in blood. When summoning an infernal with the Summon Darkness talent, you may summon an infernal 2 levels higher than your normal limit. However, at the start of each turn, you lose 1d6 HP . If this would reduce you to 0 HP , your infernal is immediately unsummoned.","prerequisites":"Blood Magick, Summon Darkness","automation":{"type":"rollableResourceOrAttack","automated":false,"requiresTargetOrResourcePrompt":true},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c138e640483a17a5","name":"Divine Preservation","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Devotee","description":"Channeling mana also advances the user's Break Gauge. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"29e73c2dfbbbc450","name":"Goety","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Occultist","description":"Reduce the bonus a higher-level target receives against the user's black magick. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e7efb5f2a0dd4ba2","name":"Manafont","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Secret_of_the_Lily.webp","system":{"className":"Mage","tree":"Arcanist","description":"Channeling restores additional mana based on character level. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6808b14e1a13aecc","name":"Summon Darkness","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Initiate","tree":"Occultist","description":"Summon an undead or infernal creature ally by spending mana. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook f