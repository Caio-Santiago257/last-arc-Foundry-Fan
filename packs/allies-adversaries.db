ick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"89db72a8996d00bd","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c1862e037a9678dc","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e7067cce6ebe0097","name":"Pin","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"22b8be533c36afdc","name":"Skill Focus (perception, persuasion, spellcraft, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, persuasion, spellcraft, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"db0894a7dc856176","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5068475b33e00034","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"278ebbf9e7d2fb7f","name":"Weapon Proficiency (axes, bludgeons, knives, polearms, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"axes, bludgeons, knives, polearms, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"19bb8dc2136b5345","name":"Curse Bearer 5","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"83fbcf2e7f8cc71a","name":"Oblivion","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":"Class feature; see class entry."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d0192c9cbf310ef0","name":"Unholy Sacrifice","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Aetherial_Manipulation.webp","system":{"category":"Class Feature","description":"Class feature; see class entry."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5f05e2367d57538d","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"06a9512ab527d50b","name":"Expiry","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Living_Dead.webp","system":{"school":"Black Magick","mpCost":24,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A curse makes the target unable to benefit from allied aid.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"zombified","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7760e48f823864ab","name":"Maim","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Bloodspiller.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A severe burst of dark energy inflicts damage.","specialRules":"Each explosive damage die creates two extra dice. If this spell moves the target down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1ebedc7b97cb4003","name":"Sap","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Abyssal_Drain.webp","system":{"school":"Black Magick","mpCost":16,"action":"Primary Action","target":"One living creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Drains a foe's vitality and pushes it down the Break Gauge.","specialRules":"Move the target down 1 step, plus one additional step for every 10 by which Spellcraft beats Fort Defence. Higher-level targets gain +5 to Fort Defence. Death effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"breakGaugeDown","requiresDefences":["fort"],"durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"70f411f35cf6965f","name":"Obsidian Brooch","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":8000,"availability":"Exotic","bulk":0.1,"equipSlot":"Chest","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"023ebcadf3eb2bee","name":"Pentacle","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":4400,"availability":"Rare","bulk":0.1,"equipSlot":"Neck","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"30419b397cecdf39","name":"Zombie Mail","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Heavy Armour","description":"This cursed set of armour is adorned with the necrotic flesh of the dead. You gain resistance to all physical damage.","cost":11700,"availability":"Epic","bulk":3,"armorType":"heavy","reflexBonus":3,"damageReduction":9,"maxAgilityBonus":3,"armorCheckPenalty":-10,"specialRules":"This cursed set of armour is adorned with the necrotic flesh of the dead. You gain resistance to all physical damage.","itemEffects":{"resistances":["all"]},"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c2f39f41ec0b21b2","name":"Corse","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"Archlich Initiate 9/Necromancer 10","race":"Human","alignment":"Corrupt","biography":"Hidden from the eyes of the living, these powerful undead dwell in shadow, guiding death-worshipping cults with a silent, malevolent will."},"attributes":{"str":{"score":10},"vit":{"score":20},"agi":{"score":13},"int":{"score":18},"mnd":{"score":22},"cha":{"score":14}},"skills":{"alchemy":{"trained":true,"total":23},"light-weapon":{"trained":true,"total":20},"lore-occult":{"trained":true,"total":18},"perception":{"trained":true,"total":25},"smithing":{"trained":true,"total":23},"unarmed":{"trained":true,"total":14}},"defences":{"ref":{"total":31},"fort":{"total":37},"will":{"total":40}},"resources":{"hp":{"value":219,"max":219,"baseMax":219},"mp":{"value":204,"max":204}},"combat":{"initiativeDie":"1d10","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":42,"immunities":["Cold","Dark","Death Effects","Disease","Fear Effects","Petrify","Poison","Sleep","Toad","Zombify"],"resistances":["Blunt*","Holy","Piercing*","Slashing*"],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":19,"level":9,"xp":3800,"size":"medium","species":"Human","profileLine":"Corrupt Evil Medium Human Archlich Initiate 9/Necromancer 10","classLevels":"Archlich Initiate 9/Necromancer 10","alignment":"Corrupt","temperament":"","description":"Hidden from the eyes of the living, these powerful undead dwell in shadow, guiding death-worshipping cults with a silent, malevolent will.","languages":"Celestial, Common, Dwarven, Elven, Infernal Hidden from the eyes of the living, these powerful undead dwell in shadow, guiding death-worshipping cults with a silent, malevolent will.","speedText":"6, Fly 6 (hover)","initiativeDie":"1d10","senses":"Lifesense; Passive Perception 35","passivePerception":35,"attributes":{"str":10,"agi":13,"vit":20,"int":18,"mnd":22,"cha":14},"defences":{"ref":31,"flatFootedRef":30,"fort":37,"will":40},"damageReduction":15,"breakThreshold":42,"immunities":["Cold","Dark","Death Effects","Disease","Fear Effects","Petrify","Poison","Sleep","Toad","Zombify"],"resistances":["Blunt*","Holy","Piercing*","Slashing*"],"weaknesses":["Holy"],"skills":[{"name":"Alchemy","bonus":23,"key":"alchemy"},{"name":"Light Weapon","bonus":20,"key":"light-weapon"},{"name":"Lore (arcane)","bonus":18,"key":""},{"name":"Lore (occult)","bonus":18,"key":"lore-occult"},{"name":"Lore (social)","bonus":18,"key":""},{"name":"Perception","bonus":25,"key":"perception"},{"name":"Smithing","bonus":23,"key":"smithing"},{"name":"Unarmed","bonus":14,"key":"unarmed"}],"attacks":[{"name":"Heretic’s Rod","attack":28,"damage":"3d6+12","mode":"ranged","type":"blunt"}],"abilities":[],"spells":["Ark Blast","Banish","Black Hole","Blizzard","Darkness","Dispel","Fireball","Firestorm","Infest","Lightning Bolt","Maim","Torpor","Void","Whiteout"],"performances":[],"equipped":"Death Mantle, Heretic’s Rod, Necromancer’s Athame, Obsidian Brooch, Tourmaline Ring","loot":"Moondust (5%), Necromancer’s Athame (20%), Heretic’s Rod (50%), Death Mantle (95%), and 10,900gp","steal":"Moondust (5%), Tourmaline Ring (20%), Obsidian Brooch (50%), Cursed Bone (95%)","sourcePage":262}},"prototypeToken":{"name":"Corse","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"777adb77d576c16d","name":"Heretic’s Rod","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d6+12","type":"blunt"},"attack":{"bonus":28},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"acad2fb010f8eb7b","name":"Condemn","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Necromancer","tree":"Necromant","description":"With a word, you damn your foe, and the dead obey. As a primary action, you may designate a target within 12 squares and line of sight. Until the end of the encounter, all undead you control may reroll attack rolls against the target, keeping the second result, even if worse. As a primary action, you may select a different target to become affected by this talent.","prerequisites":"Death March","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bc2e19ca1af2e67a","name":"Dark Renewal","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Initiate","tree":"Occultist","description":"Once per encounter, recover resources after moving a foe down the Break Gauge. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d0b7255b43813a8c","name":"Deathless Countenance","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5d6b75120e3ec014","name":"Death March","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Necromancer","tree":"Necromant","description":"The fallen march again, bound to your will alone. Once per encounter, as a minor action, you may move all undead you control up to their speed.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"23153866d87d30b6","name":"Death Sentence","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Rain_of_Death.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7448b5f09aafe1ab","name":"Enfeeble","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Occultist","description":"A black spell that worsens a foe's Break Gauge can push it an additional step. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"722e1882612bf8e7","name":"Massacre","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"className":"Necromancer","tree":"Necromant","description":"The wrath of your horde is fuelled by your dark power. Whenever an undead under your control deals damage to a target affected by your Condemn talent, each explosive damage die creates 2 additional dice, rather than 1.","prerequisites":"Condemn, Death March","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"430dfd890cf5e5e7","name":"Summon Darkness","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Initiate","tree":"Occultist","description":"Summon an undead or infernal creature ally by spending mana. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"335a1423f489a93f","name":"Triumph of Death","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Rain_of_Death.webp","system":{"className":"Necromancer","tree":"Necromant","description":"Each soul claimed drives your legions onward. Whenever you or an undead you control kill a creature affected by your Condemn talent, you regain a use of your Death March talent.","prerequisites":"Condemn, Death March","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1ced57914676b2ba","name":"Vengeful Spirit","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Holy_Spirit.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f07033f712452291","name":"Arcane Study (3)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,