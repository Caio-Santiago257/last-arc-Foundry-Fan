"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"blinded","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"526fab08362fbaf1","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c2d941252e66dc2e","name":"Fear","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Shadow_Wall.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Overwhelming fear limits the target's actions.","specialRules":"Higher-level targets gain +5 to Will Defence. Fear effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"condition","status":"primaryActionOnly","defence":"will","durationRounds":1}]},{"dc":20,"effects":[{"type":"condition","status":"secondaryActionOnly","defence":"will","durationRounds":1}]},{"dc":25,"effects":[{"type":"condition","status":"minorActionOnly","defence":"will","durationRounds":1}]},{"dc":30,"effects":[{"type":"condition","status":"noActions","defence":"will","durationRounds":1},{"type":"condition","status":"flatFooted","defence":"will","durationRounds":1}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"045cd9d2254789a6","name":"Fireball","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_II.webp","system":{"school":"Red Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"An explosive fire orb damages its target and nearby creatures.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half the primary damage if the check beats their Reflex Defence; otherwise none.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"6d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"8d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"10d6","damageType":"fire","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"edc2142693f52fdf","name":"Maim","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Bloodspiller.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A severe burst of dark energy inflicts damage.","specialRules":"Each explosive damage die creates two extra dice. If this spell moves the target down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7208ce86e6bf8158","name":"Heretic’s Rod","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Staves","description":"This rod channels dark magick.","cost":16600,"availability":"Rare","bulk":1,"weaponGroup":"staves","weaponSize":"Medium","weaponSkill":"spellcraft","attack":{"bonus":3},"damage":{"formula":"3d6+3","type":"Dark"},"range":"Ranged","capacity":0,"specialRules":"A dark sceptre favoured by apostates and cultists. When you cast a black magick spell that deals dark damage, you may reroll your damage dice, keeping the second result, even if worse.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"79ec5fa3b211f85a","name":"Imp Knife","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Throwing_Dagger.webp","system":{"category":"Knives","description":"Knive; Slashing damage.","cost":4600,"availability":"Rare","bulk":0.1,"weaponGroup":"knives","weaponSize":"Tiny","weaponSkill":"light-weapon","attack":{"bonus":2},"damage":{"formula":"2d4+3","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"This strange, red knife bears a wicked edge. Should your attack roll beat both a target’s Ref and Will Defence, the target becomes silenced.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ef3c7953870a32c2","name":"Magick Ring","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/RDM/Enchanted_Moulinet.webp","system":{"category":"Accessories","description":"These enchanted rings help magick users tap into their latent power. When you deal elemental","cost":1400,"availability":"Uncommon","bulk":0.1,"equipSlot":"Finger","equippable":true,"specialRules":"These enchanted rings help magick users tap into their latent power. When you deal elemental"},"effects":[],"folder":null,"