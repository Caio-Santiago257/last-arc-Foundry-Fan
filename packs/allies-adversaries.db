{"_id":"297fe14762fa2db0","name":"Thief","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"Nonheroic 6/Rogue 3/ Purloiner 1","race":"Nasha","alignment":"Corrupt","biography":"Quick of hand and quicker of wit, these criminals take whatever they can. A few steal to survive—but most, simply because they want more."},"attributes":{"str":{"score":10},"vit":{"score":12},"agi":{"score":18},"int":{"score":13},"mnd":{"score":8},"cha":{"score":14}},"skills":{"acrobatics":{"trained":true,"total":19},"deception":{"trained":true,"total":12},"light-weapon":{"trained":true,"total":19},"perception":{"trained":true,"total":9},"stealth":{"trained":true,"total":19}},"defences":{"ref":{"total":23},"fort":{"total":17},"will":{"total":13}},"resources":{"hp":{"value":48,"max":48,"baseMax":48},"mp":{"value":4,"max":4}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":6,"baseDamageReduction":6,"breakThreshold":17,"immunities":["Blind"],"resistances":["Electric"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"nonheroic","cr":6,"level":6,"xp":1200,"size":"medium","species":"Nasha","profileLine":"Corrupt Neutral Medium Nasha Nonheroic 6/Rogue 3/ Purloiner 1","classLevels":"Nonheroic 6/Rogue 3/ Purloiner 1","alignment":"Corrupt","temperament":"","description":"Quick of hand and quicker of wit, these criminals take whatever they can. A few steal to survive—but most, simply because they want more.","languages":"Beastongue, Common, Goblin Quick of hand and quicker of wit, these criminals take whatever they can. A few steal to survive—but most, simply because they want more.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision, Keen Scent; Passive Perception 19","passivePerception":19,"attributes":{"str":10,"agi":18,"vit":12,"int":13,"mnd":8,"cha":14},"defences":{"ref":23,"flatFootedRef":19,"fort":17,"will":13},"damageReduction":6,"breakThreshold":17,"immunities":["Blind"],"resistances":["Electric"],"weaknesses":[],"skills":[{"name":"Acrobatics","bonus":19,"key":"acrobatics"},{"name":"Deception","bonus":12,"key":"deception"},{"name":"Light Weapon","bonus":19,"key":"light-weapon"},{"name":"Perception","bonus":9,"key":"perception"},{"name":"Stealth","bonus":19,"key":"stealth"}],"attacks":[{"name":"Thieves' Jambiya","attack":20,"damage":"2d4+11","mode":"melee","type":"blunt"}],"abilities":[],"spells":[],"performances":[],"equipped":"Malachite Ring, Thieves' Jambiya, Wind Garb","loot":"Thieves' Jambiya (5%), Wind Garb (20%), Malachite Ring (50%), and 1,600gp","steal":"to survive—but most, simply because they want more. HP 48 MP 4 Init d8 Speed 6 Senses Dark Vision, Keen Scent; Passive Perception 19 Defence Ref 23 (flat-footed 19), Fort 17, Will 13 DR 6; Threshold 17 Immunity Blind Resistance Electric Offence Melee Thieves' Jambiya +20 (2d4+11) Statistics Attributes Str 10, Agi 18, Vit 12, Int 13, Mnd 8, Chr 14 Class Features Score Talents Accomplice, Cat Burglar, Cutpurse Technicks Agile Manoeuvres, Armour Proficiency (light), Dodge, Improved Initiative, Skill Focus (acrobatics, light weapon, stealth), Tactical Withdrawal, Weapon Finesse, Weapon Proficiency (knives) Skills Acrobatics +19, Deception +12, Light Weapon +19, Perception +9, Stealth +19 Items Equipped Malachite Ring, Thieves' Jambiya, Wind Garb Loot Thieves' Jambiya (5%), Wind Garb (20%), Malachite Ring (50%), and 1,600gp Steal Thieves’ Tools (20%), Hi-Potion (50%), Elfwort (95%)","sourcePage":265}},"prototypeToken":{"name":"Thief","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"75d34112eeeb07c4","name":"Thieves' Jambiya","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d4+11","type":"blunt"},"attack":{"bonus":20},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e769b5fdc31d5577","name":"Accomplice","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"className":"Purloiner","tree":"Brigand","description":"Your cohorts afford you an easy opening to escape. Once per turn, when an ally makes a successful attack roll against a target that is threatening you, you may, as a reaction, disengage. The target threatens no squares while you are disengaging with this talent. This may not be used during your turn.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6142b2dc9af07767","name":"Cat Burglar","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Aeolian_Edge.webp","system":{"className":"Rogue","tree":"Thief","description":"Climb or traverse narrow ledges at normal speed without provoking counterattacks. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"237e054389405f5f","name":"Cutpurse","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Rogue","tree":"Thief","description":"Reroll Stealth checks for pickpocketing; Sneaky may improve the result. Summary only: consult the rulebook for exact wording, usage limits, and prereq