Bonus":4,"armorCheckPenalty":-5,"specialRules":"A suit of treated leather armour, favoured by thieves and those who want a little more protection without sacrificing mobility.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b9c29ecd1a1cd067","name":"Goblin Bow","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"category":"Bows","description":"A pitiful excuse of a bow, stringed together by savage goblins. It is extremely weak and cheap but will do in a pinch. When you roll a natural 1 on an attack, this weapon moves -1 step on the Break Gauge.","cost":50,"availability":"Common","bulk":0.1,"weaponGroup":"bows","weaponSize":"Small","weaponSkill":"ranged","attack":{"bonus":0},"damage":{"formula":"2d6-1","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A pitiful excuse of a bow, stringed together by savage goblins. It is extremely weak and cheap but will do in a pinch. When you roll a natural 1 on an attack, this weapon moves -1 step on the Break Gauge.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3e75af4a464c3980","name":"Goblin Club","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Bludgeons","description":"This dinky little club is hardly effective, but extremely cheap. When you roll a natural 1 on an attack roll, this weapon moves -1 step on the Break Gauge.","cost":50,"availability":"Common","bulk":0.1,"weaponGroup":"bludgeons","weaponSize":"Small","weaponSkill":"light-weapon","attack":{"bonus":0},"damage":{"formula":"2d6-1","type":"Blunt"},"range":"Melee","capacity":0,"specialRules":"This dinky little club is hardly effective, but extremely cheap. When you roll a natural 1 on an attack roll, this weapon moves -1 step on the Break Gauge.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"