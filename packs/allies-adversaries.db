cription":"A small electric jolt damages and may paralyse a target.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude paralyses.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"1d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"electric","defence":"ref","halfOnFailure":true},{"type":"condition","status":"paralysed","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d61e0a655e752e93","name":"Field Khukuri","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Knives","description":"Knive; Slashing damage.","cost":400,"availability":"Common","bulk":0.1,"weaponGroup":"knives","weaponSize":"Tiny","weaponSkill":"light-weapon","attack":{"bonus":0},"damage":{"formula":"2d4+1","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"An oddly curved knife favoured by hunters and scouts. This weapon may be used with a survival kit, granting you a +2 bonus toward Survival checks made to gather materials.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fae3e704d2417f26","name":"Fire Wand","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Staves","description":"A small wand infused with the power of fire. When you cast a red magick spell that deals fire damage, it deals +1 die of damage.","cost":400,"availability":"Common","bulk":0.1,"weaponGroup":"staves","weaponSize":"Small","weaponSkill":"spellcraft","attack":{"bonus":0},"damage":{"formula":"3d4","type":"Fire"},"range":"Ranged","capacity":0,"specialRules":"A small wand infused with the power of fire. When you cast a red magick spell that deals fire damage, it deals +1 die of damage.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a12a5a367de5deb8","name":"Wizard’s Robes","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Mystic Armour","description":"Mystic armour; damage reduction and armour check penalty are recorded.","cost":100,"availability":"Common","bulk":1,"armorType":"mystic","damageReduction":2,"armorCheckPenalty":-2,"specialRules":"Classic magickal robes donned by many aspiring magick users.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"e6d93a9716874377","name":"Spellbreaker","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"Warrior 5/ Mage 2/Battlemage 3","race":"Dwarf","alignment":"Pure","biography":"From childhood, these arcane warriors are forged to oppose magick in every guise, guardians sworn to uphold peace and order within the hallowed halls of the Silvered Tower."},"attributes":{"str":{"score":16},"vit":{"score":16},"agi":{"score":10},"int":{"score":15},"mnd":{"score":16},"cha":{"score":8}},"skills":{"alchemy":{"trained":true,"total":12},"athletics":{"trained":true,"total":13},"perception":{"trained":true,"total":13},"smithing":{"trained":true,"total":12},"unarmed":{"trained":true,"total":13}},"defences":{"ref":{"total":26},"fort":{"total":28},"will":{"total":28}},"resources":{"hp":{"value":110,"max":110,"baseMax":110},"mp":{"value":89,"max":89}},"combat":{"initiativeDie":"1d12","speed":4,"baseSpeed":4,"damageReduction":11,"baseDamageReduction":11,"breakThreshold":33,"immunities":[],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":10,"level":5,"xp":2000,"size":"medium","species":"Dwarf","profileLine":"Pure Neutral Medium Dwarf Warrior 5/ Mage 2/Battlemage 3","classLevels":"Warrior 5/ Mage 2/Battlemage 3","alignment":"Pure","temperament":"","description":"From childhood, these arcane warriors are forged to oppose magick in every guise, guardians sworn to uphold peace and order within the hallowed halls of the Silvered Tower.","languages":"Common, Dwarven, Elven, Gnomish From childhood, these arcane warriors are forged to oppose magick in every guise, guardians sworn to uphold peace and order within the hallowed halls of the Silvered Tower.","speedText":"4","initiativeDie":"1d12","senses":"Dark Vision; Passive Perception 23","passivePerception":23,"attributes":{"str":16,"agi":10,"vit":16,"int":15,"mnd":16,"cha":8},"defences":{"ref":26,"flatFootedRef":26,"fort":28,"will":28},"damageReduction":11,"breakThreshold":33,"immunities":[],"resistances":[],"weaknesses":[],"skills":[{"name":"handed","bonus":18,"key":""},{"name":"Alchemy","bonus":12,"key":"alchemy"},{"name":"Athletics","bonus":13,"key":"athletics"},{"name":"Lore (arcane)","bonus":12,"key":""},{"name":"Perception","bonus":13,"key":"perception"},{"name":"Smithing","bonus":12,"key":"smithing"},{"name":"Unarmed","bonus":13,"key":"unarmed"}],"attacks":[{"name":"Crystal Parashu","attack":21,"damage":"2d8+11","mode":"melee","type":"blunt"}],"abilities":[],"spells":["Barrier","Cleanse","Dispel"],"performances":[],"equipped":"Crystal Parashu, Ice Shield, Magick Armour, Talisman of Wisdom","loot":"Crystal Parashu (5%), Magick Armour (20%), Ice Shield (50%), Hi-Ether (95%), and 3,700gp","steal":"Talisman of Wisdom (5%), Nothing (20%), Hi-Ether (50%)","sourcePage":270}},"prototypeToken":{"name":"Spellbreaker","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"02348ef7a9f76c35","name":"Crystal Parashu","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d8+11","type":"blunt"},"attack":{"bonus":21},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"01595405dbace9f5","name":"Deflect","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"className":"Warrior","tree":"Defender","description":"Use a shield reaction to protect nearby allies from a large area effect. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7681bc93824087a0","name":"Negate Spell","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"className":"Battlemage","tree":"Spellbreaker","description":"Your shield absorbs spells entirely, negating their effects. When blocking spells with your shield, you take no damage when you successfully block and failed blocks are resolved as if you had the Evasive talent. If you have the Shield Ally or Deflect talent, this effect also applies to creatures you block for.","prerequisites":"Deflect, Shield Ally, Shield Proficiency","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"aa711a0448b6c3d7","name":"Shield Ally","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"className":"Warrior","tree":"Defender","description":"Use a shield reaction to block for an adjacent ally. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ae28d1c198d15d2e","name":"Shield Expert","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"className":"Warrior","tree":"Defender","description":"Reduce the penalty for consecutive shield blocks. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4e8074395fe56310","name":"Spell Steal","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Battlemage","tree":"Spellbreaker","description":"When you cast the Dispel or Cleanse spell, you may target another creature within 6 squares and line of sight. If your check is successful, you instead transfer the effects or statuses from the first target to the second. Should the second target be unwilling, your check must also beat their Will Defence.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7622475ce78dc985","name":"Swift Spell","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Mage","tree":"Arcanist","description":"Once per day, cast a normally primary-action spell as a minor action. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d894a8eee39b34ef","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1b86aeea23192882","name":"Armour Proficiency (light, heavy)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"22d8caa99cff44f7","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"67f85414d288549e","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d047175e6c470269","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"693e113644dbabb0","name":"Disruptive","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5285444afa4f55bd","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"796f5c69244e064a","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c107472fc5f069b3","name":"Skill Focus (1-handed, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"40c831f004287299","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7f51f75358e04ea8","name":"Weapon Proficiency (axes, bludgeons, knives, polearms, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"axes, bludgeons, knives, polearms, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3f7dff146b457fc7","name":"Arcane Armour","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"category":"Class Feature","description":"No defensive casting penalty while wearing proficient armour."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b8f1c6abe8a38ff8","name":"Warmage 1","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ac12cfa96ef008ae","name":"Barrier","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Succor.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants increasing protection against elemental damage.","specialRules":"Encounter duration. Elemental damage reduces this DR by 5 when it exceeds the DR. Stacks with existing DR but not itself; does not stack with Ward. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Barrier elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":10,"label":"Barrier elemental DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":15,"label":"Barrier elemental DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2c82d6d87b155b74","name":"Cleanse","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":6,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Removes ailments, with stronger results cleansing more conditions.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"removeConditions","statuses":["poisoned"]}]},{"dc":20,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced"]}]},{"dc":25,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed"]}]},{"dc":30,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping"]}]},{"dc":35,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified"]}]},{"dc":40,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified","cursed"]}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"40dc434d71c31a5a","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b1a49d492760ce89","name":"Crystal Parashu","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Heavy_Swing.webp","system":{"category":"Axes","description":"This enchanted battleaxe was imbued with the power of the djinn. Elementals are treated as weak against this weapon’s damage. Medium creatures may treat this weapon as either a 1-handed or 2-handed weapon.","cost":23500,"availability":"Epic","bulk":1,"weaponGroup":"axes","weaponSize":"Medium","weaponSkill":"one-handed","attack":{"bonus":3},"damage":{"formula":"2d8+3","type":"Slashing"},"range":"Melee","capacity":0,"specialRules":"This enchanted battleaxe was imbued with the power of the djinn. Elementals are treated as weak against this weapon’s damage. Medium creatures may treat this weapon as either a 1-handed or 2-handed weapon.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f29de63e8df33aa1","name":"Ice Shield","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Shields","description":"Shield; item attack bonus applies to shield block checks.","cost":11100,"availability":"Rare","weaponSize":"Small","weaponSkill":"light-weapon","attack":{"bonus":3},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":0.1,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"41ef027c801eae0d","name":"Magick Armour","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Light Armour","description":"An ornate suit of enchanted mail that feeds on the wearer’s magickal energy. You gain a +5 bonus to all defences against spells. However, at the start of each turn, you lose 1d6 MP. While at 0 MP, you lose this effect.","cost":16300,"availability":"Exotic","bulk":2,"armorType":"light","reflexBonus":3,"damageReduction":11,"maxAgilityBonus":3,"armorCheckPenalty":-5,"specialRules":"An ornate suit of enchanted mail that feeds on the wearer’s magickal energy. You gain a +5 bonus to all defences against spells. However, at the start of each turn, you lose 1d6 MP. While at 0 MP, you lose this effect.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3b8797af7d26c081","name":"Talisman of Wisdom","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":3000,"availability":"Exotic","bulk":0.1,"equipSlot":"Neck","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
