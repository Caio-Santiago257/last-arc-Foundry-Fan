eaknesses":[],"skills":[{"name":"Alchemy","bonus":19,"key":"alchemy"},{"name":"Lore (arcane)","bonus":19,"key":""},{"name":"Lore (mystic)","bonus":14,"key":"lore-mystic"},{"name":"Lore (occult)","bonus":14,"key":"lore-occult"},{"name":"Perception","bonus":16,"key":"perception"},{"name":"Persuasion","bonus":13,"key":"persuasion"}],"attacks":[{"name":"Summoner’s Lathi","attack":25,"damage":"3d6+10","mode":"ranged","type":"blunt"}],"abilities":[],"spells":["Banish","Barrier","Cleanse","Curatio","Cure","Dispel","Faith","Haste","Levitation","Revive","Shell","Teleport"],"performances":[],"equipped":"High Summoner’s Vestments, Idol of Flames* , Sage’s Ring, Summoner’s Lathi","loot":"Summoner's Lathi (5%), High Summoner's Vestments (20%), Hi-Ether (50%), Magicite (95%), and 5,700gp","steal":"Idol of Flames* (5%), Sage’s Ring (20%), Golden Sap (50%)","sourcePage":270}},"prototypeToken":{"name":"High Summoner","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"f32706a1e9e11fcf","name":"Summoner’s Lathi","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d6+10","type":"blunt"},"attack":{"bonus":25},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b9966de0943ace43","name":"Astral Flow","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Mage","tree":"Conjurer","description":"Once per day, use Summon Elemental without paying its mana cost. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d0e5b0b49f41bdc1","name":"Astral Rush I","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enhanced_Astral_Fire.webp","system":{"className":"Summoner","tree":"Evoker","description":"Your elementals fervently heed your commands. You may use a secondary action, rather than a primary action, to grant your summoned elemental its entire turn of actions.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9e0bb2bc504402c6","name":"Astral Rush II","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enhanced_Astral_Fire.webp","system":{"className":"Summoner","tree":"Evoker","description":"You may now use a minor action to grant your summoned elemental its entire turn of actions.","prerequisites":"Astral Rush I","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5714444544263ae4","name":"Guardian Force","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"className":"Mage","tree":"Conjurer","description":"Gain a Reflex Defence bonus while close to your summoned elemental. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"af4424e5cdca93d2","name":"Healer’s Blessing I","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"","category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d9f38bcd183d62e5","name":"Life Link","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Secret_of_the_Lily.webp","system":{"className":"Summoner","tree":"Evoker","description":"Your connection with your summons is deeper than blood. While you have at least 1 HP , your summoned elemental cannot be reduced to 0 HP by damage. Any damage that would reduce your summoned elemental to 0 HP instead reduces your HP by the same amount. This talent has no effect if the damage would exceed your current HP . This talent has no effect if you and your elemental are damaged by the same source.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"574dceb184c83387","name":"Summon Elemental","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Mage","tree":"Conjurer","description":"Summon an elemental ally by spending mana, subject to level and field limits. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d2e1b9aa045593ef","name":"Arcane Study 3","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"745f61e2f7c55805","name":"Armour Proficiency (mystic)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0f49c3cee7b89dff","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1c96c8a817909bd7","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ffbf9f229223aba2","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6ea01779d9dcf643","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2ae46f978d0e67aa","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"be50326a82672409","name":"Skill Focus (alchemy, lore arcane, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"alchemy, lore arcane, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cebe705be2ddc10e","name":"Weapon Proficiency (knives, staves, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"knives, staves, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5599999253303f9c","name":"Astral Conduit 2","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enhanced_Astral_Fire.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0214743f63ef451f","name":"Summon Aeon","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"category":"Class Feature","description":"Choose an Aeon and add additional Aeons when you acquire their idols. Summon an owned Aeon by spending 5 MP per Summoner class level. It remains for 5 + Mind modifier turns. Its statistics, spells, and Technicks scale with Summoner class level."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"218cbc924357f71c","name":"Banish","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Holy_Spirit.webp","system":{"school":"White Magick","mpCost":24,"action":"Primary Action","target":"One summoned creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Forces a summoned creature away.","specialRules":"Higher-level targets gain +5 to Will Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"unsummoned","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7c8d252985f1719c","name":"Barrier","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Succor.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants increasing protection against elemental damage.","specialRules":"Encounter duration. Elemental damage reduces this DR by 5 when it exceeds the DR. Stacks with existing DR but not itself; does not stack with Ward. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Barrier elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":10,"label":"Barrier elemental DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.elementalDama