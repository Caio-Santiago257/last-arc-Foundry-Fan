:null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"01221fa57d2b47b1","name":"Rage","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"className":"Warrior","tree":"Barbarian","description":"Once per encounter, temporarily improve melee attacks and bypass some damage reduction. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b9b9c12eae3a83a3","name":"Toughness","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Warrior","tree":"Barbarian","description":"Once per encounter, resist being moved down the Break Gauge. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5ad56aaca4e2036f","name":"Armour Proficiency (light)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Searing_Light.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c2f1465e13d4ff8b","name":"Cleave","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"As an all-out action, make one melee attack against a target and creatures adjacent to both you and it. Reach weapons can strike targets at the same reach. This attack cannot combo and cannot be combined with Lunge.","prerequisites":{"technicks":["Mighty Strikes"],"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fcb18ea445eac340","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"20f3f2a94ffdb24f","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3d469462e2fcc832","name":"Mighty Strikes","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ff6f51429c98f3bc","name":"Power Attack","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/Chocobo/Choco_strike_icon1.webp","system":{"description":"Spend two minor actions to deal one additional damage die on all melee attacks until your turn ends. Does not stack with Rapid Strike.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fdd37869eeb6ee70","name":"Skill Focus (2-handed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"2-handed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"74c24581bf45918d","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2b30fe943c69f044","name":"Weapon Proficiency (axes, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"axes, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b452595e6326cb45","name":"Berserkergang","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Berserk.webp","system":{"category":"Class Feature","description":"On listed triggers, roll d%; 25% chance to enter a berserk rage, with later level features increasing the chance."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3db997a0d29bf20d","name":"Furore","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Fell_Cleave.webp","system":{"category":"Class 