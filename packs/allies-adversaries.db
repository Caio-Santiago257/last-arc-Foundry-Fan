pe":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_II.webp","system":{"school":"Red Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"An explosive fire orb damages its target and nearby creatures.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half the primary damage if the check beats their Reflex Defence; otherwise none.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"6d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"8d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"10d6","damageType":"fire","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bc8e139d69a73126","name":"Firestorm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_III.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"Fire rains down across an expanding area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half the initial damage at the start of the next turn and one quarter at the following turn. Area radius 1/2/3 squares for DC 20/25/30. DR reduces only the initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFa