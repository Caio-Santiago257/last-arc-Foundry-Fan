one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"df4694b090e0bd2b","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e05eef0b1419879c","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8ebdf9b4e5ced1ab","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bf08adc71732eaa1","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ff2215a0cdb7c939","name":"Skill Focus (light weapon, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeata