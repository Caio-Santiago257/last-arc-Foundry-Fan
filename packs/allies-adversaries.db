":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]},{"dc":40,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6820f2f8742cb834","name":"High Summoner’s Vestments","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Mystic Armour","description":"Mystic armour; damage reduction and armour check penalty are recorded.","cost":13900,"availability":"Exotic","bulk":1,"armorType":"mystic","damageReduction":9,"armorCheckPenalty":-2,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b844438b5de7535f","name":"Sage’s Ring","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Accessories","description":"Accessory; see item entry for its special quality.","cost":13000,"availability":"Epic","bulk":0.1,"equipSlot":"Finger","equippable":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7304519d8c717708","name":"Summoner’s Lathi","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"category":"Staves","description":"Stave; Blunt damage.","cost":27400,"availability":"Epic","bulk":1,"weaponGroup":"staves","weaponSize":"Medium","weaponSkill":"spellcraft","attack":{"bonus":4},"damage":{"formula":"3d6+4","type":"Blunt"},"range":"Ranged","capacity":0,"equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"02bb0a23bcdcb68a","name":"High Magister","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":7,"xp":0,"nextLevel":0,"className":"Mage 7/Archmage 8","race":"High Elf","alignment":"Neutral","biography":"Sylvan Counted among the Arcanum’s highest-ranking magi, they command respect for their profound knowledge and arcane mastery. Rarely seen beyond their sanctum, their pursuits overshadow the mundane affairs of the world."},"attributes":{"str":{"score":7},"vit":{"score":12},"agi":{"score":14},"int":{"score":18},"mnd":{"score":22},"cha":{"score":10}},"skills":{"alchemy":{"trained":true,"total":16},"lore-mystic":{"trained":true,"total":16},"lore-occult":{"trained":true,"total":16},"lore-terrestrial":{"trained":true,"total":16},"perception":{"trained":true,"total":18},"persuasion":{"trained":true,"total":12}},"defences":{"ref":{"total":30},"fort":{"total":27},"will":{"total":38}},"resources":{"hp":{"value":117,"max":117,"baseMax":117},"mp":{"value":172,"max":172}},"combat":{"initiativeDie":"1d12","speed":6,"baseSpeed":6,"damageReduction":9,"baseDamageReduction":9,"breakThreshold":32,"immunities":["Toad"],"resistances":["Cold","Dark","Electric","Fire","Holy"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":15,"level":7,"xp":3000,"size":"medium","species":"High Elf","profileLine":"Neutral Good Medium High Elf Mage 7/Archmage 8","classLevels":"Mage 7/Archmage 8","alignment":"Neutral","temperament":"","description":"Sylvan Counted among the Arcanum’s highest-ranking magi, they command respect for their profound knowledge and arcane mastery. Rarely seen beyond their sanctum, their pursuits overshadow the mundane affairs of the world.","languages":"Beastongue, Celestial, Common, Draconic, Dwarven, Elven, Giant, Gnomish, Infernal, Primordial, Sylvan Counted among the Arcanum’s highest-ranking magi, they command respect for their profound knowledge and arcane mastery. Rarely seen beyond their sanctum, their pursuits overshadow the mundane affairs of the world.","speedText":"6","initiativeDie":"1d12","senses":"Low-light Vision, Blindsense; Passive Perception 28","passivePerception":28,"attributes":{"str":7,"agi":14,"vit":12,"int":18,"mnd":22,"cha":10},"defences":{"ref":30,"flatFootedRef":28,"fort":27,"will":38},"damageReduction":9,"breakThreshold":32,"immunities":["Toad"],"resistances":["Cold","Dark","Electric","Fire","Holy"],"weaknesses":[],"skills":[{"name":"Alchemy","bonus":16,"key":"alchemy"},{"name":"Lore (arcane)","bonus":21,"key":""},{"name":"Lore (mystic)","bonus":16,"key":"lore-mystic"},{"name":"Lore (occult)","bonus":16,"key":"lore-occult"},{"name":"Lore (terrestrial)","bonus":16,"key":"lore-terrestrial"},{"name":"Perception","bonus":18,"key":"perception"},{"name":"Persuasion","bonus":12,"key":"persuasion"}],"attacks":[{"name":"Staff of the Magi","attack":27,"damage":"3d8+11","mode":"ranged","type":"blunt"}],"abilities":[],"spells":["Ark Blast","Barrier","Blizzard","Cleanse","Dispel","Firestorm","Gravity","Inferno","Invisibility","Muddle","Shell","Teleport","Thunderstorm","Whiteout"],"performances":[],"equipped":"Lens of Truth, Magister’s Houppelande, Staff of the Magi, Tourmaline Ring","loot":"Staff of the Magi (5%), Magister’s Houppelande (20%), Tourmaline Ring (50%), Mega-Ether (95%), and 8,700gp","steal":"Lens of Truth (5%), Ambrosia (20%), Mega-Potion (50%) * Against spells.","sourcePage":271}},"prototypeToken":{"name":"High Magister","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"e1ee0106390c9d83","name":"Staff of the Magi","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d8+11","type":"blunt"},"attack":{"bonus":27},"npcStaticAttack":true,"spe