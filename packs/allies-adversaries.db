"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dbe02848b5cd0239","name":"Steady Wing","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Dragoon","tree":"Dragoneer","description":"You may now use the Mounted Combat technick on your pet dragon if it is within 6 squares and line of sight. Additionally, when you negate an attack against your pet dragon with the Mounted Combat technick, you regain a use of the technick.","prerequisites":"Mounted Combat, Tame, Wyrmtamer","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3e0cee65327ad2f3","name":"Tame","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Ranger","tree":"Tamer","description":"Use Persuasion to improve the attitude of low-Intelligence beasts without the usual penalty. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cec79c189529e707","name":"Wyrmtamer","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"className":"Dragoon","tree":"Dragoneer","description":"You not only specialize in quelling dragons, but also in commanding them. You may now tame dragons with the Tame talent. Additionally, you may use bait to affect dragons. Lastly, while your pet dragon is within 4 squares and line of sight, you may negate attacks against it with the Mounted Combat technick.","prerequisites":"Tame","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0abc8a5ec61ed6d1","name":"Armour Proficiency (light, heavy)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f14499f2afe6f7d9","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"552d048e0ac84c8d","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"06f7a30af7539e0b","name":"Lunge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"description":"Once per turn, extend the reach of your next melee attack by 1 square and take -2 Reflex Defence until your next turn. Cannot be used while charging, prone, or making a counterattack.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"73719068f4ddca44","name":"Mounted Combat","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"description":"Once per turn as a reaction, make a Ride check to avoid a successful attack against your mount; success treats the attack as not beating its Reflex Defence.","prerequisites":{"skills":["ride"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9dbc261600632e1d","name":"Powerful Charge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"Gain +2 on attacks made while charging and deal additional damage equal to half your character level.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2fdcb1e45ee2c3b3","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cb8d35fa06a6231e","name":"Skill Focus (2-handed, Persuasion, Ride)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"2-handed, persuasion, ride","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2a80f2dc7922ef6b","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"00e8dee1598a3eee","name":"Weapon Proficiency (axes, bludgeons, crossbows, knives, polearms, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and 