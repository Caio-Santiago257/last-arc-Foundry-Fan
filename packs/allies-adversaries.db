{"_id":"ac7c905da376a1b7","name":"Fae Mother","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":7,"xp":0,"nextLevel":0,"className":"Initiate 7/Druid 8","race":"Wood Elf","alignment":"Pure","biography":"Revered as the wisest druid of the Faewood, she guides the secret village of Myrth with a calm hand and ancient wisdom."},"attributes":{"str":{"score":14},"vit":{"score":14},"agi":{"score":16},"int":{"score":16},"mnd":{"score":18},"cha":{"score":10}},"skills":{"athletics":{"trained":true,"total":14},"lore-mystic":{"trained":true,"total":15},"lore-terrestrial":{"trained":true,"total":15},"medicine":{"trained":true,"total":21},"perception":{"trained":true,"total":16},"survival":{"trained":true,"total":16}},"defences":{"ref":{"total":31},"fort":{"total":30},"will":{"total":34}},"resources":{"hp":{"value":132,"max":132,"baseMax":132},"mp":{"value":134,"max":134}},"combat":{"initiativeDie":"1d12","speed":6,"baseSpeed":6,"damageReduction":7,"baseDamageReduction":7,"breakThreshold":30,"immunities":["Slow","Toad","Zombify"],"resistances":["Cold","Electric","Fire"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Allies","profile":"npc","cr":15,"level":7,"xp":3000,"size":"medium","species":"Wood Elf","profileLine":"Pure Neutral Medium Wood Elf Initiate 7/Druid 8","classLevels":"Initiate 7/Druid 8","alignment":"Pure","temperament":"","description":"Revered as the wisest druid of the Faewood, she guides the secret village of Myrth with a calm hand and ancient wisdom.","languages":"Beastongue, Common, Elven, Sylvan, Primordial Revered as the wisest druid of the Faewood, she guides the secret village of Myrth with a calm hand and ancient wisdom.","speedText":"6","initiativeDie":"1d12","senses":"Low-light Vision; Passive Perception 26","passivePerception":26,"attributes":{"str":14,"agi":16,"vit":14,"int":16,"mnd":18,"cha":10},"defences":{"ref":31,"flatFootedRef":28,"fort":30,"will":34},"damageReduction":7,"breakThreshold":30,"immunities":["Slow","Toad","Zombify"],"resistances":["Cold","Electric","Fire"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":14,"key":"athletics"},{"name":"Lore (mystic)","bonus":15,"key":"lore-mystic"},{"name":"Lore (terrestrial)","bonus":15,"key":"lore-terrestrial"},{"name":"Medicine","bonus":21,"key":"medicine"},{"name":"Perception","bonus":16,"key":"perception"},{"name":"Survival","bonus":16,"key":"survival"}],"attacks":[{"name":"Sage’s Staff","attack":23,"damage":"3d8+7","mode":"ranged","type":"blunt"}],"abilities":[],"spells":["Barrier","Cleanse","Curatio","Dispel","Entangle","Faith","Overgrowth","Shell","Succession","Tempest","Windburst","Whirlwind"],"performances":[],"equipped":"Jet Necklace, Sage’s Staff, Sage’s Surplice, Tourmaline Ring","loot":"Sage’s Surplice (5%), Jet Necklace (20%), Tourmaline Ring (50%), Sage’s Staff (95%), and 8,700gp","steal":"Unicorn Horn (20%), Hi-Ether (95%)","sourcePage":259}},"prototypeToken":{"name":"Fae Mother","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"e8e073345011f66a","name":"Sage’s Staff","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"3d8+7","type":"blunt"},"attack":{"bonus":23},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fd963ecff5578b32","name":"Beast Shape","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Initiate","tree":"Animist","description":"Assume the form of a nearby beast after a successful Spellcraft check. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b3e8535c9fe76024","name":"Call of the Wild","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Druid","tree":"Beastcaller","description":"Nature answers your summons. Once per encounter, you may use the Summon Wild talent to summon 3 beasts of a single type at no additional MP cost. Each beast must be at least 5 levels lower than an appropriate companion for your level (see page 278). Additionally, each beast gains a bonus to their attack rolls, skill checks, damage rolls, and defences equal to your class level. Lastly, they gain DR equal to half your class level.","prerequisites":"Summon Wild","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d6a85ae81cf2045f","name":"Fae Touched","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"className":"Druid","tree":"Shapeshifter","description":"You have been granted the mystical power of the fae. You may now include fae when using talents such as Summon Wild and Beast Shape. Additionally, you may now cast white magick spells while transformed via the Beast Shape talent.","prerequisites":"","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8124eb82d03a053e","name":"Force of Nature","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Druid","tree":"Beastcaller","description":"When using the Call of the Wild talent, you may summon beasts 3 levels lower than your normal limit. However, these beasts gain no bonus DR.","prerequisites":"Call of the Wild, Summon Wild","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d21be934ad1e5406","name":"Galeforce","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Animist","description":"A wind spell that meets its attack conditions can worsen a target's Break Gauge state. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3c63f9b3ce31b225","name":"Run Wild","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/Chocobo/Choco_surge_icon1.webp","system":{"className":"Druid","tree":"Beastcaller","description":"Beasts surge forth, braying and howling. Once per encounter, as a minor action, you may move all summoned beasts you control up to their speed.","prerequisites":"Summon Wild","automation":{"type":"manual","automated":false},"repeatable":false,"uses":{"frequency":"see description"},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d9efaf8a5d539fa4","name":"Summon Wild","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Bahamut.webp","system":{"className":"Initiate","tree":"Animist","description":"Summon a beast ally by spending mana; its level and duration are limited by the rules. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7f0ac462e612ef61","name":"Tanglevine","type":"talent","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"className":"Initiate","tree":"Animist","description":"Make a green spell that stops movement harder to escape from. Summary only: consult the rulebook for exact wording, usage limits, and prerequisites.","prerequisites":"See the rulebook for prerequisites.","automation":{"mode":"manual","reason":"Conditional, triggered, or usage-limited effect; adjudicate using the rulebook."},"repeatable":false,"uses":{"value":0,"max":0},"category":"Talent"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"23aba71bd9a0fa51","name":"Arcane Study (3)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f50b87b6fd74e39a","name":"Armour Proficiency (mystic)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fa7b93fd74eacb29","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"20104bf40958f4ff","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"12741ab444619fc1","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cf8109b6834da530","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4f76c8e34ea5f951","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ca28273fcfb0a9a2","name":"Precise Shot","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Make ranged attacks into melee without the normal -5 penalty.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dcc7f05417334697","name":"Shake it Off","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Shake_It_Off.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b9d0c9e7000428db","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c0337fd8f1476ddb","name":"Skill Focus (medicine, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"medicine, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1390e769144f5fa2","name":"Weapon Proficiency (knives, staves)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"knives, staves","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1183e1573c08049d","name":"Advolution 2","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c9b23d3fa1d402af","name":"Life Cycle 4","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"41b5ded9ca831673","name":"Wild Magick","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Class Feature","description":"Cast green magick while in Beast Shape and use the better Spellcraft modifier when trained."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dda3428c4e3d62a0","name":"Barrier","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Succor.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants increasing protection against elemental damage.","specialRules":"Encounter duration. Elemental damage reduces this DR by 5 when it exceeds the DR. Stacks with existing DR but not itself; does not stack with Ward. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Barrier elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":10,"label":"Barrier elemental DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":15,"label":"Barrier elemental DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"87eec431199e1a04","name":"Cleanse","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":6,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Removes ailments, with stronger results cleansing more conditions.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"removeConditions","statuses":["poisoned"]}]},{"dc":20,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced"]}]},{"dc":25,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed"]}]},{"dc":30,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping"]}]},{"dc":35,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified"]}]},{"dc":40,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified","cursed"]}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c8f38b9be76aced6","name":"Curatio","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Assize.webp","system":{"school":"White Magick","mpCost":24,"action":"Primary Action","target":"You or one living creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Restores a large amount of HP.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"heal","formula":"3*@level"}]},{"dc":25,"effects":[{"type":"heal","formula":"4*@level"}]},{"dc":30,"effects":[{"type":"heal","formula":"5*@level"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a770e5a7e883d877","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"680b3a40aac6d2d6","name":"Entangle","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Summon_Titan.webp","system":{"school":"Green Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Plants restrain and render a foe flat-footed.","specialRules":"Effect lasts until your next turn. Target may use a secondary action and an Unarmed check against the initial Spellcraft result to escape; on failure it takes 2d6 piercing damage. Does not affect hovering creatures; they cannot gain hover while trapped.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"restrained","defence":"ref","durationRounds":0},{"type":"condition","status":"flatFooted","defence":"ref","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6b41382d26c406ae","name":"Faith","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Presence_of_Mind.webp","system":{"school":"White Magick","mpCost":10,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Raises Fortitude and Will Defence for an encounter.","specialRules":"Bonuses last for the encounter; may be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"change","key":"system.defences.fort.misc","value":1,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":1,"label":"Faith Will"}]},{"dc":20,"effects":[{"type":"change","key":"system.defences.fort.misc","value":2,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":2,"label":"Faith Will"}]},{"dc":25,"effects":[{"type":"change","key":"system.defences.fort.misc","value":3,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":3,"label":"Faith Will"}]},{"dc":30,"effects":[{"type":"change","key":"system.defences.fort.misc","value":4,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":4,"label":"Faith Will"}]},{"dc":35,"effects":[{"type":"change","key":"system.defences.fort.misc","value":5,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":5,"label":"Faith Will"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7a4980e08fbe0014","name":"Overgrowth","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Regen.webp","system":{"school":"Green Magick","mpCost":16,"action":"Primary Action","target":"An area within 2 squares of you","targetMode":"self","checkSkill":"spellcraft","description":"Creates thorny terrain that hinders nearby movement.","specialRules":"Squares within 2 squares are rough terrain for 2/3/4/5 turns. Creatures moving into, through, or out of the area take 4d6 piercing damage. Does not affect hovering creatures; gaining hover ends it. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9070b0abe7366b98","name":"Shell","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Sacred_Soil.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants protection from physical damage.","specialRules":"Encounter duration. Physical damage reduces the effect's DR by 5 when it exceeds it. May stack with existing DR, but not with itself or Protect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":5,"label":"Shell physical DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":10,"label":"Shell physical DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":15,"label":"Shell physical DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fb52c564b1ea8e0f","name":"Succession","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/SummonGem.webp","system":{"school":"Green Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A sudden mass of thorned growth traps and damages foes.","specialRules":"Successful Reflex defence also reduces speed to 0 and makes flat-footed until your next turn; on failure half damage and neither condition. Escape: secondary action, Unarmed check vs Spellcraft; failure causes 2d6 piercing. Large targets take +1 die; does not affect hover.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"piercing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"restrained","defence":"ref","durationRounds":0},{"type":"condition","status":"flatFooted","defence":"ref","durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"piercing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"restrained","defence":"ref","durationRounds":0},{"type":"condition","status":"flatFooted","defence":"ref","durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"piercing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"restrained","defence":"ref","durationRounds":0},{"type":"condition","status":"flatFooted","defence":"ref","durationRounds":0}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"piercing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"restrained","defence":"ref","durationRounds":0},{"type":"condition","status":"flatFooted","defence":"ref","durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d85bf69fe1cb5b95","name":"Tempest","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Aerial_Slash.webp","system":{"school":"Green Magick","mpCost":10,"action":"Primary Action","target":"Adjacent creatures around you","targetMode":"self","checkSkill":"spellcraft","description":"A vortex of wind damages creatures close to you over time.","specialRules":"At the end of your turn, adjacent creatures take 4d6 slashing damage for 2/3/4/5 turns. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ec1ef282214baea1","name":"Windburst","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Aero.webp","system":{"school":"Green Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A gale damages and slows foes across a wide area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude reduces speed by 2 until your next turn. Area targets occupying multiple squares take +1 damage die.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"slashing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"slashing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"slashing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"slashing","defence":"ref","halfOnFailure":true},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"406c338192b8b869","name":"Whirlwind","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Aerial_Slash.webp","system":{"school":"Green Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A powerful wind suspends and batters a target.","specialRules":"On a successful Fortitude check, deal 4d6 slashing at the start of each affected turn; speed 0 and -5 attack/skill checks. Duration 2/3/4/5 turns. Target falls prone at expiry; damage from another source ends the effect. Dispellable stun.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"535f04ccbce2254f","name":"Jet Necklace","type":"equipment","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Accessories","description":"This necklace bears a stone said to protect the wearer from the effects of undeath. You gain immunity to zombify.","cost":9000,"availability":"Exotic","bulk":0.1,"equipSlot":"Neck","equippable":true,"specialRules":"This necklace bears a stone said to protect the wearer from the effects of undeath. You gain immunity to zombify.","itemEffects":{"immunities":["zombify"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9ab681d3d2ae39b1","name":"Sage’s Staff","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"category":"Staves","description":"A staff made from magickal, petrified wood. When you cast a 