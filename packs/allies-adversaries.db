"flags":{}},{"_id":"841e3b756b9f80d5","name":"MP","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4be47ab250538a3e","name":"Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"aa3e8067b68e031d","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d1c7b6385449b800","name":"Skill Focus (athletics, spellcraft, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"athletics, spellcraft, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ce3312966a5483ca","name":"Skill Training (spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Train one additional skill from a class skill list. Each additional copy must train a different skill.","repeatable":true,"choice":{"type":"classSkillTraining"},"effects":{"selectedSkillTraining":true},"selectedSkill":"spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6b539d67f5c2f74c","name":"Weapon Proficiency (axes, bludgeons, knives, polearms, swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"axes, bludgeons, knives, polearms, swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"04da22ff21189392","name":"Advolution 1","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5bfa968d08daf8a3","name":"Life Cycle 2","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"category":"Class Feature","description":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"73f882cbbbbc68eb","name":"Wild Magick","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Class Feature","description":"Cast green magick while in Beast Shape and use the better Spellcraft modifier when trained."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c1950579fd9288ea","name":"Boulder","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Rock_Buster.webp","system":{"school":"Green Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Hurls a conjured boulder at a foe.","specialRules":"Successful Reflex defence still takes half damage. Prone also requires beating Fortitude by 5. Secondary e