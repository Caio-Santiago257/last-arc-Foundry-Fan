{"_id":"d6395b84e4c5675c","name":"Seraphim","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":18,"xp":0,"nextLevel":0,"className":"","race":"Celestials","alignment":"Pure","biography":"Eyes ablaze with flame and wings stained by the blood of the wicked—meeting their gaze means your fate is sealed."},"attributes":{"str":{"score":30},"vit":{"score":32},"agi":{"score":27},"int":{"score":25},"mnd":{"score":30},"cha":{"score":23}},"skills":{"athletics":{"trained":true,"total":24},"acrobatics":{"trained":true,"total":22},"disable":{"trained":true,"total":22},"medicine":{"trained":true,"total":24},"perception":{"trained":true,"total":24},"persuasion":{"trained":true,"total":20},"unarmed":{"trained":true,"total":24}},"defences":{"ref":{"total":33},"fort":{"total":40},"will":{"total":39}},"resources":{"hp":{"value":311,"max":311,"baseMax":311},"mp":{"value":257,"max":257}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":50,"immunities":["Confusion","Curse","Death Effects","Holy","Mind Effects","Petrify","Sleep","Stuns","Toad"],"resistances":["Dark","Fire"],"vulnerabilities":["Dark Block Flame Shield +32"]},"adversary":{"isAdversary":true,"category":"Celestials","profile":"celestial","cr":18,"level":18,"xp":3600,"size":"large","species":"Celestials","profileLine":"Pure Good Large Celestial 18; Helpful/Aggressive","classLevels":"","alignment":"Pure","temperament":"Helpful/Aggressive","description":"Eyes ablaze with flame and wings stained by the blood of the wicked—meeting their gaze means your fate is sealed.","languages":"Celestial, Draconic, Infernal; Truespeech Eyes ablaze with flame and wings stained by the blood of the wicked—meeting their gaze means your fate is sealed.","speedText":"8, Fly 12 (hover)","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 34","passivePerception":34,"attributes":{"str":30,"agi":27,"vit":32,"int":25,"mnd":30,"cha":23},"defences":{"ref":33,"flatFootedRef":32,"fort":40,"will":39},"damageReduction":15,"breakThreshold":50,"immunities":["Confusion","Curse","Death Effects","Holy","Mind Effects","Petrify","Sleep","Stuns","Toad"],"resistances":["Dark","Fire"],"weaknesses":["Dark Block Flame Shield +32"],"skills":[{"name":"handed","bonus":24,"key":""},{"name":"Athletics","bonus":24,"key":"athletics"},{"name":"Acrobatics","bonus":22,"key":"acrobatics"},{"name":"Disable","bonus":22,"key":"disable"},{"name":"Lore (all)","bonus":21,"key":""},{"name":"Medicine","bonus":24,"key":"medicine"},{"name":"Perception","bonus":24,"key":"perception"},{"name":"Persuasion","bonus":20,"key":"persuasion"},{"name":"Unarmed","bonus":24,"key":"unarmed"}],"attacks":[{"name":"Rune Blade","attack":33,"damage":"2d10+22","mode":"melee","type":"slashing"}],"abilities":[{"name":"Angelfire","description":"Fire damage dealt by the seraphim is treated as holy against creatures that are immune, resistant, or weak to holy damage."},{"name":"Blood Angel","description":"A seraphim may double the MP cost of any red or white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap)."},{"name":"Purge","description":"As an all-out action, the seraphim can make a Spellcraft check (d20+29) against the Will Defence of all enemies within 6 squares. If successful, targets take 10d6+19 fire damage. Otherwise, they take half damage. The seraphim may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Righteous Fury","description":"Whenever the seraphim casts the Scorching Strike spell, its combo range increases to 17-20 until the start of its next turn."},{"name":"Second Skin","description":"Seraphim are never treated as encumbered by heavy armour."}],"spells":["Barrier","Dispel","Firestorm","Inferno","Mend","Scorching Strike","Shell","Smite"],"performances":[],"equipped":"Flame Shield, Rune Blade, Valiant Mail","loot":"Valiant Mail (5%), Rune Blade (20%), Flame Shield (50%), Angel Feather (95%)","steal":"Stardust (5%), Elixir (20%), Ammonia Salt (50%), Angel Feather (95%)","sourcePage":312}},"prototypeToken":{"name":"Seraphim","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"9fcb170cc11d36a4","name":"Rune Blade","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d10+22","type":"slashing"},"attack":{"bonus":33},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5b5486921af4a407","name":"Angelfire","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"Fire damage dealt by the seraphim is treated as holy against creatures that are immune, resistant, or weak to holy damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5185ec1f0a5038c7","name":"Blood Angel","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A seraphim may double the MP cost of any red or white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap).","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d1e6e86abb8a9be5","name":"Purge","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As an all-out action, the seraphim can make a Spellcraft check (d20+29) against the Will Defence of all enemies within 6 squares. If successful, targets take 10d6+19 fire damage. Otherwise, they take half damage. The seraphim may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b83dd25d022904af","name":"Righteous Fury","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"Whenever the seraphim casts the Scorching Strike spell, its combo range increases to 17-20 until the start of its next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cb52c712e69d6aea","name":"Second Skin","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"category":"Special Ability","description":"Seraphim are never treated as encumbered by heavy armour.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e8e6f501ef4dd21c","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ca870ee23e1d16cf","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"532ec0c338020b2b","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e2d665dc151eb149","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3547b03e107480b6","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b40091489429778b","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4d176a7bb709237a","name":"Skill Focus (1-handed, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e6d671d061918569","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0419ec605423d231","name":"Barrier","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Succor.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants increasing protection against elemental damage.","specialRules":"Encounter duration. Elemental damage reduces this DR by 5 when it exceeds the DR. Stacks with existing DR but not itself; does not stack with Ward. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Barrier elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":10,"label":"Barrier elemental DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":15,"label":"Barrier elemental DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fe6da9f9a0a478ac","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"610577d904f14f18","name":"Firestorm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_III.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"Fire rains down across an expanding area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half the initial damage at the start of the next turn and one quarter at the following turn. Area radius 1/2/3 squares for DC 20/25/30. DR reduces only the initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1e5c7175e57d1b83","name":"Inferno","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SMN/Inferno.webp","system":{"school":"Red Magick","mpCost":34,"action":"All-out Action","target":"All enemies within 6 squares","targetMode":"selected","checkSkill":"spellcraft","description":"A massive firestorm scorches a wide area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half damage at start of next turn and one quarter at following turn. Multi-square targets take +1 die; DR applies only to initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"2d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"3d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"damage","formula":"5d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c598b541d46a178e","name":"Mend","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Cure_II.webp","system":{"school":"White Magick","mpCost":16,"action":"All-out Action","target":"One unattended item within 6 squares and line of sight","targetMode":"none","checkSkill":"spellcraft","description":"Repairs an item by moving it up the Break Gauge.","specialRules":"Moves item up 1/2/3/4 Break Gauge steps. May target an attended item using its Reflex Defence. Cannot repair destroyed items.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dc5ec7c91565a97e","name":"Scorching Strike","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/RDM/Verflare.webp","system":{"school":"Red Magick","mpCost":10,"action":"Secondary Action","target":"You","targetMode":"self","checkSkill":"spellcraft","description":"Imbues melee attacks with fire damage.","specialRules":"Bonus lasts until your next turn. Not altered by abilities augmenting melee damage; does not stack with Galvanic Strike.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"change","key":"system.combat.meleeDamageBonus","value":1,"label":"Scorching Strike +1d6 fire"}]},{"dc":20,"effects":[{"type":"change","key":"system.combat.meleeDamageBonus","value":2,"label":"Scorching Strike +2d6 fire"}]},{"dc":25,"effects":[{"type":"change","key":"system.combat.meleeDamageBonus","value":3,"label":"Scorching Strike +3d6 fire"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.meleeDamageBonus","value":4,"label":"Scorching Strike +4d6 fire"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6dc34f37008f6bf5","name":"Shell","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Sacred_Soil.webp","system":{"school":"White Magick","mpCost":16,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Grants protection from physical damage.","specialRules":"Encounter duration. Physical damage reduces the effect's DR by 5 when it exceeds it. May stack with existing DR, but not with itself or Protect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":25,"tiers":[{"dc":25,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":5,"label":"Shell physical DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":10,"label":"Shell physical DR"}]},{"dc":35,"effects":[{"type":"change","key":"system.combat.physicalDamageReduction","value":15,"label":"Shell physical DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7638310001c680d7","name":"Smite","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Spirits_Within.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Holy force deals heavy damage to an enemy.","specialRules":"Each explosive damage die generates two additional dice. If the target moves down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"holy","defence":"will","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"254c94f4645333a8","name":"Flame Shield","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Shields","description":"Forged to resemble a burning flame, this shield is adorned with blazing crystals. You may reroll block attempts against attacks and spells that deal fire damage, keeping the higher result. When using the Shield Bash technick, this shield’s","cost":15700,"availability":"Rare","weaponSize":"Small","weaponSkill":"light-weapon","attack":{"bonus":3},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":0.1,"spec