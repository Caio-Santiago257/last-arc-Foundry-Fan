quares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Restores a large amount of HP.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"heal","formula":"3*@level"}]},{"dc":25,"effects":[{"type":"heal","formula":"4*@level"}]},{"dc":30,"effects":[{"type":"heal","formula":"5*@level"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"971cc83482abb9df","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cd1cc09653b8c02b","name":"Revive","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Raise.webp","system":{"school":"White Magick","mpCost":16,"action":"Primary Action","target":"One living, unconscious creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Restores an unconscious ally's HP and moves it up the Break Gauge.","specialRules":"On success move the target up 1/2/3/4/5 Break Gauge steps for DC 20/25/30/35/40.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"heal","formula":"@level"}]},{"dc":25,"effects":[{"type":"heal","formula":"@level"}]},{"dc":30,"effects":[{"type":"heal","formula":"@level"}]},{"dc":35,"effects":[{"type":"heal","formula":"@level"}]},{"dc":40,"effects":[{"type"