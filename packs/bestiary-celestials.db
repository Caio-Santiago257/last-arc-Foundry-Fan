{"_id":"21d6abe43f3db3f6","name":"Cherubim","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":16,"xp":0,"nextLevel":0,"className":"","race":"Celestials","alignment":"Pure","biography":"Mighty celestial beings who descend from the skies with resounding trumpets and proclamations, heralding fate and divine judgment."},"attributes":{"str":{"score":19},"vit":{"score":25},"agi":{"score":17},"int":{"score":16},"mnd":{"score":20},"cha":{"score":20}},"skills":{"acrobatics":{"trained":true,"total":16},"lore-mystic":{"trained":true,"total":16},"perception":{"trained":true,"total":18},"perform":{"trained":true,"total":23},"persuasion":{"trained":true,"total":18},"stealth":{"trained":true,"total":16},"unarmed":{"trained":true,"total":17}},"defences":{"ref":{"total":32},"fort":{"total":34},"will":{"total":32}},"resources":{"hp":{"value":213,"max":213,"baseMax":213},"mp":{"value":128,"max":128}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":34,"immunities":["Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Dark"],"vulnerabilities":["Dark"]},"adversary":{"isAdversary":true,"category":"Celestials","profile":"celestial","cr":16,"level":16,"xp":3200,"size":"medium","species":"Celestials","profileLine":"Pure Good Medium Celestial 16; Helpful/Territorial","classLevels":"","alignment":"Pure","temperament":"Helpful/Territorial","description":"Mighty celestial beings who descend from the skies with resounding trumpets and proclamations, heralding fate and divine judgment.","languages":"Celestial, Draconic, Infernal; Truespeech Mighty celestial beings who descend from the skies with resounding trumpets and proclamations, heralding fate and divine judgment.","speedText":"8, Fly 12 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 28","passivePerception":28,"attributes":{"str":19,"agi":17,"vit":25,"int":16,"mnd":20,"cha":20},"defences":{"ref":32,"flatFootedRef":29,"fort":34,"will":32},"damageReduction":15,"breakThreshold":34,"immunities":["Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Dark"],"weaknesses":["Dark"],"skills":[{"name":"handed","bonus":22,"key":""},{"name":"Acrobatics","bonus":16,"key":"acrobatics"},{"name":"Lore (mystic)","bonus":16,"key":"lore-mystic"},{"name":"Lore (social)","bonus":16,"key":""},{"name":"Perception","bonus":18,"key":"perception"},{"name":"Perform (instrument)","bonus":23,"key":"perform"},{"name":"Persuasion","bonus":18,"key":"persuasion"},{"name":"Stealth","bonus":16,"key":"stealth"},{"name":"Unarmed","bonus":17,"key":"unarmed"}],"attacks":[{"name":"Daemonsbane","attack":26,"damage":"2d8+16","mode":"melee","type":"blunt"}],"abilities":[{"name":"Angel Song","description":"As an all-out action, a cherubim may make a DC 20 Perform Instrument check (d20+27). If successful, all allies within 6 squares gain 10 temporary HP , as well as a +1 bonus to all defences. This bonus increases by +1 for every 5 points by which the check exceeds the base DC (maximum +5). This effect lasts until the start of the cherubim’s next turn."},{"name":"Angel Wing","description":"A cherubim may double the MP cost of any white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap)."}],"spells":["Cleanse","Curatio","Dispel","Revive"],"performances":[],"equipped":"Daemonsbane, Divine Coat, Empyrean Flute","loot":"Daemonsbane (5%), Divine Coat (20%), Empyrean Flute (50%), Angel Feather (95%)","steal":"Stardust (5%), Angel Feather (20%), Holy Water (50%)","sourcePage":311}},"prototypeToken":{"name":"Cherubim","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"31ff13e46d11ae30","name":"Daemonsbane","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d8+16","type":"blunt"},"attack":{"bonus":26},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2404d24c110d3da0","name":"Angel Song","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As an all-out action, a cherubim may make a DC 20 Perform Instrument check (d20+27). If successful, all allies within 6 squares gain 10 temporary HP , as well as a +1 bonus to all defences. This bonus increases by +1 for every 5 points by which the check exceeds the base DC (maximum +5). This effect lasts until the start of the cherubim’s next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6f40b80dda116627","name":"Angel Wing","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A cherubim may double the MP cost of any white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap).","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d93d4be1ded84ca0","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds anot