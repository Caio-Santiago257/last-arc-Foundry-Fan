{"_id":"bd387e2e1951f781","name":"Angel, Guardian","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"","race":"Celestials","alignment":"Pure","biography":"Ever vigilant, these silent protectors are sent from above to shield the faithful."},"attributes":{"str":{"score":16},"vit":{"score":18},"agi":{"score":17},"int":{"score":17},"mnd":{"score":17},"cha":{"score":19}},"skills":{"acrobatics":{"trained":true,"total":12},"athletics":{"trained":true,"total":12},"lore-mystic":{"trained":true,"total":12},"lore-occult":{"trained":true,"total":12},"perception":{"trained":true,"total":12},"persuasion":{"trained":true,"total":13},"unarmed":{"trained":true,"total":12}},"defences":{"ref":{"total":25},"fort":{"total":24},"will":{"total":23}},"resources":{"hp":{"value":95,"max":95,"baseMax":95},"mp":{"value":54,"max":54}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":24,"immunities":["Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Cold"],"vulnerabilities":["Dark"]},"adversary":{"isAdversary":true,"category":"Celestials","profile":"celestial","cr":9,"level":9,"xp":1800,"size":"medium","species":"Celestials","profileLine":"Pure Good Medium Celestial 9; Helpful/Defensive","classLevels":"","alignment":"Pure","temperament":"Helpful/Defensive","description":"Ever vigilant, these silent protectors are sent from above to shield the faithful.","languages":"Celestial, Draconic, Infernal; Truespeech Ever vigilant, these silent protectors are sent from above to shield the faithful.","speedText":"8, Fly 12 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 22","passivePerception":22,"attributes":{"str":16,"agi":17,"vit":18,"int":17,"mnd":17,"cha":19},"defences":{"ref":25,"flatFootedRef":22,"fort":24,"will":23},"damageReduction":10,"breakThreshold":24,"immunities":["Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Cold"],"weaknesses":["Dark"],"skills":[{"name":"Handed","bonus":17,"key":""},{"name":"Acrobatics","bonus":12,"key":"acrobatics"},{"name":"Athletics","bonus":12,"key":"athletics"},{"name":"Lore (arcane)","bonus":12,"key":""},{"name":"Lore (mystic)","bonus":12,"key":"lore-mystic"},{"name":"Lore (occult)","bonus":12,"key":"lore-occult"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Persuasion","bonus":13,"key":"persuasion"},{"name":"Unarmed","bonus":12,"key":"unarmed"}],"attacks":[{"name":"Flametongue","attack":19,"damage":"2d8+9","mode":"melee","type":"blunt"}],"abilities":[{"name":"Angelfire","description":"Fire damage dealt by the guardian angel is treated as holy against creatures that are immune, resistant, or weak to holy damage."}],"spells":["Cleanse","Faith","Smite","Ward"],"performances":[],"equipped":"Flametongue, Mythril Shirt","loot":"Angel Feather (5%), Flametongue (20%), Mythril Shirt (50%), Holy Water (95%)","steal":"Stardust (5%), Ambrosia (20%) Celestials Servants of the Goddess, the celestials are both benevolent and terrifying; for while they are righteous, they are extremely dogmatic and uncompromising. Celestials progress as beasts. However, they gain an amount of MP equal to 3+ Mnd (minimum 1) at each level and always treat all skills as class skills. Additionally, celestials are always proficient with equipment they have equipped. When reduced to 0 HP or moved to the bottom of the Break Gauge, celestials are destroyed, leaving no corpse behind.","sourcePage":309}},"prototypeToken":{"name":"Angel, Guardian","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"a72915387b4fc6c9","name":"Flametongue","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d8+9","type":"blunt"},"attack":{"bonus":19},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d4e20035c8eda01f","name":"Angelfire","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"Fire damage dealt by the guardian angel is treated as holy against creatures that are immune, resistant, or weak to holy damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f71a640da0d19368","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c27efa24ceef25c6","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3ded1bfb46ef175d","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"36c9b882a3d247e0","name":"Skill Focus (1-Handed, Spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fe78c30f65002f4b","name":"Cleanse","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":6,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Removes ailments, with stronger results cleansing more conditions.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"removeConditions","statuses":["poisoned"]}]},{"dc":20,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced"]}]},{"dc":25,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed"]}]},{"dc":30,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping"]}]},{"dc":35,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified"]}]},{"dc":40,"effects":[{"type":"removeConditions","statuses":["poisoned","blinded","silenced","slowed","paralysed","confused","diseased","sleeping","petrified","toad","zombified","cursed"]}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c36fb6f0e2ce13e8","name":"Faith","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Presence_of_Mind.webp","system":{"school":"White Magick","mpCost":10,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Raises Fortitude and Will Defence for an encounter.","specialRules":"Bonuses last for the encounter; may be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"change","key":"system.defences.fort.misc","value":1,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":1,"label":"Faith Will"}]},{"dc":20,"effects":[{"type":"change","key":"system.defences.fort.misc","value":2,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":2,"label":"Faith Will"}]},{"dc":25,"effects":[{"type":"change","key":"system.defences.fort.misc","value":3,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":3,"label":"Faith Will"}]},{"dc":30,"effects":[{"type":"change","key":"system.defences.fort.misc","value":4,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":4,"label":"Faith Will"}]},{"dc":35,"effects":[{"type":"change","key":"system.defences.fort.misc","value":5,"label":"Faith Fortitude"},{"type":"change","key":"system.defences.will.misc","value":5,"label":"Faith Will"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"24b681951e5a1242","name":"Smite","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Spirits_Within.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Holy force deals heavy damage to an enemy.","specialRules":"Each explosive damage die generates two additional dice. If the target moves down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"holy","defence":"will","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5c0b116d52d62eda","name":"Ward","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/WHM/Divine_Benison.webp","system":{"school":"White Magick","mpCost":4,"action":"Secondary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Provides increasing protection from elemental damage.","specialRules":"Encounter duration. Elemental damage reduces the effect's DR by 5 when it exceeds it. May stack with existing DR, but not with itself or Barrier. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":2,"label":"Ward elemental DR"}]},{"dc":20,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":3,"label":"Ward elemental DR"}]},{"dc":25,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":4,"label":"Ward elemental DR"}]},{"dc":30,"effects":[{"type":"change","key":"system.combat.elementalDamageReduction","value":5,"label":"Ward elemental DR"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e9b79144876944d8","name":"Flametongue","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Fast_Blade.webp","system":{"category":"Swords","description":"This special blade was forged in the shape of a dragon’s forked tongue and radiates intense heat. This weapon’s","cost":8500,"availability":"Rare","bulk":1,"weaponGroup":"swords","weaponSize":"Medium","weaponSkill":"one-handed","attack":{"bonus":2},"damage":{"formula":"2d8+2","type":"Piercing or Slashing"},"range":"Melee","capacity":0,"specialRules":"This special blade was forged in the shape of a dragon’s forked tongue and radiates intense heat. This weapon’s","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"aa56d3fd117f03b8","name":"Mythril Shirt","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Light Armour","description":"A chain shirt fashioned from mythril links. It is far lighter than other armour, while still offering a great deal of protection.","cost":7900,"availability":"Exotic","bulk":2,"armorType":"light","reflexBonus":2,"damageReduction":9,"maxAgilityBonus":4,"armorCheckPenalty":-5,"specialRules":"A chain shirt fashioned from mythril links. It is far lighter than other armour, while still offering a great deal of protection.","equipped":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"4d360276399950fb","name":"Valkyrie","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":14,"xp":0,"nextLevel":0,"className":"","race":"Celestials","alignment":"Pure","biography":"Known as weeping angels, they veil their faces to prevent souls from mistaking them for goddesses—lest they commit sacrilege."},"attributes":{"str":{"score":20},"vit":{"score":19},"agi":{"score":22},"int":{"score":19},"mnd":{"score":21},"cha":{"score":16}},"skills":{"acrobatics":{"trained":true,"total":18},"athletics":{"trained":true,"total":17},"lore-mystic":{"trained":true,"total":16},"lore-occult":{"trained":true,"total":16},"light-weapon":{"trained":true,"total":23},"perception":{"trained":true,"total":17},"persuasion":{"trained":true,"total":15},"stealth":{"trained":true,"total":20},"unarmed":{"trained":true,"total":17}},"defences":{"ref":{"total":32},"fort":{"total":29},"will":{"total":30}},"resources":{"hp":{"value":126,"max":126,"baseMax":126},"mp":{"value":131,"max":131}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":34,"immunities":["Blind","Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Dark"],"vulnerabilities":["Dark Block Duelling Buckler +25"]},"adversary":{"isAdversary":true,"category":"Celestials","profile":"celestial","cr":14,"level":14,"xp":2800,"size":"medium","species":"Celestials","profileLine":"","classLevels":"","alignment":"Pure","temperament":"Helpful/Aggressive","description":"Known as weeping angels, they veil their faces to prevent souls from mistaking them for goddesses—lest they commit sacrilege.","languages":"Celestial, Draconic, Infernal; Truespeech Known as weeping angels, they veil their faces to prevent souls from mistaking them for goddesses—lest they commit sacrilege.","speedText":"8, Fly 12 (hover)","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 27","passivePerception":27,"attributes":{"str":20,"agi":22,"vit":19,"int":19,"mnd":21,"cha":16},"defences":{"ref":32,"flatFootedRef":26,"fort":29,"will":30},"damageReduction":15,"breakThreshold":34,"immunities":["Blind","Curse","Death Effects","Holy","Petrify","Sleep","Toad"],"resistances":["Dark"],"weaknesses":["Dark Block Duelling Buckler +25"],"skills":[{"name":"Acrobatics","bonus":18,"key":"acrobatics"},{"name":"Athletics","bonus":17,"key":"athletics"},{"name":"Lore (mystic)","bonus":16,"key":"lore-mystic"},{"name":"Lore (occult)","bonus":16,"key":"lore-occult"},{"name":"Lore (social)","bonus":16,"key":""},{"name":"Light Weapon","bonus":23,"key":"light-weapon"},{"name":"Perception","bonus":17,"key":"perception"},{"name":"Persuasion","bonus":15,"key":"persuasion"},{"name":"Stealth","bonus":20,"key":"stealth"},{"name":"Unarmed","bonus":17,"key":"unarmed"}],"attacks":[{"name":"Phantom Edge","attack":25,"damage":"2d6+14","mode":"melee","type":"blunt"}],"abilities":[{"name":"Dark Angel","description":"A valkyrie may double the MP cost of any black or white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap.)"},{"name":"Grave Ward","description":"Any undead creature that begins its turn within 2 squares of a valkyrie is subject to an attack roll (d20+17) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. However, any creature that resisted this effect cannot be targeted by this ability again for the duration of the encounter. Higher-level targets gain a +5 to their defence against this ability."}],"spells":["Darkness","Expiry","Luminescence","Sap","Smite"],"performances":[],"equipped":"Black Garb, Duelling Buckler, Phantom Edge","loot":"Phantom Edge (5%), Black Garb (20%), Duelling Buckler (50%), Angel Feather (95%)","steal":"Moondust (5%), Angel Feather (20%), Holy Water (50%)","sourcePage":310}},"prototypeToken":{"name":"Valkyrie","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"755cc059032e9b01","name":"Phantom Edge","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d6+14","type":"blunt"},"attack":{"bonus":25},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"64d37eddeeaa3f13","name":"Dark Angel","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A valkyrie may double the MP cost of any black or white magick spell to either double the range of the spell, double the spell’s area of effect, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap.)","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"59890d6c2b7a6ec8","name":"Grave Ward","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"Any undead creature that begins its turn within 2 squares of a valkyrie is subject to an attack roll (d20+17) against their Will Defence. If successful, the target becomes flat-footed and may take no actions until the start of its next turn. However, any creature that resisted this effect cannot be targeted by this ability again for the duration of the encounter. Higher-level targets gain a +5 to their defence against this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4109f919d14d76ee","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6d3b335375561203","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3358bac9d4d6f500","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f1b663a78ed48f42","name":"MP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Manafont.webp","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cfe62c534f9abb75","name":"Skill Focus (light weapon, spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"descriptio