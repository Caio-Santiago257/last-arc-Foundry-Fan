{"_id":"966708f3d5aa117b","name":"Spiked Armour","type":"armor","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sentinel.webp","system":{"category":"Heavy Armour","description":"An exotic suit of plate mail adorned with countless spikes. Any creature that deals damage to you with a melee attack suffers 2d6 points of piercing damage. This excludes weapons that grant Reach 2.","cost":2900,"availability":"Uncommon","bulk":3,"armorType":"heavy","reflexBonus":4,"damageReduction":5,"maxAgilityBonus":1,"armorCheckPenalty":-10,"specialRules":"An exotic suit of plate mail adorned with countless spikes. Any creature that deals damage to you with a melee attack suffers 2d6 points of piercing damage. This excludes weapons that grant Reach 2."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
