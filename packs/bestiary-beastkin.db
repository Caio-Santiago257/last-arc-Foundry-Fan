{"_id":"9a21257e37feea4c","name":"Siren","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Beastkin","alignment":"Neutral","biography":"One of the terrors of the Sphallien Sea, these creatures use their haunting song to lure sailors to a watery doom."},"attributes":{"str":{"score":10},"vit":{"score":12},"agi":{"score":17},"int":{"score":14},"mnd":{"score":19},"cha":{"score":21}},"skills":{"acrobatics":{"trained":true,"total":10},"lore-terrestrial":{"trained":true,"total":9},"perception":{"trained":true,"total":11},"perform":{"trained":true,"total":17},"stealth":{"trained":true,"total":10},"survival":{"trained":true,"total":11},"unarmed":{"trained":true,"total":12}},"defences":{"ref":{"total":18},"fort":{"total":19},"will":{"total":19}},"resources":{"hp":{"value":30,"max":30,"baseMax":30},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":19,"immunities":["Silence","Toad"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beastkin","profile":"beastkin","cr":5,"level":5,"xp":1000,"size":"medium","species":"Beastkin","profileLine":"Neutral Evil Medium Beastkin 5; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"One of the terrors of the Sphallien Sea, these creatures use their haunting song to lure sailors to a watery doom.","languages":"Beastongue, Primordial One of the terrors of the Sphallien Sea, these creatures use their haunting song to lure sailors to a watery doom.","speedText":"4, Fly 8 (hover)","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 21","passivePerception":21,"attributes":{"str":10,"agi":17,"vit":12,"int":14,"mnd":19,"cha":21},"defences":{"ref":18,"flatFootedRef":15,"fort":19,"will":19},"damageReduction":5,"breakThreshold":19,"immunities":["Silence","Toad"],"resistances":[],"weaknesses":[],"