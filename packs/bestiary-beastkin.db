{"_id":"293d134e70cdf605","name":"Minotaur","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Beastkin","alignment":"Corrupt","biography":"Hulking brutes who patrol the Labyrinth’s narrow halls, crushing all who cross their path."},"attributes":{"str":{"score":23},"vit":{"score":19},"agi":{"score":10},"int":{"score":7},"mnd":{"score":19},"cha":{"score":9}},"skills":{"athletics":{"trained":true,"total":16},"perception":{"trained":true,"total":14},"survival":{"trained":true,"total":14},"unarmed":{"trained":true,"total":21}},"defences":{"ref":{"total":24},"fort":{"total":25},"will":{"total":25}},"resources":{"hp":{"value":99,"max":99,"baseMax":99},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":12,"baseDamageReduction":12,"breakThreshold":30,"immunities":["Curse","Death Effects","Paralysis","Petrify"],"resistances":["to all physical damage for the duration of the encounter. This effect may be dispelled","in which case","the minotaur may not use this ability again for 1d4+1 turns. Bulldoze: The minotaur is treated as having the Trample technick and is treated as both mount and rider while charging. Additionally","any creature the minotaur tramples is knocked prone","even if they took half damage. Butcher’s Grip: The minotaur may treat large weapons as 2-handed weapons","despite their size. Second Skin: Minotaurs are never treated as encumbered by heavy armour. Skewer: Whenever the minotaur successfully hits a target with its gore attack at the end of a charge","it deals +1 damage die. Additionally","the damage ignores all non-magickal DR."],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beastkin","profile":"beastkin","cr":11,"level":11,"xp":2200,"size":"large","species":"Beastkin","profileLine":"Corrupt Neutral Large Beastkin 11; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Hulking brutes who patrol the Labyrinth’s narrow halls, crushing all who cross their path.","languages":"Beastongue Hulking brutes who patrol the Labyrinth’s narrow halls, crushing all who cross their path.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision, Scent; Passive Perception 24","passivePerception":24,"attributes":{"str":23,"agi":10,"vit":19,"int":7,"mnd":19,"cha":9},"defences":{"ref":24,"flatFootedRef":24,"fort":25,"will":25},"damageReduction":12,"breakThreshold":30,"immunities":["Curse","Death Effects","Paralysis","Petrify"],"resistances":["to all physical damage for the duration of the encounter. This effect may be dispelled","in which case","the minotaur may not use this ability again for 1d4+1 turns. Bulldoze: The minotaur is treated as having the Trample technick and is treated as both mount and rider while charging. Additionally","any creature the minotaur tramples is knocked prone","even if they took half damage. Butcher’s Grip: The minotaur may treat large weapons as 2-handed weapons","despite their size. Second Skin: Minotaurs are never treated as encumbered by heavy armour. Skewer: Whenever the minotaur successfully hits a target with its gore attack at the end of a charge","it deals +1 damage die. Additionally","the damage ignores all non-magickal DR."],"weaknesses":[],"skills":[{"name":"handed","bonus":21,"key":""},{"name":"Athletics","bonus":16,"key":"athletics"},{"name":"Perception","bonus":14,"key":"perception"},{"name":"Survival","bonus":14,"key":"survival"},{"name":"Unarmed","bonus":21,"key":"unarmed"}],"attacks":[{"name":"Gigas Mallet","attack":24,"damage":"2d12+20","mode":"melee","type":"blunt"},{"name":"Gore","attack":23,"damage":"2d8+11","mode":"melee","type":"piercing"}],"abilities":[{"name":"Beef Up","description":"As a minor action, the minotaur can grant itself resistance to all physical damage for the duration of the encounter. This effect may be dispelled, in which case, the minotaur may not use this ability again for 1d4+1 turns."},{"name":"Bulldoze","description":"The minotaur is treated as having the Trample technick and is treated as both mount and rider while charging. Additionally, any creature the minotaur tramples is knocked prone, even if they took half damage."},{"name":"Butcher’s Grip","description":"The minotaur may treat large weapons as 2-handed weapons, despite their size."},{"name":"Second Skin","description":"Minotaurs are never treated as encumbered by heavy armour."},{"name":"Skewer","description":"Whenever the minotaur successfully hits a target with its gore attack at the end of a charge, it deals +1 damage die. Additionally, the damage ignores all non-magickal DR."}],"spells":[],"performances":[],"equipped":"","loot":"Ancient Armour (5%), Gigas Mallet (20%), Mega-Potion (50%), Beast Horn (95%)","steal":"Gigas Heart (20%), Earth Crystal (95%)","sourcePage":308}},"prototypeToken":{"name":"Minotaur","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"65fef3be7999e5a6","name":"Gigas Mallet","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d12+20","type":"blunt"},"attack":{"bonus":24},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"12b9afeee61c8443","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d8+11","type":"piercing"},"attack":{"bonus":2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f543eda9744ac002","name":"Beef Up","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"As a minor action, the minotaur can grant itself resistance to all physical damage for the duration of the encounter. This effect may be dispelled, in which case, the minotaur may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"06b9f04c4565a56b","name":"Bulldoze","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"The minotaur is treated as having the Trample technick and is treated as both mount and rider while charging. Additionally, any creature the minotaur tramples is knocked prone, even if they took half damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f32722df29b665a2","name":"Butcher’s Grip","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"category":"Special Ability","description":"The minotaur may treat large weapons as 2-handed weapons, despite their size.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b03aaea0a8f7d833","name":"Second Skin","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Heavy_Shot.webp","system":{"category":"Special Ability","description":"Minotaurs are never treated as encumbered by heavy armour.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"dafa52f440b9ff5e","name":"Skewer","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":