 Attack","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"Spend two minor actions to deal one additional damage die on all melee attacks until your turn ends. Does not stack with Rapid Strike.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a2fead5e8f4bc1e5","name":"Shake it Off","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e707428796cf76c6","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"69e09c640ec54fdf","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
