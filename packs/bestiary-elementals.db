{"_id":"bb4d55705205ed4a","name":"Djinn, Frost","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Pure","biography":"Spirits as cold and unfeeling as the Dread himself."},"attributes":{"str":{"score":25},"vit":{"score":21},"agi":{"score":11},"int":{"score":4},"mnd":{"score":14},"cha":{"score":11}},"skills":{"athletics":{"trained":true,"total":17},"lore-terrestrial":{"trained":true,"total":7},"perception":{"trained":true,"total":12},"unarmed":{"trained":true,"total":22}},"defences":{"ref":{"total":22},"fort":{"total":27},"will":{"total":24}},"resources":{"hp":{"value":126,"max":126,"baseMax":126},"mp":{"value":55,"max":55}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":32,"immunities":["Cold","Confusion","Curse","Disease","Mind Effects","Zombify"],"resistances":["Holy","Slashing"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":11,"level":11,"xp":2200,"size":"medium","species":"Elementals","profileLine":"Pure Neutral Medium Elemental 11; Territorial","classLevels":"","alignment":"Pure","temperament":"Territorial","description":"Spirits as cold and unfeeling as the Dread himself.","languages":"Primordial Spirits as cold and unfeeling as the Dread himself.","speedText":"6 (hover)","initiativeDie":"1d8","senses":"Blindsense; Passive Perception 22","passivePerception":22,"attributes":{"str":25,"agi":11,"vit":21,"int":4,"mnd":14,"cha":11},"defences":{"ref":22,"flatFootedRef":22,"fort":27,"will":24},"damageReduction":10,"breakThreshold":32,"immunities":["Cold","Confusion","Curse","Disease","Mind Effects","Zombify"],"resistances":["Holy","Slashing"],"weaknesses":["Fire"],"skills":[{"name":"Athletics","bonus":17,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":7,"key":"lore-terrestrial"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Unarmed","bonus":22,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":22,"damage":"1d4+12","mode":"melee","type":"blunt"}],"abilities":[{"name":"Flurry","description":"As a primary action, a frost djinn can make an attack (d20+20) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+10 cold damage. Otherwise, creatures take half damage. Additionally, should the roll beat both a creature’s Ref and Fort Defence, the creature loses their secondary action on their next turn. The frost djinn may not use this ability again for 1d4+1 turns."},{"name":"Frostbite","description":"A frost djinn’s slam attack deals cold damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the frost djinn’s next turn."}],"spells":[],"performances":[],"equipped":"","loot":"Ice Crystal (20%), Magicite (50%)","steal":"Ice Crystal (20%), Magicite (95%)","sourcePage":329}},"prototypeToken":{"name":"Djinn, Frost","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"1eeccd692d525f79","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+12","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e6d9f038184c334b","name":"Flurry","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, a frost djinn can make an attack (d20+20) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+10 cold damage. Otherwise, creatures take half damage. Additionally, should the roll beat both a creature’s Ref and Fort Defence, the creature loses their secondary action on their next turn. The frost djinn may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5c1b07a79781fc09","name":"Frostbite","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A frost djinn’s slam attack deals cold damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the frost djinn’s next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"65dbb5b97a9218ba","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"728f86be086660d0","name":"Disruptive","type":"technick","img":"icons/skills/trades/music-notes-sound-blue.webp","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"90fc9d38f8470d36","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ff5c3ebc43bbf937","name":"Shake it Off","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cd708860d273bd2b","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a1bf118af65b513b","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"fa6f55d21acc779a","name":"Titan, Rock","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":12,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Corrupt","biography":"Majestic giants roaming the Highlands’ mountains, rumored gentler than their kin—though few live to confirm it."},"attributes":{"str":{"score":34},"vit":{"score":31},"agi":{"score":8},"int":{"score":10},"mnd":{"score":11},"cha":{"score":11}},"skills":{"athletics":{"trained":true,"total":23},"lore-terrestrial":{"trained":true,"total":11},"perception":{"trained":true,"total":11},"persuasion":{"trained":true,"total":11},"survival":{"trained":true,"total":11},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":20},"fort":{"total":33},"will":{"total":23}},"resources":{"hp":{"value":197,"max":197,"baseMax":197},"mp":{"value":36,"max":36}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":48,"immunities":["Confusion","Curse","Disease","Electric","Fear Effects","Mind Effects","Stuns","Zombify"],"resistances":["Blunt","Slashing"],"vulnerabilities":["Blunt"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":12,"level":12,"xp":3400,"size":"huge","species":"Elementals","profileLine":"Corrupt Neutral Huge Elemental 12; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Majestic giants roaming the Highlands’ mountains, rumored gentler than their kin—though few live to confirm it.","languages":"Primordial Majestic giants roaming the Highlands’ mountains, rumored gentler than their kin—though few live to confirm it.","speedText":"4","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 21","passivePerception":21,"attributes":{"str":34,"agi":8,"vit":31,"int":10,"mnd":11,"cha":11},"defences":{"ref":20,"flatFootedRef":20,"fort":33,"will":23},"damageReduction":15,"breakThreshold":48,"immunities":["Confusion","Curse","Disease","Electric","Fear Effects","Mind Effects","Stuns","Zombify"],"resistances":["Blunt","Slashing"],"weaknesses":["Blunt"],"skills":[{"name":"Athletics","bonus":23,"key":"athletics"},{"name":"Lore (arcane)","bonus":11,"key":""},{"name":"Lore (terrestrial)","bonus":11,"key":"lore-terrestrial"},{"name":"Perception","bonus":11,"key":"perception"},{"name":"Persuasion","bonus":11,"key":"persuasion"},{"name":"Survival","bonus":11,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":28,"damage":"1d8+18","mode":"melee","type":"blunt"},{"name":"Slam","attack":28,"damage":"2d8+18","mode":"melee","type":"blunt"}],"abilities":[{"name":"Earthquake","description":"As an all-out action, a rock titan may make an attack (d20+26) against the Ref Defence of all enemies within its reach. If successful, targets suffer 8d6+16 blunt damage. Otherwise, creatures take half damage. Additionally, should the attack roll beat both a target's Ref and Fort Defence, they become flat-footed on their next turn. Should the attack beat a target's Fort Defence by 5 or more, the target is knocked prone. The rock titan may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun."},{"name":"Immovable","description":"A rock titan cannot be moved by any means of forced movement, including teleportation."},{"name":"Imposing","description":"A rock titan may add its Str modifier to all Persuasion checks made to intimidate."},{"name":"Unction","description":"Whenever the rock titan’s slam attack beats both a target's Ref and Fort Defence, the target becomes oiled."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Earth Crystal (50%), Magicite (95%)","steal":"Stardust (5%), Earth Crystal (95%)","sourcePage":330}},"prototypeToken":{"name":"Titan, Rock","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"2448a158a4b5c7a2","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+18","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6361bbd6a65e5290","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d8+18","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6cf3d92a43a9bbbc","name":"Earthquake","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As an all-out action, a rock titan may make an attack (d20+26) against the Ref Defence of all enemies within its reach. If successful, targets suffer 8d6+16 blunt damage. Otherwise, creatures take half damage. Additionally, should the attack roll beat both a target's Ref and Fort Defence, they become flat-footed on their next turn. Should the attack beat a target's Fort Defence by 5 or more, the target is knocked prone. The rock titan may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cd2753a85d05aab7","name":"Immovable","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A rock titan 