{"_id":"acb5621a415a83b4","name":"Sprite, Bolt","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":2,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Neutral","biography":""},"attributes":{"str":{"score":1},"vit":{"score":10},"agi":{"score":15},"int":{"score":5},"mnd":{"score":11},"cha":{"score":11}},"skills":{"acrobatics":{"trained":true,"total":8},"perception":{"trained":true,"total":6},"unarmed":{"trained":true,"total":13}},"defences":{"ref":{"total":16},"fort":{"total":12},"will":{"total":12}},"resources":{"hp":{"value":10,"max":10,"baseMax":10},"mp":{"value":6,"max":6}},"combat":{"initiativeDie":"1d8","speed":2,"baseSpeed":2,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":12,"immunities":["Electric"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":1,"level":2,"xp":0,"size":"tiny","species":"Elementals","profileLine":"Neutral Tiny Incorporeal Elemental 2; TimidXP 200 Playful spirits seen on stormy nights, dancing joyfully through the thunderous skies. HP 10 MP 6 Init d8 Speed 2, Fly 8 (hover) Senses Dark Vision; Passive Perception 16 Defence Ref 16 (flat-footed 14), Fort 12, Will 12 Threshold 12 Immunity Electric Offence Melee Slam +13 (1d2+3) Space 1 square; Reach 1 square Statistics Attributes Str 1, Agi 15, Vit 10, Int 5, Mnd 11, Chr 11 Technicks Skill Focus (unarmed) Skills Acrobatics +8, Lore (arcane) +3, Perception +6, Unarmed +13 Abilities Conductive: A bolt sprite’s slam attack deals electric damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target becomes flat- footed until the start of the bolt sprite's next turn. Starburst: When reduced to 0 HP or the bottom of the Break Gauge, the bolt sprite makes an attack roll (d20+11), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+1 electric damage. Otherwise, targets take half damage. The bolt sprite is then destroyed. This is an area effect. Items Loot Storm Crystal (20%), Magicite (50%) Steal Storm Crystal (5%), Magicite (95%)","classLevels":"","alignment":"Neutral","temperament":"","description":"","languages":"","speedText":"2, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 16","passivePerception":16,"attributes":{"str":1,"agi":15,"vit":10,"int":5,"mnd":11,"cha":11},"defences":{"ref":16,"flatFootedRef":14,"fort":12,"will":12},"damageReduction":0,"breakThreshold":12,"immunities":["Electric"],"resistances":[],"weaknesses":[],"skills":[{"name":"Acrobatics","bonus":8,"key":"acrobatics"},{"name":"Lore (arcane)","bonus":3,"key":""},{"name":"Perception","bonus":6,"key":"perception"},{"name":"Unarmed","bonus":13,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":13,"damage":"1d2+3","mode":"melee","type":"blunt"}],"abilities":[{"name":"Conductive","description":"A bolt sprite’s slam attack deals electric damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target becomes flat- footed until the start of the bolt sprite's next turn."},{"name":"Starburst","description":"When reduced to 0 HP or the bottom of the Break Gauge, the bolt sprite makes an attack roll (d20+11), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+1 electric damage. Otherwise, targets take half damage. The bolt sprite is then destroyed. This is an area effect."}],"spells":[],"performances":[],"equipped":"","loot":"Storm Crystal (20%), Magicite (50%)","steal":"Storm Crystal (5%), Magicite (95%)","sourcePage":325}},"prototypeToken":{"name":"Sprite, Bolt","texture":{"src":"icons/svg/mystery-man.svg"},"width":0.5,"height":0.5,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"c065433008cb2ef3","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d2+3","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"85b58e156ab133e8","name":"Conductive","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A bolt sprite’s slam attack deals electric damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target becomes flat- footed until the start of the bolt sprite's next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"208e526c1abe041d","name":"Starburst","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When reduced to 0 HP or the bottom of the Break Gauge, the bolt sprite makes an attack roll (d20+11), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+1 electric damage. Otherwise, targets take half damage. The bolt sprite is then destroyed. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cd969358622c8d87","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"1106cf21d34db637","name":"Sprite, Snow","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":3,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Neutral","biography":""},"attributes":{"str":{"score":1},"vit":{"score":13},"agi":{"score":12},"int":{"score":5},"mnd":{"score":11},"cha":{"score":11}},"skills":{"acrobatics":{"trained":true,"total":7},"perception":{"trained":true,"total":6},"unarmed":{"trained":true,"total":12}},"defences":{"ref":{"total":17},"fort":{"total":15},"will":{"total":14}},"resources":{"hp":{"value":18,"max":18,"baseMax":18},"mp":{"value":9,"max":9}},"combat":{"initiativeDie":"1d8","speed":2,"baseSpeed":2,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":15,"immunities":["Cold"],"resistances":[],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":2,"level":3,"xp":0,"size":"tiny","species":"Elementals","profileLine":"Neutral Tiny Incorporeal Elemental 3; TimidXP 400 Shy, childlike spirits who emerge to play when the snow is fresh and untouched. HP 18 MP 9 Init d8 Speed 2, Fly 8 (hover) Senses Dark Vision; Passive Perception 16 Defence Ref 17 (flat-footed 16), Fort 15, Will 14 Threshold 15 Immunity Cold Weakness Fire Offence Melee Slam +12 (1d2+2) Space 1 square; Reach 1 square Statistics Attributes Str 1, Agi 12, Vit 13, Int 5, Mnd 11, Chr 11 Technicks Defence Up, Skill Focus (unarmed) Skills Acrobatics +7, Lore (arcane) +3, Perception +6, Unarmed +12 Abilities Frostbite: A snow sprite’s slam attack deals cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the snow sprite's next turn. Starburst: When reduced to 0 HP or the bottom of the Break Gauge, the snow sprite makes an attack roll (d20+12), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+2 cold damage. Otherwise, targets take half damage. The snow sprite is then destroyed. This is an area effect. Items Loot Ice Crystal (20%), Magicite (50%) Steal Ice Crystal (5%), Magicite (95%) Elementals Echoes of the old gods, these strange beings manifest from the raw magickal power that remains in the world long after the primals were sealed away. Elementals progress as beasts. However, they gain an amount of MP equal to 3+ Mnd (minimum 1) at each level and always treat Spellcraft as a class skill. Additionally, elementals cannot be knocked prone. Lastly, when reduced to 0 HP or the bottom of the Break Gauge, elementals are destroyed, leaving no corpse behind. 324 v.03 10/27/2026","classLevels":"","alignment":"Neutral","temperament":"","description":"","languages":"","speedText":"2, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 16","passivePerception":16,"attributes":{"str":1,"agi":12,"vit":13,"int":5,"mnd":11,"cha":11},"defences":{"ref":17,"flatFootedRef":16,"fort":15,"will":14},"damageReduction":0,"breakThreshold":15,"immunities":["Cold"],"resistances":[],"weaknesses":["Fire"],"skills":[{"name":"Acrobatics","bonus":7,"key":"acrobatics"},{"name":"Lore (arcane)","bonus":3,"key":""},{"name":"Perception","bonus":6,"key":"perception"},{"name":"Unarmed","bonus":12,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":12,"damage":"1d2+2","mode":"melee","type":"blunt"}],"abilities":[{"name":"Frostbite","description":"A snow sprite’s slam attack deals cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the snow sprite's next turn."},{"name":"Starburst","description":"When reduced to 0 HP or the bottom of the Break Gauge, the snow sprite makes an attack roll (d20+12), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+2 cold damage. Otherwise, targets take half damage. The snow sprite is then destroyed. This is an area effect."}],"spells":[],"performances":[],"equipped":"","loot":"Ice Crystal (20%), Magicite (50%)","steal":"Ice Crystal (5%), Magicite (95%) Elementals Echoes of the old gods, these strange beings manifest from the raw magickal power that remains in the world long after the primals were sealed away. Elementals progress as beasts. However, they gain an amount of MP equal to 3+ Mnd (minimum 1) at each level and always treat Spellcraft as a class skill. Additionally, elementals cannot be knocked prone. Lastly, when reduced to 0 HP or the bottom of the Break Gauge, elementals are destroyed, leaving no corpse behind.","sourcePage":325}},"prototypeToken":{"name":"Sprite, Snow","texture":{"src":"icons/svg/mystery-man.svg"},"width":0.5,"height":0.5,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"5ff6dee4a336da10","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d2+2","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3bca3d6b99a40941","name":"Frostbite","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A snow sprite’s slam attack deals cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the snow sprite's next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f4a3ff3ef642a7df","name":"Starburst","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When reduced to 0 HP or the bottom of the Break Gauge, the snow sprite makes an attack roll (d20+12), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+2 cold damage. Otherwise, targets take half damage. The snow sprite is then destroyed. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e2757b3e0c851885","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"18dcfee91ccd732c","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"fd03718b99244dd0","name":"Sprite, Flame","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":4,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Neutral","biography":""},"attributes":{"str":{"score":1},"vit":{"score":14},"agi":{"score":17},"int":{"score":5},"mnd":{"score":13},"cha":{"score":11}},"skills":{"acrobatics":{"trained":true,"total":10},"perception":{"trained":true,"total":8},"unarmed":{"trained":true,"total":15}},"defences":{"ref":{"total":20},"fort":{"total":17},"will":{"total":16}},"resources":{"hp":{"value":28,"max":28,"baseMax":28},"mp":{"value":16,"max":16}},"combat":{"initiativeDie":"1d8","speed":2,"baseSpeed":2,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":17,"immunities":["Fire"],"resistances":[],"vulnerabilities":["Cold"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":3,"level":4,"xp":0,"size":"tiny","species":"Elementals","profileLine":"Neutral Tiny Incorporeal Elemental 4; TimidXP 600 Hot-headed and impish, these temperamental spirits are notorious for setting things ablaze. HP 28 MP 16 Init d8 Speed 2, Fly 8 (hover) Senses Dark Vision; Passive Perception 18 Defence Ref 20 (flat-footed 17), Fort 17, Will 16 Threshold 17 Immunity Fire Weakness Cold Offence Melee Slam +15 (1d2+5) Space 1 square; Reach 1 square Statistics Attributes Str 1, Agi 17, Vit 14, Int 5, Mnd 13, Chr 11 Technicks Defence Up, Skill Focus (unarmed) Skills Acrobatics +10, Lore (arcane) +4, Perception +8, Unarmed +15 Abilities Burn: A flame sprite’s slam attack deals fire damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target takes an additional 1d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR. Starburst: When reduced to 0 HP or the bottom of the Break Gauge, the flame sprite makes an attack roll (d20+14), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+4 fire damage. Otherwise, targets take half damage. The flame sprite is then destroyed. This is an area effect. Items Loot Fire Crystal (20%), Magicite (50%) Steal Fire Crystal (5%), Magicite (95%)","classLevels":"","alignment":"Neutral","temperament":"","description":"","languages":"","speedText":"2, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 18","passivePerception":18,"attributes":{"str":1,"agi":17,"vit":14,"int":5,"mnd":13,"cha":11},"defences":{"ref":20,"flatFootedRef":17,"fort":17,"will":16},"damageReduction":0,"breakThreshold":17,"immunities":["Fire"],"resistances":[],"weaknesses":["Cold"],"skills":[{"name":"Acrobatics","bonus":10,"key":"acrobatics"},{"name":"Lore (arcane)","bonus":4,"key":""},{"name":"Perception","bonus":8,"key":"perception"},{"name":"Unarmed","bonus":15,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":15,"damage":"1d2+5","mode":"melee","type":"blunt"}],"abilities":[{"name":"Burn","description":"A flame sprite’s slam attack deals fire damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target takes an additional 1d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR."},{"name":"Starburst","description":"When reduced to 0 HP or the bottom of the Break Gauge, the flame sprite makes an attack roll (d20+14), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+4 fire damage. Otherwise, targets take half damage. The flame sprite is then destroyed. This is an area effect."}],"spells":[],"performances":[],"equipped":"","loot":"Fire Crystal (20%), Magicite (50%)","steal":"Fire Crystal (5%), Magicite (95%)","sourcePage":326}},"prototypeToken":{"name":"Sprite, Flame","texture":{"src":"icons/svg/mystery-man.svg"},"width":0.5,"height":0.5,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"4eeee09b9904e81b","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d2+5","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a04f06ad50e21c98","name":"Burn","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A flame sprite’s slam attack deals fire damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target takes an additional 1d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"723ee7947b2ab26a","name":"Starburst","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When reduced to 0 HP or the bottom of the Break Gauge, the flame sprite makes an attack roll (d20+14), at no penalty, against the Ref Defence of all adjacent creatures. If successful, targets take 1d6+4 fire damage. Otherwise, targets take half damage. The flame sprite is then destroyed. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6fc3493ab0f76924","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8dded42dc99dc025","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigi