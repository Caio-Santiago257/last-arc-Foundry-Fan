}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a238ae3848a09d0c","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8128b06c0ee809a0","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"938d2ddd978f0c29","name":"Djinn, Thunder","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Pure","biography":"Once sacred spirits of Lynuria, now scorned for their wild and vexing nature."},"attributes":{"str":{"score":20},"vit":{"score":18},"agi":{"score":22},"int":{"score":4},"mnd":{"score":14},"cha":{"score":11}},"skills":{"acrobatics":{"trained":true,"total":16},"lore-terrestrial":{"trained":true,"total":7},"perception":{"trained":true,"total":12},"unarmed":{"trained":true,"total":20}},"defences":{"ref":{"total":27},"fort":{"total":25},"will":{"total":23}},"resources":{"hp":{"value":105,"max":105,"baseMax":105},"mp":{"value":50,"max":50}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":30,"immunities":["Confusion","Curse","Disease","Electric","Mind Effects","Zombify"],"resistances":["Holy"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":10,"level":10,"xp":2000,"size":"medium","species":"Elementals","profileLine":"Pure Neutral Medium Elemental 10; Territorial","classLevels":"","alignment":"Pure","temperament":"Territorial","description":"Once sacred spirits of Lynuria, now scorned for their wild and vexing nature.","languages":"Primordial Once sacred spirits of Lynuria, now scorned for their wild and vexing nature.","speedText":"6 (hover)","initiativeDie":"1d8","senses":"Blindsense; Passive Perception 22","passivePerception":22,"attributes":{"str":20,"agi":22,"vit":18,"int":4,"mnd":14,"cha":11},"defences":{"ref":27,"flatFootedRef":21,"fort":25,"will":23},"damageReduction":10,"breakThreshold":30,"immunities":["Confusion","Curse","Disease","Electric","Mind Effects","Zombify"],"resistances":["Holy"],"weaknesses":[],"skills":[{"name":"Acrobatics","bonus":16,"key":"acrobatics"},{"name":"Lore (terrestrial)","bonus":7,"key":"lore-terrestr