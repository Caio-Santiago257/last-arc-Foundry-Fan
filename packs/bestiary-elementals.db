y"],"resistances":["Slashing"],"weaknesses":["Fire"],"skills":[{"name":"Athletics","bonus":22,"key":"athletics"},{"name":"Lore (arcane)","bonus":12,"key":""},{"name":"Lore (terrestrial)","bonus":12,"key":"lore-terrestrial"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Persuasion","bonus":12,"key":"persuasion"},{"name":"Survival","bonus":12,"key":"survival"},{"name":"Unarmed","bonus":27,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":25,"damage":"1d8+19","mode":"melee","type":"blunt"},{"name":"Slam","attack":25,"damage":"2d8+19","mode":"melee","type":"blunt"}],"abilities":[{"name":"Ice Storm","description":"As an all-out action, an ice titan may make an attack roll (d20+27) against the Ref Defence of all enemies within its reach. If successful, targets suffer 8d6+17 cold damage. Otherwise, creatures take half damage. Additionally, should the attack roll beat both a target's Ref and Fort Defence, the creature loses its secondary action on its turn. The ice titan may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Frostbite","description":"An ice titan’s slam attack deals cold damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the ice titan’s next turn."},{"name":"Immovable","description":"An ice titan cannot be moved by any means of forced movement, including teleportation."},{"name":"Imposing","description":"An ice titan may add its Str modifier to all Persuasion checks made to intimidate."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Ice Crystal (50%), Magicite (95%)","steal":"Stardust (5%), Ice Crystal (95%)","sourcePage":333}},"prototypeToken":{"name":"Titan, Ice","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"8625