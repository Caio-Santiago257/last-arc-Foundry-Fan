{"_id":"f26a5d8c7b571a20","name":"Djinn, Fire","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Pure","biography":"Brief-lived spirits, burning fiercely and fading quickly."},"attributes":{"str":{"score":18},"vit":{"score":17},"agi":{"score":20},"int":{"score":4},"mnd":{"score":14},"cha":{"score":11}},"skills":{"acrobatics":{"trained":true,"total":14},"lore-terrestrial":{"trained":true,"total":6},"perception":{"trained":true,"total":11},"unarmed":{"trained":true,"total":18}},"defences":{"ref":{"total":25},"fort":{"total":23},"will":{"total":22}},"resources":{"hp":{"value":86,"max":86,"baseMax":86},"mp":{"value":45,"max":45}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":28,"immunities":["Confusion","Curse","Disease","Fire","Mind Effects","Zombify"],"resistances":["Holy","Piercing"],"vulnerabilities":["Cold"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":9,"level":9,"xp":1800,"size":"medium","species":"Elementals","profileLine":"Pure Neutral Medium Elemental 9; Territorial","classLevels":"","alignment":"Pure","temperament":"Territorial","description":"Brief-lived spirits, burning fiercely and fading quickly.","languages":"Primordial Brief-lived spirits, burning fiercely and fading quickly.","speedText":"6 (hover)","initiativeDie":"1d8","senses":"Blindsense; Passive Perception 21","passivePerception":21,"attributes":{"str":18,"agi":20,"vit":17,"int":4,"mnd":14,"cha":11},"defences":{"ref":25,"flatFootedRef":20,"fort":23,"will":22},"damageReduction":10,"breakThreshold":28,"immunities":["Confusion","Curse","Disease","Fire","Mind Effects","Zombify"],"resistances":["Holy","Piercing"],"weaknesses":["Cold"],"skills":[{"name":"Acrobatics","bonus":14,"key":"acrobatics"},{"name":"Lore (terrestrial)","bonus":6,"key":"lore-terrestrial"},{"name":"Perception","bonus":11,"key":"perception"},{"name":"Unarmed","bonus":18,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":18,"damage":"1d4+8","mode":"melee","type":"blunt"}],"abilities":[{"name":"Burn","description":"A fire djinn’s slam attack deals fire damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target takes an additional 2d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR."},{"name":"Firebolt","description":"As a primary action, a fire djinn may make an attack (d20+17) against the Ref defence of a target within 6 squares and line of sight. If successful, the target takes 6d6+7 fire damage. Otherwise, the target takes half damage. Additionally, if the attack roll beat the Ref Defence of any creatures adjacent to the target, they take half that damage. The fire djinn may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Fire Crystal (20%), Magicite (50%)","steal":"Fire Crystal (20%), Magicite (95%)","sourcePage":328}},"prototypeToken":{"name":"Djinn, Fire","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"11486023819104ed","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+8","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"66d307a27dc0fb1e","name":"Burn","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A fire djinn’s slam attack deals fire damage. Additionally, if the attack roll beats both the target’s Ref and Fort Def