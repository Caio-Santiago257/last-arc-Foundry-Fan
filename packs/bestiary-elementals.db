{"_id":"365f9da6b8f9a40d","name":"Flan, Static","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Corrupt","biography":"Mischievous slimes that delight in toying with their prey—often with a shocking surprise."},"attributes":{"str":{"score":18},"vit":{"score":17},"agi":{"score":8},"int":{"score":4},"mnd":{"score":11},"cha":{"score":14}},"skills":{"deception":{"trained":true,"total":9},"perception":{"trained":true,"total":7},"survival":{"trained":true,"total":7},"unarmed":{"trained":true,"total":16}},"defences":{"ref":{"total":16},"fort":{"total":19},"will":{"total":16}},"resources":{"hp":{"value":40,"max":40,"baseMax":40},"mp":{"value":15,"max":15}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":24,"immunities":["Electric","Mind Effects","Paralysis","Petrify","Silence","Slow","Stuns"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":4,"level":5,"xp":800,"size":"small","species":"Elementals","profileLine":"Corrupt Neutral Small Elemental 5; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Mischievous slimes that delight in toying with their prey—often with a shocking surprise.","languages":"","speedText":"4","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 17","passivePerception":17,"attributes":{"str":18,"agi":8,"vit":17,"int":4,"mnd":11,"cha":14},"defences":{"ref":16,"flatFootedRef":16,"fort":19,"will":16},"damageReduction":5,"breakThreshold":24,"immunities":["Electric","Mind Effects","Paralysis","Petrify","Silence","Slow","Stuns"],"resistances":[],"weaknesses":[],"skills":[{"name":"Deception","bonus":9,"key":"deception"},{"name":"Perception","bonus":7,"key":"perception"},{"name":"Survival","bonus":7,"key":"survival"},{"name":"Unarmed","bonus":16,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":16,"damage":"1d3+6","mode":"melee","type":"blunt"}],"abilities":[{"name":"Bubble","description":"As a primary action, a static flan can make an attack roll (d20+15) against the Ref Defence of a target within 6 squares and line of sight. If successful, the target becomes drenched. Should the attack roll beat both the target's Ref and Fort Defence, the target is also knocked prone. The static flan may not use this ability again for 1d4+1 turns."},{"name":"Conductive","description":"A static flan’s slam attack deals electric damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target becomes flat- footed until the start of the static flan's next turn."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Storm Crystal (50%), Magicite (95%)","steal":"Stardust (5%), Storm Crystal (20%), Handkercher (95%)","sourcePage":326}},"prototypeToken":{"name":"Flan, Static","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"3e2121a33fb795b4","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d3+6","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"419b752124e85a59","name":"Bubble","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, a static flan can make an attack roll (d20+15) against the Ref Defence of a target within 6 squares and line of sight. If successful, the target becomes drenched. Should the attack roll beat both the target's Ref and Fort Defence, the