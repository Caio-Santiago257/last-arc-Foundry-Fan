{"_id":"5650ee0c0d162dec","name":"Djinn, Earth","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Elementals","alignment":"Pure","biography":"Serene spirits that linger in quiet watch over the ancient ruins of Al-Sabrah."},"attributes":{"str":{"score":24},"vit":{"score":21},"agi":{"score":10},"int":{"score":4},"mnd":{"score":14},"cha":{"score":11}},"skills":{"athletics":{"trained":true,"total":16},"lore-terrestrial":{"trained":true,"total":6},"perception":{"trained":true,"total":11},"unarmed":{"trained":true,"total":21}},"defences":{"ref":{"total":19},"fort":{"total":24},"will":{"total":21}},"resources":{"hp":{"value":93,"max":93,"baseMax":93},"mp":{"value":40,"max":40}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":29,"immunities":["Confusion","Curse","Disease","Electric","Mind Effects","Zombify"],"resistances":["Holy","Piercing","Slashing"],"vulnerabilities":["Blunt"]},"adversary":{"isAdversary":true,"category":"Elementals","profile":"elemental","cr":8,"level":8,"xp":1600,"size":"medium","species":"Elementals","profileLine":"Pure Neutral Medium Elemental 8; Territorial","classLevels":"","alignment":"Pure","temperament":"Territorial","description":"Serene spirits that linger in quiet watch over the ancient ruins of Al-Sabrah.","languages":"Primordial Serene spirits that linger in quiet watch over the ancient ruins of Al-Sabrah.","speedText":"6 (hover)","initiativeDie":"1d8","senses":"Blindsense; Passive Perception 21","passivePerception":21,"attributes":{"str":24,"agi":10,"vit":21,"int":4,"mnd":14,"cha":11},"defences":{"ref":19,"flatFootedRef":19,"fort":24,"will":21},"damageReduction":10,"breakThreshold":29,"immunities":["Confusion","Curse","Disease","Electric","Mind Effects","Zombify"],"resistances":["Holy","Piercing","Slashing"],"weaknesses":["Blunt"],"skills":[{"name":"Athletics","bonus":16,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":6,"key":"lore-terrestrial"},{"name":"Perception","bonus":11,"key":"perception"},{"name":"Unarmed","bonus":21,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":21,"damage":"1d4+11","mode":"melee","type":"blunt"}],"abilities":[{"name":"Tremor","description":"As a primary action, an earth djinn can make an attack (d20+19) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+9 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The earth djinn may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun."},{"name":"Unction","description":"Whenever the earth djinn’s slam attack beats both a target's Ref and Fort Defence, the target becomes oiled."}],"spells":[],"performances":[],"equipped":"","loot":"Earth Crystal (20%), Magicite (50%)","steal":"Earth Crystal (50%), Magicite (95%)","sourcePage":328}},"prototypeToken":{"name":"Djinn, Earth","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"8cb966035fa02ca5","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+11","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a5a0de40f0cc1670","name":"Tremor","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, an earth djinn can make an attack (d20+19) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+9 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The earth djinn may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"117442aeeba7486c","name":"Unction","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the earth djinn’s slam attack beats both a target's Ref and Fort Defence, the target becomes oiled.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a15269feee7b75ce","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9f5147dbb1312fd3","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"670b658ed68a9819","name":"Skill Focus (unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d8cf689b929ce28d","name":"Threshold Up","typ