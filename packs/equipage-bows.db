{"_id":"43c88ec949e982d0","name":"Aevis Striker","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bows","description":"A bow designed to take down flying creatures. Creatures with a natural fly speed are treated as weak against damage from this weapon. This is true even if said creature loses their fly speed due to another effect.","cost":3100,"availability":"Uncommon","bulk":1,"weaponGroup":"bows","weaponSize":"Medium","weaponSkill":"ranged","attack":{"bonus":1},"damage":{"formula":"2d8+1","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A bow designed to take down flying creatures. Creatures with a natural fly speed are treated as weak against damage from this weapon. This is true even if said creature loses their fly speed due to another effect."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"ed56995a456d36d2","name":"Orcish Warbow","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bows","description":"A deadly bow created by orcs to cripple their prey. Creatures moved down the Break Gauge by this weapon cannot start and finish a recovery action within the same turn. This effect persists until the creature reaches the top of the Break Gauge. Requires 15 Str to wield.","cost":4600,"availability":"Rare","bulk":2,"weaponGroup":"bows","weaponSize":"Large","weaponSkill":"ranged","attack":{"bonus":2},"damage":{"formula":"2d10+1","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A deadly bow created by orcs to cripple their prey. Creatures moved down the Break Gauge by this weapon cannot start and finish a recovery action within the same turn. This effect persists until the creature reaches the top of the Break Gauge. Requires 15 Str to wield.","prerequisites":{"str":15}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
