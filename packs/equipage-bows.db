{"_id":"e74488ae9893e8bb","name":"Goblin Bow","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bows","description":"A pitiful excuse of a bow, stringed together by savage goblins. It is extremely weak and cheap but will do in a pinch. When you roll a natural 1 on an attack, this weapon moves -1 step on the Break Gauge.","cost":50,"availability":"Common","bulk":0.1,"weaponGroup":"bows","weaponSize":"Small","weaponSkill":"ranged","attack":{"bonus":0},"damage":{"formula":"2d6-1","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A pitiful excuse of a bow, stringed together by savage goblins. It is extremely weak and cheap but will do in a pinch. When you roll a natural 1 on an attack, this weapon moves -1 step on the Break Gauge."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
