{"_id":"f238aa8535e0027f","name":"Gandiva","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bows","description":"A legendary, indestructible bow said to be lost to time. No source of DR or resistance may reduce Gandiva’s damage to less than half. Additionally, Gandiva cannot be moved down the Break Gauge by any means.","cost":23500,"availability":"Legendary","bulk":2,"weaponGroup":"bows","weaponSize":"Large","weaponSkill":"ranged","attack":{"bonus":5},"damage":{"formula":"2d10+5","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A legendary, indestructible bow said to be lost to time. No source of DR or resistance may reduce Gandiva’s damage to less than half. Additionally, Gandiva cannot be moved down the Break Gauge by any means."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
