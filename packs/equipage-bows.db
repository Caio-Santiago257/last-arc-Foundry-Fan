{"_id":"fe717c4af8cf6352","name":"Siege Bow","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bows","description":"A powerful great bow that packs immense force into each shot. When your attack roll beats both a target’s Ref and Fort Defence, the target is moved 2 squares directly away from you. Additionally, any attempts to negate the attack suffer a -2 penalty. Requires 15 Str to use.","cost":10900,"availability":"Exotic","bulk":2,"weaponGroup":"bows","weaponSize":"Large","weaponSkill":"ranged","attack":{"bonus":3},"damage":{"formula":"2d10+3","type":"Piercing"},"range":"Ranged","capacity":0,"specialRules":"A powerful great bow that packs immense force into each shot. When your attack roll beats both a target’s Ref and Fort Defence, the target is moved 2 squares directly away from you. Additionally, any attempts to negate the attack suffer a -2 penalty. Requires 15 Str to use.","prerequisites":{"str":15}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
