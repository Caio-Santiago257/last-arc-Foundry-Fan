{"_id":"683fe7ae81abe80e","name":"Daemon Staff","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Blizzard.webp","system":{"category":"Staves","description":"A cursed staff that amplifies dark damage and harms its wielder when it does.","cost":23500,"availability":"Epic","bulk":2,"weaponGroup":"staves","weaponSize":"Large","weaponSkill":"spellcraft","attack":{"bonus":4},"damage":{"formula":"3d8+3","type":"Dark"},"range":"Ranged","capacity":0,"specialRules":"This accursed staff grants great power to those willing to pay its price. When you deal dark damage with this weapon or a black magick spell, reroll all results of 1, until the result of a 2 or higher is achieved."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
