{"_id":"2d831bf874e76e44","name":"Dryad","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Pure","biography":"Said to be fallen druids, they defend the Faewood even in death."},"attributes":{"str":{"score":10},"vit":{"score":13},"agi":{"score":19},"int":{"score":14},"mnd":{"score":15},"cha":{"score":16}},"skills":{"acrobatics":{"trained":true,"total":12},"lore-mystic":{"trained":true,"total":10},"lore-terrestrial":{"trained":true,"total":10},"perception":{"trained":true,"total":10},"persuasion":{"trained":true,"total":11},"stealth":{"trained":true,"total":12},"survival":{"trained":true,"total":10},"unarmed":{"trained":true,"total":13}},"defences":{"ref":{"total":19},"fort":{"total":20},"will":{"total":22}},"resources":{"hp":{"value":36,"max":36,"baseMax":36},"mp":{"value":30,"max":30}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":20,"immunities":["Mind Effects","Paralysis","Poison","Sleep"],"resistances":["Cold","Electric"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":6,"level":6,"xp":1200,"size":"medium","species":"Fae","profileLine":"Pure Neutral Medium Fae 6; Territorial","classLevels":"","alignment":"Pure","temperament":"Territorial","description":"Said to be fallen druids, they defend the Faewood even in death.","languages":"Sylvan Said to be fallen druids, they defend the Faewood even in death.","speedText":"6, Climb 4","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 20","passivePerception":20,"attributes":{"str":10,"agi":19,"vit":13,"int":14,"mnd":15,"cha":16},"defences":{"ref":19,"flatFootedRef":16,"fort":20,"will":22},"damageReduction":5,"breakThreshold":20,"immunities":["Mind Effects","Paralysis","Poison","Sleep"],"resistances":["Cold","Electric"],"weaknesses":["Fire"],"skills":[{"name":"Acrobatics","bonus":12,"key":"acrobatics"},{"name":"Lore (mystic)","bonus":10,"key":"lore-mystic"},{"name":"Lore (terrestrial)","bonus":10,"key":"lore-terrestrial"},{"name":"Perception","bonus":10,"key":"perception"},{"name":"Persuasion","bonus":11,"key":"persuasion"},{"name":"Stealth","bonus":12,"key":"stealth"},{"name":"Survival","bonus":10,"key":"survival"},{"name":"Unarmed","bonus":13,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":13,"damage":"1d4+3","mode":"melee","type":"slashing"}],"abilities":[{"name":"Swarmstrike","description":"As a primary action, the dryad can make an attack (d20+14) against the Ref Defence of all enemies in a 4 square cone. If successful, creatures suffer 4d6+4 points of piercing damage and there is a 50% chance (50 or less on d%) the creatures are poisoned by widow’s kiss. Otherwise, creatures suffer half damage and are not poisoned. The dryad may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Tree Meld","description":"When in jungles or forests, dryads may take 20 on Stealth checks and may hide in plain sight."}],"spells":["Entangle","Overgrowth","Repose"],"performances":[],"equipped":"","loot":"Moondust (5%), Fae Wood (50%), Earth Crystal (95%)","steal":"Faerie Wand (5%), Pistoja Powder (20%), Golden Sap (50%)","sourcePage":335}},"prototypeToken":{"name":"Dryad","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"df9d630d257ba519","name":"Claws","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+3","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2081ddc48f504b94","name":"Swarmstrike","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, the dryad can make an attack (d20+14) against the Ref Defence of all enemies in a 4 square cone. If successful, creatures suffer 4d6+4 points of piercing damage and there is a 50% chance (50 or less on d%) the creatures are poisoned by widow’s kiss. Otherwise, creatures suffer half damage and are not poisoned. The dryad may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f775a97aeddc81e0","name":"Tree Meld","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When in jungles or forests, dryads may take 20 on Stealth checks and may hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"04ebe55bc87fb412","name":"Arcane Study","type":"technick","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d5f13309a28c5eb0","name":"Skill Focus (spellcraft, unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"spellcraft, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7b4