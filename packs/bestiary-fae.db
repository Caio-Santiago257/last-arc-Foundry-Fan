{"_id":"e0307fdd40b1aaf2","name":"Nymph","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":2,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Corrupt","biography":"Once benevolent faeries, now marked by a menacing, eerie glow."},"attributes":{"str":{"score":5},"vit":{"score":11},"agi":{"score":19},"int":{"score":14},"mnd":{"score":14},"cha":{"score":10}},"skills":{"acrobatics":{"trained":true,"total":10},"deception":{"trained":true,"total":6},"lore-occult":{"trained":true,"total":8},"lore-terrestrial":{"trained":true,"total":8},"perception":{"trained":true,"total":8},"stealth":{"trained":true,"total":20},"survival":{"trained":true,"total":8},"unarmed":{"trained":true,"total":3}},"defences":{"ref":{"total":18},"fort":{"total":12},"will":{"total":14}},"resources":{"hp":{"value":10,"max":10,"baseMax":10},"mp":{"value":10,"max":10}},"combat":{"initiativeDie":"1d8","speed":2,"baseSpeed":2,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":12,"immunities":[],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":2,"level":2,"xp":400,"size":"tiny","species":"Fae","profileLine":"Corrupt Evil Tiny Fae 2; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Once benevolent faeries, now marked by a menacing, eerie glow.","languages":"Elven, Sylvan Once benevolent faeries, now marked by a menacing, eerie glow.","speedText":"2, Fly 12 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 18","passivePerception":18,"attributes":{"str":5,"agi":19,"vit":11,"int":14,"mnd":14,"cha":10},"defences":{"ref":18,"flatFootedRef":14,"fort":12,"will":14},"damageReduction":0,"breakThreshold":12,"immunities":[],"resistances":[],"weaknesses":[],"skills":[{"name":"Acrobatics","bonus":10,"key":"acrobatics"},{"name":"Deception","bonus":6,"key":"deception"},{"name":"Lore (occult)","bonus":8,"key":"lore-occult"},{"name":"Lore (terrestrial)",