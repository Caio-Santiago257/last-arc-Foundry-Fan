ck spell, it suffers no effect and instead gains an amount of temporary MP equal to the cost of the spell used. If this temporary MP is not used by the end of the encounter, it is lost.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"402d613d850d676c","name":"Syphon Mana","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, nymphs can make a Spellcraft check against the Will Defence of a target within 12 squares and line of sight. If successful, the target loses 1d6 MP and the nymph gains an equal amount of MP . This die may explode. The nymph may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"afd1116b21f576b0","name":"Arcane Study","type":"technick","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8a79382475ae8ada","name":"Darkness","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":6,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Magickal shadow blinds a creature.","specialRules":"Targets of a higher level gain +5 to the relevant defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"blinded","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9a75681cc07f889a","name":"Infest","type":"spell","img":"icons/magic/unholy/hand-claw-fog-green.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Infects a foe with spreading dark energy.","specialRules":"Successful defence checks take half damage. Target takes half the initial damage at the start of its next turn and one quarter at the start of the following turn; adjacent creatures whose Fort Defence is beaten take half damage and then one quarter on their next turn. Later ticks bypass damage reduction.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a9602caed9e78145","name":"Wind Slash","type":"spell","img":"icons/magic/air/air-wave-gust-blue.webp","system":{"school":"Green Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A blade of wind damages and slows its target.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"791371f952486335","name":"Mandragora","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":4,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Pure","biography":"Small, plant-like fae that emit ear-piercing shrieks before fleeing when spooked."},"attributes":{"str":{"score":11},"vit":{"score":13},"agi":{"score":18},"int":{"score":8},"mnd":{"score":13},"cha":{"score":9}},"skills":{"athletics":{"trained":true,"total":7},"lore-mystic":{"trained":true,"total":6},"perception":{"trained":true,"total":8},"stealth":{"trained":true,"total":16},"survival":{"trained":true,"total":8},"unarmed":{"trained":true,"total":16}},"defences":{"ref":{"total":19},"fort":{"total":15},"will":{"total":15}},"resources":{"hp":{"value":24,"max":24,"baseMax":24},"mp":{"value":16,"max":16}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":15,"immunities":["Confusion","Paralysis","Sleep"],"resistances":["Holy"],"vulnerabilities":["Dark","Fire"]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":4,"level":4,"xp":800,"size":"small","species":"Fae","profileLine":"Pure Neutral Small Fae 4; Timid","classLevels":"","alignment":"Pure","temperament":"Timid","description":"Small, plant-like fae that emit ear-piercing shrieks before fleeing when spooked.","languages":"Sylvan Small, plant-like fae that emit ear-piercing shrieks before fleeing when spooked.","speedText":"6","initiativeDie":"1d8","senses":"; Passive Perception 18","passivePerception":18,"attributes":{"str":11,"agi":18,"vit":13,"int":8,"mnd":13,"cha":9},"defences":{"ref":19,"flatFootedRef":15,"fort":15,"will":15},"damageReduction":5,"breakThreshold":15,"immunities":["Confusion","Paralysis","Sleep"],"resistances":["Holy"],"weaknesses":["Dark","Fire"],"skills":[{"name":"Athletics","bonus":7,"key":"athletics"},{"name":"Lore (mystic)","bonus":6,"key":"lore-mystic"},{"name":"Perception","bonus":8,"key":"perception"},{"na