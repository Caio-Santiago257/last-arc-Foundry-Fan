a","type":"spell","img":"icons/magic/symbols/rune-sigil-horned-blue.webp","system":{"school":"Blue Magick","mpCost":6,"action":"Secondary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Slows a target, or dispels Haste.","specialRules":"Higher-level targets gain +5 to Fort Defence. If the target is hasted, end Haste instead.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"slowed","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ad72ac82f66d0061","name":"Muddle","type":"spell","img":"icons/magic/symbols/rune-sigil-horned-blue.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Confuses a foe and disrupts its ability to distinguish friend from enemy.","specialRules":"Higher-level targets gain +5 to Will Defence. Mind effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"confused","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d1e73e1167d33e79","name":"Repose","type":"spell","img":"icons/magic/symbols/rune-sigil-horned-blue.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Puts a foe to sleep.","specialRules":"Higher-level targets gain +5 to Will Defence. Mind effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"sleeping","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":