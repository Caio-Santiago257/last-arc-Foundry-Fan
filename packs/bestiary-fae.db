{"_id":"cc856fbce1550bc7","name":"Sylph","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Pure","biography":"Higher fae who guard and guide the Faewood with unseen grace."},"attributes":{"str":{"score":10},"vit":{"score":18},"agi":{"score":21},"int":{"score":16},"mnd":{"score":25},"cha":{"score":17}},"skills":{"acrobatics":{"trained":true,"total":14},"lore-mystic":{"trained":true,"total":12},"lore-terrestrial":{"trained":true,"total":12},"medicine":{"trained":true,"total":16},"perception":{"trained":true,"total":16},"persuasion":{"trained":true,"total":12},"stealth":{"trained":true,"total":19},"survival":{"trained":true,"total":16},"unarmed":{"trained":true,"total":14}},"defences":{"ref":{"total":24},"fort":{"total":22},"will":{"total":25}},"resources":{"hp":{"value":72,"max":72,"baseMax":72},"mp":{"value":80,"max":80}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":22,"immunities":["Disease"],"resistances":["Holy"],"vulnerabilities":["Dark","Fire"]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":8,"level":8,"xp":0,"size":"small","species":"Fae","profileLine":"Pure Neutral Small Fae 8; Helpful/TerritorialXP 1,600 Language Sylvan Higher fae who guard and guide the Faewood with unseen grace. HP 72 MP 80 Init d8 Speed 4, Fly 8 (hover) Senses Dark Vision; Passive Perception 26 Defence Ref 24 (flat-footed 19), Fort 22, Will 25 DR 10; Threshold 22 Immunity Disease Resistance Holy Weakness Dark, Fire Offence Melee Slam +14 (1d3+4) Space 1 square; Reach 1 square Spells (spellcraft +21) Charm, Regen, Whirlwind, Wind Slash Statistics Attributes Str 10, Agi 21, Vit 18, Int 16, Mnd 25, Chr 17 Technicks Arcane Study, Channel, Skill Focus (Spellcraft, Unarmed) Skills Acrobatics +14, Lore (mystic) +12, Lore (terrestrial) +12, Medicine +16, Perception +16, Persuasion +12, Spellcraft +21, Stealth +19, Survival +16, Unarmed +14 Abilities Absorb Magick : When a sylph is affected by a non-black magick spell, it suffers no effect and instead gains an amount of temporary MP equal to the cost of the spell used. If this temporary MP is not used by the end of the encounter, it is lost. Kaleidoscope: When casting a single target spell that targets Will Defence, a sylph may choose to target all enemies within a 6 square cone, rather than the normal range. Items Loot Moondust (5%), Hi-potion (20%), Fae Wood (50%), Golden Sap (95%) Steal Moondust (5%), Hi-ether (20%) 335 Chapter 16: Bestiary v.03 10/27/2026","classLevels":"","alignment":"Pure","temperament":"","description":"Higher fae who guard and guide the Faewood with unseen grace.","languages":"Sylvan Higher fae who guard and guide the Faewood with unseen grace.","speedText":"4, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 26","passivePerception":26,"attributes":{"str":10,"agi":21,"vit":18,"int":16,"mnd":25,"cha":17},"defences":{"ref":24,"flatFootedRef":19,"fort":22,"will":25},"damageReduction":10,"breakThreshold":22,"immunities":["Disease"],"resistances":["Holy"],"weaknesses":["Dark","Fire"],"skills":[{"name":"Acrobatics","bonus":14,"key":"acrobatics"},{"name":"Lore (mystic)","bonus":12,"key":"lore-mystic"},{"name":"Lore (terrestrial)","bonus":12,"key":"lore-terrestrial"},{"name":"Medicine","bonus":16,"key":"medicine"},{"name":"Perception","bonus":16,"key":"perception"},{"name":"Persuasion","bonus":12,"key":"persuasion"},{"name":"Stealth","bonus":19,"key":"stealth"},{"name":"Survival","bonus":16,"key":"survival"},{"name":"Unarmed","bonus":14,"key":"unarmed"}],"attacks":[{"name":"Slam","attack":14,"damage":"1d3+4","mode":"melee","type":"blunt"}],"abilities":[{"name":"Absorb Magick","description":"When a sylph is affected by a non-black magick spell, it suffers no effect and instead gains an amount of temporary MP equal to the cost of the spell used. If this temporary MP is not used by the end of the encounter, it is lost."},{"name":"Kaleidoscope","description":"When casting a single target spell that targets Will Defence, a sylph may choose to target all enemies within a 6 square cone, rather than the normal range."}],"spells":["Charm","Regen","Whirlwind","Wind Slash"],"performances":[],"equipped":"","loot":"Moondust (5%), Hi-potion (20%), Fae Wood (50%), Golden Sap (95%)","steal":"Moondust (5%), Hi-ether (20%)","sourcePage":336}},"prototypeToken":{"name":"Sylph","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"bb080e6fd75e75a1","name":"Slam","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d3+4","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b927bc9f2cd88fbd","name":"Absorb Magick","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When a sylph is affected by a non-black magick spell, it suffers no effect and instead gains an amount of temporary MP equal to the cost of the spell used. If this temporary MP is not used by the end of the encounter, it is lost.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b9e521fb7b7f29f0","name":"Kaleidoscope","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When casting a single target spell that targets Will Defence, a sylph may choose to target all enemies within a 6 square cone, rather than the normal range.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"afe65ba662197266","name":"Arcane Study","type":"technick","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1fe81b57ec884936","name":"Channel","type":"technick","img":"icons/magic/life/heart-cross-green.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"285537f35455cdb5","name":"Skill Focus (Spellcraft, Unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-horned-white-purple.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"spellcraft, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"34c9011e07f7b6d7","name":"Charm","type":"spell","img":"icons/magic/symbols/rune-sigil-horned-blue.webp","system":{"school":"Blue Magick","mpCost":34,"action":"All-out Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Turns a foe into a temporary ally.","specialRules":"The target treats your allies as its own and your enemies as hostile. The effect ends if it is attacked, damaged, or moved down the Break Gauge by you or an ally. Mind effect; summoned creatures are immune; may be dispelled. Higher-level targets gain +5 to Will Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":2}]},{"dc":25,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":3}]},{"dc":30,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":4}]},{"dc":35,"effects":[{"type":"condition","status":"charmed","defence":"will","durationRounds":5}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d79f76cd7e78d86b","name":"Regen","type":"spell","img":"icons/magic/life/heart-cross-green.webp","system":{"school":"White Magick","mpCost":16,"action":"Primary Action","target":"You or one living creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Restores HP immediately and continues healing over two turns.","specialRules":"Target also heals half of the initial amount at the start of its next turn and one quarter at the start of the following turn.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"heal","formula":"5+@level"}]},{"dc":25,"effects":[{"type":"heal","formula":"10+@level"}]},{"dc":30,"effects":[{"type":"heal","formula":"15+@level"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c96046018761bbd3","name":"Whirlwind","type":"spell","img":"icons/magic/air/air-wave-gust-blue.webp","system":{"school":"Green Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A powerful wind suspends and batters a target.","specialRules":"On a successful Fortitude check, deal 4d6 slashing at the start of each affected turn; speed 0 and -5 attack/skill checks. Duration 2/3/4/5 turns. Target falls prone at expiry; damage from another source ends the effect. Dispellable stun.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]},{"dc":35,"effects":[{"type":"condition","status":"movementZero","requiresDefences":["fort"],"durationRounds":0},{"type":"condition","status":"attackSkillPenalty","requiresDefences":["fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"47bd8211781bcbbb","name":"Wind Slash","type":"spell","img":"icons/magic/air/air-wave-gust-blue.webp","system":{"school":"Green Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A blade of wind damages and slows its target.","specialRules":"","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"slashing","defence":"ref","halfOnFailure":false},{"type":"condition","status":"speedPenalty2","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c5192d526609bf52","name":"Owlbear","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Neutral","biography":"Fierce fae beasts, fiercely protective and aggressive. Their enchanted feathers repel all magick."},"attributes":{"str":{"score":25},"vit":{"score":21},"agi":{"score":13},"int":{"score":2},"mnd":{"score":12},"cha":{"score":10}},"skills":{"perception":{"trained":true,"total":16},"survival":{"trained":true,"total":11},"unarmed":{"trained":true,"total":22}},"defences":{"ref":{"total":21},"fort":{"total":26},"will":{"total":22}},"resources":{"hp":{"value":115,"max":115,"baseMax":115},"mp":{"value":40,"max":40}},"combat":{"initiativeDie":"1d6","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":31,"immunities":["Curses","Stuns"],"resistances":["Slashing"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":10,"level":10,"xp":2000,"size":"large","species":"Fae","profileLine":"Neutral Large Fae 10; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"Fierce fae beasts, fiercely protective and aggressive. Their enchanted feathers repel all magick.","languages":"","speedText":"6","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 26","passivePerception":26,"attributes":{"str":25,"agi":13,"vit":21,"int":2,"mnd":12,"cha":10},"defences":{"ref":21,"flatFootedRef":21,"fort":26,"will":22},"damageReduction":10,"breakThreshold":31,"immunities":["Curses","Stuns"],"resistances":["Slashing"],"weaknesses":[],"skills":[{"name":"Perception","bonus":16,"key":"perception"},{"name":"Survival","bonus":11,"key":"survival"},{"name":"Unarmed","bonus":22,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":22,"damage":"1d8+12","mode":"melee","type":"piercing"},{"name":"Claws","attack":22,"damage":"1d6+12","mode":"melee","type":"slashing"}],"abilities":[{"name":"Gust","description":"As a primary action, an owlbear may make an attack roll (d20+20) against the Fort Defence of all targets within a 6 square cone. If successful, targets take 6d6+10 slashing damage and are moved 2 squares directly away from the owlbear. Otherwise, targets take half damage and are not moved. Creatures that are 2 or more size categories larger than the owlbear ignore the forced movement, even upon success. The owlbear may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Magick Resistance","description":"The owlbear gains a +5 bonus to all defences against spells."}],"spells":[],"performances":[],"equipped":"","loot":"Elfwort (20%), Great Feather (50%), Earth Crystal (95%)","steal":"Golden Sap (5%), Great Feather (20%), Earth Crystal (95%) * Against spells.","sourcePage":337}},"prototypeToken":{"name":"Owlbear","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"ed66f0fd0bd82bf8","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+12","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a9dede7766b4b16d","name":"Claws","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+12","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4dba24c506865c0a","name":"Gust","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, an owlbear may make an attack roll (d20+20) against the Fort Defence of all targets within a 6 square cone. If successful, targets take 6d6+10 slashing damage and are moved 2 squares directly away from the owlbear. Otherwise, targets take half damage and are not moved. Creatures that are 2 or more size categories larger than the owlbear ignore the forced movement, even upon success. The owlbear may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"013573fc91c557e9","name":"Magick Resistance","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The owlbear gains a +5 bonus to all defences against spells.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"26cbcd5e7b508fd9","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d7ea665cc16bbb97","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d84d482e8bec0521","name":"Improved Initiative","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b19f0b9329213930","name":"Skill Focus (perception, unarmed)","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9b2527b94b9bfe61","name":"Treant","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Fae","alignment":"Pure","biography":"In their final days, some druids enter a deep trance, allowing the Faewood to consume their bodies. What emerges is one of nature’s mightiest protectors."},"attributes":{"str":{"score":29},"vit":{"score":21},"agi":{"score":8},"int":{"score":12},"mnd":{"score":16},"cha":{"score":13}},"skills":{"athletics":{"trained":true,"total":19},"lore-mystic":{"trained":true,"total":11},"lore-terrestrial":{"trained":true,"total":11},"perception":{"trained":true,"total":13},"ranged":{"trained":true,"total":24},"survival":{"trained":true,"total":13},"unarmed":{"trained":true,"total":24}},"defences":{"ref":{"total":19},"fort":{"total":27},"will":{"total":25}},"resources":{"hp":{"value":126,"max":126,"baseMax":126},"mp":{"value":66,"max":66}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":42,"immunities":["Blind","Confusion","Disease","Fear Effects","Petrify","Sleep","Toad","Zombify"],"resistances":[],"vulnerabilities":["Slashing"]},"adversary":{"isAdversary":true,"category":"Fae","profile":"fae","cr":11,"level":11,"xp":2200,"size":"huge","species":"Fae","profileLine":"Pure Neutral Huge Fae 11; Defensive*/Territorial**","classLevels":"","alignment":"Pure","temperament":"Defensive*/Territorial**","description":"In their final days, some druids enter a deep trance, allowing the Faewood to consume their bodies. What emerges is one of nature’s mightiest protectors.","languages":"Elven, Sylvan In their final days, some druids enter a deep trance, allowing the Faewood to consume their bodies. What emerges is one of nature’s mightiest protectors.","speedText":"6","initiativeDie":"1d8","senses":"Tremorsense; Passive Perception 22","passivePerception":22,"attributes":{"str":29,"agi":8,"vit":21,"int":12,"mnd":16,"cha":13},"defences":{"ref":19,"flatFootedRef":19,"fort":27,"will":25},"damageReduction":10,"breakThreshold":42,"immunities":["Blind","Confusion","Disease","Fear Effects","Petrify","Sleep","Toad","Zombify"],"resistances":[],"weaknesses":["Slashing"],"skills":[{"name":"Athletics","bonus":19,"key":"athletics"},{"name":"Lore (mystic)","bonus":11,"key":"lore-mystic"},{"name":"Lore (terrestrial)","bonus":11,"key":"lore-terrestrial"},{"name":"Perception","bonus":13,"key":"perception"},{"name":"Ranged","bonus":24,"key":"ranged"},{"name":"Survival","bonus":13,"key":"survival"},{"name":"Unarmed","bonus":24,"key":"unarmed"}],"attacks":[{"name":"Lob","attack":24,"damage":"1d8+14","mode":"ranged","type":"blunt"}],"abilities":[{"name":"Immovable*","description":"The treant cannot be moved by any means of forced movement, including teleportation."},{"name":"Lurk*","description":"Treants blend into the canopy of trees around them. When in jungles or forests, treants treat Stealth as a trained skill and ignore any size penalties to Stealth checks."},{"name":"Lob","description":"Treants may make a slam attack as if using a thrown weapon. Additionally, they may use their Str modifier in place of their Agi modifier when doing so."},{"name":"Regrow","description":"When a treant loses a limb, they are able to grow it back in 1d10+1 days, at which point any penalties are removed."},{"name":"Root","description":"As a secondary action, a treant may root itself into the ground. While rooted, the treant’s movement speed is reduced to 0. Alternatively, if rooted, the treant may uproot itself as a secondary action, regaining its movement speed. The treant may not activate this ability again on the following turn."},{"name":"Wild Charge**","description":"As an all-out action, the treant may charge, doubling the damage it deals until the charge is resolved. While charging this way, the treant is treated as having the Trample technick and is treated as both mount and rider while charging. The treant may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Mega-Ether (5%), Ammonia Salt (20%), Fae Wood (50%), Magicite (95%)","steal":"Remedy (5%), Mandrake Root (25%), Earth Crystal (50%) * Only while rooted. ** Only while uprooted. † Includes 3 points of mighty strikes.","sourcePage":338}},"prototypeToken":{"name":"Treant","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"3b2097659c0ff626","name":"Lob","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"1d8+14","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7509d8b7dc41b9bb","name":"Immovable*","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The treant cannot be moved by any means of forced movement, including teleportation.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4cb0e3fe45c8fad6","name":"Lurk*","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Treants blend into the canopy of trees around them. When in jungles or forests, treants treat Stealth as a trained skill and ignore any size penalties to Stealth checks.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2c98294a41d24f02","name":"Lob","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Treants may make a slam attack as if using a thrown weapon. Additionally, they may use their Str modifier in place of their Agi modifier when doing so.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cd1e374117854f61","name":"Regrow","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When a treant loses a limb, they are able to grow it back in 1d10+1 days, at which point any penalties are removed.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d38288efabb6f674","name":"Root","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a secondary action, a treant may root itself into the ground. While rooted, the treant’s movement speed is reduced to 0. Alternatively, if rooted, the treant may uproot itself as a secondary action, regaining its movement speed. The treant may not activate this ability again on the following turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"68d6ffe1bb874d65","name":"Wild Charge**","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As an all-out action, the treant may charge, doubling the damage it deals until the charge is resolved. While charging this way, the treant is treated as having the Trample technick and is treated as both mount and rider while charging. The treant may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"baf1783aec2e716a","name":"Defence Up","type":"technick","img":"icons/magic/defensive/shield-barrier-blue.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"aa1ad2989a61def4","name":"HP Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5d96d69f82c2cdfc","name":"Mighty Strikes","type":"technick","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d3350a761baa5e80","name":"Skill Focus (ranged, unarmed)","type":"technick","img":"icons/svg/target.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"ranged, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"da8cf9d6c40b3c0a","name":"Threshold Up","type":"technick","img":"icons/magic/symbols/rune-sigil-rough-white-teal.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
