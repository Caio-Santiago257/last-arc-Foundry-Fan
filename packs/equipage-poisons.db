{"_id":"473b04d798b1c579","name":"Basilisk Venom","type":"equipment","img":"icons/svg/item-bag.svg","system":{"category":"Poisons","description":"Target loses one Break step and moves at half speed.","cost":500,"availability":"Rare","bulk":0.1,"poisonType":"Injury","attackFormula":"d20+15","effect":"Target loses one Break step and moves at half speed.","consumable":true,"specialRules":"Should the poison’s attack roll (d20+15) beat a target’s Fort Defence, the target moves -1 persistent step on the Break Gauge and their speed is reduced by 1/2 until the start of their next turn. If the target is 4 or more steps down the Break Gauge, they become petrified. Requires a DC 20 Medicine check to remove."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
