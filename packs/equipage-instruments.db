{"_id":"d8f6b746c541b18f","name":"Satyr’s Aulos","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":8500,"availability":"Uncommon","bulk":1,"performanceBonus":2,"requiresTwoHands":true,"specialRules":"A strange instrument with 2 horns, used by beastkin to beguile their victims. Enemies suffer a –2 penalty to their Will Defence against your bardic performances."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"df8ccd7c942eb23e","name":"Bloodstring Lyre","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":10900,"availability":"Epic","bulk":1,"performanceBonus":3,"requiresTwoHands":true,"specialRules":"Each haunting note from this instrument siphons life to weave melodies of sorrow and despair. You can make Perform Instrument checks while silenced. Additionally, you heal 1 HP for each creature affected by your bardic performance. This healing does not damage you while zombified."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"3d9c726086588523","name":"Meister’s Rebec","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":13600,"availability":"Rare","bulk":1,"performanceBonus":3,"requiresTwoHands":true,"specialRules":"These gilded instruments are reserved for true masters of the musical arts. You can make Perform Instrument checks while silenced. Additionally, while performing defensively, you only suffer a -2 penalty to Perform Instrument checks, rather than the normal -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
