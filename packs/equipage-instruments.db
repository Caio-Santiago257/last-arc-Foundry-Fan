{"_id":"65aa58eb4b6cf0cf","name":"Torban of Truth","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":19900,"availability":"Exotic","bulk":1,"performanceBonus":4,"requiresTwoHands":true,"specialRules":"The strings of this instrument never fall out of tune. You can make Perform Instrument checks while silenced. Additionally, you may reroll natural 1’s on Perform Instrument checks until a natural 2 or higher is achieved."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"acf4957c73aaee49","name":"Gjallarhorn","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":23500,"availability":"Legendary","bulk":1,"performanceBonus":5,"requiresTwoHands":true,"specialRules":"The thundrous call of this legendary horn heralds victory. Allies affected by your bardic performance are no longer flat-footed if they have yet to act in combat. Additionally, during surprise attacks, affected allies may take a single action, or all of their actions if they act before every enemy. Lastly, enemies in range of your bardic peformances, whose Will Defence was beaten, cannot target you while you’re within 4 squares of a conscious ally. This effect lasts until the start of your next turn."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
