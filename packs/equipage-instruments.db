{"_id":"45d35303a9306bfe","name":"Piper’s Cornette","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":1900,"availability":"Uncommon","bulk":1,"performanceBonus":1,"requiresTwoHands":true,"specialRules":"A sheperd’s instrument, used to stave off beasts. Beasts in range of your bardic performances, whose Will Defence was beaten, cannot target you while you’re within 4 squares of a conscious ally. This effect lasts until the start of your next turn."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9ba9007d6309e3ee","name":"Silver Harp","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":3100,"availability":"Uncommon","bulk":1,"performanceBonus":1,"requiresTwoHands":true,"specialRules":"An instrument used to pacify the spirits of the dead. You can make Perform Instrument checks while silenced. Additionally, undead in range of your bardic performances, whose Will Defence was beaten, cannot target you while you’re within 4 squares of a conscious ally. This effect lasts until the start of your next turn."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7323487cc8035079","name":"Hurdy-Gurdy","type":"equipment","img":"icons/svg/book.svg","system":{"category":"Bardic Instruments","description":"Instrument for Perform Instrument checks; requires two hands.","cost":4600,"availability":"Common","bulk":1,"performanceBonus":1,"requiresTwoHands":true,"specialRules":"This hand-cranked instrument easily maintains a constant tune. You can make Perform Instrument checks while silenced. Additionally, as a secondary action, you may take 10 on the next Perform Instrument check you make within the same turn."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
