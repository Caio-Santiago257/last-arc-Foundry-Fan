{"_id":"743d15ec38142580","name":"Jack-O’-Lantern","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":4,"xp":0,"nextLevel":0,"className":"","race":"Constructs","alignment":"Neutral","biography":"Created to ward off evil spirits, their mischievous antics can make them as troublesome as any monster."},"attributes":{"str":{"score":12},"vit":{"score":14},"agi":{"score":17},"int":{"score":7},"mnd":{"score":14},"cha":{"score":7}},"skills":{"acrobatics":{"trained":true,"total":10},"athletics":{"trained":true,"total":8},"perception":{"trained":true,"total":9},"stealth":{"trained":true,"total":15},"unarmed":{"trained":true,"total":15}},"defences":{"ref":{"total":18},"fort":{"total":16},"will":{"total":16}},"resources":{"hp":{"value":28,"max":28,"baseMax":28},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":16,"immunities":["Blind","Confusion","Fear Effects","Sleep"],"resistances":["Fire"],"vulnerabilities":["Cold"]},"adversary":{"isAdversary":true,"category":"Constructs","profile":"construct","cr":4,"level":4,"xp":800,"size":"small","species":"Constructs","profileLine":"Neutral Good Small Construct 4; Helpful/Defensive","classLevels":"","alignment":"Neutral","temperament":"Helpful/Defensive","description":"Created to ward off evil spirits, their mischievous antics can make them as troublesome as any monster.","languages":"","speedText":"4","initiativeDie":"1d8","senses":"","passivePerception":19,"attributes":{"str":12,"agi":17,"vit":14,"int":7,"mnd":14,"cha":7},"defences":{"ref":18,"flatFootedRef":15,"fort":16,"will":16},"damageReduction":5,"breakThreshold":16,"immunities":["Blind","Confusion","Fear Effects","Sleep"],"resistances":["Fire"],"weaknesses":["Cold"],"skills":[{"name":"Acrobatics","bonus":10,"key":"acrobatics"},{"name":"Athletics","bonus":8,"key":"athletics"},{"name":"Perception","bonus":9,"key":"perception"},{"name":"Stealth","bonus":15,"key":"stealth"},{"name":"Unarmed","bonus":15,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":15,"damage":"1d4+3","mode":"melee","type":"piercing"}],"abilities":[{"name":"Explode","description":"When a jack-o’-lantern is reduced to 0 Hp or the bottom of the Break Gauge, it is not destroyed, but may not take any actions. However, at the start of its next turn, the jack-o’-lantern makes an attack roll (d20+15), at no penalty, against the Ref Defence of all creatures within 4 squares. If successful, creatures suffer 4d6+5 fire damage. Otherwise, creatures take half damage. The jack-o’-lantern is then destroyed. This is an area effect."},{"name":"Firebolt","description":"As a primary action, a jack-o’-lantern may make an attack (d20+15) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target suffers 4d6+5 fire damage. Otherwise, the target takes half damage. Additionally, if the attack roll beat the Ref Defence of any creatures adjacent to the target, they take half that damage. The jack-o’-lantern may not use this ability again for 1d4+1 turns."},{"name":"Imitate","description":"A jack-o’-lantern may take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Unction","description":"Whenever the jack-o’-lantern’s bite attack beats both a target's Ref and Fort Defence, the target becomes oiled."}],"spells":[],"performances":[],"equipped":"","loot":"Health Potion (5%), Mythril (20%), Silk Thread (50%)","steal":"Antidote (5%), 1gp (20%), Earth Crystal (95%)","sourcePage":313}},"prototypeToken":{"name":"Jack-O’-Lantern","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"e92952d4864ab4f1","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+3","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ddda3211898d30a3","name":"Explode","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When a jack-o’-lantern is reduced to 0 Hp or the bottom of the Break Gauge, it is not destroyed, but may not take any actions. However, at the start of its next turn, the jack-o’-lantern makes an attack roll (d20+15), at no penalty, against the Ref Defence of all creatures within 4 squares. If successful, creatures suffer 4d6+5 fire damage. Otherwise, creatures take half damage. The jack-o’-lantern is then destroyed. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"accb16ce6f4def96","name":"Firebolt","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a primary action, a jack-o’-lantern may make an attack (d20+15) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target suffers 4d6+5 fire damage. Otherwise, the target takes half damage. Additionally, if the attack roll beat the Ref Defence of any creatures adjacent to the target, they take half that damage. The jack-o’-lantern may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c7965f533630ea4a","name":"Imitate","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A jack-o’-lantern may take 20 on Stealth checks when remaining still and can hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ad72cf50c8d3c037","name":"Unction","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever the jack-o’-lantern’s bite attack beats both a target's Ref and Fort Defence, the target becomes oiled.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2639fe0f0635d694","name":"Agile Manoeuvres","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Use Agility instead of Strength for Unarmed checks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9c209902f10f83d1","name":"Skill Focus (unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"e83a8fb9e7405320","name":"Bag O’ Tricks","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Constructs","alignment":"Neutral","biography":"“Never look a gift bag in the mouth”—for if it has one, you’re already in grave danger."},"attributes":{"str":{"score":15},"vit":{"score":12},"agi":{"score":13},"int":{"score":6},"mnd":{"score":14},"cha":{"score":13}},"skills":{"deception":{"trained":true,"total":8},"perception":{"trained":true,"total":9},"stealth":{"trained":true,"total":18},"unarmed":{"trained":true,"total":14}},"defences":{"ref":{"total":19},"fort":{"total":17},"will":{"total":18}},"resources":{"hp":{"value":30,"max":30,"baseMax":30},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":2,"baseSpeed":2,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":17,"immunities":["Fear Effects","Petrify","Sleep"],"resistances":[],"vulnerabilities":["Slashing"]},"adversary":{"isAdversary":true,"category":"Constructs","profile":"construct","cr":5,"level":5,"xp":1000,"size":"tiny","species":"Constructs","profileLine":"Neutral Evil Tiny Construct 5; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"“Never look a gift bag in the mouth”—for if it has one, you’re already in grave danger.","languages":"","speedText":"2","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 19","passivePerception":19,"attributes":{"str":15,"agi":13,"vit":12,"int":6,"mnd":14,"cha":13},"defences":{"ref":19,"flatFootedRef":18,"fort":17,"will":18},"damageReduction":5,"breakThreshold":17,"immunities":["Fear Effects","Petrify","Sleep"],"resistances":[],"weaknesses":["Slashing"],"skills":[{"name":"Deception","bonus":8,"key":"deception"},{"name":"Lore (social)","bonus":5,"key":""},{"name":"Perception","bonus":9,"key":"perception"},{"name":"Stealth","bonus":18,"key":"stealth"},{"name":"Unarmed","bonus":14,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":14,"damage":"1d3+4","mode":"melee","type":"piercing"}],"abilities":[{"name":"Imitate","description":"A Bag o’ Tricks may take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Lockjaw","description":"Whenever a bag o’ tricks successfully hits a creature with its bite attack, the bag o’ tricks may attach itself to the creature if they are larger than the bag o’ tricks. While doing so, the bag o’ tricks shares the creature’s space and there is a 50% chance (50 or less on d%) that any attack, spell, or ability that targets the bag o’ tricks hits the affected creature instead. The bag o’tricks may end this effect as a free action."}],"spells":[],"performances":[],"equipped":"","loot":"Health Potion (20%), Silk Thread (50%)","steal":"Antidote (5%), 1gp (20%), Earth Crystal (95%)","sourcePage":314}},"prototypeToken":{"name":"Bag O’ Tricks","texture":{"src":"icons/svg/mystery-man.svg"},"width":0.5,"height":0.5,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"eb80ae9701df6bb1","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d3+4","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"66879c37b3edb099","name":"Imitate","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A Bag o’ Tricks may take 20 on Stealth checks when remaining still and can hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"25da4be6ab411d35","name":"Lockjaw","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a bag o’ tricks successfully hits a creature with its bite attack, the bag o’ tricks may attach itself to the creature if they are larger than the bag o’ tricks. While doing so, the bag o’ tricks shares the creature’s space and there is a 50% chance (50 or less on d%) that any attack, spell, or ability that targets the bag o’ tricks hits the affected creature instead. The bag o’tricks may end this effect as a free action.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ee58d9b21f474006","name":"Defence Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8b44b551b357885a","name":"Improved Initiative","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"88fcfc0650ea19d5","name":"Skill Focus (unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"ce0b238b24893814","name":"Phantom Armour","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Constructs","alignment":"Neutral","biography":"Once enchanted sentries for mages, they fell out of use as common folk, fearing necromancy, often hunted them down."},"attributes":{"str":{"score":18},"vit":{"score":19},"agi":{"score":15},"int":{"score":5},"mnd":{"score":17},"cha":{"score":11}},"skills":{"perception":{"trained":true,"total":11},"stealth":{"trained":true,"total":10},"unarmed":{"trained":true,"total":12}},"defences":{"ref":{"total":21},"fort":{"total":20},"will":{"total":19}},"resources":{"hp":{"value":54,"max":54,"baseMax":54},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":20,"immunities":["Petrify","Poison","Stuns","Toad","Zombify"],"resistances":["Piercing","Slashing"],"vulnerabilities":["Fire Block Heater Shield +17"]},"adversary":{"isAdversary":true,"category":"Constructs","profile":"construct","cr":6,"level":6,"xp":1200,"size":"medium","species":"Constructs","profileLine":"Neutral Medium Construct 6; Defensive","classLevels":"","alignment":"Neutral","temperament":"Defensive","description":"Once enchanted sentries for mages, they fell out of use as common folk, fearing necromancy, often hunted them down.","languages":"","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 21","passivePerception":21,"attributes":{"str":18,"agi":15,"vit":19,"int":5,"mnd":17,"cha":11},"defences":{"ref":21,"flatFootedRef":19,"fort":20,"will":19},"damageReduction":5,"breakThreshold":20,"immunities":["Petrify","Poison","Stuns","Toad","Zombify"],"resistances":["Piercing","Slashing"],"weaknesses":["Fire Block Heater Shield +17"],"skills":[{"name":"Handed","bonus":17,"key":""},{"name":"Perception","bonus":11,"key":"perception"},{"name":"Stealth","bonus":10,"key":"stealth"},{"name":"Unarmed","bonus":12,"key":"unarmed"}],"attacks":[{"name":"Mythril Blade","attack":18,"damage":"2d6+9","mode":"melee","type":"slashing"}],"abilities":[{"name":"Imitate","description":"A phantom armour may take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Armoured Form","description":"The phantom armour is treated as proficient in any armour it wears. Additionally, the phantom armour is never treated as encumbered by heavy armour."}],"spells":[],"performances":[],"equipped":"","loot":"Mythril Blade (5%), Iron Cuirass (20%), Heater Shield (50%)","steal":"Moondust (5%), Mythril (20%), Ectoplasm (50%)","sourcePage":314}},"prototypeToken":{"name":"Phantom Armour","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"ad7101aa4c509f7a","name":"Mythril Blade","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d6+9","type":"slashing"},"attack":{"bonus":18},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c6d173ee3fe26cb7","name":"Imitate","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A phantom armour may take 20 on Stealth checks when remaining still and can hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9ecba7bf1ffe6207","name":"Armoured Form","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The phantom armour is treated as proficient in any armour it wears. Additionally, the phantom armour is never treated as encumbered by heavy armour.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"349752dbc2ebcbad","name":"Skill Focus (1-handed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2c9fc52d8d9f140a","name":"Shield Proficiency","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0fb0b80b3eb89897","name":"Weapon Proficiency (swords)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7e1fd86b87e42257","name":"Mimic","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":7,"xp":0,"nextLevel":0,"className":"","race":"Constructs","alignment":"Neutral","biography":"Thieves and treasure hunters beware—a hungry mimic waits to turn you into an early retirement."},"attributes":{"str":{"score":19},"vit":{"score":17},"agi":{"score":12},"int":{"score":6},"mnd":{"score":13},"cha":{"score":10}},"skills":{"deception":{"trained":true,"total":8},"perception":{"trained":true,"total":14},"stealth":{"trained":true,"total":9},"unarmed":{"trained":true,"total":17}},"defences":{"ref":{"total":18},"fort":{"total":20},"will":{"total":18}},"resources":{"hp":{"value":56,"max":56,"baseMax":56},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":2,"baseSpeed":2,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":20,"immunities":["Fear Effects","Sleep","Stuns","Petrify"],"resistances":["Blunt*","Piercing*","Slashing*"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Constructs","profile":"construct","cr":7,"level":7,"xp":1400,"size":"medium","species":"Constructs","profileLine":"Neutral Evil Medium Construct 7; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"Thieves and treasure hunters beware—a hungry mimic waits to turn you into an early retirement.","languages":"","speedText":"2","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 24","passivePerception":24,"attributes":{"str":19,"agi":12,"vit":17,"int":6,"mnd":13,"cha":10},"defences":{"ref":18,"flatFootedRef":17,"fort":20,"will":18},"damageReduction":5,"breakThreshold":20,"immunities":["Fear Effects","Sleep","Stuns","Petrify"],"resistances":["Blunt*","Piercing*","Slashing*"],"weaknesses":[],"skills":[{"name":"Deception","bonus":8,"key":"deception"},{"name":"Lore (social)","bonus":6,"key":""},{"name":"Perception","bonus":14,"key":"perception"},{"name":"Stealth","bonus":9,"key":"stealth"},{"name":"Unarmed","bonus":17,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":17,"damage":"1d6+7","mode":"melee","type":"piercing"}],"abilities":[{"name":"Gnaw","description":"Whenever a mimic pins a target, it may make a free bite attack that ignores non-magickal DR."},{"name":"Imitate","description":"A mimic may take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Mighty Guard","description":"As a secondary action, the mimic can close the lid on its chest-like body for 1d4+1 turns. While closed, the mimic clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the mimic would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the mimic may not use this ability again for 1d4+1 turns."},{"name":"Tongue","description":"The mimic may attempt to grab a creature within 6 squares and line of sight. If successful, the target is immediately moved adjacent to the mimic."},{"name":"Voracious","description":"When a mimic’s bite attack beats both a target’s Ref and Will Defence, the target loses all positive effects and buffs provided by spells and the mimic gains them. This effect is resolved before damage is rolled."}],"spells":[],"performances":[],"equipped":"","loot":"Hi-Ether (5%), Hi-potion (20%), Ether (50%), Magicite (95%)","steal":"Antidote (25%), Hi-potion (95%)","sourcePage":315}},"prototypeToken":{"name":"Mimic","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"528d7fa7a46dddc1","name":"Bite","type":"weapon","img":"icons/skills/melee/strike-sword-steel-yellow.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+7","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7f3fa79d52ab8fd4","name":"Gnaw","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"Whenever a mimic pins a target, it may make a free bite attack that ignores non-magickal DR.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"526a637c04bd32f1","name":"Imitate","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"A mimic may take 20 on Stealth checks when remaining still and can hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5ae6f5440854e6bc","name":"Mighty Guard","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"As a secondary action, the mimic can close the lid on its chest-like body for 1d4+1 turns. While closed, the mimic clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the mimic would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the mimic may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fd9f261c01275a5c","name":"Tongue","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"The mimic may attempt to grab a creature within 6 squares and line of sight. If successful, the target is immediately moved adjacent to the mimic.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fc47607bcff580b2","name":"Voracious","type":"feature","img":"icons/svg/aura.svg","system":{"category":"Special Ability","description":"When a mimic’s bite attack beats both a target’s Ref and Will Defence, the target loses all positive effects and buffs provided by spells and the mimic gains them. This effect is resolved before damage is rolled.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ce67fd8b6e2ac73b","name":"Improved Initiative","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bfe9d65805986083","name":"Pin","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f0f5d09329a960df","name":"Skill Focus (perception, unarmed)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"10e12a68748e1d7e","name":"Greedy Grimoire","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"","race":"Constructs","alignment":"Neutral","biography":"Born from the mad scrawlings of a wizard, this ravenous creature devours all things magical."},"attributes":{"str":{"score":12},"vit":{"score":15},"agi":{"score":18},"int":{"score":12},"mnd":{"score":22},"cha":{"score":8}},"skills":{"acrobatics":{"trained":true,"total":13},"athletics":{"trained":true,"total":10},"deception":{"trained":true,"total":8},"perception":{"trained":true,"total":15},"stealth":{"trained":true,"total":23},"survival":{"trained":true,"total":15},"unarmed":{"trained":true,"total":18}},"defences":{"ref":{"total":25},"fort":{"total":21},"will":{"total":25}},"resources":{"hp":{"value":63,"max":63,"baseMax":63},"mp":{"value":81,"max":81}},"combat":{"initiativeDie":"1d6","speed":2,"baseSpeed":2,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":21,"immunities":["Blind","Death Effects","Disease","Fear Effects","Paralysis","Poison","Silence","Sleep"],"resistances":[],"vulnerabilities":["Slashing"]},"adversary":{"isAdversary":true,"category":"Constructs","profile":"construct","cr":9,"level":9,"xp":1800,"size":"tiny","species":"Constructs","profileLine":"Neutral Evil Tiny Construct 9; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"Born from the mad scrawlings of a wizard, this ravenous creature devours all things magical.","languages":"","speedText":"2 (hover)","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 25","passivePerception":25,"attributes":{"str":12,"agi":18,"vit":15,"int":12,"mnd":22,"cha":8},"defences":{"ref":25,"flatFootedRef":21,"fort":21,"will":25},"damageReduction":10,"breakThreshold":21,"immunities":["Blind","Death Effects","Disease","Fear Effects","Paralysis","Poison","Silence","Sleep"],"resistances":[],"weaknesses":["Slashing"],"skills":[{"name":"Acrobatics","bonus":13,"key":"acrobatics"},{"name":"Athletics","bonus":10,"key":"athletics"},{"name":"Deception","bonus":8,"key":"deception"},{"name":"Perception","bonus":15,"key":"perception"},{"name":"Stealth","bonus":23,"key":"stealth"},{"name":"Survival","bonus":15,"key":"survival"},{"name":"Unarmed","bonus":18,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":18,"damage":"1d3+5","mode":"melee","type":"piercing"}],"abilities":[{"name":"Absorb Magick","description":"When a greedy grimoire is affected by a non-blue magick spell, it suffers no effect and instead regains an amount of temporary MP equal to the cost of the spell used. If this temporary MP is not used by the end of the encounter, it is lost."},{"name":"Imitate","description":"A greedy grimoire may take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Magickal","description":"Greedy Grimiores gain an amount of MP equal to 3+Mnd each level, and always treat Spellcraft as a class skill."},{"name":"Spell Thief","description":"Any spell cast within 12 squares and line of sight of the greedy grimoire is then treated as a known spell by the greedy grimoire until the end of the encounter."},{"name":"Syphon Mana","description":"As a primary action, the greedy grimoire can make a Spellcraft check (d20+20) against the Will Defence of a single creature within 12 squares and line of sight. If successful, the target loses 3d6 MP and the greedy grimoire gains an equal amount of MP . These dice may explode. The greedy grimoire may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Evil Eye (20%), Hi-Ether (50%), Magicite (95%)","steal":"Hi-Ether (50%)","sourcePage":316}},"prototypeToken":{"name":"Greedy Grimoire","texture":{"src":"icons/svg/mystery-man.svg"},"width":0.5,"height":0.5,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id"