{"_id":"712ffb3de856ec61","name":"Multi-Spell","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"High Arcana","className":"Archmage","description":"When using this High Arcana, target a number of additional creatures equal to your Mind modifier (minimum 1). It applies only to spells targeting one creature; area spells may not overlap. Using a High Arcana doubles the spell's MP cost; only one High Arcana may be used on a spell. Apply any MP cost reductions after doubling.","automation":{"highArcana":"multiSpell"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
