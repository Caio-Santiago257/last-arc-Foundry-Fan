{"_id":"24e3041fb4fb2aa6","name":"Adamant Spell","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"High Arcana","className":"Archmage","description":"When using this High Arcana, ignore Break Gauge penalties to the Spellcraft check. Using a High Arcana doubles the spell's MP cost; only one High Arcana may be used on a spell. Apply any MP cost reductions after doubling.","automation":{"highArcana":"adamantSpell"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
