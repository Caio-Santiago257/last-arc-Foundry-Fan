{"_id":"757944a43a4a1663","name":"Soul Rend","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Summon_Eos.webp","system":{"category":"Last Resort","tree":"Necromant","action":"All-out Action","target":"See description","damageByLevel":{"10":"8d6","15":"10d6","base":"8d6"},"damageType":"unaspected","automation":"damage","description":"One living creature within 12 squares and line of sight takes unaspected damage and moves down one Break Gauge step. If killed, summon a wraith without MP cost. At level 15 deal 10d6, move it down 2 steps, and summon a reaper instead.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9c1896e486dd4eb7","name":"Spirit Bond","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/Tab%20Icons/actions_&_traits.webp","system":{"category":"Last Resort","tree":"Tamer","action":"All-out Action","target":"See description","damageByLevel":{},"damageType":"","automation":"summon-or-buff","description":"Summon an incorporeal version of your most recently owned pet for the encounter; it retains its traits, skills, and abilities. Cannot be used while your companion is present.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"375a753a931bbd22","name":"Triangulate","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Last Resort","tree":"Hunter","action":"All-out Action","target":"You and allies within 12 squares may reroll attack and skill checks against enemies, keeping the higher result, until the end of your next turn","damageByLevel":{},"damageType":"","automation":"effect","description":"You and allies within 12 squares may reroll attack and skill checks against enemies, keeping the higher result, until the end of your next turn.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"546931c2c0b66604","name":"Ultimate Guard","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Sheltron.webp","system":{"category":"Last Resort","tree":"Defender","action":"All-out Action","target":"See description","damageByLevel":{},"damageType":"","automation":"effect","description":"Until the start of your next turn, gain DR and +10 to shield block checks. DR bonus is +5, +10 at level 10, and +15 at level 15.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"64813f8557d204fc","name":"Vandal Heart","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Last Resort","tree":"Saboteur","action":"All-out Action","target":"Enemies within 6 squares have DR 0 until the end of the encounter","damageByLevel":{},"damageType":"","automation":"effect","description":"Enemies within 6 squares have DR 0 until the end of the encounter.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"aa09a63475e95851","name":"Wildfire","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Last Resort","tree":"Skirmisher","action":"All-out Action","target":"enemies within 6 squares; affected targets take half that damage again at the start of your next turn","damageByLevel":{"10":"8d6","15":"10d6","base":"8d6"},"damageType":"fire","automation":"damage","description":"Move up to 12 squares without provoking counterattacks. At any point during movement, deal fire damage to enemies within 6 squares; affected targets take half that damage again at the start of your next turn.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"f7207b88d10888a9","name":"Wildheart","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"category":"Last Resort","tree":"Shapeshifter","action":"Minor Action","target":"See description","damageByLevel":{},"damageType":"","automation":"summon-or-buff","description":"As a minor action, take beast form until the encounter ends: +5 to all defences, attacks, and skill checks, and +2 damage dice to all attacks and abilities. Reverting ends this effect.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"33912fea559182eb","name":"Wild Hunt","type":"last-resort","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Summon_Eos.webp","system":{"category":"Last Resort","tree":"Beastcaller","action":"All-out Action","target":"See description","damageByLevel":{},"damageType":"","automation":"mp-drain","description":"Summon 3 beasts of one type in an unoccupied area within 4 squares and line of sight without MP. Their level cannot exceed your companion level. They remain until the start of your next turn; summon 5 at level 15.","uses":{"perDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
