{"_id":"db578febf0b06c9e","name":"Imp","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":3,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Neutral","biography":"Cowardly daemons that feed on others’ magical essence."},"attributes":{"str":{"score":10},"vit":{"score":10},"agi":{"score":17},"int":{"score":14},"mnd":{"score":14},"cha":{"score":12}},"skills":{"acrobatics":{"trained":true,"total":9},"deception":{"trained":true,"total":7},"disable":{"trained":true,"total":9},"lore-occult":{"trained":true,"total":8},"perception":{"trained":true,"total":8},"stealth":{"trained":true,"total":9},"unarmed":{"trained":true,"total":6}},"defences":{"ref":{"total":17},"fort":{"total":13},"will":{"total":15}},"resources":{"hp":{"value":15,"max":15,"baseMax":15},"mp":{"value":15,"max":15}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":13,"immunities":["Confusion","Dark","Fire","Poison","Sleep"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":3,"level":3,"xp":600,"size":"small","species":"Infernals","profileLine":"Neutral Evil Small Infernal 3; Aggressive*/Timid","classLevels":"","alignment":"Neutral","temperament":"Aggressive*/Timid","description":"Cowardly daemons that feed on others’ magical essence.","languages":"Common, Infernal Cowardly daemons that feed on others’ magical essence.","speedText":"4, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 18","passivePerception":18,"attributes":{"str":10,"agi":17,"vit":10,"int":14,"mnd":14,"cha":12},"defences":{"ref":17,"flatFootedRef":14,"fort":13,"will":15},"damageReduction":0,"breakThreshold":13,"immunities":["Confusion","Dark","Fire","Poison","Sleep"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":9,"key":"acrobatics"},{"name":"Deception","bonus":7,"key":"deception"},{"name":"Disable","bonus":9,"key":"disable"},{"name":"Lore (arcane)","bonus":8,"key":""},{"name":"Lore (occult)","bonus":8,"key":"lore-occult"},{"name":"Perception","bonus":8,"key":"perception"},{"name":"Stealth","bonus":9,"key":"stealth"},{"name":"Unarmed","bonus":6,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":6,"damage":"1d4+1","mode":"melee","type":"piercing"}],"abilities":[{"name":"Syphon Mana","description":"As a primary action, imps can make a Spellcraft check against the Will defence of a target within 12 squares and line of sight. If successful, the target loses 1d6 MP and the imp gains an equal amount of MP . This die may explode. The imp may not use this ability again for 1d4+1 turns."}],"spells":["Dispel","Ember","Invisibility"],"performances":[],"equipped":"","loot":"Stardust (5%), Daemon Horn (20%), Ether (50%), Fire Crystal (95%)","steal":"130gp (20%), Ether (50%) * Only when in the presence of other creatures.","sourcePage":344}},"prototypeToken":{"name":"Imp","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"a36dce8947890d7a","name":"Bite","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+1","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a36df35e3860da2d","name":"Syphon Mana","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, imps can make a Spellcraft check against the Will defence of a target within 12 squares and line of sight. If successful, the target loses 1d6 MP and the imp gains an equal amount of MP . This die may explode. The imp may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ab0377b81ba2801a","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bd3145ab1de03fec","name":"Skill Focus (spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"518afa78e2a9c3eb","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9d42910c2d0d0cbe","name":"Ember","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire.webp","system":{"school":"Red Magick","mpCost":6,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A small fire bolt strikes one creature and may splash nearby foes.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half of the primary damage only if the check beats their Reflex Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"damage","formula":"2d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":20,"effects":[{"type":"damage","formula":"3d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"5d6","damageType":"fire","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"78226aab8b2b1a83","name":"Invisibility","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Hide.webp","system":{"school":"Blue Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Conceals a creature for the encounter.","specialRules":"Actions other than movement, sneaking, or carefully interacting with unattended objects end the effect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"invisible","durationRounds":0}]},{"dc":25,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":2,"label":"Invisibility Stealth"}]},{"dc":30,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":5,"label":"Invisibility Stealth"}]},{"dc":35,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":10,"label":"Invisibility Stealth"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"cfa233eb7af3be60","name":"Hellhound","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":4,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Pure","biography":"Relentless abyssal hunters, known to feast on the flesh of the dead."},"attributes":{"str":{"score":13},"vit":{"score":15},"agi":{"score":13},"int":{"score":6},"mnd":{"score":10},"cha":{"score":6}},"skills":{"acrobatics":{"trained":true,"total":8},"perception":{"trained":true,"total":7},"stealth":{"trained":true,"total":8},"survival":{"trained":true,"total":7},"unarmed":{"trained":true,"total":13}},"defences":{"ref":{"total":15},"fort":{"total":16},"will":{"total":14}},"resources":{"hp":{"value":28,"max":28,"baseMax":28},"mp":{"value":12,"max":12}},"combat":{"initiativeDie":"1d6","speed":10,"baseSpeed":10,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":16,"immunities":["Dark","Fire"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":4,"level":4,"xp":800,"size":"medium","species":"Infernals","profileLine":"Pure Evil Medium Infernal 4; Aggressive","classLevels":"","alignment":"Pure","temperament":"Aggressive","description":"Relentless abyssal hunters, known to feast on the flesh of the dead.","languages":"","speedText":"10","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 17","passivePerception":17,"attributes":{"str":13,"agi":13,"vit":15,"int":6,"mnd":10,"cha":6},"defences":{"ref":15,"flatFootedRef":14,"fort":16,"will":14},"damageReduction":5,"breakThreshold":16,"immunities":["Dark","Fire"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":8,"key":"acrobatics"},{"name":"Perception","bonus":7,"key":"perception"},{"name":"Stealth","bonus":8,"key":"stealth"},{"name":"Survival","bonus":7,"key":"survival"},{"name":"Unarmed","bonus":13,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":13,"damage":"1d6+3","mode":"melee","type":"piercing"}],"abilities":[{"name":"Abyssal Breath","description":"As a primary action, a hellhound can make an attack (d20+14) against the Ref Defence of all creatures within a 6 square cone. If successful, targets take 4d6+4 fire damage. Otherwise, targets take half damage. The damage is instead treated as dark against any creature immune, resistant, or weak to dark damage. The hellhound may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Abyssal Fang","description":"The hellhound's bite attack deals dark damage to targets either immune, resistant, or weak to dark damage."}],"spells":[],"performances":[],"equipped":"","loot":"Obsidian (20%), Magicite (20%), Daemon Flesh (50%)","steal":"Remedy (5%), Obsidian (50%), Philter (95%) Infernals From fallen angels to the corrupted souls of mortals, these daemonic creatures are the sworn enemies of the celestials, seeking the destruction of all that is holy. Infernals progress as beasts. However, they gain an amount of MP equal to 3 + Mnd (minimum 1), at each level and always treat Spellcraft as a class skill. Additionally, when reduced to 0 HP or moved to the bottom of the Break Gauge, infernals are destroyed, leaving no corpse behind.","sourcePage":344}},"prototypeToken":{"name":"Hellhound","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"7df52f76781e3716","name":"Bite","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+3","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"70ec05e99eff511e","name":"Abyssal Breath","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, a hellhound can make an attack (d20+14) against the Ref Defence of all creatures within a 6 square cone. If successful, targets take 4d6+4 fire damage. Otherwise, targets take half damage. The damage is instead treated as dark against any creature immune, resistant, or weak to dark damage. The hellhound may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"80310d95f679d6d9","name":"Abyssal Fang","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"category":"Special Ability","description":"The hellhound's bite attack deals dark damage to targets either immune, resistant, or weak to dark damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2f8c1019d608574e","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d54609c6cdbee92c","name":"Skill Focus (unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":