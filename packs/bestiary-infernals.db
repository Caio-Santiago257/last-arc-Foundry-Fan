nted stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"face9cca500c7989","name":"Hell Sabre","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"3d6+16","type":"blunt"},"attack":{"bonus":24},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"141de6dea46d2092","name":"Onresen","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"The erinys gains a +2 bonus to attack rolls, excluding blocks, for each erinys within 4 squares of the target (max +10).","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"033f4e2b6f0fbaa5","name":"Swoop","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"category":"Special Ability","description":"Whenever an erinys uses the Running Attack technick, it deals +1 die of damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9478928a68bc13f5","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ca6663a7c375a95a","name":"Rapid Strike","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"description":"For a melee attack, take -2 to hit to deal one extra damage die. Does not stack with Power Attack and cannot be used while charging. If Agility is below 13, the attack penalty is -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"da3a03b8c6bfc7e8","name":"Running Attack","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"description":"Use a primary action to attack at any point during your secondary action.","prerequisites":{"attributes":{"agi":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"65bc9102e77f4d10","name":"Skill Focus (unarmed, 1-handed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed, 1-handed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9b4e1c1d31f6b5a0","name":"Shield Proficiency","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Shield_Bash.webp","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6fb6e4581dbc1371","name":"Weapon Proficiency (swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"02692046dc8463b7","name":"Behemoth","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":16,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Corrupt","biography":"Avatars of wrath and ruin, these gluttonous hulks crush and devour all, leaving only carnage behind."},"attributes":{"str":{"score":40},"vit":{"score":37},"agi":{"score":13},"int":{"score":6},"mnd":{"score":22},"cha":{"score":10}},"skills":{"athletics":{"trained":true,"total":28},"lore-occult":{"trained":true,"total":11},"perception":{"trained":true,"total":19},"persuasion":{"trained":true,"total":13},"unarmed":{"trained":true,"total":33}},"defences":{"ref":{"total":26},"fort":{"total":40},"will":{"total":33}},"resources":{"hp":{"value":309,"max":309,"baseMax":309},"mp":{"value":144,"max":144}},"combat":{"initiativeDie":"1d8","speed":10,"baseSpeed":10,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":55,"immunities":["Dark","Fire","Paralysis","Petrify","Poison","Toad"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":16,"level":16,"xp":3200,"size":"huge","species":"Infernals","profileLine":"Corrupt Evil Huge Infernal 16; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Avatars of wrath and ruin, these gluttonous hulks crush and devour all, leaving only carnage behind.","languages":"","speedText":"10","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 29","passivePerception":29,"attributes":{"str":40,"agi":13,"vit":37,"int":6,"mnd":22,"cha":10},"defences":{"ref":26,"flatFootedRef":25,"fort":40,"will":33},"damageReduction":15,"breakThreshold":55,"immunities":["Dark","Fire","Paralysis","Petrify","Poison","Toad"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Athletics","bonus":28,"key":"athletics"},{"name":"Lore (occult)","bonus":11,"key":"lore-occult"},{"name":"Perception","bonus":19,"key":"perception"},{"name":"Persuasion","bonus":13,"key":"persuasion"},{"name":"Unarmed","bonus":33,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":31,"damage":"2d6+25","mode":"melee","type":"piercing"},{"name":"Claws","attack":31,"damage":"1d8+25","mode":"melee","type":"slashing"},{"name":"Gore","attack":35,"damage":"2d6+33","mode":"melee","type":"piercing"}],"abilities":[{"name":"Devour","description":"Whenever a behemoth reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The behemoth then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the behemoth may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Hellfire Breath","description":"As a primary action, the behemoth can make an attack roll (d20+31) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 10d6+21 fire damage. Otherwise, creatures take half damage. The damage is instead treated as dark against any creature immune, resistant, or weak to dark damage. The behemoth may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Overrun","description":"The behemoth is treated as having the Trample technick and is treated as both mount and rider while charging."},{"name":"Overthrow","description":"Whenever a behemoth successfully deals damage to a target at the end of a charge with its gore, they may choose to move the target 3 squares away from them in any direction. This is a stun."},{"name":"Tail Slam","description":"Whenever the behemoth uses a primary action to attack while flanked, it may make a free slam attack (d20+31) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+25 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Daemon Heart (20%), Daemon Tail (50%), Daemon Horn (95%)","steal":"Stardust (20%), Daemon Flesh (50%) * Includes 2 points of mighty strikes.","sourcePage":349}},"prototypeToken":{"name":"Behemoth","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"98ce6adf83e6795a","name":"Bite","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+25","type":"piercing"},"attack":{"bonus":-2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3889a2c2e578091a","name":"Claws","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+25","type":"slashing"},"attack":{"bonus":-2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c2c44ebf6191a4b1","name":"Gore","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+33","type":"piercing"},"attack":{"bonus":2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e9313bd4f50a91ad","name":"Devour","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"category":"Special Ability","description":"Whenever a behemoth reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The behemoth then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the behemoth may perform a coup de grace on an unconscious creature, devouring the creature.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"07b72a02d9ef9de0","name":"Hellfire Breath","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, the behemoth can make an attack roll (d20+31) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 10d6+21 fire damage. Otherwise, creatures take half damage. The damage is instead treated as dark against any creature immune, resistant, or weak to dark damage. The behemoth may not use this ability again for 1d4+1 turns. This is an area effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"018f7ea62741367c","name":"Overrun","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"category":"Special Ability","description":"The behemoth is treated as having the Trample technick and is treated as both mount and rider while charging.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f101e8d64980b187","name":"Overthrow","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"category":"Special Ability","description":"Whenever a behemoth successfully deals damage to a target at the end of a charge with its gore, they may choose to move the target 3 squares away from them in any direction. This is a stun.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2bad18e23033c3a0","name":"Tail Slam","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"Whenever the behemoth uses a primary action to attack while flanked, it may make a free slam attack (d20+31) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d8+25 damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d5c89181a4d57826","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3202096c276d2cc5","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"76819d4a2167b24c","name":"Improved Charge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"You may charge without moving in a straight line.","prerequisites":{"attributes":{"agi":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fe4b324d30ce5aa8","name":"Mighty Strikes","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d6adc5225a02785f","name":"Powerful Charge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"Gain +2 on attacks made while charging and deal additional damage equal to half your character level.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4c89e5ba2a35d12e","name":"Shake it Off","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Shake_It_Off.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"474209426f11e3c8","name":"Skill Focus (unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d0de141727d1723f","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"a8eeb86922e6b0f0","name":"Pit Fiend","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":18,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Corrupt","biography":"Fearsome infernal lieutenants commanding abyssal armies, driving dark minions with ruthless authority."},"attributes":{"str":{"score":37},"vit":{"score":36},"agi":{"score":29},"int":{"score":24},"mnd":{"score":30},"cha":{"score":26}},"skills":{"acrobatics":{"trained":true,"total":23},"alchemy":{"trained":true,"total":21},"athletics":{"trained":true,"total":27},"deception":{"trained":true,"total":22},"lore-mystic":{"trained":true,"total":21},"lore-occult":{"trained":true,"total":21},"perception":{"trained":true,"total":24},"persuasion":{"trained":true,"total":22},"stealth":{"trained":true,"total":18},"unarmed":{"trained":true,"total":27}},"defences":{"ref":{"total":37},"fort":{"total":42},"will":{"total":39}},"resources":{"hp":{"value":347,"max":347,"baseMax":347},"mp":{"value":234,"max":234}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":52,"immunities":["Confusion","Curse","Dark","Death Effects","Disease","Fear","Fire","Blind","Sleep","Toad"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":18,"level":18,"xp":3600,"size":"large","species":"Infernals","profileLine":"Corrupt Evil Large Infernal 18; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Fearsome infernal lieutenants commanding abyssal armies, driving dark minions with ruthless authority.","languages":"Celestial, Common, Draconic, Dwarven, Elven, Orcish, Infernal Fearsome infernal lieutenants commanding abyssal armies, driving dark minions with ruthless authority.","speedText":"6, Fly 8 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 34","passivePerception":34,"attributes":{"str":37,"agi":29,"vit":36,"int":24,"mnd":30,"cha":26},"defences":{"ref":37,"flatFootedRef":28,"fort":42,"will":39},"damageReduction":15,"breakThreshold":52,"immunities":["Confusion","Curse","Dark","Death Effects","Disease","Fear","Fire","Blind","Sleep","Toad"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"handed","bonus":32,"key":""},{"name":"Acrobatics","bonus":23,"key":"acrobatics"},{"name":"Alchemy","bonus":21,"key":"alchemy"},{"name":"Athletics","bonus":27,"key":"athletics"},{"name":"Deception","bonus":22,"key":"deception"},{"name":"Lore (arcane)","bonus":21,"key":""},{"name":"Lore (mystic)","bonus":21,"key":"lore-mystic"},{"name":"Lore (occult)","bonus":21,"key":"lore-occult"},{"name":"Lore (social)","bonus":21,"key":""},{"name":"Perception","bonus":24,"key":"perception"},{"name":"Persuasion","bonus":22,"key":"persuasion"},{"name":"Stealth","bonus":18,"key":"stealth"},{"name":"Unarmed","bonus":27,"key":"unarmed"}],"attacks":[{"name":"Double Edge","attack":35,"damage":"2d12+24","mode":"melee","type":"blunt"}],"abilities":[{"name":"Accursed","description":"Pit Fiends ignore the cursed effects of cursed items they wield."},{"name":"Ensorcelled Weapon","description":"Pit Fiends may add the the attack bonus from their melee weapon to any Spellcraft checks."},{"name":"Hellfire","description":"Fire damage dealt by the pit fiend is treated as dark against enemies immune, resistant, or weak to dark damage."},{"name":"Leech","description":"As a primary action, the pit fiend can make a Spellcraft check (d20+32) against the Fort Defence of a living creature within 12 squares and line of sight. If successful, the target suffers 6d6+19 dark damage, and the pit fiend is healed an amount of HP equal to the damage dealt to the target. The pit fiend may not use this ability again for 1d4+1 turns."},{"name":"Malediction","description":"A pit fiend may double the MP cost of any black or red magick spell to either double the range of the spell, double the area, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap)."},{"name":"Tyrant","description":"As a reaction, the pit fiend can force an ally within line of sight to reroll an attack roll, keeping the higher result. That creature then moves -1 step on the Break Gauge."}],"spells":["Banish","Dispel","Fear","Fireball","Firestorm","Invisibility","Maim","Teleport"],"performances":[],"equipped":"","loot":"Double Edge (5%), Daemon Heart (20%), Daemon Horn (50%), Daemon Flesh (95%)","steal":"Stardust (5%), Daemon Flesh (20%), Elfwort (95%)","sourcePage":350}},"prototypeToken":{"name":"Pit Fiend","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"d5d32441a9669e44","name":"Double Edge","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d12+24","type":"blunt"},"attack":{"bonus":35},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0742e3aae34c8a6a","name":"Accursed","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"category":"Special Ability","description":"Pit Fiends ignore the cursed effects of cursed items they wield.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"00606fd8e68ea178","name":"Ensorcelled Weapon","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Blood_Weapon.webp","system":{"category":"Special Ability","description":"Pit Fiends may add the the attack bonus from their melee weapon to any Spellcraft checks.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2bed72da8c73ce82","name":"Hellfire","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"Fire damage dealt by the pit fiend is treated as dark against enemies immune, resistant, or weak to dark damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f8b53bb83dd23544","name":"Leech","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, the pit fiend can make a Spellcraft check (d20+32) against the Fort Defence of a living creature within 12 squares and line of sight. If successful, the target suffers 6d6+19 dark damage, and the pit fiend is healed an amount of HP equal to the damage dealt to the target. The pit fiend may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"947f95162bb77458","name":"Malediction","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A pit fiend may double the MP cost of any black or red magick spell to either double the range of the spell, double the area, double the spell’s damage dice, or target up to 5 creatures with a single target spell (though no single target spell with an area of effect may overlap).","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"abb4d35c1741751a","name":"Tyrant","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a reaction, the pit fiend can force an ally within line of sight to reroll an attack roll, keeping the higher result. That creature then moves -1 step on the Break Gauge.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8cc6cbabcedf707a","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fd564388c493913d","name":"Channel","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cef6367940490b2d","name":"Combat Casting","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7d524893b37e47a1","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8eaf4d81ac237ead","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a52b9db0d8611ee4","name":"Skill Focus (1-handed, Spellcraft)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"1-handed, spellcraft","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"be5d08456c7d5b24","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6db1c1b6e178704a","name":"Weapon Proficiency (swords)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-MELEE/Bloodbath.webp","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true},"selectedWeaponGroup":"swords","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"22013d364c3b124d","name":"Banish","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Holy_Spirit.webp","system":{"school":"White Magick","mpCost":24,"action":"Primary Action","target":"One summoned creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Forces a summoned creature away.","specialRules":"Higher-level targets gain +5 to Will Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"unsummoned","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bfb1ae56605cc6d3","name":"Dispel","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/ROLE-HEALER/Esuna.webp","system":{"school":"White Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 12 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Ends dispellable magickal effects on the target.","specialRules":"When targeting an ally, treat Will Defence as 5 lower. Removes spell effects marked dispellable if the check beats Will Defence.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"dispel"}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"35d42d21425193ed","name":"Fear","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Shadow_Wall.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Overwhelming fear limits the target's actions.","specialRules":"Higher-level targets gain +5 to Will Defence. Fear effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":15,"tiers":[{"dc":15,"effects":[{"type":"condition","status":"primaryActionOnly","defence":"will","durationRounds":1}]},{"dc":20,"effects":[{"type":"condition","status":"secondaryActionOnly","defence":"will","durationRounds":1}]},{"dc":25,"effects":[{"type":"condition","status":"minorActionOnly","defence":"will","durationRounds":1}]},{"dc":30,"effects":[{"type":"condition","status":"noActions","defence":"will","durationRounds":1},{"type":"condition","status":"flatFooted","defence":"will","durationRounds":1}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3c429dcf4ef73b8d","name":"Fireball","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_II.webp","system":{"school":"Red Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"An explosive fire orb damages its target and nearby creatures.","specialRules":"Successful Reflex defence still takes half damage. Adjacent creatures take half the primary damage if the check beats their Reflex Defence; otherwise none.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":25,"effects":[{"type":"damage","formula":"6d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":30,"effects":[{"type":"damage","formula":"8d6","damageType":"fire","defence":"ref","halfOnFailure":true}]},{"dc":35,"effects":[{"type":"damage","formula":"10d6","damageType":"fire","defence":"ref","halfOnFailure":true}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5de6c110209b4085","name":"Firestorm","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Fire_III.webp","system":{"school":"Red Magick","mpCost":24,"action":"Primary Action","target":"One creature within 12 squares and line of sight; nearby creatures may also be affected","targetMode":"selected","checkSkill":"spellcraft","description":"Fire rains down across an expanding area.","specialRules":"Successful Reflex defence still takes half damage. Beating both Reflex and Fortitude adds half the initial damage at the start of the next turn and one quarter at the following turn. Area radius 1/2/3 squares for DC 20/25/30. DR reduces only the initial damage.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":25,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]},{"dc":30,"effects":[{"type":"damage","formula":"4d6","damageType":"fire","defence":"ref","halfOnFailure":true},{"type":"condition","status":"ongoingDamage","requiresDefences":["ref","fort"],"durationRounds":0}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"50aa0b5090e0256b","name":"Invisibility","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Hide.webp","system":{"school":"Blue Magick","mpCost":10,"action":"Primary Action","target":"You or one creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Conceals a creature for the encounter.","specialRules":"Actions other than movement, sneaking, or carefully interacting with unattended objects end the effect. May be dispelled.","higherLevelDefenceBonus":0,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[{"type":"condition","status":"invisible","durationRounds":0}]},{"dc":25,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":2,"label":"Invisibility Stealth"}]},{"dc":30,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":5,"label":"Invisibility Stealth"}]},{"dc":35,"effects":[{"type":"condition","status":"invisible","durationRounds":0},{"type":"change","key":"system.skills.stealth.misc","value":10,"label":"Invisibility Stealth"}]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"844150cf3ad4f239","name":"Maim","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Bloodspiller.webp","system":{"school":"Black Magick","mpCost":10,"action":"Primary Action","target":"One creature within 6 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"A severe burst of dark energy inflicts damage.","specialRules":"Each explosive damage die creates two extra dice. If this spell moves the target down the Break Gauge, the condition persists until intensive care or magickal healing restores a step.","higherLevelDefenceBonus":0,"automation":{"minimumDC":0,"effects":[{"type":"damage","formula":"4d6","damageType":"dark","defence":"fort","halfOnFailure":false}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b2dcdd245723aff0","name":"Teleport","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Aetherial_Manipulation.webp","system":{"school":"Blue Magick","mpCost":24,"action":"All-out Action","target":"You, or one object or creature within 6 squares and line of sight","targetMode":"self-or-selected","checkSkill":"spellcraft","description":"Moves a target through space, with distance and size based on the check.","specialRules":"DC 20/25/30/35/40 allow Medium/Large/Huge/Gargantuan/Colossal targets up to 6/12/18/24/30 squares. Contents and riders travel with their carrier. Unwilling creatures require beating Fort Defence. Destination must be in line of sight; higher-level targets gain +5 to Fort Defence.","higherLevelDefenceBonus":5,"automation":{"minimumDC":20,"tiers":[{"dc":20,"effects":[]},{"dc":25,"effects":[]},{"dc":30,"effects":[]},{"dc":35,"effects":[]},{"dc":40,"effects":[]}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
