{"_id":"e394400f53eabd39","name":"Erinys","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":14,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Pure","biography":"Fierce daemons who strangely retain traces of their angelic past. Some wonder if they are truly fallen—or still destined for redemption before the Goddess."},"attributes":{"str":{"score":20},"vit":{"score":21},"agi":{"score":23},"int":{"score":14},"mnd":{"score":18},"cha":{"score":21}},"skills":{"acrobatics":{"trained":true,"total":18},"athletics":{"trained":true,"total":17},"deception":{"trained":true,"total":17},"lore-occult":{"trained":true,"total":14},"perception":{"trained":true,"total":16},"persuasion":{"trained":true,"total":17},"stealth":{"trained":true,"total":18},"unarmed":{"trained":true,"total":22}},"defences":{"ref":{"total":31},"fort":{"total":30},"will":{"total":29}},"resources":{"hp":{"value":140,"max":140,"baseMax":140},"mp":{"value":98,"max":98}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":30,"immunities":["Dark","Fire","Poison","Death Effects"],"resistances":["Cold"],"vulnerabilities":["Holy Block Daemon Shield +26"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":14,"level":14,"xp":2800,"size":"medium","species":"Infernals","profileLine":"Pure Evil Medium Infernal 14; Aggressive","classLevels":"","alignment":"Pure","temperament":"Aggressive","description":"Fierce daemons who strangely retain traces of their angelic past. Some wonder if they are truly fallen—or still destined for redemption before the Goddess.","languages":"Celestial, Common, Draconic, Elven, Infernal Fierce daemons who strangely retain traces of their angelic past. Some wonder if they are truly fallen—or still destined for redemption before the Goddess.","speedText":"6, Fly 10 (hover)","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 26","passivePercepti