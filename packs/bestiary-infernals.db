{"_id":"3a15e45441c56d41","name":"Gargouille","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Corrupt","biography":"Wicked daemons that mimic the statues guarding Val’ daera’s castles and cathedrals."},"attributes":{"str":{"score":15},"vit":{"score":16},"agi":{"score":14},"int":{"score":6},"mnd":{"score":11},"cha":{"score":7}},"skills":{"acrobatics":{"trained":true,"total":9},"perception":{"trained":true,"total":7},"stealth":{"trained":true,"total":9},"unarmed":{"trained":true,"total":14}},"defences":{"ref":{"total":17},"fort":{"total":18},"will":{"total":15}},"resources":{"hp":{"value":50,"max":50,"baseMax":50},"mp":{"value":15,"max":15}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":18,"immunities":["Dark"],"resistances":["Piercing","Slashing"],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":5,"level":5,"xp":1000,"size":"medium","species":"Infernals","profileLine":"Corrupt Evil Medium Infernal 5; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Wicked daemons that mimic the statues guarding Val’ daera’s castles and cathedrals.","languages":"Common, Infernal Wicked daemons that mimic the statues guarding Val’ daera’s castles and cathedrals.","speedText":"8, Fly 12 (hover)","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 17","passivePerception":17,"attributes":{"str":15,"agi":14,"vit":16,"int":6,"mnd":11,"cha":7},"defences":{"ref":17,"flatFootedRef":15,"fort":18,"will":15},"damageReduction":5,"breakThreshold":18,"immunities":["Dark"],"resistances":["Piercing","Slashing"],"weaknesses":["Holy"],"skills":[{"name":"Acrobatics","bonus":9,"key":"acrobatics"},{"name":"Lore (social)","bonus":5,"key":""},{"name":"Perception","bonus":7,"key":"perception"},{"name":"Stealth","bonus":9,"key":"stealth"},{"name":"Unarmed","bonus":14,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":14,"damage":"1d4+4","mode":"melee","type":"slashing"}],"abilities":[{"name":"Imitate","description":"A gargouille can take 20 on Stealth checks when remaining still and can hide in plain sight."},{"name":"Obsidian Tablet","description":"Once per turn, as a reaction to being targeted by a spell, a gargouille can make an opposing attack roll (d20+14). Should the attack beat the Spellcraft check, the spell is treated as if it failed to beat the gargouille’s defence."}],"spells":[],"performances":[],"equipped":"","loot":"Hi-Potion (5%), Obsidian (20%), Daemon Flesh (50%)","steal":"Obsidian (20%)","sourcePage":345}},"prototypeToken":{"name":"Gargouille","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"e7b33e7474623b9a","name":"Claws","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+4","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ee802589450b0c1e","name":"Imitate","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Hide.webp","system":{"category":"Special Ability","description":"A gargouille can take 20 on Stealth checks when remaining still and can hide in plain sight.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5ea33efa791173ed","name":"Obsidian Tablet","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"Once per turn, as a reaction to being targeted by a spell, a gargouille can make an opposing attack roll (d20+14). Should the attack beat the Spellcraft check, the spell is treated as if it failed to beat the gargouille’s defence.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e684969db400b1e2","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c9a046f0788ca060","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a562d0c5432c6861","name":"Skill Focus (unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"4ac869a92c872579","name":"Gallu","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Neutral","biography":"Accursed daemons that feast on living souls."},"attributes":{"str":{"score":22},"vit":{"score":24},"agi":{"score":13},"int":{"score":15},"mnd":{"score":17},"cha":{"score":16}},"skills":{"athletics":{"trained":true,"total":15},"deception":{"trained":true,"total":12},"lore-occult":{"trained":true,"total":11},"perception":{"trained":true,"total":12},"persuasion":{"trained":true,"total":12},"stealth":{"trained":true,"total":10},"unarmed":{"trained":true,"total":20}},"defences":{"ref":{"total":19},"fort":{"total":25},"will":{"total":21}},"resources":{"hp":{"value":96,"max":96,"baseMax":96},"mp":{"value":48,"max":48}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":25,"immunities":["Dark","Electric","Fire","Poison"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":8,"level":8,"xp":1600,"size":"medium","species":"Infernals","profileLine":"Neutral Evil Medium Infernal 8; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"Accursed daemons that feast on living souls.","languages":"Celestial, Common, Draconic, Infernal Accursed daemons that feast on living souls.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 22","passivePerception":22,"attributes":{"str":22,"agi":13,"vit":24,"int":15,"mnd":17,"cha":16},"defences":{"ref":19,"flatFootedRef":18,"fort":25,"will":21},"damageReduction":10,"breakThreshold":25,"immunities":["Dark","Electric","Fire","Poison"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Athletics","bonus":15,"key":"athletics"},{"name":"Deception","bonus":12,"key":"deception"},{"name":"Lore (arcane)","bonus":11,"key":""},{"name":"Lore (occult)","bonus":11,"key":"lore-occult"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Persuasion","bonus":12,"key":"persuasion"},{"name":"Stealth","bonus":10,"key":"stealth"},{"name":"Unarmed","bonus":20,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":20,"damage":"1d4+10","mode":"melee","type":"slashing"},{"name":"Gore","attack":24,"damage":"1d6+14","mode":"melee","type":"piercing"}],"abilities":[{"name":"Soul Snare","description":"As a primary action, a gallu may make a Spellcraft check against the Will Defence of a living creature within 12 squares and line of sight. If successful, the target is cursed with misfortune. If the cursed creature is killed, the gallu is immediately healed an amount of HP equal to the creature's Mnd score. The gallu cannot use this ability again while a creature is cursed with this ability. As a minor action, the gallu can remove the curse. Higher-level targets gain a +5 bonus to their defence against this effect."}],"spells":["Inertia","Muddle"],"performances":[],"equipped":"","loot":"Daemon Heart (5%), Daemon Horn (20%), Daemon Flesh (50%)","steal":"Orichalcum (5%), Remedy (20%)","sourcePage":345}},"prototypeToken":{"name":"Gallu","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"4945407a4f88325c","name":"Claws","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+10","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9f17555103bcfd17","name":"Gore","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+14","type":"piercing"},"attack":{"bonus":4},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a43ea8a8bdffed1c","name":"Soul Snare","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, a gallu may make a Spellcraft check against the Will Defence of a living creature within 12 squares and line of sight. If successful, the target is cursed with misfortune. If the cursed creature is killed, the gallu is immediately healed an amount of HP equal to the creature's Mnd score. The gallu cannot use this ability again while a creature is cursed with this ability. As a minor action, the gallu can remove the curse. Higher-level targets gain a +5 bonus to their defence against this effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"04c4fae0c90c6c8e","name":"Arcane Study","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Enochian.webp","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f02812eb8fae79a9","name":"Powerful Charge","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"description":"Gain +2 on attacks made while charging and deal additional damage equal to half your character level.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e8736043173bf51d","name":"Skill Focus (Spellcraft, Unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/Gravity.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"spellcraft, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"7571e392cec552e4","name":"Inertia","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Armor_Crush.webp","system":{"school":"Blue Magick","mpCost":6,"action":"Secondary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Slows a target, or dispels Haste.","specialRules":"Higher-level targets gain +5 to Fort Defence. If the target is hasted, end Haste instead.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"slowed","defence":"fort","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"82d594d374f622be","name":"Muddle","type":"spell","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Trick_Attack.webp","system":{"school":"Blue Magick","mpCost":16,"action":"Primary Action","target":"One creature within 12 squares and line of sight","targetMode":"selected","checkSkill":"spellcraft","description":"Confuses a foe and disrupts its ability to distinguish friend from enemy.","specialRules":"Higher-level targets gain +5 to Will Defence. Mind effect.","higherLevelDefenceBonus":5,"automation":{"minimumDC":0,"effects":[{"type":"condition","status":"confused","defence":"will","durationRounds":0}]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"79f81d0066605685","name":"Succubus","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Neutral","biography":"Daemonic temptresses who prey on weakness of men, feeding on their lust and lifeforce."},"attributes":{"str":{"score":13},"vit":{"score":20},"agi":{"score":21},"int":{"score":14},"mnd":{"score":18},"cha":{"score":27}},"skills":{"acrobatics":{"trained":true,"total":15},"deception":{"trained":true,"total":18},"lore-occult":{"trained":true,"total":12},"perception":{"trained":true,"total":14},"persuasion":{"trained":true,"total":23},"stealth":{"trained":true,"total":15},"survival":{"trained":true,"total":14},"unarmed":{"trained":true,"total":20}},"defences":{"ref":{"total":25},"fort":{"total":25},"will":{"total":24}},"resources":{"hp":{"value":100,"max":100,"baseMax":100},"mp":{"value":70,"max":70}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":25,"immunities":["Dark","Electric","Fire","Poison","Toad"],"resistances":["Cold"],"vulnerabilities":["of men","feeding on their lust and lifeforce. HP 100 MP 70 Init d8 Speed 6","Fly 10 (hover) Senses Dark Vision","Passive Perception 24 Defence Ref 25 (flat-footed 20)","Fort 25","Will 24 DR 10","Threshold 25 Immunity Dark","Electric","Fire","Poison","Toad Resistance Cold Weakness Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":10,"level":10,"xp":2000,"size":"medium","species":"Infernals","profileLine":"Neutral Evil Medium Infernal 10; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"Daemonic temptresses who prey on weakness of men, feeding on their lust and lifeforce.","languages":"Celestial, Common, Draconic, Elven, Infernal Daemonic temptresses who prey on weakness of men, feeding on their lust and lifeforce.","speedText":"6, Fly 10 (hover)","initiativeDie":"1d8","senses":"Dark Vision;","passivePerception":24,"attributes":{"str":13,"agi":21,"vit":20,"int":14,"mnd":18,"cha":27},"defences":{"ref":25,"flatFootedRef":20,"fort":25,"will":24},"damageReduction":10,"breakThreshold":25,"immunities":["Dark","Electric","Fire","Poison","Toad"],"resistances":["Cold"],"weaknesses":["of men","feeding on their lust and lifeforce. HP 100 MP 70 Init d8 Speed 6","Fly 10 (hover) Senses Dark Vision","Passive Perception 24 Defence Ref 25 (flat-footed 20)","Fort 25","Will 24 DR 10","Threshold 25 Immunity Dark","Electric","Fire","Poison","Toad Resistance Cold Weakness Holy"],"skills":[{"name":"Acrobatics","bonus":15,"key":"acrobatics"},{"name":"Deception","bonus":18,"key":"deception"},{"name":"Lore (occult)","bonus":12,"key":"lore-occult"},{"name":"Lore (social)","bonus":12,"key":""},{"name":"Perception","bonus":14,"key":"perception"},{"name":"Persuasion","bonus":23,"key":"persuasion"},{"name":"Stealth","bonus":15,"key":"stealth"},{"name":"Survival","bonus":14,"key":"survival"},{"name":"Unarmed","bonus":20,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":20,"damage":"1d4+10","mode":"melee","type":"slashing"}],"abilities":[{"name":"Delusional Vision","description":"Once per turn, a succubus may use the Persuasion skill to cast the Charm spell as a secondary action at no MP cost. However, any creature the succubus fails to charm this way cannot be targeted by this ability again for the duration of the encounter. The succubus does not need to know the charm spell to use this ability."},{"name":"Kiss of the Daemon","description":"Whenever a succubus pins a living creature, it may immediately move the creature -1 persistent step on the Break Gauge and gains an amount of HP equal to the creature's Vit score, for each turn the pin is maintained. Creatures moved to the bottom of the Break Gauge this way die, regardless of hero points. Additionally, the succubus may use this ability against an adjacent creature they have charmed, without needing to pin the target. This does not end the effect of the Charm spell cast with the Delusional Vision ability."},{"name":"Torturous Strike","description":"When a succubus' claw attack beats both the target's Ref and Fort Defence, it deals an additional 2d6 damage and moves the target -1 step down the Break Gauge."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Vampyre Fang (20%), Daemon Heart (50%), Daemon Horn (95%)","steal":"Moondust (5%), Vampyre Fang (50%)","sourcePage":346}},"prototypeToken":{"name":"Succubus","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"31e19087af769d91","name":"Claws","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+10","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e2bc8f6cf63f3df5","name":"Delusional Vision","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"Once per turn, a succubus may use the Persuasion skill to cast the Charm spell as a secondary action at no MP cost. However, any creature the succubus fails to charm this way cannot be targeted by this ability again for the duration of the encounter. The succubus does not need to know the charm spell to use this ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1296b6da4aad7404","name":"Kiss of the Daemon","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"category":"Special Ability","description":"Whenever a succubus pins a living creature, it may immediately move the creature -1 persistent step on the Break Gauge and gains an amount of HP equal to the creature's Vit score, for each turn the pin is maintained. Creatures moved to the bottom of the Break Gauge this way die, regardless of hero points. Additionally, the succubus may use this ability against an adjacent creature they have charmed, without needing to pin the target. This does not end the effect of the Charm spell cast with the Delusional Vision ability.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9f5416ec3447d089","name":"Torturous Strike","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"When a succubus' claw attack beats both the target's Ref and Fort Defence, it deals an additional 2d6 damage and moves the target -1 step down the Break Gauge.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d1ac7aa7e1dd9aec","name":"Agile Manoeuvres","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength for Unarmed checks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ba3682e7e70c98ac","name":"Pin","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4602e3a420165ce6","name":"Skill Focus (persuasion, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"persuasion, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e10d964321fc6954","name":"Weapon Finesse","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength when calculating damage with light weapons, thrown weapons, unarmed attacks, and natural attacks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"179b0a2cc9919ec0","name":"Nightmare","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":12,"xp":0,"nextLevel":0,"className":"","race":"Infernals","alignment":"Pure","biography":"These fell steeds haunt the border between worlds, shifting in and out of their ghostly, incorporeal form."},"attributes":{"str":{"score":31},"vit":{"score":21},"agi":{"score":18},"int":{"score":13},"mnd":{"score":12},"cha":{"score":12}},"skills":{"athletics":{"trained":true,"total":21},"deception":{"trained":true,"total":12},"lore-occult":{"trained":true,"total":12},"perception":{"trained":true,"total":12},"persuasion":{"trained":true,"total":12},"stealth":{"trained":true,"total":10},"survival":{"trained":true,"total":12},"unarmed":{"trained":true,"total":26}},"defences":{"ref":{"total":26},"fort":{"total":28},"will":{"total":24}},"resources":{"hp":{"value":137,"max":137,"baseMax":137},"mp":{"value":48,"max":48}},"combat":{"initiativeDie":"1d6","speed":10,"baseSpeed":10,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":33,"immunities":["Blind","Confusion","Dark","Fear","Fire","Poison","Sleep"],"resistances":[],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Infernals","profile":"infernal","cr":12,"level":12,"xp":2400,"size":"large","species":"Infernals","profileLine":"Pure Evil Large Infernal 12; Aggressive","classLevels":"","alignment":"Pure","temperament":"Aggressive","description":"These fell steeds haunt the border between worlds, shifting in and out of their ghostly, incorporeal form.","languages":"Celestial, Infernal These fell steeds haunt the border between worlds, shifting in and out of their ghostly, incorporeal form.","speedText":"10 (hover*)","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 22","passivePerception":22,"attributes":{"str":31,"agi":18,"vit":21,"int":13,"mnd":12,"cha":12},"defences":{"ref":26,"flatFootedRef":22,"fort":28,"will":24},"damageReduction":15,"breakThreshold":33,"immunities":["Blind","Confusion","Dark","Fear","Fire","Poison","Sleep"],"resistances":[],"weaknesses":["Holy"],"skills":[{"name":"Athletics","bonus":21,"key":"athletics"},{"name":"Deception","bonus":12,"key":"deception"},{"name":"Lore (occult)","bonus":12,"key":"lore-occult"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Persuasion","bonus":12,"key":"persuasion"},{"name":"Stealth","bonus":10,"key":"stealth"},{"name":"Survival","bonus":12,"key":"survival"},{"name":"Unarmed","bonus":26,"key":"unarmed"}],"attacks":[{"name":"Gore","attack":26,"damage":"1d8+16","mode":"melee","type":"piercing"},{"name":"Gore","attack":30,"damage":"1d8+22","mode":"melee","type":"piercing"}],"abilities":[{"name":"Burn**","description":"A nightmare’s gore attack deals fire damage. Additionally, if the attack roll beats both the target's Ref Defence and Fort Defence, the target takes an additional 3d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR."},{"name":"Incorporeal Touch*","description":"The nightmare's gore attack deals unaspected damage to living creatures. Additionally, when the nightmare successfully hits a living creature with its gore, the target moves -1 step on the Break Gauge. This secondary effect is a death effect."},{"name":"Phantom Form","description":"As a minor action, the nightmare may become incorporeal. This effect may be dispelled, in which case, the nightmare may not use this ability again for 1d4+1 turns."},{"name":"Terror Touch","description":"Whenever a nightmare’s gore attack beats both a target's Ref and Will Defence, the target loses their secondary action on their next turn. If the attack beat the target's Will Defence by 5 or more, the target also loses their primary action. If the attack beat the target’s Will Defence by 10 or more, the target becomes flat-footed and may take no actions until the start of the nightmare’s next turn. This is a fear effect."}],"spells":[],"performances":[],"equipped":"","loot":"Daemon Horn (20%), Philter (50%), Hi-Potion (95%)","steal":"Elfwort (20%), Snowdrop (50%) * Only when incorporeal. ** Only when not incorporeal.","sourcePage":347}},"prototypeToken":{"name":"Nightmare","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"02419dbb36f1df2a","name":"Gore","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+16","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ded82ea192f11ca1","name":"Gore","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+22","type":"piercing"},"attack":{"bonus":4},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"94d3ea591fe490f0","name":"Burn**","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A nightmare’s gore attack deals fire damage. Additionally, if the attack roll beats both the target's Ref Defence and Fort Defence, the target takes an additional 3d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a852a943b18e66b3","name":"Incorporeal Touch*","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"category":"Special Ability","description":"The nightmare's gore attack deals unaspected damage to living creatures. Additionally, when the nightmare successfully hits a living creature with its gore, the target moves -1 step on the Break Gauge. This secondary effect is a death effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fdc08a97da0879d7","name":"Phantom Form","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"As a minor action, the nightmare may become incorporeal. This effect may be dispelled, in which case, the nightmare may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f6532858fe909029","name":"Terror Touch","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"Whenever a nightmare’s gore attack beats both a target's Ref and Will Defence, the target loses their secondary action on their next turn. If the attack beat the target's Will Defence by 5 or more, the target also loses their primary action. If the attack beat the target’s Will Defence by 10 or more, the target becomes flat-footed and may take no actions until the start of the nightmare’s next turn. This is a fear effect.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1b4803c1c4d65031","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bd71a8741a992c46","name":"HP Up","type"