{"_id":"aecaf89251cdd85c","name":"Acrobatic Strike","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After successfully juking past a target during this turn, gain +2 on melee attacks against it.","prerequisites":{"skills":["acrobatics"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"aacda52fb6a7b930","name":"Agile Manoeuvres","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Use Agility instead of Strength for Unarmed checks."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9f4838ec4fa6778f","name":"Arcane Study","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Learn spells from scrolls, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots (minimum 1).","prerequisites":{"skills":["spellcraft"]},"repeatable":true,"effects":{"spellSlotsPerCopy":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"b94846cd5ae857fd","name":"Armour Proficiency (heavy)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ignore the armour check penalty from heavy armour.","prerequisites":{"technicks":["Armour Proficiency (light)"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"00965d61213b29f5","name":"Armour Proficiency (light)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ignore the armour check penalty from light armour."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"3129180374d85eb5","name":"Armour Proficiency (mystic)","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ignore the armour check penalty from mystic armour."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"fed19394ff648b9a","name":"Bardic Study","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Learn performances from scores, up to 1 + Intelligence modifier. Each copy adds another 1 + Intelligence modifier slots. New slots are granted retroactively when the Intelligence modifier increases.","prerequisites":{"anySkills":["perform"]},"repeatable":true,"effects":{"performanceSlotsPerCopy":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"8486dbfb654f975b","name":"Brawler I","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"With empty hands, increase unarmed damage by one die step, gain +1 Reflex Defence (lost while flat-footed), make unarmed counterattacks, and stop provoking counterattacks with unarmed attacks.","effects":{"conditional":{"condition":"emptyHands","defenceBonuses":{"ref":1}}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"0460b8dd64356f67","name":"Brawler II","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"With empty hands, increase unarmed damage by one additional die step and raise Brawler's Reflex bonus to +2.","prerequisites":{"characterLevel":3,"technicks":["Brawler I"]},"effects":{"conditional":{"condition":"emptyHands","defenceBonuses":{"ref":2}}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7b201add93a378d9","name":"Brawler III","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"With empty hands, increase unarmed damage by one additional die step and raise Brawler's Reflex bonus to +3.","prerequisites":{"characterLevel":6,"technicks":["Brawler I","Brawler II"]},"effects":{"conditional":{"condition":"emptyHands","defenceBonuses":{"ref":3}}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"8044ff725e0b573a","name":"Bull Rush","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After a successful charge attack, push a target no more than one size larger back 1 square.","prerequisites":{"attributes":{"str":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"37766f432de3d9e2","name":"Channel","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Once per day while at or below half MP, spend a minor action to restore the greater of your Mind score or one quarter of maximum MP. Usable no more than once per encounter.","prerequisites":{"skills":["spellcraft"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"5a71dd576bee230c","name":"Cleave","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"As an all-out action, make one melee attack against a target and creatures adjacent to both you and it. Reach weapons can strike targets at the same reach. This attack cannot combo and cannot be combined with Lunge.","prerequisites":{"technicks":["Mighty Strikes"],"attributes":{"str":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"cf1200263f6056cf","name":"Combat Casting","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When casting defensively while threatened by multiple enemies, take only one -5 penalty.","prerequisites":{"skills":["spellcraft"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"1491a5910d5357df","name":"Crush","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When you pin a target, automatically deal unarmed, claw, or slam damage to it.","prerequisites":{"technicks":["Pin"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"4994876f3f600615","name":"Deadly Aim","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After aiming at a target, your next ranged attack against it deals one additional damage die; the benefit ends if your aim is disrupted and does not stack with Rapid Shot.","prerequisites":{"characterLevel":4,"technicks":["Precise Shot"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c5ff2e35f93591bc","name":"Defence Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"01b430e1c38ee61a","name":"Disruptive","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase the penalty for casting or performing in a threatened area: -5 becomes -10, or -2 becomes -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"91f91a17ea08d57d","name":"Dodge","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Once per turn as a reaction in light or no armour, make an Acrobatics check to avoid a successful attack. If the check beats the attack roll, treat the attack as not beating your Reflex Defence.","prerequisites":{"attributes":{"agi":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"394365f4fa48df17","name":"Dodge Roll","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After successfully dodging an attack, immediately move to an adjacent unoccupied space without provoking counterattacks.","prerequisites":{"attributes":{"agi":13},"technicks":["Dodge"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"17713d4e4920acfb","name":"Dual Wield I","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Reduce the penalty for attacking with two weapons from -10 to -5.","prerequisites":{"attributes":{"agi":15}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"909863d9ac7c74ea","name":"Dual Wield II","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Reduce the two-weapon attack penalty from -5 to -2.","prerequisites":{"attributes":{"agi":17},"characterLevel":6,"technicks":["Dual Wield I"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"b2e21cb169c4c506","name":"Dual Wield III","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Remove the penalty for attacking with two weapons.","prerequisites":{"attributes":{"agi":19},"characterLevel":11,"technicks":["Dual Wield I","Dual Wield II"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9f5560957b5bbbdd","name":"Extra Second Wind","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain one additional use of second wind per day. You still cannot use second wind more than once per encounter.","repeatable":true,"effects":{"extraSecondWinds":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"a23fa80ac8af1483","name":"Farshot","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Reduce short-, medium-, and long-range attack penalties by one step (-10 to -5, -5 to -2, and -2 to 0)."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"209bb6852b071f96","name":"Focused Shot","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After aiming a ranged weapon, reroll your next ranged attack made that turn and keep the second result, even if lower.","prerequisites":{"characterLevel":2}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"d1f7ff0c3e254e3a","name":"Hale and Hearty","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"You may use more than one second wind per encounter.","prerequisites":{"technicks":["Extra Second Wind"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"483b7a78a0b56e5a","name":"Heroic","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain one additional Hero Point per day.","effects":{"heroPointsPerDay":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"adec41be4eac786a","name":"HP Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"610f25936c1ca4bc","name":"Improved Charge","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"You may charge without moving in a straight line.","prerequisites":{"attributes":{"agi":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7032cb6b418d9a9b","name":"Improved Disarm","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 on attempts to disarm and failed disarm attempts no longer provoke counterattacks.","prerequisites":{"technicks":["Tactical Guard"],"attributes":{"int":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"2d0a66e1edbdb9db","name":"Improved Initiative","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"2f62b400ce415488","name":"Improved Shield Bash","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Shield bash can interrupt defensive casting, performing, or juking; shield bash no longer adds cumulative block penalties.","prerequisites":{"technicks":["Shield Bash","Shield Proficiency"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"df93c6e64db10113","name":"Linguist","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Learn 1 + Intelligence modifier additional languages (minimum 1). This technick may be taken more than once.","prerequisites":{"attributes":{"int":13}},"repeatable":true,"choice":{"type":"languages"},"effects":{"languages":{"base":1,"intModifier":1}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"5a6d57b279398be5","name":"Lunge","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Once per turn, extend the reach of your next melee attack by 1 square and take -2 Reflex Defence until your next turn. Cannot be used while charging, prone, or making a counterattack."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"0c0702c55ecea546","name":"Mighty Strikes","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7c1f72cfa087ba6b","name":"Mounted Archery","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Reduce the mounted ranged attack penalty to -2, or to -5 when the mount is flying.","prerequisites":{"technicks":["Mounted Combat"],"skills":["ride"],"anySkills":["ranged"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"94dfcca68812ede9","name":"Mounted Combat","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Once per turn as a reaction, make a Ride check to avoid a successful attack against your mount; success treats the attack as not beating its Reflex Defence.","prerequisites":{"skills":["ride"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"cb7f951db3f4a723","name":"MP Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Increase maximum MP by 5 + your character level.","prerequisites":{"skills":["spellcraft"]},"effects":{"resources":{"mpMaxFlat":5,"mpMaxPerLevel":1}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"54f975749a689a84","name":"Naval Combat","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Once per turn as a reaction, make a Pilot check to avoid a successful attack against your vessel; success treats the attack as not beating its Reflex Defence.","prerequisites":{"skills":["pilot"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"1c178a01506777b8","name":"Pin","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A successful grapple pins the target until your next turn. It becomes prone and flat-footed and can take only one minor action on its next turn; you are also prone and flat-footed while maintaining the pin."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"7581c23d6a9e991e","name":"Pole Fighter","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"With a reach weapon, attack adjacent enemies at -2 instead of the normal -5 penalty."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"79d72129f9dc67de","name":"Power Attack","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Spend two minor actions to deal one additional damage die on all melee attacks until your turn ends. Does not stack with Rapid Strike.","prerequisites":{"attributes":{"str":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"43ae64a1991d5f12","name":"Powerful Charge","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +2 on attacks made while charging and deal additional damage equal to half your character level."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"6292bddb8209bfd0","name":"Precise Shot","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Make ranged attacks into melee without the normal -5 penalty."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"5ea6695d7fa196e1","name":"Quick Draw","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Draw or sheath a weapon as a minor action and draw a hidden weapon as a secondary action."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"bc8a3719e49f7642","name":"Quick Reload","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Reload a ranged weapon with capacity as a minor action."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"47137df3e816b5fe","name":"Rapid Counter","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Make additional counterattacks per turn equal to your Agility modifier and counterattack while flat-footed; each trigger still allows only one attack.","effects":{"counterattacksPerTurnFromAgi":true}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"0e124c266be7987f","name":"Rapid Shot","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"For a ranged attack, take -2 to hit to deal one extra damage die. This uses two pieces of ammunition or two identical thrown weapons and does not stack with Deadly Aim. If Strength is below 13, the attack penalty is -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c055d96a76eea452","name":"Rapid Strike","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"For a melee attack, take -2 to hit to deal one extra damage die. Does not stack with Power Attack and cannot be used while charging. If Agility is below 13, the attack penalty is -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"ce450e29cebb085d","name":"Running Attack","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Use a primary action to attack at any point during your secondary action.","prerequisites":{"attributes":{"agi":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"9d3ea92cffad2f64","name":"Shake it Off","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"08dfdfc5c5080c2f","name":"Shield Bash","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Make counterattacks with a shield, dealing damage based on shield size. If the attack beats both Reflex and Fortitude Defence, disrupt and end the triggering action; shield bash adds to cumulative block penalties.","prerequisites":{"technicks":["Shield Proficiency"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"732b04647838ca8c","name":"Shield Proficiency","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ignore the -5 penalty for using shields and reduce cumulative block penalties to -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c8390dcb2aacdfa4","name":"Skill Focus","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"dad2cc1ab41f80d8","name":"Skill Training","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Train one additional skill from a class skill list. Each additional copy must train a different skill.","repeatable":true,"choice":{"type":"classSkillTraining"},"effects":{"selectedSkillTraining":true}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"d77ece3b55efe785","name":"Tactical Guard","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When making a melee attack as a primary action, choose up to -1 on the attack to gain the same bonus to Reflex Defence until your next turn. Limit increases by 1 at level 4 and every 4 levels, to -5/+5; these modifiers do not affect attacks to block or parry.","prerequisites":{"attributes":{"int":13}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"016552e1890e3932","name":"Tactical Withdrawal","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 Reflex Defence against counterattacks.","prerequisites":{"attributes":{"agi":13},"technicks":["Dodge"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"a133898571d70f36","name":"Threshold Up","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"71d49b4bd65d5f04","name":"Throw","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When using Trip, you may move the target 1 square beyond your reach and deal blunt damage equal to your unarmed or natural attack damage.","prerequisites":{"technicks":["Trip"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"b18dda55b25566ea","name":"Trample","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"During a mounted charge, move through creatures at least one size smaller than your mount; it attacks each with an Unarmed check for size-scaled unaspected damage and may knock them prone. A target can react by falling prone outside the path to avoid damage.","prerequisites":{"technicks":["Mounted Combat"],"skills":["ride"]}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"a864370a6c3d2a1f","name":"Trip","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"After a successful grapple, the target falls prone in its space and is no longer grappled."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"cc8d1196160ddfa6","name":"Triple Crit","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Ranged weapon critical hits deal triple weapon damage.","prerequisites":{"characterLevel":8},"effects":{"rangedCriticalMultiplier":3}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"71675b3472e94f8b","name":"Unseat","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"A polearm counterattack that beats both Reflex and Fortitude Defence dismounts and knocks a mounted target prone. If it tries to stay mounted with Ride, use your attack roll as the new DC."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"b9e64be945fde6b0","name":"Weapon Finesse","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Use Agility instead of Strength when calculating damage with light weapons, thrown weapons, unarmed attacks, and natural attacks."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"dbcd635015c4ac72","name":"Weapon Proficiency","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"Choose a weapon group and ignore the -5 penalty on checks with its weapons. Each additional copy must select a different group.","repeatable":true,"choice":{"type":"weaponGroup","options":["axes","bows","bludgeons","crossbows","knives","polearms","staves","swords"]},"effects":{"weaponProficiency":true}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"07baa62716da9bf7","name":"Whirlwind Attack","type":"technick","img":"icons/svg/item-bag.svg","system":{"description":"When using Cleave, you may instead hit every creature adjacent to you, or creatures 2 squares away when wielding a reach weapon.","prerequisites":{"technicks":["Cleave","Mighty Strikes"],"attributes":{"str":15}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
