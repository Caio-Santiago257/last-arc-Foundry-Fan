{"_id":"284548888befd22a","name":"Ore Hammer","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bludgeons","description":"A large, dwarven hammer bearing searing red runes. This weapon’s damage is treated as fire against targets either immune, resistant, or weak to fire damage, or targets that are oiled.","cost":16600,"availability":"Rare","bulk":2,"weaponGroup":"bludgeons","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":3},"damage":{"formula":"2d10+3","type":"Blunt"},"range":"Melee","capacity":0,"specialRules":"A large, dwarven hammer bearing searing red runes. This weapon’s damage is treated as fire against targets either immune, resistant, or weak to fire damage, or targets that are oiled."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"079eda449a9f9f0f","name":"Gigas Mallet","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bludgeons","description":"This massive hammer packs the power of a giant in each hit. Targets suffer a -2 penalty to block or parry this weapon. Additionally, should your attack roll beat both a target’s Ref and Fort Defence, the Bull Rush technick may be applied to the attack, even without charging. Requires 15 Str to wield.","cost":19900,"availability":"Exotic","bulk":2,"weaponGroup":"bludgeons","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":3},"damage":{"formula":"2d12+3","type":"Blunt"},"range":"Melee","capacity":0,"specialRules":"This massive hammer packs the power of a giant in each hit. Targets suffer a -2 penalty to block or parry this weapon. Additionally, should your attack roll beat both a target’s Ref and Fort Defence, the Bull Rush technick may be applied to the attack, even without charging. Requires 15 Str to wield.","prerequisites":{"str":15}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
