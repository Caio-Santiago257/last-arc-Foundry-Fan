{"_id":"1259a0f80d1175fe","name":"Spiked Flail","type":"weapon","img":"icons/svg/item-bag.svg","system":{"category":"Bludgeons","description":"A spiked metal ball, fastened to the end of a chain. You may use the appropriate weapon skill in place of the Unarmed skill when using the Trip technick. Additionally, use this weapon’s damage in place of your unarmed damage when used with the Throw technick. Small creatures may treat this as either a 1-handed or 2-handed weapon.","cost":8500,"availability":"Uncommon","bulk":0.1,"weaponGroup":"bludgeons","weaponSize":"Small","weaponSkill":"light-weapon","attack":{"bonus":2},"damage":{"formula":"2d6+2","type":"Piercing"},"range":"Melee","capacity":0,"specialRules":"A spiked metal ball, fastened to the end of a chain. You may use the appropriate weapon skill in place of the Unarmed skill when using the Trip technick. Additionally, use this weapon’s damage in place of your unarmed damage when used with the Throw technick. Small creatures may treat this as either a 1-handed or 2-handed weapon."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
