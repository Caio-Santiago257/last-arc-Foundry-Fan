{"_id":"d75f288683038810","name":"Duelling Buckler","type":"armor","img":"icons/svg/item-bag.svg","system":{"category":"Shields","description":"This little round shield is favoured by swashbucklers, duellists, and gladiators. Whenever you roll a natural 19 or 20 to block, you cumulate no block penalty.","cost":4300,"availability":"Uncommon","weaponSize":"Tiny","weaponSkill":"light-weapon","attack":{"bonus":2},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":0.1,"specialRules":"This little round shield is favoured by swashbucklers, duellists, and gladiators. Whenever you roll a natural 19 or 20 to block, you cumulate no block penalty."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"bfe244b80ce83640","name":"Ecranche","type":"armor","img":"icons/svg/item-bag.svg","system":{"category":"Shields","description":"A shield made specifically for mounted combat. You cumulate no block penalties while making a mounted charge. Additionally, you gain a +5 bonus to your Fort Defence against the Unseat technick. However, you may not use the Shield Bash technick while mounted. Medium creatures may treat this as either a 1-handed or light shield.","cost":5700,"availability":"Common","weaponSize":"Tiny","weaponSkill":"light-weapon","attack":{"bonus":2},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":0.1,"specialRules":"A shield made specifically for mounted combat. You cumulate no block penalties while making a mounted charge. Additionally, you gain a +5 bonus to your Fort Defence against the Unseat technick. However, you may not use the Shield Bash technick while mounted. Medium creatures may treat this as either a 1-handed or light shield.","itemEffects":{"conditionalDefenceBonuses":{"condition":"the unseat technick","fort":5}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"006f27bd890e15ca","name":"War-Door","type":"armor","img":"icons/svg/item-bag.svg","system":{"category":"Shields","description":"This large tower shield helps protect the wielder from the worst of attacks. You suffer only a -2 penalty when fighting defensively, rather than the normal -5.","cost":7300,"availability":"Uncommon","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":2},"damage":{"formula":"","type":"Blunt"},"armorType":"shield","bulk":2,"specialRules":"This large tower shield helps protect the wielder from the worst of attacks. You suffer only a -2 penalty when fighting defensively, rather than the normal -5."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
