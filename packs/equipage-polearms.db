{"_id":"9711bfcf80d62535","name":"Brandestoc","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/True_Thrust.webp","system":{"category":"Polearms","description":"A large polearm with as much blade as haft. When attacking adjacent targets, reduce the penalty to -2, or suffer no penalty if you have the Pole Fighter technick. This weapon requires 17 Str to be wielded 1-handed by medium creatures and may not be wielded by small creatures. This weapon grants you reach 2.","cost":3100,"availability":"Common","bulk":2,"weaponGroup":"polearms","weaponSize":"Large","weaponSkill":"two-handed","attack":{"bonus":1},"damage":{"formula":"2d10","type":"Piercing"},"range":"Melee","capacity":0,"specialRules":"A large polearm with as much blade as haft. When attacking adjacent targets, reduce the penalty to -2, or suffer no penalty if you have the Pole Fighter technick. This weapon requires 17 Str to be wielded 1-handed by medium creatures and may not be wielded by small creatures. This weapon grants you reach 2.","prerequisites":{"str":17}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
