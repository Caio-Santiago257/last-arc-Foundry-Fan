{"_id":"5d1b187f6f32bbde","name":"Cockatrice","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Beware the statues that dot the Malloram Jungle—each may be the petrified form of a careless victim. Those who meet a cockatrice’s gaze risk more than paralysis; should you avoid stone-cold death, you may still be devoured alive as you lie helpless."},"attributes":{"str":{"score":20},"vit":{"score":19},"agi":{"score":15},"int":{"score":2},"mnd":{"score":13},"cha":{"score":8}},"skills":{"perception":{"trained":true,"total":14},"survival":{"trained":true,"total":9},"unarmed":{"trained":true,"total":18}},"defences":{"ref":{"total":17},"fort":{"total":20},"will":{"total":17}},"resources":{"hp":{"value":54,"max":54,"baseMax":54},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":25,"immunities":["Curse","Petrify","Poison","Sleep"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":5,"level":6,"xp":1000,"size":"large","species":"Beasts","profileLine":"Corrupt Neutral Large Beast 6; Territorial","classLevels":"","alignment":"Corrupt","temperament":"Territorial","description":"Beware the statues that dot the Malloram Jungle—each may be the petrified form of a careless victim. Those who meet a cockatrice’s gaze risk more than paralysis; should you avoid stone-cold death, you may still be devoured alive as you lie helpless.","languages":"","speedText":"8, Fly 10","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 24","passivePerception":24,"attributes":{"str":20,"agi":15,"vit":19,"int":2,"mnd":13,"cha":8},"defences":{"ref":17,"flatFootedRef":15,"fort":20,"will":17},"damageReduction":5,"breakThreshold":25,"immunities":["Curse","Petrify","Poison","Sleep"],"resistances":[],"weaknesses":[],"skills":[{"name":