{"_id":"fcbd81dd8d4e7698","name":"Rat, Plague","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Infested dire rats, their bodies riddled with pustulous buboes and pox, driven mad by disease. Killed and burned on sight, they spread deadly plague wherever they roam."},"attributes":{"str":{"score":12},"vit":{"score":18},"agi":{"score":19},"int":{"score":2},"mnd":{"score":14},"cha":{"score":4}},"skills":{"perception":{"trained":true,"total":17},"stealth":{"trained":true,"total":24},"unarmed":{"trained":true,"total":19}},"defences":{"ref":{"total":25},"fort":{"total":24},"will":{"total":22}},"resources":{"hp":{"value":90,"max":90,"baseMax":90},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":24,"immunities":["Confusion","Disease"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":9,"level":10,"xp":1800,"size":"small","species":"Beasts","profileLine":"Corrupt Evil Small Beast 10; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Infested dire rats, their bodies riddled with pustulous buboes and pox, driven mad by disease. Killed and burned on sight, they spread deadly plague wherever they roam.","languages":"","speedText":"8","initiativeDie":"1d8","senses":"Low-light Vision, Scent; Passive Perception 27","passivePerception":27,"attributes":{"str":12,"agi":19,"vit":18,"int":2,"mnd":14,"cha":4},"defences":{"ref":25,"flatFootedRef":21,"fort":24,"will":22},"damageReduction":10,"breakThreshold":24,"immunities":["Confusion","Disease"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":17,"key":"perception"},{"name":"Stealth","bonus":24,"key":"stealth"},{"name":"Unarmed","bonus":19,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":19,"damage":"1d4+9","mode":"melee","type":"piercing"}],"abilities":[{"name":"Festering Bite","description":"If a plague rat's bite attack beats both a target's Ref and Fort Defence, the target becomes diseased."},{"name":"Heart of the Swarm","description":"If a plague rat starts its turn adjacent to 2 or more plague rats, it gains 10 temporary HP . This HP is used first and any remaining at the start of their next turn is lost."},{"name":"Overwhelm","description":"Plague Rats receive a +2 bonus to attack rolls for each adjacent plague rat (max +10)."},{"name":"Poison","description":"When a plague rats bite deals damage to a living target, there is a 75% chance (75 or less on d%) the target becomes poisoned by death fog."}],"spells":[],"performances":[],"equipped":"","loot":"Remedy (20%), Beast Mane (50%)","steal":"Stardust (5%), 1gp (20%), Beast Mane (50%)","sourcePage":294}},"prototypeToken":{"name":"Rat, Plague","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"5d685f0881a2fd35","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d4+9","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"36e9143b935e3146","name":"Festering Bite","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/Caustic_Bite.webp","system":{"category":"Special Ability","description":"If a plague rat's bite attack beats both a target's Ref and Fort Defence, the target becomes diseased.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"fl