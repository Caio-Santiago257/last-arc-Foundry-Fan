{"_id":"3cc9159d92c603e1","name":"Stirge","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":12,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"A blood-sucking nightmare, this monster haunts the dark corners of the world, preying on the living."},"attributes":{"str":{"score":25},"vit":{"score":25},"agi":{"score":16},"int":{"score":2},"mnd":{"score":12},"cha":{"score":7}},"skills":{"perception":{"trained":true,"total":17},"stealth":{"trained":true,"total":9},"unarmed":{"trained":true,"total":23}},"defences":{"ref":{"total":24},"fort":{"total":30},"will":{"total":24}},"resources":{"hp":{"value":161,"max":161,"baseMax":161},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":45,"immunities":["Poison"],"resistances":["Blunt","Dark"],"vulnerabilities":["Holy Fire"]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":11,"level":12,"xp":2200,"size":"huge","species":"Beasts","profileLine":"Neutral Evil Huge Beast 12; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"A blood-sucking nightmare, this monster haunts the dark corners of the world, preying on the living.","languages":"","speedText":"4, Fly 10","initiativeDie":"1d8","senses":"Blindsense; Passive Perception 27","passivePerception":27,"attributes":{"str":25,"agi":16,"vit":25,"int":2,"mnd":12,"cha":7},"defences":{"ref":24,"flatFootedRef":21,"fort":30,"will":24},"damageReduction":15,"breakThreshold":45,"immunities":["Poison"],"resistances":["Blunt","Dark"],"weaknesses":["Holy Fire"],"skills":[{"name":"Perception","bonus":17,"key":"perception"},{"name":"Stealth","bonus":9,"key":"stealth"},{"name":"Unarmed","bonus":23,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":23,"damage":"2d6+13","mode":"melee","type":"piercing"},{"name":"Sting","attack":23,"damage":"1d8+13","mode":"melee","type":"piercing"}],"abilities":[{"name":"Blood Drain","description":"Whenever a stirge deals damage to a target with its bite, it heals an amount of HP equal to half the damage dealt (minimum 1)."},{"name":"Bloodlust","description":"The stirge deals +1 damage die against any creature that took physical damage on the previous turn."},{"name":"Poison","description":"When a stirge’s sting deals damage to a living target, the target becomes poisoned by hag’s grasp."},{"name":"Ultrasonic Screech","description":"As a primary action, a stirge can make an attack (d20+23) against the Fort Defence of all enemies within a 12 square cone. If successful, the target moves -1 step on the Break Gauge. The stirge may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Sacrificial Dagger (5%), Chitin (20%), Vampyre Fang (50%)","steal":"Moondust (5%), Antidote (20%)","sourcePage":298}},"prototypeToken":{"name":"Stirge","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"332920f2b777a966","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+13","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f13a81071d8bbfef","name":"Sting","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+13","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat blo