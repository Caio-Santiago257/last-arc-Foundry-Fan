{"_id":"39746349f05c69cb","name":"Bear, Ogre","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":15,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Fueled by impossible rage, this beast ignores lesser wounds, relentlessly pursuing its prey until one or the other falls."},"attributes":{"str":{"score":33},"vit":{"score":25},"agi":{"score":10},"int":{"score":2},"mnd":{"score":12},"cha":{"score":14}},"skills":{"perception":{"trained":true,"total":18},"survival":{"trained":true,"total":13},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":24},"fort":{"total":33},"will":{"total":27}},"resources":{"hp":{"value":200,"max":200,"baseMax":200},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":10,"baseSpeed":10,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":48,"immunities":["Petrify"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":14,"level":15,"xp":2800,"size":"huge","species":"Beasts","profileLine":"Corrupt Evil Huge Beast 15; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Fueled by impossible rage, this beast ignores lesser wounds, relentlessly pursuing its prey until one or the other falls.","languages":"","speedText":"10","initiativeDie":"1d8","senses":"Low-light Vision, Scent; Passive Perception 28","passivePerception":28,"attributes":{"str":33,"agi":10,"vit":25,"int":2,"mnd":12,"cha":14},"defences":{"ref":24,"flatFootedRef":24,"fort":33,"will":27},"damageReduction":15,"breakThreshold":48,"immunities":["Petrify"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":18,"key":"perception"},{"name":"Survival","bonus":13,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":26,"damage":"2d6+20","mode":"melee","type":"piercing"},{"name":"Claws","attack":26,"damage":"1d8+20","mode":"melee","type":"slashing"},{"name":"Gore","attack":30,"damage":"2d6+27","mode":"melee","type":"piercing"}],"abilities":[{"name":"Devour","description":"Whenever an ogre bear reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The ogre bear then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the ogre bear may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Diehard","description":"The ogre bear cannot be moved to the bottom of the Break Gauge, including when it is reduced to 0 HP . However, while at 0 HP , it may only take a primary action each turn and it still dies if damage would beat its Threshold."},{"name":"Overthrow","description":"Whenever an ogre bear successfully deals damage to a target with its gore attack at the end of a charge, they may choose to move the target 3 squares away from them in any direction. This is a stun."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Obsidian (95%)","steal":"Catholicon Ring (5%)","sourcePage":300}},"prototypeToken":{"name":"Bear, Ogre","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"e32a7c8cc0684283","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+20","type":"piercing"},"attack":{"bonus":-2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4ba97f0d42ace49a","name":"Claws","type":"weapon","img":"sy