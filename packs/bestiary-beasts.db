":"Burn","description":"A salamander’s bite attack deals fire damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target takes an additional 2d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR."},{"name":"Firebolt","description":"As a primary action, a salamander may make an attack (d20+18) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target suffers 6d6+8 fire damage. Otherwise, the target takes half damage. Additionally, if the attack roll beat the Ref Defence of any creatures adjacent to the target, they take half that damage. The salamander may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Fire Crystal (50%), Beast Scale (95%)","steal":"Hi-Potion (95%)","sourcePage":292}},"prototypeToken":{"name":"Salamander","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"19f0844e461f71e3","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+7","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0221a604125e384e","name":"Burn","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"A salamander’s bite attack deals fire damage. Additionally, if the attack roll beats both the target’s Ref and Fort Defence, the target takes an additional 2d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"11dbf14b74ab4a16","name":"Firebolt","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, a salamander may make an attack (d20+18) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target suffers 6d6+8 fire damage. Otherwise, the target takes half damage. Additionally, if the attack roll beat the Ref Defence of any creatures adjacent to the target, they take half that damage. The salamander may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a9305e3692e02f44","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ffc5e218ef09e701","name":"Skill Focus (perception, stealth, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Aeolian_Edge.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, stealth, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"c2560086a39d7e38","name":"Chimera","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Abominable beasts rumored to be the twisted result of a mad wizard’s horrific experiments."},"attributes":{"str":{"score":24},"vit":{"score":18},"agi":{"score":12},"int":{"score":5},"mnd":{"score":12},"cha":{"score":10}},"skills":{"lore-terrestrial":{"trained":true,"total":6},"perception":{"trained":true,"total":10},"survival":{"trained":true,"total":10},"unarmed":{"trained":true,"total":21}},"defences":{"ref":{"total":20},"fort":{"total":24},"will":{"total":26}},"resources":{"hp":{"value":95,"max":95,"baseMax":95},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":34,"immunities":["Disease","Paralysis","Poison","Sleep"],"resistances":["Dark"],"vulnerabilities":["Holy"]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":8,"level":9,"xp":1600,"size":"large","species":"Beasts","profileLine":"Corrupt Evil Large Beast 9; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Abominable beasts rumored to be the twisted result of a mad wizard’s horrific experiments.","languages":"","speedText":"6, Fly 10","initiativeDie":"1d6","senses":"Dark Vision, Scent; Passive Perception 20","passivePerception":20,"attributes":{"str":24,"agi":12,"vit":18,"int":5,"mnd":12,"cha":10},"defences":{"ref":20,"flatFootedRef":19,"fort":24,"will":26},"damageReduction":10,"breakThreshold":34,"immunities":["Disease","Paralysis","Poison","Sleep"],"resistances":["Dark"],"weaknesses":["Holy"],"skills":[{"name":"Lore (terrestrial)","bonus":6,"key":"lore-terrestrial"},{"name":"Perception","bonus":10,"key":"perception"},{"name":"Survival","bonus":10,"key":"survival"},{"name":"Unarmed","bonus":21,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":21,"damage":"1d8+11","mode":"melee","type":"piercing"},{"name":"Claws","attack":21,"damage":"1d6+11","mode":"melee","type":"slashing"}],"abilities":[{"name":"Chimera Brain","description":"Chimeras gain a +5 bonus to their Will Defence."},{"name":"Fire Breath","description":"A chimera may make an attack (d20+18) against the Ref Defence of all creatures in a 6 square cone. If successful, targets take 6d6+8 fire damage. Otherwise, targets take only half damage. The chimera may not use this ability again for 1d4+1 turns. This is an area effect."},{"name":"Poison","description":"When a chimera’s bite or tail slam deals damage to a living target, there is a 75% chance (75 or less on d%) the target becomes poisoned by hag’s grasp."},{"name":"Tail Slam","description":"Whenever the chimera uses a primary action to attack while flanked, it may make a free sting attack (d20+21) against another target within reach that is providing the initial target the flanking bonus. This attack deals 1d6+11 damage."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Antidote (20%), Hi-Potion (50%)","steal":"Remedy (5%), Stardust (20%), 60gp (95%)","sourcePage":293}},"prototypeToken":{"name":"Chimera","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"8ff66412a8f40d4a","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+11","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"fb560451720a1ccf","name":"Claws","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icon