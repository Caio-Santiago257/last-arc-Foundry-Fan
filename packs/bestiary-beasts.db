{"_id":"ca1ece68a53dcce3","name":"Manticore","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Hulking monsters that lurk in the shadowed chasms of the Uplands, manticores prey on those desperate enough to seek shelter from dragons—turning refuge into a deadly trap."},"attributes":{"str":{"score":20},"vit":{"score":18},"agi":{"score":15},"int":{"score":2},"mnd":{"score":12},"cha":{"score":9}},"skills":{"athletics":{"trained":true,"total":13},"perception":{"trained":true,"total":9},"stealth":{"trained":true,"total":5},"unarmed":{"trained":true,"total":18}},"defences":{"ref":{"total":17},"fort":{"total":20},"will":{"total":22}},"resources":{"hp":{"value":65,"max":65,"baseMax":65},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":8,"baseSpeed":8,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":25,"immunities":["Blind","Poison"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":5,"level":6,"xp":1000,"size":"large","species":"Beasts","profileLine":"Corrupt Evil Large Beast 6; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Hulking monsters that lurk in the shadowed chasms of the Uplands, manticores prey on those desperate enough to seek shelter from dragons—turning refuge into a deadly trap.","languages":"","speedText":"8","initiativeDie":"1d6","senses":"Dark Vision, Scent;","passivePerception":19,"attributes":{"str":20,"agi":15,"vit":18,"int":2,"mnd":12,"cha":9},"defences":{"ref":17,"flatFootedRef":15,"fort":20,"will":22},"damageReduction":5,"breakThreshold":25,"immunities":["Blind","Poison"],"resistances":[],"weaknesses":[],"skills":[{"name":"Athletics","bonus":13,"key":"athletics"},{"name":"Perception","bonus":9,"key":"perception"},{"name":"Stealth","bonus":5,"key":"stealth"},{"name":"Unarmed","bonus":18,"key":"unarmed"}