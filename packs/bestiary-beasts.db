{"_id":"c805e70a86302b20","name":"Red Widow","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":3,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Lurking in the shadowed depths of the sewers, these cruel arachnids weave intricate webs to trap the unwary. Their venom paralyzes the body while leaving the mind awake, condemning their victims to feel every bite."},"attributes":{"str":{"score":11},"vit":{"score":12},"agi":{"score":17},"int":{"score":2},"mnd":{"score":10},"cha":{"score":2}},"skills":{"perception":{"trained":true,"total":6},"stealth":{"trained":true,"total":14},"unarmed":{"trained":true,"total":11}},"defences":{"ref":{"total":16},"fort":{"total":13},"will":{"total":13}},"resources":{"hp":{"value":18,"max":18,"baseMax":18},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":0,"baseDamageReduction":0,"breakThreshold":14,"immunities":["Poison"],"resistances":[],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":2,"level":3,"xp":400,"size":"medium","species":"Beasts","profileLine":"Neutral Medium Beast 3; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"Lurking in the shadowed depths of the sewers, these cruel arachnids weave intricate webs to trap the unwary. Their venom paralyzes the body while leaving the mind awake, condemning their victims to feel every bite.","languages":"","speedText":"6, Climb 6","initiativeDie":"1d8","senses":"Dark Vision, Tremorsense; Passive Perception 16","passivePerception":16,"attributes":{"str":11,"agi":17,"vit":12,"int":2,"mnd":10,"cha":2},"defences":{"ref":16,"flatFootedRef":13,"fort":13,"will":13},"damageReduction":0,"breakThreshold":14,"immunities":["Poison"],"resistances":[],"weaknesses":["Fire"],"skills":[{"name":"Perception","bonus":6,"key":"perception"},{"name":"Stealth","bonus":14,"key":"stealth"},{"name":"Unarmed","bonus":11,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":11,"damage":"1d6+1","mode":"melee","type":"piercing"}],"abilities":[{"name":"Poison","description":"When a red widow’s bite deals damage to a living target, there is a 25% chance (25 or less on d%) the target becomes poisoned by widow’s kiss."},{"name":"Web","description":"As a primary action, a red widow can make an attack (d20+12) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target’s speed is reduced to 0 and they become flat-footed. A creature must make a DC 20 Str check as a primary action, or take fire damage, to end this effect. The red widow may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Poison Fang (5%), Silk Thread (20%), Chitin (50%)","steal":"Philter (20%), 1gp (50%)","sourcePage":283}},"prototypeToken":{"name":"Red Widow","texture":{"src":"icons/svg/mystery-man.svg"},"width":1,"height":1,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"68fa6fd08b65d689","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d6+1","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"475c2b1f7cb85383","name":"Poison","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Living_Dead.webp","system":{"category":"Special Ability","description":"When a red widow’s bite deals damage to a living target, there is a 25% chance (25 or less on d%) the target becomes poisoned by widow’s kiss.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort