{"_id":"9b995a74e0067ea1","name":"Tyrantula","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Nightmarish spiders that ensnare prey in webs laced with corrosive acid."},"attributes":{"str":{"score":24},"vit":{"score":20},"agi":{"score":15},"int":{"score":1},"mnd":{"score":10},"cha":{"score":2}},"skills":{"perception":{"trained":true,"total":15},"unarmed":{"trained":true,"total":22}},"defences":{"ref":{"total":22},"fort":{"total":26},"will":{"total":21}},"resources":{"hp":{"value":115,"max":115,"baseMax":115},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":36,"immunities":["Mind Effects","Poison","Toad"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":9,"level":10,"xp":1800,"size":"large","species":"Beasts","profileLine":"Neutral Large Beast 10; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"Nightmarish spiders that ensnare prey in webs laced with corrosive acid.","languages":"","speedText":"6, Climb 6","initiativeDie":"1d8","senses":"Dark Vision, Tremorsense; Passive Perception 25","passivePerception":25,"attributes":{"str":24,"agi":15,"vit":20,"int":1,"mnd":10,"cha":2},"defences":{"ref":22,"flatFootedRef":20,"fort":26,"will":21},"damageReduction":10,"breakThreshold":36,"immunities":["Mind Effects","Poison","Toad"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":15,"key":"perception"},{"name":"Unarmed","bonus":22,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":22,"damage":"1d8+12","mode":"melee","type":"piercing"}],"abilities":[{"name":"Corrosive Web","description":"As a primary action, a tyrantula can make an attack (d20+20) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target’s speed is reduced to 0 and they become flat-footed. A creature must make a DC 20 Str check as a primary action, or take fire damage, to end this effect. Additionally, should the attack beat the target’s defence by 10 or more, the target's armour is moved -1 step on the Break Gauge. The tyrantula may not use this ability again for 1d4+1 turns."},{"name":"Poison","description":"When a tyrantula’s bite deals damage to a living target, there is a 75% chance (75 or less on d%) the target becomes poisoned by black adder venom."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Poison Fang (20%), Silk Thread (50%), Chitin (95%)","steal":"Moondust (5%), Hi-Potion (95%)","sourcePage":295}},"prototypeToken":{"name":"Tyrantula","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"9cff3bc7affb68f1","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+12","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a8d13fb285a056c5","name":"Corrosive Web","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, a tyrantula can make an attack (d20+20) against the Ref Defence of a single creature within 6 squares and line of sight. If successful, the target’s speed is reduced to 0 and they become flat-footed. A creature must make a DC 20 Str check as a primary action, or take fire damage, to end this effect. Additionally, should the attack beat the target’s defence by 10 or more, the target's armour is moved -1 step on the Break Gauge. The tyrantula may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d0ac7a7d26f42496","name":"Poison","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRK/Living_Dead.webp","system":{"category":"Special Ability","description":"When a tyrantula’s bite deals damage to a living target, there is a 75% chance (75 or less on d%) the target becomes poisoned by black adder venom.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1331558767dc77fe","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"95575e0b17fe5f3f","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"35425cc4b52d9363","name":"Skill Focus (perception, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5a5e2746073e9302","name":"