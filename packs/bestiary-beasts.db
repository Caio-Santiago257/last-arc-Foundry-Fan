{"_id":"ff840c8caa51a492","name":"Mammoth","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Favored by the dwarven lords of the Knorhing Highlands, these massive beasts serve as formidable battle mounts."},"attributes":{"str":{"score":30},"vit":{"score":23},"agi":{"score":10},"int":{"score":2},"mnd":{"score":13},"cha":{"score":6}},"skills":{"perception":{"trained":true,"total":11},"survival":{"trained":true,"total":11},"unarmed":{"trained":true,"total":25}},"defences":{"ref":{"total":20},"fort":{"total":28},"will":{"total":23}},"resources":{"hp":{"value":137,"max":137,"baseMax":137},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":43,"immunities":["Paralysis","Petrify","Sleep"],"resistances":["Cold","Piercing"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":10,"level":11,"xp":2000,"size":"huge","species":"Beasts","profileLine":"Neutral Huge Beast 11; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"Favored by the dwarven lords of the Knorhing Highlands, these massive beasts serve as formidable battle mounts.","languages":"","speedText":"8","initiativeDie":"1d8","senses":"Scent; Passive Perception 21","passivePerception":21,"attributes":{"str":30,"agi":10,"vit":23,"int":2,"mnd":13,"cha":6},"defences":{"ref":20,"flatFootedRef":20,"fort":28,"will":23},"damageReduction":10,"breakThreshold":43,"immunities":["Paralysis","Petrify","Sleep"],"resistances":["Cold","Piercing"],"weaknesses":[],"skills":[{"name":"Perception","bonus":11,"key":"perception"},{"name":"Survival","bonus":11,"key":"survival"},{"name":"Unarmed","bonus":25,"key":"unarmed"}],"attacks":[{"name":"Gore","attack":25,"damage":"2d6+15","mode":"melee","type":"piercing"},{"name":"Gore","attack":29,"damage":"2d6+20","mode":"melee","type":"piercing"}],"abilities":[{"name":"Overrun","description":"The mammoth is treated as having the Trample technick and is treated as both mount and rider while charging."},{"name":"Tremor","description":"As a primary action, the mammoth can make an attack roll (d20+21) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+11 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The mammoth may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun."},{"name":"Tusk","description":"Whenever the mammoth successfully hits a target with its gore attack at the end of a charge, the damage ignores non-magickal DR."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Beast Fang (50%), Beast Mane (95%)","steal":"Stardust (5%), Pistoja Powder (50%)","sourcePage":297}},"prototypeToken":{"name":"Mammoth","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"98b34ef8131d875b","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+15","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"e31a5668fd62cbec","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+20","type":"piercing"},"attack":{"bonus":4},"npcStaticAttack":tr