ry action, a vampyre bat may make an attack roll (d20+8) against the Fort Defence of all enemies within a 4 square cone. If successful, the target moves -1 step on the Break Gauge. The vampyre bat may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"71ca2aa362b529f4","name":"Agile Manoeuvres","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Inner_Strength.webp","system":{"description":"Use Agility instead of Strength for Unarmed checks.","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9d75f63d96917d61","name":"Skill Focus (stealth)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Aeolian_Edge.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"stealth","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
