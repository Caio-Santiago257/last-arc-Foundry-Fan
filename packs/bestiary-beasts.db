{"_id":"4634de7b84858f6c","name":"Mastodon","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":17,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Titanic monstrosities, these beasts of burden and war serve the jotun of the Northern Wastes with relentless strength."},"attributes":{"str":{"score":34},"vit":{"score":24},"agi":{"score":12},"int":{"score":2},"mnd":{"score":14},"cha":{"score":6}},"skills":{"athletics":{"trained":true,"total":25},"perception":{"trained":true,"total":15},"unarmed":{"trained":true,"total":30}},"defences":{"ref":{"total":27},"fort":{"total":35},"will":{"total":30}},"resources":{"hp":{"value":226,"max":226,"baseMax":226},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":12,"baseSpeed":12,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":50,"immunities":["Confusion","Curses","Paralysis","Petrify","Poison","Toad"],"resistances":["Cold","Piercing"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":16,"level":17,"xp":3200,"size":"huge","species":"Beasts","profileLine":"Neutral Huge Beast 17; Territorial*","classLevels":"","alignment":"Neutral","temperament":"Territorial*","description":"Titanic monstrosities, these beasts of burden and war serve the jotun of the Northern Wastes with relentless strength.","languages":"","speedText":"12","initiativeDie":"1d8","senses":"Low-light Vision, Scent; Passive Perception 25","passivePerception":25,"attributes":{"str":34,"agi":12,"vit":24,"int":2,"mnd":14,"cha":6},"defences":{"ref":27,"flatFootedRef":26,"fort":35,"will":30},"damageReduction":15,"breakThreshold":50,"immunities":["Confusion","Curses","Paralysis","Petrify","Poison","Toad"],"resistances":["Cold","Piercing"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":25,"key":"athletics"},{"name":"Perception","bonus":15,"key":"perception"},{"name":"Unarmed","bonus":30,"key":"unarmed"}],"attacks":[{"name":"Gore","attack":28,"damage":"2d6+22","mode":"melee","type":"blunt"},{"name":"Gore (Powerful Charge)","attack":32,"damage":"2d6+30","mode":"melee","type":"blunt"}],"abilities":[{"name":"Overrun","description":"The mastodon is treated as having the Trample technick and is treated as both mount and rider while charging."},{"name":"Tremor","description":"As a primary action, the mastodon can make an attack (d20+25) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 10d6+15 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The mastodon may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun."},{"name":"Tusk","description":"Whenever the mastodon successfully hits a target with its gore attack, at the end of a charge, the damage ignores non-magickal DR."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Ancient Bone (20%), Beast Fang (50%), Beast Hide (95%)","steal":"Moondust (5%), Mega-Potion (20%)","sourcePage":302}},"prototypeToken":{"name":"Mastodon","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"4b8bbcc56843401e","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+22","type":"blunt"},"attack":{"bonus":-2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"310cae98aed93b81","name":"Gore (Powerful Charge)","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+30","type":"blunt"},"attack":{"bonus":2},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"be77c0b807d428b8","name":"Overrun","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"The mastodon is treated as having the Trample technick and is treated as both mount and rider while charging.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b7292b9a8824b2ca","name":"Tremor","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, the mastodon can make an attack (d20+25) against the Ref Defence of all creatures within a 12 square cone. If successful, creatures take 10d6+15 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The mastodon may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area effect and the secondary effect is a stun.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"352e3fd1b1f32b50","name":"Tusk","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"Whenever the mastodon successfully hits a target with its gore attack, at the end of a charge, the damage ignores non-magickal DR.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ce2339e140d935fb","name":"Bull Rush","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-ico