{"_id":"2b09024d2d7443de","name":"Anaconda","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"The giant, “man-eating” serpents of the Malloram Jungle are silent and patient predators. They wait for their prey to retrace their path, then strike swiftly— ambushing, constricting, and swallowing them whole."},"attributes":{"str":{"score":25},"vit":{"score":16},"agi":{"score":15},"int":{"score":2},"mnd":{"score":14},"cha":{"score":2}},"skills":{"perception":{"trained":true,"total":9},"survival":{"trained":true,"total":9},"unarmed":{"trained":true,"total":19}},"defences":{"ref":{"total":16},"fort":{"total":18},"will":{"total":17}},"resources":{"hp":{"value":50,"max":50,"baseMax":50},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":28,"immunities":["Paralysis"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":4,"level":5,"xp":800,"size":"large","species":"Beasts","profileLine":"Neutral Large Beast 5; Territorial","classLevels":"","alignment":"Neutral","temperament":"Territorial","description":"The giant, “man-eating” serpents of the Malloram Jungle are silent and patient predators. They wait for their prey to retrace their path, then strike swiftly— ambushing, constricting, and swallowing them whole.","languages":"","speedText":"4, Climb 4, Swim 4","initiativeDie":"1d8","senses":"Scent; Passive Perception 19","passivePerception":19,"attributes":{"str":25,"agi":15,"vit":16,"int":2,"mnd":14,"cha":2},"defences":{"ref":16,"flatFootedRef":14,"fort":18,"will":17},"damageReduction":5,"breakThreshold":28,"immunities":["Paralysis"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":9,"key":"perception"},{"name":"Survival","bonus":9,"key":"survival"},{"name":"Unarmed","bonus":19,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":19,"damage":"1d8+9","mode":"melee","type":"piercing"}],"abilities":[{"name":"Constrict","description":"An anaconda is treated as having the Pin and Crush technicks when making a grab and while grabbing a target. Additionally, whenever the anaconda uses the Crush technick, it deals +1 die of damage."},{"name":"Lurk","description":"Anacondas can more naturally blend into their surroundings. When in jungles or savannahs, anacondas treat Stealth as a trained skill and ignore any size penalties to Stealth checks."}],"spells":[],"performances":[],"equipped":"","loot":"Putrid Flesh (5%), Moonwort (20%), Beast Fang (50%), Beast Scale (95%)","steal":"Leather Breastplate (5%), 400gp (20%), Earth Crystal (50%)","sourcePage":285}},"prototypeToken":{"name":"Anaconda","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"d76192a120ee269f","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+9","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"1e5c00e044dd4641","name":"Constrict","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/NIN/Armor_Crush.webp","system":{"category":"Special Ability","description":"An anaconda is treated as having the Pin and Crush technicks when making a grab and while grabbing a target. Additionally, whenever the anaconda uses the Crush technick, it deals +1 die of damage.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6c2b84f5d2