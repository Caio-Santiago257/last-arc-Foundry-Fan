{"_id":"4379424f7d75196a","name":"Tortoise, Great","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":10,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Massive turtles armored with impenetrable shells of adamantite, moving slow but nearly unstoppable."},"attributes":{"str":{"score":28},"vit":{"score":24},"agi":{"score":6},"int":{"score":2},"mnd":{"score":13},"cha":{"score":6}},"skills":{"perception":{"trained":true,"total":16},"survival":{"trained":true,"total":11},"unarmed":{"trained":true,"total":24}},"defences":{"ref":{"total":17},"fort":{"total":28},"will":{"total":22}},"resources":{"hp":{"value":135,"max":135,"baseMax":135},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":4,"baseSpeed":4,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":43,"immunities":["Confusion","Curse","Stuns"],"resistances":["Blunt*","Cold","Electric","Piercing*","Slashing*"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":9,"level":10,"xp":1800,"size":"huge","species":"Beasts","profileLine":"Neutral Huge Beast 10; Defensive","classLevels":"","alignment":"Neutral","temperament":"Defensive","description":"Massive turtles armored with impenetrable shells of adamantite, moving slow but nearly unstoppable.","languages":"","speedText":"4/0* , Swim 4/0*","initiativeDie":"1d8","senses":"Low-light Vision, Scent; Passive Perception 26","passivePerception":26,"attributes":{"str":28,"agi":6,"vit":24,"int":2,"mnd":13,"cha":6},"defences":{"ref":17,"flatFootedRef":17,"fort":28,"will":22},"damageReduction":10,"breakThreshold":43,"immunities":["Confusion","Curse","Stuns"],"resistances":["Blunt*","Cold","Electric","Piercing*","Slashing*"],"weaknesses":["Fire"],"skills":[{"name":"Perception","bonus":16,"key":"perception"},{"name":"Survival","bonus":11,"key":"survival"},{"name":"Unarmed","bonus":24,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":24,"damage":"2d6+14","mode":"melee","type":"piercing"}],"abilities":[{"name":"Immovable","description":"The great tortoise cannot be moved by any means of forced movement, including teleportation."},{"name":"Impassable*","description":"Creatures may not move through squares occupied by the great tortoise, regardless of size."},{"name":"Mighty Guard","description":"As a secondary action, the great tortoise can retreat into its shell for 1d4+1 turns, treating itself as blind. While in its shell, the great tortoise clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the great tortoise would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the great tortoise may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Adamantite (20%), Storm Crystal (50%)","steal":"Stardust (5%), Wind Garb (20%), Storm Crystal (95%)","sourcePage":296}},"prototypeToken":{"name":"Tortoise, Great","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"740356ec1ee47b3d","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+14","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"522a70dca6ad879f","name":"Immovable","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"category":"Special Ability","description":"The great tortoise cannot be moved by any means of forced movement, including teleportation.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f95b3d179505d5d6","name":"Impassable*","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"category":"Special Ability","description":"Creatures may not move through squares occupied by the great tortoise, regardless of size.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"8a9301625d270921","name":"Mighty Guard","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"As a secondary action, the great tortoise can retreat into its shell for 1d4+1 turns, treating itself as blind. While in its shell, the great tortoise clears itself of all status effects (except curses) and gains immunity to all status effects (except curses). Additionally, if damaged by melee attacks, half the damage the great tortoise would suffer is instead dealt to the attacker as unaspected damage. Once this effect ends, the great tortoise may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"bf88861c5fd168d3","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"0c4e22f8e232f466","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"c82ac4e120d72827","name":"Skill Focus (perception, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3a1214f98af23c7f","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"3e3a467d9cd2ddfc","name":"Beither","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"A fearsome beast crackling with electricity, lightning constantly arcs from its immense body."},"attributes":{"str":{"score":25},"vit":{"score":20},"agi":{"score":17},"int":{"score":2},"mnd":{"score":12},"cha":{"score":7}},"skills":{"perception":{"trained":true,"total":16},"stealth":{"trained":true,"total":13},"unarmed":{"trained":true,"total":22}},"defences":{"ref":{"total":24},"fort":{"total":27},"will":{"total":23}},"resources":{"hp":{"value":126,"max":126,"baseMax":126},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":32,"immunities":["Electric","Paralysis","Sleep"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":10,"level":11,"xp":2000,"size":"large","species":"Beasts","profileLine":"Neutral Large Beast 11; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"A fearsome beast crackling with electricity, lightning constantly arcs from its immense body.","languages":"","speedText":"6, Climb 6","initiativeDie":"1d6","senses":"Low-light Vision, Scent; Passive Perception 26","passivePerception":26,"attributes":{"str":25,"agi":17,"vit":20,"int":2,"mnd":12,"cha":7},"defences":{"ref":24,"flatFootedRef":21,"fort":27,"will":23},"damageReduction":10,"breakThreshold":32,"immunities":["Electric","Paralysis","Sleep"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":16,"key":"perception"},{"name":"Stealth","bonus":13,"key":"stealth"},{"name":"Unarmed","bonus":22,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":22,"damage":"1d8+12","mode":"melee","type":"piercing"}],"abilities":[{"name":"Conductive","description":"A beither’s bite attack deals electric damage. Additionally, if the attack roll beats both a target’s Ref and Fort Defence, the target becomes flat-footed until the start of the beither's next turn."},{"name":"Forked Lightning","description":"As a primary action, the beithir can make an attack (d20+20) against th e Ref Defence of up to 5 creatures within a 6 square cone. If successful, targets take 6d6+10 electric damage. Otherwise, targets take only half damage. Additionally, if the attack roll beat both a target's Ref and Fort Defence, the target becomes paralysed. The beithir may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Electromancer’s Ring (5%), Storm Crystal (50%), Beast Scale (95%)","steal":"Moonwort (20%), Storm Crystal (95%)","sourcePage":296}},"prototypeToken":{"name":"Beither","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"378c57d4272dcf9c","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+12","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cb9334bda5696385","name":"Conductive","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"A beither’s bite attack deals electric damage. Additionally, if the attack roll beats both a target’s Ref and Fort Defence, the target becomes flat-footed until the start of the beither's next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b1eea820dde7102a","name":"Forked Lightning","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, the beithir can make an attack (d20+20) against th e Ref Defence of up to 5 creatures within a 6 square cone. If successful, targets take 6d6+10 electric damage. Otherwise, targets take only half damage. Additionally, if the attack roll beat both a target's Ref and Fort Defence, the target becomes paralysed. The beithir may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ef4120ee447942e3","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3c3aa6d63cf98cea","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"f859f94d2a05a1ff","name":"Improved Initiative","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Adloquium.webp","system":{"description":"Improve your initiative die by one step (d12 to d10, d10 to d8, d8 to d6, d6 to d4, d4 to d3). It cannot improve beyond d3.","repeatable":true,"effects":{"initiativeStep":1},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"4a18fdca90cc0986","name":"Skill Focus (perception, stealth, unarmed)","type":"technick","img":"systems/last-