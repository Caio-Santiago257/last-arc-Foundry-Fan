{"_id":"9e39ec5702e48b97","name":"Wolf, Dire","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":5,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Neutral","biography":"Towering apex predators of Rydia, these massive wolves lead ravenous packs across the lowlands. They strike fear into farmers and caravans alike, hunting relentlessly for livestock—and anything else unfortunate enough to cross their path."},"attributes":{"str":{"score":19},"vit":{"score":17},"agi":{"score":15},"int":{"score":2},"mnd":{"score":12},"cha":{"score":10}},"skills":{"perception":{"trained":true,"total":8},"stealth":{"trained":true,"total":4},"survival":{"trained":true,"total":8},"unarmed":{"trained":true,"total":16}},"defences":{"ref":{"total":16},"fort":{"total":18},"will":{"total":16}},"resources":{"hp":{"value":40,"max":40,"baseMax":40},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":10,"baseSpeed":10,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":23,"immunities":[],"resistances":["Cold"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":4,"level":5,"xp":800,"size":"large","species":"Beasts","profileLine":"Neutral Large Beast 5; Aggressive","classLevels":"","alignment":"Neutral","temperament":"Aggressive","description":"Towering apex predators of Rydia, these massive wolves lead ravenous packs across the lowlands. They strike fear into farmers and caravans alike, hunting relentlessly for livestock—and anything else unfortunate enough to cross their path.","languages":"","speedText":"10","initiativeDie":"1d6","senses":"Low-light Vision, Scent; Passive Perception 18","passivePerception":18,"attributes":{"str":19,"agi":15,"vit":17,"int":2,"mnd":12,"cha":10},"defences":{"ref":16,"flatFootedRef":14,"fort":18,"will":16},"damageReduction":5,"breakThreshold":23,"immunities":[],"resistances":["Cold"],"weaknesses":[],"skills":[{"name":"Perception","bonus":8,"key":"perception"},{