{"_id":"f719e019b9f30861","name":"Sphinx","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":13,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Fickle guardians of Al-Sabrah’s lost treasures— seemingly benevolent, but never to be fully trusted."},"attributes":{"str":{"score":35},"vit":{"score":26},"agi":{"score":10},"int":{"score":12},"mnd":{"score":13},"cha":{"score":17}},"skills":{"deception":{"trained":true,"total":19},"lore-terrestrial":{"trained":true,"total":12},"perception":{"trained":true,"total":17},"persuasion":{"trained":true,"total":19},"survival":{"trained":true,"total":12},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":22},"fort":{"total":32},"will":{"total":25}},"resources":{"hp":{"value":187,"max":187,"baseMax":187},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":42,"immunities":["Mind Effects","Paralysis","Petrify","Slow"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":12,"level":13,"xp":2400,"size":"huge","species":"Beasts","profileLine":"Corrupt Good Huge Beast 13; Territorial","classLevels":"","alignment":"Corrupt","temperament":"Territorial","description":"Fickle guardians of Al-Sabrah’s lost treasures— seemingly benevolent, but never to be fully trusted.","languages":"","speedText":"8, Fly 10","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 27","passivePerception":27,"attributes":{"str":35,"agi":10,"vit":26,"int":12,"mnd":13,"cha":17},"defences":{"ref":22,"flatFootedRef":22,"fort":32,"will":25},"damageReduction":15,"breakThreshold":42,"immunities":["Mind Effects","Paralysis","Petrify","Slow"],"resistances":[],"weaknesses":[],"skills":[{"name":"Deception","bonus":19,"key":"deception"},{"name":"Lore (arcane)","bonus":12,"key":""},{"name":"Lore (social)","bonus":12,"key":""},{"name":"Lore (terrestrial)","bonus":12,"key":"lore-terrestrial"},{"name":"Perception","bonus":17,"key":"perception"},{"name":"Persuasion","bonus":19,"key":"persuasion"},{"name":"Survival","bonus":12,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Claws","attack":28,"damage":"1d8+18","mode":"melee","type":"slashing"}],"abilities":[{"name":"Death Gaze","description":"As a primary action, a sphinx may make an attack (d20+17) against the Fort Defence of a living creature within 6 squares and line of sight. If successful, the target becomes petrified. Otherwise, the creature instead becomes paralysed. If the attack failed by 5 or more, the creature suffers no status effect. The sphinx may not use this ability again for 1d4+1 turns."},{"name":"Purify","description":"As a secondary action, a sphinx may clear itself of all status effects, except curses. The sphinx may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Evil Eye (20%), Orichalcum (50%), Great Feather (95%)","steal":"Dwarven Warpick (5%), Moonwart (20%), Orichalcum (50%)","sourcePage":298}},"prototypeToken":{"name":"Sphinx","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"d23dc6de7757173e","name":"Claws","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+18","type":"slashing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"cb90553049f613a2","name":"Death Gaze","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.web