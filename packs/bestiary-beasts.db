{"_id":"a87488107f803535","name":"Hell Pig","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":14,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Blazing beasts that rampage through the Chitari Badlands, leaving nothing but smoldering ruins in their wake."},"attributes":{"str":{"score":32},"vit":{"score":29},"agi":{"score":13},"int":{"score":2},"mnd":{"score":22},"cha":{"score":10}},"skills":{"perception":{"trained":true,"total":18},"survival":{"trained":true,"total":23},"unarmed":{"trained":true,"total":28}},"defences":{"ref":{"total":24},"fort":{"total":34},"will":{"total":31}},"resources":{"hp":{"value":215,"max":215,"baseMax":215},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":10,"baseSpeed":10,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":49,"immunities":["Fire"],"resistances":["Electric"],"vulnerabilities":["Cold"]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":13,"level":14,"xp":2600,"size":"huge","species":"Beasts","profileLine":"Corrupt Evil Huge Beast 14; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Blazing beasts that rampage through the Chitari Badlands, leaving nothing but smoldering ruins in their wake.","languages":"","speedText":"10","initiativeDie":"1d8","senses":"Scent; Passive Perception 28","passivePerception":28,"attributes":{"str":32,"agi":13,"vit":29,"int":2,"mnd":22,"cha":10},"defences":{"ref":24,"flatFootedRef":23,"fort":34,"will":31},"damageReduction":15,"breakThreshold":49,"immunities":["Fire"],"resistances":["Electric"],"weaknesses":["Cold"],"skills":[{"name":"Perception","bonus":18,"key":"perception"},{"name":"Survival","bonus":23,"key":"survival"},{"name":"Unarmed","bonus":28,"key":"unarmed"}],"attacks":[{"name":"Gore","attack":28,"damage":"2d6+18","mode":"melee","type":"piercing"},{"name":"Gore","attack":32,"damage":"2d6+25","mode":"melee","type":"piercing"}],"abilities":[{"name":"Burn","description":"A hell pig’s gore attack deals fire damage. Additionally, if the attack roll beats both the targe t's Ref and Fort Defence, the target takes an additional 3d6 fire damage at the start of its next turn, before taking any other action. This damage ignores DR."},{"name":"Heatwave","description":"Any creature that begins their turn within the hell pig's reach is subject to an attack (d20+26) against their Ref Defence. If successful, the creature suffers 4d6 fire damage. Otherwise, the creature takes half damage. This is an area effect."},{"name":"Overrun","description":"The hell pig is treated as having the Trample technick and is treated as both mount and rider while charging."},{"name":"Tusk","description":"Whenever the hell pig successfully hits a target with its gore attack at the end of a charge, the damage ignores non-magickal DR."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (20%), Beast Fang (50%), Fire Crystal (95%)","steal":"Flame Pendant (20%)","sourcePage":299}},"prototypeToken":{"name":"Hell Pig","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"b49fcd1fd6665ac7","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+18","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"355a530572b781c4","name":"Gore","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+25","type":