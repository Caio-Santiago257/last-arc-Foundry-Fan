{"_id":"79907258365896d6","name":"Basilisk","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":7,"xp":0,"nextLevel":0,"className":"","race":"Beasts","alignment":"Corrupt","biography":"Oft used as a grim object lesson, this sadistic creature embodies the phrase, “if looks could kill”—for in its case, they truly do."},"attributes":{"str":{"score":26},"vit":{"score":20},"agi":{"score":14},"int":{"score":2},"mnd":{"score":12},"cha":{"score":2}},"skills":{"perception":{"trained":true,"total":9},"survival":{"trained":true,"total":9},"unarmed":{"trained":true,"total":21}},"defences":{"ref":{"total":18},"fort":{"total":23},"will":{"total":19}},"resources":{"hp":{"value":82,"max":82,"baseMax":82},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d6","speed":4,"baseSpeed":4,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":33,"immunities":["Paralysis","Petrify","Poison"],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Beasts","profile":"beast","cr":7,"level":7,"xp":1400,"size":"huge","species":"Beasts","profileLine":"Corrupt Evil Huge Beast 7; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Oft used as a grim object lesson, this sadistic creature embodies the phrase, “if looks could kill”—for in its case, they truly do.","languages":"","speedText":"4, Climb 4","initiativeDie":"1d6","senses":"Dark Vision; Passive Perception 19","passivePerception":19,"attributes":{"str":26,"agi":14,"vit":20,"int":2,"mnd":12,"cha":2},"defences":{"ref":18,"flatFootedRef":16,"fort":23,"will":19},"damageReduction":5,"breakThreshold":33,"immunities":["Paralysis","Petrify","Poison"],"resistances":[],"weaknesses":[],"skills":[{"name":"Perception","bonus":9,"key":"perception"},{"name":"Survival","bonus":9,"key":"survival"},{"name":"Unarmed","bonus":21,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":21,"damage":"2d6+11","mode":"melee","type":"piercing"}],"abilities":[{"name":"Death Gaze","description":"As a primary action, a basilisk may make an attack (d20+14) against the Fort Defence of a living creature within 6 squares and line of sight. If successful, the target becomes petrified. Otherwise, the creature instead becomes paralysed. If the attack failed by 5 or more, the creature suffers no status effect. The basilisk may not use this ability again for 1d4+1 turns."},{"name":"Lurk","description":"Basilisks are better at naturally blending into their surroundings. When in mountains or caves, basilisks treat Stealth as a trained skill and ignore any size penalties to their Stealth checks."},{"name":"Poison","description":"When a basilisk’s bite deals damage to a living target, there is a 50% chance (50 or less on d%) the target becomes poisoned by basilisk venom."}],"spells":[],"performances":[],"equipped":"","loot":"Evil Eye (5%), Poison Fang (20%), Moonwort (50%), Beast Scale (95%)","steal":"Stardust (5%), Bone Club (20%), Antidote (95%)","sourcePage":291}},"prototypeToken":{"name":"Basilisk","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"94d8ec1f89f6dfc3","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+11","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"07943a1e99dac3a7","name":"Death Gaze","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/The_Beast_Within.webp","system":{"category":"Special Ability","description":"As a primary action, a basilisk may make an attack (d20+14) against the Fort Defence of a l