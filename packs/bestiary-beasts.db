name":"Blood Drain","description":"Whenever a dire bat deals damage to a target with its bite, it gains an amount of HP equal to half the damage dealt (minimum 1)."},{"name":"Overwhelm","description":"Dire bats receive a +2 bonus to attack rolls for each adjacent vampyre bat or dire bat (max +10)."},{"name":"Supersonic Screech","description":"As a primary action, the dire bat may make an attack roll (d20+15) against the Fort Defences of all enemies within a 6 square cone. If successful, the target moves -1 step on the Break Gauge. The dire bat may not use this ability again for 1d4+1 turns."}],"spells":[],"performances":[],"equipped":"","loot":"Moondust (5%), Vampyre Fang (20%), 100gp (50%), Beast Mane (95%)","steal":"Stardust (5%), Rapier (20%), Health Potion (50%)","sourcePage":285}},"prototypeToken":{"name":"Bat, Dire","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":0,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"9666a747a0a96230","name":"Bite","type":"weapon","img":"systems/last-arc-analogue/assets/ffxiv-icons/generic/auto-attack.webp","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+5","type":"piercing"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"873bf931abce50e0","name":"Blood Drain","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/SCH/Energy_Drain.webp","system":{"category":"Special Ability","description":"Whenever a dire bat deals damage to a target with its bite, it gains an amount of HP equal to half the damage dealt (minimum 1).","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9bad2861784328b6","name":"Overwhelm","type":"