{"_id":"5d83ecf94dd8406d","name":"Appleshot","type":"weapon","img":"icons/weapons/bows/bow-ornamental-carved-brown.webp","system":{"category":"Crossbows","description":"A famous crossbow used to overthrow a tyrant king, it is said to split its own bolts, able to hit the same spot repeatedly. Successful hits against a single target, that do not result in a critical hit, increase the critical range of Appleshot’s next attack against the same target by 1. This effect stacks with itself and lasts until a critical hit is achieved or a different target is attacked, whichever comes first.","cost":23500,"availability":"Legendary","bulk":1,"weaponGroup":"crossbows","weaponSize":"Medium","weaponSkill":"ranged","attack":{"bonus":5},"damage":{"formula":"2d8+5","type":"Piercing"},"range":"Ranged","capacity":10,"specialRules":"A famous crossbow used to overthrow a tyrant king, it is said to split its own bolts, able to hit the same spot repeatedly. Successful hits against a single target, that do not result in a critical hit, increase the critical range of Appleshot’s next attack against the same target by 1. This effect stacks with itself and lasts until a critical hit is achieved or a different target is attacked, whichever comes first."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"5a2532c373cbe8af","name":"Sarnga","type":"weapon","img":"icons/weapons/bows/bow-ornamental-carved-brown.webp","system":{"category":"Crossbows","description":"A legendary crossbow created to rival Pinaka—it focuses incredible power into a single shot. While aiming, your target is treated as weak against Sarnga’s damage.","cost":27400,"availability":"Legendary","bulk":2,"weaponGroup":"crossbows","weaponSize":"Large","weaponSkill":"ranged","attack":{"bonus":5},"damage":{"formula":"2d10+5","type":"Piercing"},"range":"Ranged","capacity":15,"specialRules":"A legendary crossbow created to rival Pinaka—it focuses incredible power into a single shot. While aiming, your target is treated as weak against Sarnga’s damage."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"5ea2384c2dbd5c4d","name":"Dwarven Crossbow","type":"weapon","img":"icons/weapons/bows/bow-ornamental-carved-brown.webp","system":{"category":"Crossbows","description":"A large crossbow with a high capacity.","cost":4600,"availability":"Rare","bulk":2,"weaponGroup":"crossbows","weaponSize":"Large","weaponSkill":"ranged","attack":{"bonus":2},"damage":{"formula":"2d10+1","type":"Piercing"},"range":"Ranged","capacity":20,"specialRules":"An advanced dwarven-made crossbow, able to fire a cluster of bolts in a single shot. You reduce the penalties to use the Volley talent by one step (-5 to -2, or -2 to 0)."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
