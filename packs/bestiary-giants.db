{"_id":"002472f4e6903b14","name":"Ogre","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":6,"xp":0,"nextLevel":0,"className":"","race":"Giants","alignment":"Corrupt","biography":"Savage and violent, these hulking brutes often join orcs and goblins in inland raids."},"attributes":{"str":{"score":21},"vit":{"score":23},"agi":{"score":8},"int":{"score":6},"mnd":{"score":9},"cha":{"score":7}},"skills":{"athletics":{"trained":true,"total":13},"perception":{"trained":true,"total":7},"persuasion":{"trained":true,"total":6},"unarmed":{"trained":true,"total":13}},"defences":{"ref":{"total":16},"fort":{"total":22},"will":{"total":15}},"resources":{"hp":{"value":66,"max":66,"baseMax":66},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":8,"baseSpeed":8,"damageReduction":5,"baseDamageReduction":5,"breakThreshold":27,"immunities":[],"resistances":[],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Giants","profile":"giant","cr":6,"level":6,"xp":1200,"size":"large","species":"Giants","profileLine":"Corrupt Evil Large Giant 6; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Savage and violent, these hulking brutes often join orcs and goblins in inland raids.","languages":"Giant Savage and violent, these hulking brutes often join orcs and goblins in inland raids.","speedText":"8","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 17","passivePerception":17,"attributes":{"str":21,"agi":8,"vit":23,"int":6,"mnd":9,"cha":7},"defences":{"ref":16,"flatFootedRef":16,"fort":22,"will":15},"damageReduction":5,"breakThreshold":27,"immunities":[],"resistances":[],"weaknesses":[],"skills":[{"name":"Handed","bonus":18,"key":""},{"name":"Athletics","bonus":13,"key":"athletics"},{"name":"Perception","bonus":7,"key":"perception"},{"name":"Persuasion","bonus":6,"key":"persuasion"},{"name":"Unarmed","bonus":13,"key":"unarmed"}],"attacks":[{"name":"Oaken Club","attack":19,"damage":"2d10+9","mode":"melee","type":"blunt"}],"abilities":[{"name":"Overthrow","description":"Whenever an ogre successfully deals damage to a target at the end of a charge, they may choose to move the target 3 squares away from them in any direction. This is a stun."}],"spells":[],"performances":[],"equipped":"Bronze Chestplate, Oaken Club","loot":"Gigas Heart (5%), Bronze Chestplate (20%), Oaken Club (50%), Giant Hide (95%), and 300gp","steal":"Ether (5%), Hi-Potion (95%) Giants Remnants of a more primitive age before civilizations flourished, giants once held dominion over the lesser tribes, contested only by the great dragons. While still widely feared, most see the giants as little more than oversized brutes that even the lowly Goblins can bring under their meager command. Giants progress as beasts. However, they have the class skills of a nonheroic character and gain 2 attribute points every 4th level, as normal.","sourcePage":339}},"prototypeToken":{"name":"Ogre","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"3e90e6e531d1fbcd","name":"Oaken Club","type":"weapon","img":"icons/weapons/maces/mace-flanged-steel.webp","system":{"weaponGroup":"natural","weaponSkill":"one-handed","range":"Melee","damage":{"formula":"2d10+9","type":"blunt"},"attack":{"bonus":19},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6fdfe45d4c523eb2","name":"Overthrow","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Lance_Charge.webp","system":{"category":"Special Ability","description":"Whenever an ogre successfully deals damage to a target at the end of a charge, they may choose to move the target 3 squares away from them in any direction. This is a stun."