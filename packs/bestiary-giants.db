{"_id":"e312546b61e042e3","name":"Jotun","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":15,"xp":0,"nextLevel":0,"className":"","race":"Giants","alignment":"Corrupt","biography":"Ancient giants of Jorunheim’s northern wastes, a looming threat to dwarves. Some say they’re kin to the mythic Nephilim."},"attributes":{"str":{"score":40},"vit":{"score":26},"agi":{"score":9},"int":{"score":9},"mnd":{"score":14},"cha":{"score":13}},"skills":{"athletics":{"trained":true,"total":27},"perception":{"trained":true,"total":19},"persuasion":{"trained":true,"total":8},"survival":{"trained":true,"total":14},"unarmed":{"trained":true,"total":32}},"defences":{"ref":{"total":23},"fort":{"total":34},"will":{"total":28}},"resources":{"hp":{"value":215,"max":215,"baseMax":215},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":15,"baseDamageReduction":15,"breakThreshold":49,"immunities":["Cold","Curse","Paralysis","Poison","Stuns","Toad"],"resistances":[],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Giants","profile":"giant","cr":15,"level":15,"xp":3000,"size":"huge","species":"Giants","profileLine":"Corrupt Evil Huge Giant 15; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Ancient giants of Jorunheim’s northern wastes, a looming threat to dwarves. Some say they’re kin to the mythic Nephilim.","languages":"Giant Ancient giants of Jorunheim’s northern wastes, a looming threat to dwarves. Some say they’re kin to the mythic Nephilim.","speedText":"6","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 23","passivePerception":23,"attributes":{"str":40,"agi":9,"vit":26,"int":9,"mnd":14,"cha":13},"defences":{"ref":23,"flatFootedRef":23,"fort":34,"will":28},"damageReduction":15,"breakThreshold":49,"immunities":["Cold","Curse","Paralysis","Poison","Stuns","Toad"],"resistances":[],"weaknesses":["Fire"],"skills":[{"name":"Athletics","bonus":27,"key":"athletics"},{"name":"Perception","bonus":19,"key":"perception"},{"name":"Persuasion","bonus":8,"key":"persuasion"},{"name":"Survival","bonus":14,"key":"survival"},{"name":"Unarmed","bonus":32,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":29,"damage":"2d6+25","mode":"melee","type":"piercing"},{"name":"Bite","attack":29,"damage":"3d6+25","mode":"melee","type":"piercing"},{"name":"Slams","attack":29,"damage":"1d8+25","mode":"melee","type":"blunt"},{"name":"Slams","attack":29,"damage":"2d8+25","mode":"melee","type":"blunt"}],"abilities":[{"name":"Devour","description":"Whenever a jotun reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The jotun then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the jotun may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Frostbite","description":"A jotun’s natural attacks deal cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the jotun's next turn."},{"name":"Ice Beam","description":"As a primary action, the jotun can make a single attack roll (d20+25) against a target within 12 squares and line of sight and all creatures between it and the target. If successful, the target takes 8d6+15 cold damage. Should the attack beat both a target's Ref and Fort Defence, the target loses its secondary action on its next turn. The jotun may not use this ability again for 1d4+1 turns."},{"name":"Imposing","description":"A jotun may add its Str modifier to any Persuasion checks made to intimidate."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Gigas Heart (20%), Giant Hide (50%), Ice Crystal (95%)","steal":"Moondust (5%), 1,500gp (20%), 900gp (50%) * Includes 3 points of mighty strikes. ** When using Persuasion to intimidate.","sourcePage":343}},"prototypeToken":{"name":"Jotun","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"f5f663ae773ceed3","name":"Bite","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d6+25","type":"piercing"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"de889dd5e36c1ee2","name":"Bite","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"3d6+25","type":"piercing"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"186e3cbf9436202a","name":"Slams","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+25","type":"blunt"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3bb7a300936d6bf2","name":"Slams","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"2d8+25","type":"blunt"},"attack":{"bonus":-3},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"5b2a8a1d119e597c","name":"Devour","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BRD/The_Wanderer's_Minuet.webp","system":{"category":"Special Ability","description":"Whenever a jotun reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The jotun then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the jotun may perform a coup de grace on an unconscious creature, devouring the creature.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d65433a9fde41d93","name":"Frostbite","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"category":"Special Ability","description":"A jotun’s natural attacks deal cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the jotun's next turn.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"596de999cc0c444c","name":"Ice Beam","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"As a primary action, the jotun can make a single attack roll (d20+25) against a target within 12 squares and line of sight and all creatures between it and the target. If successful, the target takes 8d6+15 cold damage. Should the attack beat both a target's Ref and Fort Defence, the target loses its secondary action on its next turn. The jotun may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ed981be14f8a24ae","name":"Imposing","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Special Ability","description":"A jotun may add its Str modifier to any Persuasion checks made to intimidate.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d84b7102fad7a59d","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"9687ed52ca108ef1","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"77953a4b411560df","name":"Mighty Strikes","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"6ae18bc1a5ebae28","name":"Power Attack","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/Chocobo/Choco_strike_icon1.webp","system":{"description":"Spend two minor actions to deal one additional damage die on all melee attacks until your turn ends. Does not stack with Rapid Strike.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"47151ee7ca191665","name":"Shake it Off","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Shake_It_Off.webp","system":{"description":"Spend two minor actions, instead of three, to take a recovery action.","prerequisites":{"attributes":{"vit":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"a058b69541954751","name":"Skill Focus (perception, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"perception, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"967c1a0ac759c46f","name":"Threshold Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"description":"Gain +5 to your Break Threshold.","effects":{"breakThresholdBonus":5},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
