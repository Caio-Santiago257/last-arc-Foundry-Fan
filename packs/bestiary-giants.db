{"_id":"2522034a925e7b26","name":"Cyclops","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":8,"xp":0,"nextLevel":0,"className":"","race":"Giants","alignment":"Corrupt","biography":"To meet a cyclops’s gaze is to invite ruin—a curse whispered through ancient tales."},"attributes":{"str":{"score":30},"vit":{"score":28},"agi":{"score":14},"int":{"score":9},"mnd":{"score":16},"cha":{"score":8}},"skills":{"athletics":{"trained":true,"total":19},"lore-terrestrial":{"trained":true,"total":8},"perception":{"trained":true,"total":12},"persuasion":{"trained":true,"total":8},"survival":{"trained":true,"total":12},"unarmed":{"trained":true,"total":24}},"defences":{"ref":{"total":19},"fort":{"total":28},"will":{"total":22}},"resources":{"hp":{"value":125,"max":125,"baseMax":125},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":43,"immunities":["Confusion","Poison","Stuns"],"resistances":["Cold","Dark","Electric","Fire","Holy"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Giants","profile":"giant","cr":8,"level":8,"xp":1600,"size":"huge","species":"Giants","profileLine":"Corrupt Evil Huge Giant 8; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"To meet a cyclops’s gaze is to invite ruin—a curse whispered through ancient tales.","languages":"Giant To meet a cyclops’s gaze is to invite ruin—a curse whispered through ancient tales.","speedText":"6","initiativeDie":"1d8","senses":"Dark Vision; Passive Perception 22","passivePerception":22,"attributes":{"str":30,"agi":14,"vit":28,"int":9,"mnd":16,"cha":8},"defences":{"ref":19,"flatFootedRef":17,"fort":28,"will":22},"damageReduction":10,"breakThreshold":43,"immunities":["Confusion","Poison","Stuns"],"resistances":["Cold","Dark","Electric","Fire","Holy"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":19,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":8,"key":"lore-terrestrial"},{"name":"Perception","bonus":12,"key":"perception"},{"name":"Persuasion","bonus":8,"key":"persuasion"},{"name":"Survival","bonus":12,"key":"survival"},{"name":"Unarmed","bonus":24,"key":"unarmed"}],"attacks":[{"name":"Slams","attack":24,"damage":"1d8+14","mode":"melee","type":"blunt"}],"abilities":[{"name":"Eye Beam","description":"As a primary action, the cyclops can make a single attack roll (d20+23) against a target within 12 squares and line of sight and all creatures between it and the target. If successful, the target takes 6d6+13 electric damage. Should the attack beat both a target's Ref and Fort Defence, the target becomes paralysed. The cyclops may not use this ability again for 1d4+1 turns."},{"name":"Imposing","description":"A cyclops may add its Str modifier to all Persuasion checks made to intimidate."}],"spells":[],"performances":[],"equipped":"","loot":"Evil Eye (5%), Giant Hide (50%)","steal":"Stardust (5%), Hi-potion (50%) * When using Persuasion to intimidate.","sourcePage":340}},"prototypeToken":{"name":"Cyclops","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"bd138fdb7a03963f","name":"Slams","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"unarmed","range":"Melee","damage":{"formula":"1d8+14","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ecac86b25cf07222","name":"Eye Beam","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/BLM/Between_the_Lines.webp","system":{"category":"Special Ability","description":"As a primary action, the cyclops can make a single attack roll (d20+23) against a target within 12 squares and line of sight and all creatures between it and the target. If successful, the target takes 6d6+13 electric damage. Should the attack beat both a target's Ref and Fort Defence, the target becomes paralysed. The cyclops may not use this ability again for 1d4+1 turns.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"798cc26cd8188c31","name":"Imposing","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/BattleLitanyBuff.webp","system":{"category":"Special Ability","description":"A cyclops may add its Str modifier to all Persuasion checks made to intimidate.","automation":{"kind":"adversaryAbility"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"d7838d41f6b5ad34","name":"Defence Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/PLD/Bulwark.webp","system":{"description":"Gain +1 to Fortitude, Reflex, and Will Defence.","effects":{"defenceBonuses":{"fort":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b38e01052d7bb6e2","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"3e198b4b5ebf8209","name":"Skill Focus (unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"