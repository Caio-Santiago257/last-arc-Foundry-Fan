t":1,"ref":1,"will":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"b3b37314bf3e7a81","name":"HP Up","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/WAR/Thrill_of_Battle.webp","system":{"description":"Increase maximum HP by 5 + your character level.","effects":{"resources":{"hpMaxFlat":5,"hpMaxPerLevel":1}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"29aab231a499de31","name":"Mighty Strikes","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Life_of_the_Dragon.webp","system":{"description":"Before an attack, choose a penalty up to -1 on melee attacks and gain the same bonus to melee damage until your next turn. The limit increases by 1 at character level 4 and every 4 levels thereafter, to -5/+5; two-handed weapons double the damage bonus.","prerequisites":{"attributes":{"str":13}},"category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"ceee673706130ab1","name":"Skill Focus (ranged, unarmed)","type":"technick","img":"systems/last-arc-analogue/assets/ffxiv-icons/DRG/Fang_and_Claw.webp","system":{"description":"Choose a trained skill and gain +5 to its checks. Each additional copy must apply to a different trained skill.","repeatable":true,"choice":{"type":"trainedSkill"},"effects":{"selectedSkillBonus":5},"selectedSkill":"ranged, unarmed","category":"Technick"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}],"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"343174ccee5ff671","name":"Gigas","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":11,"xp":0,"nextLevel":0,"className":"","race":"Giants","alignment":"Corrupt","biography":"Enormous and blood-rune-covered, this powerful giant resists magick’s touch."},"attributes":{"str":{"score":39},"vit":{"score":23},"agi":{"score":14},"int":{"score":9},"mnd":{"score":16},"cha":{"score":11}},"skills":{"athletics":{"trained":true,"total":24},"lore-terrestrial":{"trained":true,"total":9},"perception":{"trained":true,"total":13},"persuasion":{"trained":true,"total":10},"survival":{"trained":true,"total":13},"unarmed":{"trained":true,"total":29}},"defences":{"ref":{"total":22},"fort":{"total":28},"will":{"total":25}},"resources":{"hp":{"value":137,"max":137,"baseMax":137},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":43,"immunities":["Poison","Stuns"],"resistances":["Cold","Electric","Fire"],"vulnerabilities":[]},"adversary":{"isAdversary":true,"category":"Giants","profile":"giant","cr":11,"level":11,"xp":2200,"size":"huge","species":"Giants","profileLine":"Corrupt Evil Huge Giant 11; Aggressive","classLevels":"","alignment":"Corrupt","temperament":"Aggressive","description":"Enormous and blood-rune-covered, this powerful giant resists magick’s touch.","languages":"Giant Enormous and blood-rune-covered, this powerful giant resists magick’s touch.","speedText":"6","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 23","passivePerception":23,"attributes":{"str":39,"agi":14,"vit":23,"int":9,"mnd":16,"cha":11},"defences":{"ref":22,"flatFootedRef":20,"fort":28,"will":25},"damageReduction":10,"breakThreshold":43,"immunities":["Poison","Stuns"],"resistances":["Cold","Electric","Fire"],"weaknesses":[],"skills":[{"name":"Athletics","bonus":24,"key":"athletics"},{"name":"Lore (terrestrial)","bonus":9,"key":"lore-terrestrial"},{"name":"Perception","bonus":13,"key":"perception"},{"name":"Persuasion","bonus":10,"key":"persuasion"},{"name":"Survival","bonus":13,"key":"survival"},{"name":"Unarmed","bonus":29,"key":"unarmed"}],"attacks":[{"name":"Bite","attack":26,"damage":"2d6+22","mode":"melee","type":"piercing"},{"name":"Slams","attack":26,"damage":"1d8+22","mode":"melee","type":"blunt"}],"abilities":[{"name":"Devour","description":"Whenever a gigas reduces a creature to 0 HP or the bottom of the Break Gauge with its bite attack, the creature is immediately swallowed, killed (regardless of hero points), and removed from play. The gigas then immediately heals an amount of HP equal to the swallowed creature’s (level + Vit modifier) x2. Additionally, as a primary action, the gigas may perform a coup de grace on an unconscious creature, devouring the creature."},{"name":"Imposing","description":"A Gigas may add its Str modifier to any Persuasion checks made to intimidate."},{"name":"Runic","description":"The gigas gains a +5 bonus to both its Fort and Will Defence against spells."},{"name":"Tremor","description":"As a primary action, the gigas can make an attack roll (d20+21) against the Ref Defence of all creatures within a 6 square cone. If successful, creatures take 6d6+11 blunt damage and are knocked prone. Otherwise, creatures take half damage and are not knocked prone. The gigas may not use this ability again for 1d4+1 turns. This does not affect creatures with hover. This is an area affect and the secondary effect is a stun."}],"spells":[],"performances":[],"equipped":"","loot":"Stardust (5%), Gigas Heart (20%), Giant Hide (50%)","steal":"Stardust (5%), Giant Hide (95%) * Against spells. ** Includes 3 points of mighty strikes. † When using Persuasion to intimidate.","sourcePage":342}},"prototypeToken":{"name":"Gigas","texture":{"src":"icons/svg/mystery-man.svg"},"width":3,"height":3,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"