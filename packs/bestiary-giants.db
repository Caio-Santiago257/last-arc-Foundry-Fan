{"_id":"aa2d39ca46214558","name":"Troll, Ice","type":"npc","img":"icons/svg/mystery-man.svg","system":{"details":{"level":9,"xp":0,"nextLevel":0,"className":"","race":"Giants","alignment":"Corrupt","biography":"Dubbed abominable snowmen, these towering brutes may seem jolly—until it’s far too late."},"attributes":{"str":{"score":28},"vit":{"score":26},"agi":{"score":14},"int":{"score":5},"mnd":{"score":9},"cha":{"score":7}},"skills":{"perception":{"trained":true,"total":8},"ranged":{"trained":true,"total":23},"stealth":{"trained":true,"total":1},"survival":{"trained":true,"total":8},"unarmed":{"trained":true,"total":23}},"defences":{"ref":{"total":21},"fort":{"total":28},"will":{"total":19}},"resources":{"hp":{"value":131,"max":131,"baseMax":131},"mp":{"value":0,"max":0}},"combat":{"initiativeDie":"1d8","speed":6,"baseSpeed":6,"damageReduction":10,"baseDamageReduction":10,"breakThreshold":33,"immunities":["Cold"],"resistances":["Slashing"],"vulnerabilities":["Fire"]},"adversary":{"isAdversary":true,"category":"Giants","profile":"giant","cr":9,"level":9,"xp":1800,"size":"large","species":"Giants","profileLine":"Corrupt Evil Large Giant 9; Territorial","classLevels":"","alignment":"Corrupt","temperament":"Territorial","description":"Dubbed abominable snowmen, these towering brutes may seem jolly—until it’s far too late.","languages":"Giant Dubbed abominable snowmen, these towering brutes may seem jolly—until it’s far too late.","speedText":"6","initiativeDie":"1d8","senses":"Low-light Vision; Passive Perception 18","passivePerception":18,"attributes":{"str":28,"agi":14,"vit":26,"int":5,"mnd":9,"cha":7},"defences":{"ref":21,"flatFootedRef":19,"fort":28,"will":19},"damageReduction":10,"breakThreshold":33,"immunities":["Cold"],"resistances":["Slashing"],"weaknesses":["Fire"],"skills":[{"name":"Perception","bonus":8,"key":"perception"},{"name":"Ranged","bonus":23,"key":"ranged"},{"name":"Stealth","bonus":1,"key":"stealth"},{"name":"Survival","bonus":8,"key":"survival"},{"name":"Unarmed","bonus":23,"key":"unarmed"}],"attacks":[{"name":"Lob","attack":23,"damage":"1d6+13","mode":"ranged","type":"blunt"}],"abilities":[{"name":"Frostbite","description":"An ice troll’s slam attack deals cold damage. Additionally, if the attack roll beats both the target's Ref and Fort Defence, the target’s movement is reduced to 2 squares until the start of the ice troll's next turn."},{"name":"Lob","description":"Ice Trolls may make a slam attack as if using a thrown weapon. Additionally, they may use their Str modifier in place of their Agi modifier when doing so."},{"name":"Lurk","description":"Trolls are naturally better blending into their surroundings. When in tundra, taiga, or glacial environment, Ice Trolls treat Stealth as a trained skill and ignore any size penalties to their Stealth checks."},{"name":"Regrow","description":"When a ice troll loses a limb, they can grow it back in 1d10+1 days, at which point any penalties are removed."}],"spells":[],"performances":[],"equipped":"","loot":"Ancient Bone (5%), Giant Hide (50%), Ice Crystal (95%), and 400gp","steal":"Magick Root (50%) * Includes 3 points of mighty strikes. **With Lurk.","sourcePage":341}},"prototypeToken":{"name":"Troll, Ice","texture":{"src":"icons/svg/mystery-man.svg"},"width":2,"height":2,"actorLink":false,"disposition":-1,"displayName":20,"displayBars":20,"bar1":{"attribute":"resources.hp"},"bar2":{"attribute":"resources.mp"}},"items":[{"_id":"27d7129b6adbf7a7","name":"Lob","type":"weapon","img":"icons/svg/sword.svg","system":{"weaponGroup":"natural","weaponSkill":"ranged","range":"Ranged","damage":{"formula":"1d6+13","type":"blunt"},"attack":{"bonus":0},"npcStaticAttack":true,"specialRules":"Attack and damage values use this adversary's printed stat block."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}},{"_id":"2bcb19a5124f6ad4","name":"Frostbite","type":"feature","img":"systems/last-arc-analogue/assets/ffxiv-icons/AST/The_Arrow.webp","system":{"categ